# Email - every email is sent from researchlab@mcaheart.com (src/lib/email.ts).
# Leave SMTP_PASS empty to log emails to the console instead (local dev).
#   ZeptoMail: SMTP_HOST=smtp.zeptomail.com  SMTP_USER=emailapikey  SMTP_PASS=<credential password>
#   Zoho Mail: SMTP_HOST=smtp.zoho.com       SMTP_USER=(leave unset) SMTP_PASS=<app password for researchlab@>
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Where form submissions are delivered
CONTACT_TO=researchlab@mcaheart.com
IDEAS_TO=researchlab@mcaheart.com
RECRUIT_TO=researchlab@mcaheart.com
