---
import '../styles/global.css';
import '../styles/pipeline.css';
import FontLinks from '../components/FontLinks.astro';
import ThemeInit from '../components/ThemeInit.astro';
import AppBar from '../components/AppBar.astro';
import JournalOptions from '../components/JournalOptions.astro';
import { scopeProjects } from '../lib/pipeline-scope';
import { getPipelineTasks } from '../lib/pipeline-tasks';

interface Props {
  title: string;
  active?: 'conferences' | 'ongoing' | 'submissions' | 'published' | 'analysis' | 'tasks' | 'ideas' | 'requests' | 'learning';
  /** The page has journal-name boxes: include the shared journal list. */
  journals?: boolean;
}
const { title, active, journals = false } = Astro.props;
const { supabase, person } = Astro.locals;
const isAdmin = person.role === 'admin';

type Tab = { key: string; label: string; href: string; count: number | null; alert?: boolean; items?: { label: string; href: string }[] };

// Admins reach Tasks from the top app bar now (Manage > Tasks) and don't
// render this tab, so skip the query that only fed its badge count.
const tasks = isAdmin ? [] : await getPipelineTasks(supabase, person);
const taskTab: Tab = {
  key: 'tasks',
  label: 'Tasks',
  href: '/pipeline/tasks',
  count: tasks.length,
  alert: tasks.some((t) => t.urgent),
};

// Admins see totals; members see only their own papers in each phase.
const phaseCount = (phase: string) => {
  let q = supabase
    .from(isAdmin ? 'projects' : 'project_list')
    .select('id', { count: 'exact', head: true })
    .eq('phase', phase)
    .is('archived_at', null)
    .is('hidden_at', null)
    .is('deleted_at', null);
  return isAdmin ? q : scopeProjects(q, person);
};

// Admin only: journal-phase projects split into "still at a journal" vs "published".
const journalStageCount = (op: 'eq' | 'neq') =>
  supabase
    .from('projects')
    .select('id', { count: 'exact', head: true })
    .eq('phase', 'journal')
    .is('archived_at', null)
    .is('hidden_at', null)
    .is('deleted_at', null)
    [op]('stage', 'published');

// First authors (leads) of an open paper can ask for helpers on it.
const leadsAPaper = isAdmin
  ? false
  : ((await supabase.from('projects').select('id', { count: 'exact', head: true })
      .eq('lead_id', person.id).is('archived_at', null).is('deleted_at', null)).count ?? 0) > 0;

// Admin: database papers (TriNetX, NIS, NRD, DMC PCI) still without an analyst.
const noAnalystCount = () =>
  supabase
    .from('projects')
    .select('id', { count: 'exact', head: true })
    .in('study_type', ['TriNetX', 'NIS', 'NRD', 'DMC PCI'])
    .is('analyst_id', null)
    .neq('stage', 'published')
    .is('archived_at', null)
    .is('hidden_at', null)
    .is('deleted_at', null);

const [confN, ongoingN, subsN, pubN, anN] = await Promise.all([
  isAdmin
    ? supabase.from('conferences').select('id', { count: 'exact', head: true })
    : phaseCount('conference'),
  phaseCount('manuscript'),
  isAdmin ? journalStageCount('neq') : phaseCount('journal'),
  isAdmin ? journalStageCount('eq') : Promise.resolve({ count: null }),
  isAdmin ? noAnalystCount() : Promise.resolve({ count: null }),
]);

const flashOk = Astro.url.searchParams.get('ok');
const flashErr = Astro.url.searchParams.get('err');

const tabs: Tab[] = [
  { key: 'conferences', label: 'Conferences', href: '/pipeline/conferences', count: confN.count ?? null },
  { key: 'ongoing', label: 'Ongoing', href: '/pipeline/ongoing', count: ongoingN.count ?? null },
  { key: 'submissions', label: 'Submissions', href: '/pipeline/submissions', count: subsN.count ?? null },
  ...(isAdmin
    ? [
        { key: 'published', label: 'Published', href: '/pipeline/published', count: pubN.count ?? null },
        // The count is papers still waiting for an analyst.
        { key: 'analysis', label: 'Analysis', href: '/pipeline/analysis', count: anN.count ?? null, alert: true },
      ]
    : []),
  // Admins now reach these two from the top app bar (Manage > Tasks, and
  // New Idea) instead - but members have no app-bar nav items at all, so
  // this strip stays their only way to either one.
  ...(isAdmin
    ? []
    : [
        taskTab,
        // No count: these are things to ask for, not a queue of work. New
        // ideas, letters of recommendation and joining a topic all start here.
        {
          key: 'requests', label: 'Requests', href: '/pipeline/requests', count: null,
          items: [
            { label: 'New idea', href: '/pipeline/ideas' },
            { label: 'Letter of recommendation', href: '/pipeline/requests?type=lor' },
            { label: 'Join a new topic', href: '/pipeline/requests?type=topic' },
            ...(leadsAPaper ? [{ label: 'Request help on my paper', href: '/pipeline/help' }] : []),
          ],
        },
        { key: 'learning', label: 'Learning', href: '/pipeline/learning', count: null },
      ]),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeInit />
    <title>{title} · MCA Research Workflow</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141412" media="(prefers-color-scheme: dark)" />
    <FontLinks />
    {/* Internal pages run on Merriweather Sans; Archivo stays for the public site. */}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Merriweather+Sans:ital,wght@0,300..800;1,300..800&display=swap" />
  </head>
  <body class="pl-body">
    <AppBar
      active={isAdmin && active === 'tasks' ? 'tasks' : isAdmin && active === 'ideas' ? 'new-idea' : isAdmin && active === 'learning' ? 'learning' : 'pipeline'}
      name={person.full_name}
      role={person.role}
      email={person.email}
    />

    <nav class="pl-tabs" aria-label="Workflow sections">
      <div class="pl-tabs__row">
        {tabs.map((t) => t.items ? (
          // A tab that opens a small menu (members' Requests), like Review /
          // Manage in the admin bar.
          <span class="pl-tabmenu" data-tabmenu>
            <button type="button" class:list={['pl-tab', 'pl-tabmenu__btn', active === t.key && 'is-active']} aria-haspopup="true" aria-expanded="false" data-tabmenu-toggle>
              {t.label}
              <svg viewBox="0 0 20 20" width="12" height="12" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="m5 7.5 5 5 5-5" /></svg>
            </button>
            <div class="pl-tabmenu__panel" data-tabmenu-panel hidden>
              {t.items.map((s) => <a href={s.href}>{s.label}</a>)}
            </div>
          </span>
        ) : (
          <a class:list={['pl-tab', active === t.key && 'is-active']} href={t.href}>
            {t.label}
            {typeof t.count === 'number' && (
              <span class:list={['pl-tab__count', t.alert && t.count > 0 && 'is-alert']}>{t.count}</span>
            )}
          </a>
        ))}
      </div>
    </nav>

    <main class="pl-main">
      {flashOk && <p class="pl-flash pl-flash--ok">{flashOk}</p>}
      {flashErr && <p class="pl-flash pl-flash--err">{flashErr}</p>}
      <slot />
      {journals && <JournalOptions canSave={isAdmin} />}
    </main>

    <!-- Slide-in project detail. Populated client-side from /pipeline/projects/:id/panel.json. -->
    <div class="pl-drawer" id="pl-drawer" hidden>
      <div class="pl-drawer__backdrop" data-drawer-close></div>
      <aside class="pl-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="pl-drawer-title">
        <div class="pl-drawer__head">
          <p class="pl-drawer__ref" id="pl-drawer-ref"></p>
          <button type="button" class="pl-drawer__x" data-drawer-close aria-label="Close">×</button>
        </div>
        <div class="pl-drawer__scroll">
          <h2 class="pl-drawer__title" id="pl-drawer-title"></h2>
          <div class="pl-drawer__body" id="pl-drawer-body"></div>
        </div>
        <div class="pl-drawer__foot" id="pl-drawer-foot" hidden></div>
      </aside>
    </div>

    <script is:inline>
      // Project detail drawer.
      (() => {
        const drawer = document.getElementById('pl-drawer');
        if (!drawer) return;
        const refEl = document.getElementById('pl-drawer-ref');
        const titleEl = document.getElementById('pl-drawer-title');
        const bodyEl = document.getElementById('pl-drawer-body');
        const footEl = document.getElementById('pl-drawer-foot');

        const esc = (s) =>
          String(s ?? '').replace(/[&<>"']/g, (c) =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
          );
        const fmt = (d) =>
          d ? new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';

        let lastFocus = null;

        function open(id, push) {
          if (push === undefined) push = true;
          lastFocus = document.activeElement;
          drawer.hidden = false;
          document.body.style.overflow = 'hidden';
          requestAnimationFrame(() => drawer.classList.add('is-open'));
          refEl.textContent = '';
          titleEl.textContent = 'Loading…';
          bodyEl.innerHTML = '<div class="pl-dskel" aria-hidden="true"><i></i><i></i><i></i><i></i></div><p class="pl-drawer__loading">Loading the paper…</p>';
          footEl.hidden = true;
          if (push) history.pushState({ panel: id }, '', location.pathname + '?panel=' + id);

          fetch('/pipeline/projects/' + encodeURIComponent(id) + '/panel.json', { headers: { accept: 'application/json' } })
            .then((r) => (r.ok ? r.json() : r.json().then((e) => Promise.reject(e))))
            .then((d) => render(d))
            .catch((e) => {
              titleEl.textContent = 'Could not open';
              bodyEl.innerHTML = '<p class="pl-drawer__loading">' + esc((e && e.error) || 'Something went wrong.') + '</p>';
            });
        }

        function close(push) {
          if (push === undefined) push = true;
          drawer.classList.remove('is-open');
          document.body.style.overflow = '';
          const done = () => {
            drawer.hidden = true;
            drawer.removeEventListener('transitionend', done);
          };
          drawer.addEventListener('transitionend', done);
          setTimeout(done, 320);
          if (push) history.pushState({}, '', location.pathname);
          if (lastFocus && lastFocus.focus) lastFocus.focus();
        }

        function row(dt, dd) {
          return dd ? '<dt>' + esc(dt) + '</dt><dd>' + dd + '</dd>' : '';
        }
        const initials = (n) => String(n || '').trim().split(/\s+/).slice(0, 2).map((w) => w[0] || '').join('').toUpperCase();
        const SHORT_ROLE = {
          'Manuscript writing': 'Writing',
          'Screening/Extraction for meta-analysis': 'Screening',
          'Visuals': 'Visuals',
          'Analysis for TriNetX': 'TriNetX analysis',
          'Analysis for NIS/NRD': 'NIS/NRD analysis',
        };
        const STEPS = [['idea', 'Idea'], ['conference', 'Conference'], ['manuscript', 'Ongoing'], ['journal', 'Submitted'], ['published', 'Published']];
        const OUT = { accepted: 'ok', published: 'ok', rejected: 'bad', withdrawn: 'bad', rejected_comments: 'bad', rejected_no_comments: 'bad' };
        const pill = (o, fallback) => '<span class="pl-dpill pl-dpill--' + (o ? (OUT[o] || 'mid') : 'wait') + '">' + esc(o ? String(o).replace(/_/g, ' ') : fallback) + '</span>';

        function render(d) {
          refEl.innerHTML = '<span class="pl-dref">' + esc(d.ref) + '</span><span class="pl-dref pl-dref--soft">' + esc(d.study_type) + '</span>';
          titleEl.textContent = d.title;

          const late = d.days_overdue != null && d.days_overdue > 0;
          const flags = [
            late ? '<span class="pl-dflag pl-dflag--bad">Overdue ' + d.days_overdue + ' days</span>' : '',
            d.parked ? '<span class="pl-dflag">Parked</span>' : '',
            d.archived_at ? '<span class="pl-dflag pl-dflag--bad">Archived' + (d.archive_reason ? ': ' + esc(String(d.archive_reason).replace(/_/g, ' ')) : '') + '</span>' : '',
          ].join('');
          const cur = d.phase === 'journal' && d.stage === 'published' ? 4 : Math.max(0, STEPS.findIndex((s) => s[0] === d.phase));
          const stepper = '<ol class="pl-dsteps">' + STEPS.map((s, i) =>
            '<li class="' + (i < cur ? 'is-done' : i === cur ? 'is-cur' : '') + '"' + (i === cur ? ' aria-current="step"' : '') + '><span>' + s[1] + '</span></li>').join('') + '</ol>';
          const statusCard =
            '<div class="pl-dstatus">' +
              '<p class="pl-dstatus__label">' + esc(d.stage_label) + '</p>' +
              '<p class="pl-dstatus__sub">' + (d.days_in_stage != null ? d.days_in_stage + ' day' + (d.days_in_stage === 1 ? '' : 's') + ' at this stage' : '') +
                (d.next_target ? ' · target ' + fmt(d.next_target) : '') + '</p>' +
              (flags ? '<p class="pl-dflags">' + flags + '</p>' : '') +
              stepper +
            '</div>';

          const ppl = d.people || {};
          const person = (role, name, extra) => name
            ? '<li class="pl-dperson"><span class="pl-dav" aria-hidden="true">' + esc(initials(name)) + '</span><span><b>' + esc(name) + '</b><small>' + esc(role) + (extra ? ' · ' + esc(extra) : '') + '</small></span></li>'
            : '';
          const missing = (role) => '<li class="pl-dperson is-empty"><span class="pl-dav" aria-hidden="true">?</span><span><b>No ' + esc(role.toLowerCase()) + ' yet</b><small>' + esc(role) + '</small></span></li>';
          const people =
            (ppl.lead ? person('First author', ppl.lead) : missing('First author')) +
            person('Co-lead', ppl.colead) +
            (ppl.analyst ? person('Analyst', ppl.analyst) : (['NIS', 'NRD', 'TriNetX'].includes(d.study_type) ? missing('Analyst') : '')) +
            person('Presenter', ppl.presenter) +
            person('Corresponding author', ppl.corresponding) +
            (d.team || []).map((t) => person(t.roles && t.roles.length ? t.roles.map((r) => SHORT_ROLE[r] || r).join(', ') : 'Team member', t.name)).join('');

          const details =
            row('Opened', fmt(d.created_at)) +
            row('Conference', esc(d.current_conference)) +
            row('Journal', esc(d.current_journal)) +
            row('Manuscript', d.manuscript_url ? '<a href="' + esc(d.manuscript_url) + '" target="_blank" rel="noopener">Open the document</a>' : '');

          const attempts = (list, nameOf, fallback) => list.map((a) =>
            '<li><span class="pl-datt__name">' + esc(nameOf(a)) + '</span><span class="pl-datt__date">' + fmt(a.submitted_on) + '</span>' + pill(a.outcome, fallback) + '</li>').join('');
          const cAtt = attempts(d.conference_attempts || [], (a) => a.name || '-', 'pending');
          const jAtt = attempts(d.journal_attempts || [], (a) => a.journal + (a.revision_round ? ' (revision ' + a.revision_round + ')' : ''), 'with journal');

          const histAll = d.history || [];
          const histItem = (h, i) => '<li' + (i >= 6 ? ' class="is-more" hidden' : '') + '><time>' + fmt(h.at) + '</time><span>' + esc(h.label) + (h.actor ? ' <em>' + esc(h.actor) + '</em>' : '') + '</span></li>';
          const hist = histAll.length
            ? '<ol class="pl-dtime">' + histAll.map(histItem).join('') + '</ol>' +
              (histAll.length > 6 ? '<button type="button" class="pl-dmore" data-dmore>Show all ' + histAll.length + ' events</button>' : '')
            : '<p class="pl-muted">No recorded events yet.</p>';

          const section = (title, html) => html ? '<section class="pl-dsec"><h3>' + title + '</h3>' + html + '</section>' : '';
          bodyEl.innerHTML =
            statusCard +
            section('People', people ? '<ul class="pl-dpeople">' + people + '</ul>' : '') +
            section('Details', details ? '<dl class="pl-drawer__dl">' + details + '</dl>' : '') +
            section('Conference attempts', cAtt ? '<ul class="pl-datt">' + cAtt + '</ul>' : '') +
            section('Journal attempts', jAtt ? '<ul class="pl-datt">' + jAtt + '</ul>' : '') +
            section('History', hist);
          footEl.innerHTML =
            '<a class="pl-dbtn" href="/pipeline/projects/' + esc(d.id) + '">Open full view</a>' +
            '<button type="button" class="pl-dbtn pl-dbtn--ghost" data-dcopy>Copy link</button>';
          footEl.hidden = false;
          const more = bodyEl.querySelector('[data-dmore]');
          if (more) more.addEventListener('click', () => {
            bodyEl.querySelectorAll('.pl-dtime .is-more').forEach((li) => { li.hidden = false; });
            more.remove();
          });
          const copyBtn = footEl.querySelector('[data-dcopy]');
          copyBtn.addEventListener('click', () => {
            const url = location.origin + '/pipeline/projects/' + d.id;
            (navigator.clipboard ? navigator.clipboard.writeText(url) : Promise.reject())
              .then(() => { copyBtn.textContent = 'Link copied'; setTimeout(() => { copyBtn.textContent = 'Copy link'; }, 1800); })
              .catch(() => { copyBtn.textContent = 'Copy blocked'; });
          });
        }

        // Intercept clicks on any link carrying data-panel.
        document.addEventListener('click', (e) => {
          const t = e.target;
          const a = t && t.closest ? t.closest('a[data-panel]') : null;
          if (!a) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return; // let new-tab through
          e.preventDefault();
          open(a.getAttribute('data-panel'));
        });

        drawer.querySelectorAll('[data-drawer-close]').forEach((el) =>
          el.addEventListener('click', () => close()),
        );
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawer.classList.contains('is-open')) close();
        });

        window.addEventListener('popstate', (e) => {
          const id = (e.state && e.state.panel) || new URLSearchParams(location.search).get('panel');
          if (id) open(id, false);
          else if (drawer.classList.contains('is-open')) close(false);
        });

        // Deep link: /pipeline/mine?panel=<id>
        const initial = new URLSearchParams(location.search).get('panel');
        if (initial) open(initial, false);
      })();
    </script>
      <script>
      // Members' Requests tab menu. The tab strip scrolls sideways on small
      // screens (overflow-x), which would clip an absolutely positioned panel,
      // so the panel is fixed and placed under its tab when it opens.
      document.querySelectorAll<HTMLElement>('[data-tabmenu]').forEach((menu) => {
        const btn = menu.querySelector<HTMLButtonElement>('[data-tabmenu-toggle]')!;
        const panel = menu.querySelector<HTMLElement>('[data-tabmenu-panel]')!;
        const place = () => {
          const r = btn.getBoundingClientRect();
          const w = panel.offsetWidth;
          panel.style.top = `${r.bottom + 6}px`;
          panel.style.left = `${Math.max(8, Math.min(innerWidth - w - 8, r.left + r.width / 2 - w / 2))}px`;
        };
        const set = (open: boolean) => {
          panel.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
          menu.classList.toggle('is-open', open);
          if (open) place();
        };
        btn.addEventListener('click', (e) => { e.stopPropagation(); set(panel.hidden); });
        document.addEventListener('click', (e) => { if (!menu.contains(e.target as Node)) set(false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { set(false); btn.focus(); } });
        addEventListener('scroll', () => { if (!panel.hidden) place(); }, { passive: true });
        addEventListener('resize', () => { if (!panel.hidden) place(); });
      });
    </script>
</body>
</html>
