---
import '../styles/global.css';
import '../styles/pipeline.css';
import FontLinks from '../components/FontLinks.astro';
import { scopeProjects } from '../lib/pipeline-scope';
import { getPipelineTasks } from '../lib/pipeline-tasks';

interface Props {
  title: string;
  active?: 'conferences' | 'ongoing' | 'submissions' | 'tasks';
}
const { title, active } = Astro.props;
const { supabase, person } = Astro.locals;
const isAdmin = person.role === 'admin';

type Tab = { key: string; label: string; href: string; count: number | null; alert?: boolean };

const tasks = await getPipelineTasks(supabase, person);
const taskTab: Tab = {
  key: 'tasks',
  label: 'Tasks',
  href: '/pipeline/tasks',
  count: tasks.length,
  alert: tasks.some((t) => t.urgent),
};

// Admins see totals; members see only their own papers in each phase.
const phaseCount = (phase: string) => {
  let q = supabase
    .from(isAdmin ? 'projects' : 'project_list')
    .select('id', { count: 'exact', head: true })
    .eq('phase', phase)
    .is('archived_at', null);
  return isAdmin ? q : scopeProjects(q, person);
};

const [confN, ongoingN, subsN] = await Promise.all([
  isAdmin
    ? supabase.from('conferences').select('id', { count: 'exact', head: true })
    : phaseCount('conference'),
  phaseCount('manuscript'),
  phaseCount('journal'),
]);

const tabs: Tab[] = [
  { key: 'conferences', label: 'Conferences', href: '/pipeline/conferences', count: confN.count ?? null },
  { key: 'ongoing', label: 'Ongoing', href: '/pipeline/ongoing', count: ongoingN.count ?? null },
  { key: 'submissions', label: 'Submissions', href: '/pipeline/submissions', count: subsN.count ?? null },
  taskTab,
];

// The person's own inbox (RLS keeps it to them). For members this is every
// update the coordinator makes to their papers; for admins, the requests.
const { data: notifs } = await supabase
  .from('notifications')
  .select('id,title,body,link,read_at,created_at')
  .order('created_at', { ascending: false })
  .limit(20);
const unread = (notifs ?? []).filter((n: any) => !n.read_at).length;
const fmtNotif = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · MCA Research Pipeline</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <FontLinks />
  </head>
  <body class="pl-body">
    <header class="pl-banner">
      <div class="pl-banner__row">
        <span class="pl-banner__title"><a href="/pipeline">MCA Research Pipeline</a></span>
        <span class="pl-acct">
          <a href="/admin">← Members area</a>

          <span class="pl-bell" data-bell>
            <button type="button" class="pl-bell__btn" data-bell-toggle aria-label="Notifications" aria-expanded="false">
              <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M10 2a5 5 0 0 0-5 5v3.2l-1.4 2.5A1 1 0 0 0 4.5 16h11a1 1 0 0 0 .9-1.3L15 10.2V7a5 5 0 0 0-5-5Zm0 16a2.5 2.5 0 0 0 2.4-1.8H7.6A2.5 2.5 0 0 0 10 18Z"
                />
              </svg>
              {unread > 0 && <span class="pl-bell__dot" data-bell-count>{unread > 9 ? '9+' : unread}</span>}
            </button>
            <div class="pl-notif" data-bell-panel hidden>
              <p class="pl-notif__head">Notifications</p>
              {(!notifs || notifs.length === 0) && <p class="pl-notif__empty">Nothing yet.</p>}
              {(notifs ?? []).map((n: any) => (
                <a class:list={['pl-notif__item', !n.read_at && 'is-unread']} href={n.link ?? '#'}>
                  <b>{n.title}</b>
                  {n.body && <span>{n.body}</span>}
                  <time>{fmtNotif(n.created_at)}</time>
                </a>
              ))}
            </div>
          </span>

          <span>{person.full_name}</span>
          <form method="post" action="/pipeline/logout" style="display:inline">
            <button type="submit">Log out</button>
          </form>
        </span>
      </div>
      <nav class="pl-tabs">
        <div class="pl-tabs__row">
          {tabs.map((t) => (
            <a class:list={['pl-tab', active === t.key && 'is-active']} href={t.href}>
              {t.label}
              {typeof t.count === 'number' && (
                <span class:list={['pl-tab__count', t.alert && t.count > 0 && 'is-alert']}>{t.count}</span>
              )}
            </a>
          ))}
        </div>
      </nav>
    </header>

    <main class="pl-main">
      <slot />
    </main>

    <!-- Slide-in project detail. Populated client-side from /pipeline/projects/:id/panel.json. -->
    <div class="pl-drawer" id="pl-drawer" hidden>
      <div class="pl-drawer__backdrop" data-drawer-close></div>
      <aside class="pl-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="pl-drawer-title">
        <div class="pl-drawer__head">
          <p class="pl-drawer__ref" id="pl-drawer-ref"></p>
          <button type="button" class="pl-drawer__x" data-drawer-close aria-label="Close">×</button>
        </div>
        <h2 class="pl-drawer__title" id="pl-drawer-title"></h2>
        <div class="pl-drawer__body" id="pl-drawer-body"></div>
      </aside>
    </div>

    <script is:inline>
      // Notification bell.
      (() => {
        const bell = document.querySelector('[data-bell]');
        if (!bell) return;
        const btn = bell.querySelector('[data-bell-toggle]');
        const panel = bell.querySelector('[data-bell-panel]');
        const dot = bell.querySelector('[data-bell-count]');
        let open = false;

        function setOpen(v) {
          open = v;
          panel.hidden = !v;
          bell.classList.toggle('is-open', v);
          btn.setAttribute('aria-expanded', String(v));
          if (v && dot) {
            fetch('/pipeline/notifications/read', { method: 'POST' })
              .then(() => {
                dot.remove();
                bell.querySelectorAll('.pl-notif__item.is-unread').forEach((e) => e.classList.remove('is-unread'));
              })
              .catch(() => {});
          }
        }

        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          setOpen(!open);
        });
        document.addEventListener('click', (e) => {
          if (open && !bell.contains(e.target)) setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && open) setOpen(false);
        });
      })();

      // Project detail drawer.
      (() => {
        const drawer = document.getElementById('pl-drawer');
        if (!drawer) return;
        const refEl = document.getElementById('pl-drawer-ref');
        const titleEl = document.getElementById('pl-drawer-title');
        const bodyEl = document.getElementById('pl-drawer-body');

        const esc = (s) =>
          String(s ?? '').replace(/[&<>"']/g, (c) =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
          );
        const fmt = (d) =>
          d ? new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';

        let lastFocus = null;

        function open(id, push) {
          if (push === undefined) push = true;
          lastFocus = document.activeElement;
          drawer.hidden = false;
          document.body.style.overflow = 'hidden';
          requestAnimationFrame(() => drawer.classList.add('is-open'));
          refEl.textContent = '';
          titleEl.textContent = 'Loading…';
          bodyEl.innerHTML = '<p class="pl-drawer__loading">Fetching history…</p>';
          if (push) history.pushState({ panel: id }, '', location.pathname + '?panel=' + id);

          fetch('/pipeline/projects/' + encodeURIComponent(id) + '/panel.json', { headers: { accept: 'application/json' } })
            .then((r) => (r.ok ? r.json() : r.json().then((e) => Promise.reject(e))))
            .then((d) => render(d))
            .catch((e) => {
              titleEl.textContent = 'Could not open';
              bodyEl.innerHTML = '<p class="pl-drawer__loading">' + esc((e && e.error) || 'Something went wrong.') + '</p>';
            });
        }

        function close(push) {
          if (push === undefined) push = true;
          drawer.classList.remove('is-open');
          document.body.style.overflow = '';
          const done = () => {
            drawer.hidden = true;
            drawer.removeEventListener('transitionend', done);
          };
          drawer.addEventListener('transitionend', done);
          setTimeout(done, 320);
          if (push) history.pushState({}, '', location.pathname);
          if (lastFocus && lastFocus.focus) lastFocus.focus();
        }

        function row(dt, dd) {
          return dd ? '<dt>' + esc(dt) + '</dt><dd>' + dd + '</dd>' : '';
        }

        function render(d) {
          refEl.textContent = d.ref + ' · ' + d.study_type;
          titleEl.textContent = d.title;

          const status = d.archived_at
            ? 'Archived — ' + esc(d.archive_reason || 'no reason on file')
            : esc(d.stage_label);
          const sub = [
            esc(d.phase),
            d.days_in_stage != null ? d.days_in_stage + ' days in stage' : '',
            d.days_overdue != null && d.days_overdue > 0 ? '<span class="pl-warn">overdue ' + d.days_overdue + 'd</span>' : '',
            d.parked ? 'parked' : '',
          ].filter(Boolean).join(' · ');

          const ppl = d.people || {};
          const people =
            row('Lead', esc(ppl.lead)) +
            row('Co-lead', esc(ppl.colead)) +
            row('Analyst', esc(ppl.analyst)) +
            row('Presenter', esc(ppl.presenter)) +
            row('Corresponding author', esc(ppl.corresponding));

          const dates =
            row('Opened', fmt(d.created_at)) +
            row('Next target', d.next_target ? fmt(d.next_target) : '') +
            row('Current conference', esc(d.current_conference)) +
            row('Current journal', esc(d.current_journal)) +
            row('Manuscript', d.manuscript_url ? '<a href="' + esc(d.manuscript_url) + '" target="_blank" rel="noopener">open</a>' : '');

          const cAtt = (d.conference_attempts || [])
            .map((a) => '<li>' + esc(a.name || '—') + ' <span class="pl-muted">' + esc(a.outcome || 'pending') + '</span></li>')
            .join('');
          const jAtt = (d.journal_attempts || [])
            .map(
              (a) =>
                '<li>' + esc(a.journal) + ' <span class="pl-muted">' + esc(a.outcome || 'open') +
                (a.revision_round ? ' · rev ' + a.revision_round : '') + '</span></li>',
            )
            .join('');

          const hist = (d.history || []).length
            ? (d.history || [])
                .map(
                  (h) =>
                    '<li><span>' + esc(h.label) + (h.actor ? ' <span class="pl-muted">· ' + esc(h.actor) + '</span>' : '') +
                    '</span><time>' + fmt(h.at) + '</time></li>',
                )
                .join('')
            : '<li class="pl-muted">No recorded events yet.</li>';

          bodyEl.innerHTML =
            '<p class="pl-drawer__status"><b>' + status + '</b><span>' + sub + '</span></p>' +
            (people ? '<h3>People</h3><dl class="pl-drawer__dl">' + people + '</dl>' : '') +
            (dates ? '<h3>Details</h3><dl class="pl-drawer__dl">' + dates + '</dl>' : '') +
            (cAtt ? '<h3>Conference attempts</h3><ul class="pl-drawer__att">' + cAtt + '</ul>' : '') +
            (jAtt ? '<h3>Journal attempts</h3><ul class="pl-drawer__att">' + jAtt + '</ul>' : '') +
            '<h3>History</h3><ul class="pl-drawer__hist">' + hist + '</ul>' +
            '<p class="pl-drawer__full"><a href="/pipeline/projects/' + esc(d.id) + '">Open full view →</a></p>';
        }

        // Intercept clicks on any link carrying data-panel.
        document.addEventListener('click', (e) => {
          const t = e.target;
          const a = t && t.closest ? t.closest('a[data-panel]') : null;
          if (!a) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return; // let new-tab through
          e.preventDefault();
          open(a.getAttribute('data-panel'));
        });

        drawer.querySelectorAll('[data-drawer-close]').forEach((el) =>
          el.addEventListener('click', () => close()),
        );
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawer.classList.contains('is-open')) close();
        });

        window.addEventListener('popstate', (e) => {
          const id = (e.state && e.state.panel) || new URLSearchParams(location.search).get('panel');
          if (id) open(id, false);
          else if (drawer.classList.contains('is-open')) close(false);
        });

        // Deep link: /pipeline/mine?panel=<id>
        const initial = new URLSearchParams(location.search).get('panel');
        if (initial) open(initial, false);
      })();
    </script>
  </body>
</html>
