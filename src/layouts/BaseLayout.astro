---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FontLinks from '../components/FontLinks.astro';
import ThemeInit from '../components/ThemeInit.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Lets the hero sit under a transparent header. */
  transparentHeader?: boolean;
  ogImage?: string;
}

const {
  title,
  description = site.description,
  transparentHeader = false,
  ogImage = '/assets/brand/og-default.png',
} = Astro.props;

const pageTitle = title === 'Home' ? `${site.name} - ${site.tagline}` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

// BaseLayout is only ever used by the public marketing pages - never the
// admin/pipeline/auth surfaces (separate layouts, no shared import), and
// none of them render anything user-specific server-side (login state is
// handled client-side). Safe to let Cloudflare's edge cache and serve
// these directly instead of hitting the Render origin on every request -
// previously every page came back `Cache-Control: max-age=0` / `DYNAMIC`
// at the edge. 5 minutes fresh, then stale-while-revalidate for a day so
// a visitor is (almost) never the one waiting on a background refresh -
// short enough that heart-trending/education's own 20-minute YouTube-feed
// cache is never the stale part.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=86400');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeInit />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? site.url).href} />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141412" media="(prefers-color-scheme: dark)" />

    <FontLinks />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'MedicalOrganization',
        name: site.name,
        url: site.url,
        description: site.description,
        sameAs: [site.youtube],
        founder: {
          '@type': 'Person',
          name: 'M Chadi Alraies',
          honorificSuffix: 'MD MPH',
          jobTitle: 'Director of Cardiac Cath Lab',
          worksFor: { '@type': 'Organization', name: 'Detroit Medical Center' },
        },
      })}
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal-on-scroll. Progressive enhancement: without JS everything is
      // painted by the .is-visible fallback applied immediately below.
      const items = document.querySelectorAll('[data-reveal]');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
    <noscript>
      <style>[data-reveal] { opacity: 1 !important; transform: none !important; }</style>
    </noscript>
  </body>
</html>
