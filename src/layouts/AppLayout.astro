---
import '../styles/global.css';
import FontLinks from '../components/FontLinks.astro';
import ThemeInit from '../components/ThemeInit.astro';
import AppBar from '../components/AppBar.astro';
import { site } from '../data/site';
import type { User } from '../lib/auth';

interface Props {
  title: string;
  heading: string;
  user: User;
  /** Which app nav item is active. */
  active?: 'dashboard' | 'ideas' | 'applicants' | 'pipeline' | 'access';
}
const { title, heading, user, active } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeInit />
    <title>{title} | {site.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141412" media="(prefers-color-scheme: dark)" />
    <FontLinks />
  </head>

  <body class="app">
    <AppBar active={active} name={user.name} role={user.role} email={user.email} />

    <main class="app__main">
      <div class="app__shell">
        <h1 class="app__heading">{heading}</h1>
        <slot />
      </div>
    </main>

    <style is:global>
      .app { min-height: 100dvh; background: var(--bg); }
      .app__main { padding-block: var(--space-l) var(--space-xl); }
      .app__shell {
        max-width: 1140px;
        margin-inline: auto;
        padding-inline: var(--gutter);
      }
      .app__heading {
        font-size: 1.7rem;
        color: var(--text-strong);
        margin-bottom: var(--space-m);
      }
    </style>
  </body>
</html>
