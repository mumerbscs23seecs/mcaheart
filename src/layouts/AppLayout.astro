---
import '../styles/global.css';
import FontLinks from '../components/FontLinks.astro';
import { site } from '../data/site';
import type { User } from '../lib/auth';
import { pendingIdeaCount } from '../lib/ideas';
import { pendingApplicationCount } from '../lib/applications';
import { getNotifications } from '../lib/notifications';

interface Props {
  title: string;
  heading: string;
  user: User;
  /** Which app nav item is active. */
  active?: 'dashboard' | 'ideas' | 'applicants' | 'access' | 'submissions';
}
const { title, heading, user, active } = Astro.props;

const { items: notifs, unread } = await getNotifications(user.email);
const fmtNotif = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

// Admins get the full app nav; members only ever see the one page, so their
// top bar carries no nav at all.
const isAdmin = user.role === 'admin';
const pendingIdeas = isAdmin ? pendingIdeaCount() : 0;
const pendingApps = isAdmin ? pendingApplicationCount() : 0;
const navItems = isAdmin
  ? [
      { key: 'dashboard', label: 'Dashboard', href: '/admin', badge: 0 },
      { key: 'ideas', label: 'Ideas', href: '/admin/ideas', badge: pendingIdeas },
      { key: 'applicants', label: 'Applicants', href: '/admin/applications', badge: pendingApps },
      { key: 'submissions', label: 'Pipeline', href: '/pipeline', badge: 0 },
      { key: 'access', label: 'Access', href: '/admin/access', badge: 0 },
    ]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {site.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    <FontLinks />
  </head>

  <body class="app">
    <header class="appbar">
      <div class="appbar__inner">
        <a class="appbar__brand" href="/" aria-label="MCA Heart — home">
          <span class="appbar__badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
              <path d="M12 21s-8-5.2-8-10.6A4.4 4.4 0 0 1 12 7.6a4.4 4.4 0 0 1 8 2.8C20 15.8 12 21 12 21Z"/>
            </svg>
          </span>
          <span><b>MCA</b> HEART</span>
        </a>

        {navItems.length > 0 && (
          <nav class="appbar__nav" aria-label="Members">
            {navItems.map((item) => (
              <a
                class:list={['appbar__link', active === item.key && 'is-active']}
                href={item.href}
                aria-current={active === item.key ? 'page' : undefined}
              >{item.label}{item.badge > 0 && <span class="appbar__badge-n">{item.badge}</span>}</a>
            ))}
          </nav>
        )}

        <div class="appbar__account">
          <span class="nbell" data-nbell>
            <button type="button" class="nbell__btn" data-nbell-toggle aria-label="Notifications" aria-expanded="false">
              <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M10 2a5 5 0 0 0-5 5v3.2l-1.4 2.5A1 1 0 0 0 4.5 16h11a1 1 0 0 0 .9-1.3L15 10.2V7a5 5 0 0 0-5-5Zm0 16a2.5 2.5 0 0 0 2.4-1.8H7.6A2.5 2.5 0 0 0 10 18Z"
                />
              </svg>
              {unread > 0 && <span class="nbell__dot" data-nbell-count>{unread > 9 ? '9+' : unread}</span>}
            </button>
            <div class="nbell__panel" data-nbell-panel hidden>
              <p class="nbell__head">Notifications</p>
              {notifs.length === 0 && <p class="nbell__empty">Nothing yet.</p>}
              {notifs.map((n) => (
                <a class:list={['nbell__item', !n.read_at && 'is-unread']} href={n.link ?? '#'}>
                  <b>{n.title}</b>
                  {n.body && <span>{n.body}</span>}
                  <time>{fmtNotif(n.created_at)}</time>
                </a>
              ))}
            </div>
          </span>

          <span class="appbar__user">{user.name}</span>
          <form method="post" action="/logout">
            <button class="appbar__logout" type="submit">Log out</button>
          </form>
        </div>
      </div>
    </header>

    <main class="app__main">
      <div class="app__shell">
        <h1 class="app__heading">{heading}</h1>
        <slot />
      </div>
    </main>

    <style is:global>
      .app { min-height: 100dvh; background: var(--bg); }

      .appbar {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--surface);
        border-bottom: 1px solid var(--border-soft);
      }
      .appbar__inner {
        max-width: 1140px;
        margin-inline: auto;
        padding: 0 var(--gutter);
        height: 60px;
        display: flex;
        align-items: center;
        gap: var(--space-m);
      }
      .appbar__brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        font-family: var(--font-serif);
        font-size: 0.86rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--text-strong);
        flex-shrink: 0;
      }
      .appbar__brand b { color: var(--blue); font-weight: 700; }
      .appbar__badge {
        display: grid;
        place-items: center;
        width: 1.8em; height: 1.8em;
        color: #fff;
        background: linear-gradient(140deg, var(--blue), var(--red));
        border-radius: 0.45em;
      }

      .appbar__nav { display: flex; gap: 0.35rem; margin-left: var(--space-s); }
      .appbar__link {
        padding: 0.4rem 0.8rem;
        border-radius: var(--radius);
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
      }
      .appbar__link:hover { color: var(--text-strong); background: var(--bg-tint); }
      .appbar__link.is-active { color: var(--blue); background: rgba(43, 57, 144, 0.08); }
      .appbar__badge-n {
        display: inline-grid;
        place-items: center;
        min-width: 1.25em;
        height: 1.25em;
        margin-left: 0.4em;
        padding: 0 0.35em;
        font-size: 0.7rem;
        font-weight: 700;
        color: #fff;
        background: var(--red);
        border-radius: 999px;
      }

      .appbar__account { margin-left: auto; display: flex; align-items: center; gap: 0.9rem; }

      /* notification bell */
      .nbell { position: relative; display: inline-flex; }
      .nbell__btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px; height: 32px;
        border: 0; background: none;
        color: var(--text-muted);
        cursor: pointer;
        border-radius: var(--radius);
      }
      .nbell__btn:hover, .nbell.is-open .nbell__btn { color: var(--blue); background: var(--bg-tint); }
      .nbell__dot {
        position: absolute;
        top: -1px; right: -2px;
        min-width: 16px; height: 16px;
        padding: 0 4px;
        border-radius: 999px;
        background: var(--red);
        color: #fff;
        font: 700 0.62rem/16px var(--font-sans);
        text-align: center;
        box-shadow: 0 0 0 2px var(--surface);
      }
      .nbell__panel {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        width: min(340px, 86vw);
        max-height: 70vh;
        overflow-y: auto;
        background: var(--surface);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius);
        box-shadow: var(--shadow-lg);
        z-index: 60;
      }
      .nbell__panel[hidden] { display: none; }
      .nbell__head {
        margin: 0;
        padding: 12px 16px;
        font: 700 0.68rem/1 var(--font-sans);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-muted);
        border-bottom: 1px solid var(--border-soft);
      }
      .nbell__empty { margin: 0; padding: 20px 16px; font-size: 0.85rem; color: var(--text-muted); }
      .nbell__item {
        display: block;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border-soft);
        color: inherit;
      }
      .nbell__item:last-child { border-bottom: 0; }
      .nbell__item:hover { background: var(--bg-tint); }
      .nbell__item.is-unread { background: rgba(43, 57, 144, 0.05); }
      .nbell__item b { display: block; font-size: 0.85rem; font-weight: 700; color: var(--text-strong); }
      .nbell__item span { display: block; font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; }
      .nbell__item time { display: block; font-size: 0.72rem; color: var(--text-faint); margin-top: 4px; }
      .appbar__user {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--text);
        max-width: 18ch;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .appbar__logout {
        padding: 0.4rem 0.85rem;
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text);
        background: var(--surface);
        cursor: pointer;
      }
      .appbar__logout:hover { border-color: var(--blue); color: var(--blue); }

      @media (max-width: 560px) {
        .appbar__inner { gap: 0.6rem; }
        .appbar__user { display: none; }
        .appbar__nav { margin-left: 0.25rem; }
        .appbar__link { padding-inline: 0.55rem; }
      }

      .app__main { padding-block: var(--space-l) var(--space-xl); }
      .app__shell {
        max-width: 1140px;
        margin-inline: auto;
        padding-inline: var(--gutter);
      }
      .app__heading {
        font-size: 1.7rem;
        color: var(--text-strong);
        margin-bottom: var(--space-m);
      }
    </style>

    <script is:inline>
      (() => {
        const bell = document.querySelector('[data-nbell]');
        if (!bell) return;
        const btn = bell.querySelector('[data-nbell-toggle]');
        const panel = bell.querySelector('[data-nbell-panel]');
        const dot = bell.querySelector('[data-nbell-count]');
        let open = false;

        function setOpen(v) {
          open = v;
          panel.hidden = !v;
          bell.classList.toggle('is-open', v);
          btn.setAttribute('aria-expanded', String(v));
          if (v && dot) {
            fetch('/admin/notifications/read', { method: 'POST' })
              .then(() => {
                dot.remove();
                bell.querySelectorAll('.nbell__item.is-unread').forEach((e) => e.classList.remove('is-unread'));
              })
              .catch(() => {});
          }
        }

        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          setOpen(!open);
        });
        document.addEventListener('click', (e) => {
          if (open && !bell.contains(e.target)) setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && open) setOpen(false);
        });
      })();
    </script>
  </body>
</html>
