---
interface Props {
  eyebrow?: string;
  title: string;
  /** Second line, rendered smaller/lighter under the main title. */
  subtitle?: string;
  image?: string;
  align?: 'left' | 'center';
  /** Slim band for utility pages (login, dashboards) - no tall empty hero. */
  compact?: boolean;
  /** The hero image already carries the title as artwork - keep the <h1>
   *  for SEO/accessibility but don't render it visibly over the image. */
  hideTitle?: boolean;
  /** Show the supplied image exactly as given - no crop (object-fit: contain
   *  instead of cover) and no fade/tint overlay on top of it. */
  imageRaw?: boolean;
}
const {
  eyebrow, title, subtitle, image, align = 'left', compact = false, hideTitle = false, imageRaw = false,
} = Astro.props;
---

<section class:list={['phero', align === 'center' && 'phero--center', compact && 'phero--compact']}>
  {image && (
    <div class:list={['phero__bg', imageRaw && 'phero__bg--raw']} aria-hidden="true">
      <img src={image} alt="" fetchpriority="high" decoding="async" />
    </div>
  )}

  <div class="shell shell--wide phero__inner">
    {eyebrow && <p class:list={['eyebrow', align === 'center' && 'eyebrow--center']}>{eyebrow}</p>}
    <h1 class:list={['display phero__title', hideTitle && 'visually-hidden']}>{title}</h1>
    {subtitle && <p class="lede phero__sub">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .phero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: clamp(46vh, 30vh + 22vw, 68vh);
    padding-block: calc(var(--header-h) + var(--space-l)) var(--space-xl);
    background: var(--bg);
    border-bottom: 2px solid var(--ink);
    overflow: hidden;
  }
  .phero__bg { position: absolute; inset: 0; z-index: -1; }
  .phero__bg img { width: 100%; height: 100%; object-fit: cover; }
  .phero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--bg) 96%, transparent) 0%,
      color-mix(in srgb, var(--bg) 72%, transparent) 38%,
      color-mix(in srgb, var(--bg) 42%, transparent) 100%
    );
  }
  /* Raw - the exact image, uncropped and unfaded. */
  .phero__bg--raw img { object-fit: contain; }
  .phero__bg--raw::after { content: none; }

  .phero__inner { width: 100%; }
  .phero--center .phero__inner { text-align: center; }
  .phero--center .phero__sub { margin-inline: auto; }

  .phero__title {
    margin-top: var(--space-s);
    font-size: var(--step-5);
    color: var(--text-strong);
    max-width: 18ch;
  }
  .phero--center .phero__title { max-width: 22ch; margin-inline: auto; }

  .phero__sub { margin-top: var(--space-m); }

  /* --- Compact variant --- */
  .phero--compact {
    min-height: 0;
    padding-block: calc(var(--header-h) + var(--space-m)) var(--space-m);
  }
  .phero--compact .phero__title {
    margin-top: 0.35rem;
    font-size: var(--step-3);
    max-width: none;
  }
  .phero--compact .phero__sub { margin-top: var(--space-xs); }
</style>
