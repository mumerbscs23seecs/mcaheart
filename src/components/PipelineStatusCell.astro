---
import { stagesFor } from '../lib/lifecycle.mjs';
import { stageColor } from '../lib/calm';

interface Props {
  /** A project_list row - needs id, phase, stage, stage_label, days_in_stage, archived_at. */
  project: any;
  isAdmin: boolean;
}
const { project: p, isAdmin } = Astro.props;
// So a change made from a list drops the person back on that list, not the detail page.
const returnTo = Astro.url.pathname + Astro.url.search;

// Outcomes freeze a specific submission attempt (the open conference /
// journal attempt id rides in on the project row), so they post to their own
// gate instead of a plain stage change. Without an open attempt they're not
// offered at all. 'published' isn't here - once accepted, marking it
// published later is just an ordinary stage update.
type Route = { gate: string; outcome: string; rejectStage?: string };
const OUTCOME_ROUTE: Record<string, Record<string, Route>> = {
  conference: {
    accepted: { gate: 'abstract', outcome: 'accepted' },
    rejected: { gate: 'abstract', outcome: 'rejected' },
  },
  journal: {
    accepted: { gate: 'journal-outcome', outcome: 'accepted' },
    rejected_comments: { gate: 'journal-outcome', outcome: 'rejected', rejectStage: 'rejected_comments' },
    rejected_no_comments: { gate: 'journal-outcome', outcome: 'rejected', rejectStage: 'rejected_no_comments' },
  },
};
const openAttempt =
  p.phase === 'journal' ? p.open_journal_attempt_id : p.phase === 'conference' ? p.open_conference_attempt_id : null;
// A journal paper with no open attempt still offers every status: the
// outcome is then saved as a plain stage change instead of through the gate.
const routeFor = (code: string): Route | undefined =>
  p.phase === 'journal' && !openAttempt ? undefined : OUTCOME_ROUTE[p.phase]?.[code];
const isOutcome = (code: string) => !!OUTCOME_ROUTE[p.phase]?.[code];
// A decided abstract is frozen - its status cell becomes read-only.
const FROZEN: Record<string, string[]> = { conference: ['accepted', 'rejected'] };
const frozen = FROZEN[p.phase] ?? [];

// Admins see the full set (outcomes only when there's an open attempt to
// decide); members never see outcome codes - those aren't theirs to set,
// and journal-phase requests aren't supported at all (the coordinator
// handles Submissions directly).
const adminOptions = stagesFor(p.phase).filter((s: any) => p.phase === 'journal' || !(routeFor(s.code) && !openAttempt));
const memberOptions = stagesFor(p.phase).filter((s: any) => !isOutcome(s.code));
const options = isAdmin ? adminOptions : memberOptions;

// A handful of stage codes need one more field before they can apply - gate.astro
// already knows how to use it (set_submitted_journal), this just surfaces the box.
const EXTRA_FIELD: Record<string, { field: string; placeholder: string }> = {
  'journal:submitted': { field: 'journal', placeholder: 'Journal name' },
};
const extraFor = (code: string) => EXTRA_FIELD[`${p.phase}:${code}`];

const warn = p.days_in_stage != null && p.days_in_stage >= 21;
// Admins: advance_stage (any phase). Members: request_stage_change, which
// covers conference / manuscript / journal.
const phaseOK = isAdmin
  ? ['idea', 'conference', 'manuscript', 'journal'].includes(p.phase)
  : ['conference', 'manuscript', 'journal'].includes(p.phase);
const editable =
  phaseOK && !p.archived_at && !frozen.includes(p.stage) && options.length > 1;
---

{!editable ? (
  <span class:list={['pl-status', warn && 'pl-status--warn']}>{p.stage_label}</span>
) : isAdmin ? (
  <form method="post" action={`/pipeline/projects/${p.id}/gate`} class="pl-status-form" data-status-form>
    <input type="hidden" name="gate" value="stage" data-gate-input />
    <input type="hidden" name="return" value={returnTo} />
    <select class="pl-status" name="stage" title={p.stage_label} aria-label={`Status for ${p.title ?? p.ref}`} data-status-select>
      {options.map((s: any) => {
        const route = routeFor(s.code);
        return (
          <option
            value={s.code}
            selected={s.code === p.stage}
            data-extra-field={extraFor(s.code)?.field ?? ''}
            data-gate={route?.gate ?? ''}
            data-outcome={route?.outcome ?? ''}
            data-reject-stage={route?.rejectStage ?? ''}
            data-attempt={route ? openAttempt : ''}
            data-color={stageColor(p.phase, s.code)}
          >{s.label}</option>
        );
      })}
    </select>
    {options.map((s: any) => {
      const extra = extraFor(s.code);
      const route = routeFor(s.code);
      const isCurrent = s.code === p.stage;
      if (extra) {
        // Already sitting on this stage - show the box open so the field can
        // be corrected without needing to re-trigger a change event first.
        return (
          <span class="pl-status-extra" data-status-extra={s.code} hidden={!isCurrent}>
            <input type="text" name={extra.field} placeholder={extra.placeholder} value={isCurrent ? (p.current_journal ?? '') : ''}
              list={extra.field === 'journal' ? 'pl-journal-options' : undefined} autocomplete="off" data-journal-input={extra.field === 'journal' ? '' : undefined} />
            <button type="submit" class="pl-status-extra__go">Update</button>
          </span>
        );
      }
      if (route) {
        return (
          <span class="pl-status-extra" data-status-extra={s.code} hidden>
            <span class="pl-status-extra__label">Confirm &ldquo;{s.label}&rdquo;?</span>
            <button type="submit" class="pl-status-extra__go pl-status-extra__go--confirm">Yes</button>
            <button type="button" class="pl-status-extra__go pl-status-extra__go--no" data-status-cancel>No</button>
          </span>
        );
      }
      return null;
    })}
  </form>
) : (
  <form method="post" action={`/pipeline/projects/${p.id}/request`} class="pl-status-form" data-status-form>
    <input type="hidden" name="return" value={returnTo} />
    <select class="pl-status" name="stage" title={p.stage_label} aria-label={`Request a status change for ${p.title ?? p.ref}`} data-status-select data-member-select>
      <option value="" selected>{p.stage_label}</option>
      {options
        .filter((s: any) => s.code !== p.stage)
        .map((s: any) => <option value={s.code} data-extra-field={extraFor(s.code)?.field ?? ''} data-color={stageColor(p.phase, s.code)}>&rarr; {s.label}</option>)}
    </select>
    {options.filter((s: any) => s.code !== p.stage).map((s: any) => {
      const extra = extraFor(s.code);
      return extra && (
        <span class="pl-status-extra" data-status-extra={s.code} hidden>
          <input type="text" name={extra.field} placeholder={extra.placeholder}
            list={extra.field === 'journal' ? 'pl-journal-options' : undefined} autocomplete="off" />
          <button type="submit" class="pl-status-extra__go">Request</button>
        </span>
      );
    })}
    <span class="pl-status__note">change needs coordinator approval</span>
  </form>
)}

<style>
  /* A fixed width, not a max-width - the select and the extra-field row
     (input + button) both stretch to fill it via width:100%, so their
     right edges always land in exactly the same place instead of each
     sizing to its own content. */
  .pl-status-form { display: grid; gap: 6px; width: 250px; }
  .pl-status-extra { display: flex; align-items: center; gap: 6px; width: 100%; box-sizing: border-box; }
  .pl-status-extra[hidden] { display: none; }
  .pl-status-extra input {
    flex: 1;
    min-width: 0;
    padding: 6px 8px;
    border: 1px solid var(--pl-border, #d8dce6);
    border-radius: 4px;
    font: inherit;
    font-size: 0.85rem;
  }
  .pl-status-extra__label {
    flex: 1;
    min-width: 0;
    font-size: 0.8rem;
    color: var(--text, #1e293b);
  }
  .pl-status-extra__go {
    padding: 6px 10px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--bg);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }
  .pl-status-extra__go--no {
    background: transparent;
    color: var(--text-strong, var(--ink));
  }
  /* Batched: the Update bar saves, so the per-row buttons and the
     "Confirm ...?" prompts aren't needed. */
  .pl-status-extra__go, .pl-status-extra__label { display: none !important; }
  .pl-status-extra:not(:has(input[type="text"])) { display: none !important; }
  .pl-status-form.is-dirty select { box-shadow: 0 0 0 2px #e8a33d inset; border-radius: 8px; }
  .pl-status-form.is-error select, .pl-status-form.is-error input { box-shadow: 0 0 0 2px #c0432b inset; border-radius: 8px; }
  .pl-status-extra__go--confirm {
    border-color: var(--pl-accent, var(--ink));
    background: var(--pl-accent, var(--ink));
  }
</style>

<script>
  // Status changes are batched: picking a new status only marks the row
  // (no reload). An "Update" bar collects every marked row; pressing Update
  // saves them all in the background through the same endpoints as before,
  // then refreshes each row in place. Astro dedupes this script across every
  // PipelineStatusCell on the page.
  import { JOURNAL_NAMES, journalSiteHref } from '../lib/journal-links';

  // The journal-name boxes suggest every journal on the lab's list (one shared
  // list per page). Picking one also gives the row its submission link.
  if (document.querySelector('[list="pl-journal-options"]') && !document.getElementById('pl-journal-options')) {
    const dl = document.createElement('datalist');
    dl.id = 'pl-journal-options';
    for (const name of JOURNAL_NAMES) dl.append(new Option(name));
    document.body.append(dl);
  }

  type Dirty = { form: HTMLFormElement; select: HTMLSelectElement };
  const dirty = new Map<HTMLFormElement, Dirty>();

  let bar: HTMLElement | null = null;
  function ensureBar() {
    if (bar) return bar;
    bar = document.createElement('div');
    bar.className = 'st-bar';
    bar.setAttribute('role', 'region');
    bar.setAttribute('aria-label', 'Unsaved status changes');
    bar.innerHTML =
      '<p class="st-bar__text" data-st-text aria-live="polite"></p>' +
      '<button type="button" class="st-bar__btn st-bar__btn--ghost" data-st-discard>Discard</button>' +
      '<button type="button" class="st-bar__btn" data-st-update>Update</button>';
    document.body.append(bar);
    bar.querySelector('[data-st-update]')!.addEventListener('click', saveAll);
    bar.querySelector('[data-st-discard]')!.addEventListener('click', discardAll);
    return bar;
  }
  function refreshBar(message?: string, tone?: 'ok' | 'err') {
    const b = ensureBar();
    const n = dirty.size;
    const text = b.querySelector<HTMLElement>('[data-st-text]')!;
    b.dataset.tone = tone ?? '';
    text.textContent = message ?? `${n} status ${n === 1 ? 'change' : 'changes'} not saved yet`;
    b.querySelectorAll<HTMLButtonElement>('button').forEach((x) => { x.hidden = n === 0; });
    b.classList.toggle('is-on', n > 0 || !!message);
  }

  const original = (sel: HTMLSelectElement) => [...sel.options].find((o) => o.defaultSelected)?.value ?? '';

  function resetRow(form: HTMLFormElement) {
    form.querySelectorAll<HTMLElement>('[data-status-extra]').forEach((box) => { box.hidden = true; });
    form.querySelectorAll<HTMLElement>('[data-outcome-field]').forEach((el) => el.remove());
    const gateInput = form.querySelector<HTMLInputElement>('[data-gate-input]');
    if (gateInput) gateInput.value = 'stage';
    form.classList.remove('is-dirty', 'is-error');
  }

  // Set up the form for the chosen status (outcome gate fields, journal box).
  function prepare(form: HTMLFormElement, select: HTMLSelectElement) {
    resetRow(form);
    const chosen = select.selectedOptions[0];
    const gateInput = form.querySelector<HTMLInputElement>('[data-gate-input]');
    const outcome = chosen?.dataset.outcome;
    if (outcome && gateInput) {
      gateInput.value = chosen.dataset.gate || 'journal-outcome';
      const add = (name: string, value: string) => {
        const i = document.createElement('input');
        i.type = 'hidden'; i.name = name; i.value = value; i.dataset.outcomeField = '1';
        form.appendChild(i);
      };
      add('outcome', outcome);
      add('attempt', chosen.dataset.attempt ?? '');
      if (chosen.dataset.rejectStage) add('reject_stage', chosen.dataset.rejectStage);
    }
    if (chosen?.dataset.extraField) {
      const box = form.querySelector<HTMLElement>(`[data-status-extra="${chosen.value}"]`);
      if (box) { box.hidden = false; box.querySelector<HTMLInputElement>('input')?.focus(); }
    }
  }

  document.addEventListener('change', (e) => {
    const select = (e.target as HTMLElement | null)?.closest<HTMLSelectElement>('select[data-status-select]');
    if (!select) return;
    const form = select.closest<HTMLFormElement>('[data-status-form]');
    if (!form) return;
    const back = select.value === original(select) || (select.hasAttribute('data-member-select') && !select.value);
    if (back) { resetRow(form); dirty.delete(form); refreshBar(); return; }
    prepare(form, select);
    form.classList.add('is-dirty');
    dirty.set(form, { form, select });
    refreshBar();
  });

  // Editing the journal name (on a paper already with an editor) is a change too.
  document.addEventListener('input', (e) => {
    const input = (e.target as HTMLElement | null)?.closest<HTMLInputElement>('[data-status-extra] input');
    const form = input?.closest<HTMLFormElement>('[data-status-form]');
    const select = form?.querySelector<HTMLSelectElement>('select[data-status-select]');
    if (!form || !select || dirty.has(form)) return;
    form.classList.add('is-dirty');
    dirty.set(form, { form, select });
    refreshBar();
  });

  // Enter in a journal-name box saves everything, like pressing Update.
  document.addEventListener('submit', (e) => {
    const form = (e.target as HTMLElement).closest<HTMLFormElement>('[data-status-form]');
    if (!form) return;
    e.preventDefault();
    if (dirty.size) saveAll();
  });

  function discardAll() {
    for (const { form, select } of dirty.values()) {
      select.value = original(select);
      resetRow(form);
    }
    dirty.clear();
    refreshBar();
  }

  let saving = false;
  async function saveAll() {
    if (saving || !dirty.size) return;
    // A row that needs a journal name can't be saved without one.
    for (const { form, select } of dirty.values()) {
      const box = form.querySelector<HTMLElement>(`[data-status-extra="${select.value}"]`);
      const input = box?.querySelector<HTMLInputElement>('input[type="text"]');
      if (input && !input.value.trim()) {
        form.classList.add('is-error');
        input.focus();
        refreshBar('Enter the journal name for the highlighted paper, then press Update.', 'err');
        return;
      }
    }
    saving = true;
    const b = ensureBar();
    b.querySelectorAll<HTMLButtonElement>('button').forEach((x) => { x.disabled = true; });
    refreshBar(`Saving ${dirty.size}…`);
    let ok = 0;
    const errors: string[] = [];
    for (const { form, select } of [...dirty.values()]) {
      const data = new FormData(form);
      data.set('return', '/pipeline/ping');
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, credentials: 'same-origin' });
        const err = new URL(res.url).searchParams.get('err');
        if (!res.ok || err) throw new Error(err || `Error ${res.status}`);
        // Saved: this becomes the row's new starting point.
        const chosen = select.selectedOptions[0];
        [...select.options].forEach((o) => { o.defaultSelected = o === chosen; });
        if (select.hasAttribute('data-member-select')) {
          const label = chosen?.textContent?.replace(/^→\s*/, '') ?? '';
          select.value = '';
          [...select.options].forEach((o) => { o.defaultSelected = o.value === ''; });
          const note = form.querySelector<HTMLElement>('.pl-status__note');
          if (note) note.textContent = `Requested: ${label} (waiting for approval)`;
        } else {
          const color = chosen?.dataset.color;
          const cell = form.closest<HTMLElement>('.cv-st');
          if (cell && color) cell.style.setProperty('--c', color);
          const row = form.closest<HTMLElement>('[data-cv-row]');
          if (row) row.dataset.cvF = select.value;
          select.title = chosen?.textContent ?? '';
          // A new journal name shows in the row straight away, with its link.
          const journal = form.querySelector<HTMLInputElement>(`[data-status-extra="${select.value}"] input[name="journal"]`)?.value.trim();
          if (row && journal) {
            row.querySelectorAll<HTMLElement>('[data-cv-journal]').forEach((el) => { el.textContent = journal; });
            const site = row.querySelector<HTMLAnchorElement>('a[aria-label="Open journal site"]');
            const href = journalSiteHref(journal);
            if (site && href) site.href = href;
          }
        }
        resetRow(form);
        // Still on a stage with a field (e.g. Submitted + journal): keep its box showing.
        const keep = form.querySelector<HTMLElement>(`[data-status-extra="${select.value}"]`);
        if (keep && keep.querySelector('input[type="text"]')) keep.hidden = false;
        dirty.delete(form);
        ok++;
      } catch (err) {
        form.classList.add('is-error');
        const who = select.getAttribute('aria-label')?.replace(/^.*for /, '') ?? 'A paper';
        errors.push(`${who}: ${(err as Error).message}`);
      }
    }
    saving = false;
    b.querySelectorAll<HTMLButtonElement>('button').forEach((x) => { x.disabled = false; });
    if (errors.length) refreshBar(`${ok} saved, ${errors.length} not saved. ${errors[0]}`, 'err');
    else {
      refreshBar(`${ok} status ${ok === 1 ? 'change' : 'changes'} saved`, 'ok');
      setTimeout(() => { if (!dirty.size) bar?.classList.remove('is-on'); }, 2600);
    }
  }

  // Leaving the page with unsaved changes asks first.
  addEventListener('beforeunload', (e) => { if (dirty.size) { e.preventDefault(); e.returnValue = ''; } });
</script>

<style is:global>
  /* The Update bar: appears when a status has been changed, saves them all. */
  .st-bar {
    position: fixed; left: 50%; bottom: 72px; z-index: 150; translate: -50% 260%;
    display: flex; align-items: center; gap: 10px; max-width: calc(100vw - 32px);
    padding: 10px 12px 10px 18px; border-radius: 12px;
    background: #161615; color: #fff; box-shadow: 0 14px 40px -12px rgba(0, 0, 0, 0.45);
    font-family: 'Merriweather Sans', system-ui, sans-serif; font-size: 0.9rem;
    transition: translate 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .st-bar.is-on { translate: -50% 0; }
  .st-bar[data-tone='ok'] .st-bar__text::before { content: '\2713  '; color: #4ade80; }
  .st-bar[data-tone='err'] .st-bar__text { color: #fca5a5; }
  .st-bar__text { margin: 0 6px 0 0; }
  .st-bar__btn {
    padding: 8px 18px; border: 1px solid #fff; border-radius: 8px; background: #fff; color: #161615;
    font: inherit; font-weight: 700; cursor: pointer;
  }
  .st-bar__btn--ghost { background: transparent; color: #fff; border-color: rgba(255, 255, 255, 0.4); font-weight: 600; }
  .st-bar__btn:disabled { opacity: 0.5; cursor: progress; }
  @media (prefers-reduced-motion: reduce) { .st-bar { transition: none; } }
</style>
