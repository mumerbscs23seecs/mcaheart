---
import { nav, site } from '../data/site';
import type { NavItem } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import LogoMark from './LogoMark.astro';

interface Props { transparent?: boolean }
const { transparent = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const matches = (href?: string) =>
  !!href && (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const isActive = (item: NavItem) =>
  matches(item.href) || (item.children?.some((c) => matches(c.href)) ?? false);

// Phone tab bar. Icons are drawn square-cornered to match the site's
// zero-radius language.
const dockTabs = [
  { label: 'Home', href: '/', icon: '<path d="M3 11.5 12 4l9 7.5M5.5 9.5V20h5v-5.5h3V20h5V9.5" />' },
  { label: 'Research', href: '/research-group', icon: '<path d="M9 3.5h6M10 3.5V9l-5.6 9.7a.9.9 0 0 0 .8 1.3h13.6a.9.9 0 0 0 .8-1.3L14 9V3.5M7.2 15h9.6" />' },
  { label: 'Trending', href: '/heart-trending', icon: '<path d="M3 5.5h18v13H3z" /><path d="M10 9.2v5.6l4.6-2.8z" fill="currentColor" />' },
  { label: 'Learn', href: '/education', icon: '<path d="M12 6.5C10 5 7 4.5 3.5 4.5v13c3.5 0 6.5.5 8.5 2 2-1.5 5-2 8.5-2v-13c-3.5 0-6.5.5-8.5 2Zm0 0v13" />' },
];
const involved = nav.find((n) => n.children)?.children ?? [];
const involvedNotes: Record<string, string> = {
  '/submit-idea': 'Propose a database or meta-analysis project',
  '/join-lab': 'Apply to the research lab',
  '/contact': 'Collaborations, letters, observerships',
};
const moreActive = involved.some((c) => matches(c.href)) || matches('/login');
---

<header class:list={['masthead', transparent && 'masthead--transparent']} data-header>
  <div class="shell shell--wide masthead__inner">
    <a class="wordmark" href="/" aria-label="MCA Heart - home">
      <LogoMark size="2.7em" kind="wordmark" />
      <span class="wordmark__text"><b>MCA</b> Heart</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {nav.map((item) => (
          <li class:list={['nav__item', item.children && 'nav__item--has-children']}>
            <a
              class:list={['nav__link', isActive(item) && 'is-current']}
              href={item.href ?? item.children?.[0]?.href}
              aria-current={isActive(item) ? 'page' : undefined}
              aria-haspopup={item.children ? 'true' : undefined}
              aria-expanded={item.children ? 'false' : undefined}
            >
              {item.label}
              {item.children && (
                <svg class="nav__caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                  <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              )}
            </a>
            {item.children && (
              <div class="nav__panel">
                <ul>
                  {item.children.map((c) => (
                    <li>
                      <a
                        class:list={['nav__sublink', matches(c.href) && 'is-current']}
                        href={c.href}
                        aria-current={matches(c.href) ? 'page' : undefined}
                      >{c.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>

      {/* Members-only. Rendered for everyone, revealed by the mca_hint cookie;
          the /pipeline and /admin routes enforce access server-side. */}
      <div class="authbar" data-auth>
        <a class="btn btn--ghost authbar__login" href="/login" data-auth-guest>Log in</a>
        <span class="authbar__account" data-auth-member hidden>
          {/* One link into the app. JS swaps it to "Admin" → /admin for admins. */}
          <a
            class:list={['nav__link', (matches('/pipeline') || matches('/admin')) && 'is-current']}
            href="/pipeline" data-auth-home
          >Workflow</a>
          <form method="post" action="/logout" class="authbar__logout">
            <button class="authbar__logout-btn" type="submit">Log out</button>
          </form>
        </span>
      </div>
      <ThemeToggle />
    </nav>

    <a class="btn masthead__join" href="/join-lab">Join the lab</a>

    <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-nav" data-burger>
      <span class="burger__label">Menu</span>
      <span class="burger__bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="drawer" id="mobile-nav" data-drawer hidden>
    <ul class="drawer__list">
      {nav.map((item, i) => (
        <li style={`--i:${i}`}>
          {item.children ? (
            <details class="drawer__group" open={isActive(item)}>
              <summary class="drawer__link drawer__summary">
                <span class="drawer__num">{String(i + 1).padStart(2, '0')}</span>
                <span>{item.label}</span>
                <svg class="drawer__caret" width="14" height="9" viewBox="0 0 14 9" aria-hidden="true">
                  <path d="M1 1l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" />
                </svg>
              </summary>
              <ul class="drawer__sublist">
                {item.children.map((c) => (
                  <li>
                    <a class:list={['drawer__sublink', matches(c.href) && 'is-current']} href={c.href}>{c.label}</a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a class:list={['drawer__link', matches(item.href) && 'is-current']} href={item.href}>
              <span class="drawer__num">{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          )}
        </li>
      ))}
    </ul>

    <div class="drawer__auth" data-auth>
      <a class="drawer__link" href="/login" data-auth-guest>Log in</a>
      <span class="drawer__member" data-auth-member hidden>
        <a
          class:list={['drawer__link', (matches('/pipeline') || matches('/admin')) && 'is-current']}
          href="/pipeline" data-auth-home
        >Workflow</a>
        <form method="post" action="/logout">
          <button class="drawer__link drawer__logout" type="submit">Log out</button>
        </form>
      </span>
    </div>

    <div class="drawer__theme">
      <span>Dark mode</span>
      <ThemeToggle />
    </div>
  </div>
</header>

{/* Phone tab bar - outside <header> on purpose: the header slides away on
    scroll via a transform, and a transformed ancestor would drag this
    fixed bar with it. */}
<nav class="dock" aria-label="Primary">
  <span class="dock__progress" data-dock-progress aria-hidden="true"></span>
  {dockTabs.map((t) => (
    <a
      class:list={['dock__item', matches(t.href) && 'is-current']}
      href={t.href}
      aria-current={matches(t.href) ? 'page' : undefined}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} />
      <span>{t.label}</span>
    </a>
  ))}
  <button
    class:list={['dock__item', moreActive && 'is-current']}
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="more-sheet"
    data-sheet-open
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 4h6.5v6.5H4zM13.5 4H20v6.5h-6.5zM4 13.5h6.5V20H4zM13.5 13.5H20V20h-6.5z" />
    </svg>
    <span>More</span>
  </button>
</nav>

<div class="sheet" id="more-sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title" data-sheet hidden>
  <div class="sheet__scrim" data-sheet-close></div>
  <div class="sheet__panel" data-sheet-panel>
    <div class="sheet__grab" data-sheet-grab>
      <span class="sheet__handle" aria-hidden="true"><i></i></span>
      <div class="sheet__head">
        <p class="sheet__title" id="sheet-title">Get involved</p>
        <button class="sheet__close" type="button" aria-label="Close menu" data-sheet-close>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
        </button>
      </div>
    </div>

    <ul class="sheet__list">
      {involved.map((c, i) => (
        <li style={`--i:${i}`}>
          <a class:list={['sheet__link', matches(c.href) && 'is-current']} href={c.href}>
            <span class="sheet__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="sheet__text">
              <span class="sheet__label">{c.label}</span>
              <span class="sheet__note">{involvedNotes[c.href] ?? ''}</span>
            </span>
            <span class="sheet__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="sheet__rows" data-auth style={`--i:${involved.length}`}>
      <a class="sheet__row" href="/login" data-auth-guest>
        <span>Members log in</span><span aria-hidden="true">&rarr;</span>
      </a>
      <span class="sheet__member" data-auth-member hidden>
        <a class="sheet__row" href="/pipeline" data-auth-home>Workflow</a>
        <form method="post" action="/logout">
          <button class="sheet__row sheet__logout" type="submit">Log out</button>
        </form>
      </span>
      <div class="sheet__row sheet__row--static">
        <span>Dark mode</span>
        <ThemeToggle />
      </div>
    </div>

    <p class="sheet__socials" style={`--i:${involved.length + 1}`}>
      <a href={site.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>
      <a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
      <a href={site.x} target="_blank" rel="noopener noreferrer">X</a>
    </p>
  </div>
</div>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--ink);
    transition: background 0.35s var(--ease), border-color 0.35s var(--ease);
  }

  /* Transparent variant sits over a hero until the page scrolls. */
  .masthead--transparent:not(.is-stuck):not(.is-open) {
    background: transparent;
    border-bottom-color: transparent;
  }

  .masthead__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
  }

  /* --- Wordmark --- */
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    flex-shrink: 0;
  }
  /* Same lockup as the admin app bar's brand text (AppBar.astro), scaled
     up to match this header's bigger logo mark. */
  .wordmark__text {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.3rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--text-strong);
  }
  .wordmark__text b { color: var(--blue); font-weight: 800; }

  /* --- Desktop nav --- */
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 0.1rem + 1.4vw, 1.9rem);
    min-width: 0;
  }
  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 0.1rem + 1.4vw, 1.9rem);
  }
  .nav__item { position: relative; }
  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.003em;
    color: var(--text);
    padding-block: 0.5rem;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--font-sans);
    transition: color 0.2s var(--ease);
    white-space: nowrap;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0; bottom: 0;
    width: 100%; height: 2px;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out);
  }
  .nav__link:hover { color: var(--text-strong); }
  .nav__link:hover::after { transform: scaleX(1); transform-origin: left; }
  .nav__link.is-current { color: var(--blue); }
  .nav__link.is-current::after { transform: scaleX(1); }

  .nav__caret { margin-left: 0.4em; opacity: 0.65; transition: transform 0.25s var(--ease); }
  .nav__item--has-children:hover .nav__caret,
  .nav__item--has-children:focus-within .nav__caret { transform: rotate(180deg); }

  /* Dropdown panel - pure CSS reveal */
  .nav__panel {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 4px);
    min-width: 230px;
    padding: 0.25rem;
    background: var(--surface);
    border: 1px solid var(--ink);
    border-radius: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s var(--ease), transform 0.15s var(--ease), visibility 0.15s;
    z-index: 120;
  }
  .nav__panel::before {
    content: '';
    position: absolute;
    left: 0; right: 0; top: -8px; height: 8px;
  }
  .nav__item--has-children:hover .nav__panel,
  .nav__item--has-children:focus-within .nav__panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }
  .nav__sublink {
    display: block;
    padding: 0.6rem 0.85rem;
    border-radius: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    transition: background 0.12s var(--ease), color 0.12s var(--ease);
  }
  .nav__sublink:hover { background: var(--ink); color: var(--bg); }
  .nav__sublink.is-current { color: var(--blue); }

  /* --- Burger --- */
  /* 44px square-ish hit area; the negative margin keeps the visible label
     flush with the gutter the way it was drawn. */
  .burger {
    display: none;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0 0.75rem;
    margin-right: -0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-strong);
  }
  .burger:active { color: var(--blue); }
  .burger__bars { display: grid; gap: 5px; width: 24px; }
  .burger__bars i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.35s var(--ease), opacity 0.25s var(--ease);
  }
  .burger[aria-expanded='true'] .burger__bars i:first-child { transform: translateY(3.25px) rotate(45deg); }
  .burger[aria-expanded='true'] .burger__bars i:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  /* --- Mobile drawer --- */
  .drawer {
    position: fixed;
    inset: var(--header-h) 0 0;
    background: var(--surface);
    padding: var(--space-m) var(--gutter) var(--space-l);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .drawer[hidden] { display: none; }
  .drawer__link:active,
  .drawer__sublink:active { color: var(--blue); }
  .drawer__list { display: grid; gap: 0.25rem; }
  .drawer__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    width: 100%;
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-strong);
    opacity: 0;
    transform: translateY(12px);
    animation: drawer-in 0.5s var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 60ms + 80ms);
  }
  .drawer__link.is-current { color: var(--blue); }
  .drawer__num {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--blue);
  }

  .drawer__group { border-bottom: 1px solid var(--border-soft); }
  .drawer__group .drawer__link { border-bottom: 0; }
  .drawer__summary { list-style: none; cursor: pointer; align-items: center; }
  .drawer__summary::-webkit-details-marker { display: none; }
  .drawer__caret { margin-left: auto; align-self: center; transition: transform 0.25s var(--ease); }
  .drawer__group[open] .drawer__caret { transform: rotate(180deg); }
  .drawer__sublist { display: grid; gap: 0.1rem; padding: 0 0 var(--space-s) 2.7rem; }
  .drawer__sublink {
    display: block;
    padding-block: 0.7rem;
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--text-muted);
  }
  .drawer__sublink.is-current { color: var(--blue); font-weight: 600; }

  @keyframes drawer-in { to { opacity: 1; transform: none; } }

  /* --- Auth bar (desktop) --- */
  [data-auth] [hidden] { display: none !important; }
  .authbar { display: flex; align-items: center; gap: 0.9rem; }
  .authbar__login { padding-block: 0.4rem; padding-inline: 0.9rem; font-size: 0.8rem; }

  /* Members zone: a solid charcoal block so the app nav reads as a distinct area. */
  .authbar__account {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 0.4rem + 0.7vw, 1.3rem);
    padding: 0.4rem 0.4rem 0.4rem 1.05rem;
    background: var(--ink);
    border-radius: 0;
  }
  .authbar__account .nav__link { font-weight: 700; font-size: 0.82rem; }
  .authbar__account .nav__link { color: color-mix(in srgb, var(--bg) 82%, transparent); }
  .authbar__account .nav__link:hover { color: var(--bg); }
  .authbar__account .nav__link::after { background: var(--bg); }
  .authbar__account .nav__link.is-current { color: var(--bg); }
  .authbar__logout { display: flex; margin: 0; }
  /* A ghost outline instead of a solid light button - a solid white fill
     here nearly vanished against the pill's own background in dark mode
     (--ink flips to an off-white there too), reading as two stacked boxes
     instead of one pill. This scales its border/text with --bg the same
     way the "Admin" link beside it does, and only goes solid on hover. */
  .authbar__logout-btn {
    cursor: pointer;
    font-family: inherit;
    font-weight: 700;
    padding-block: 0.4rem;
    padding-inline: 0.9rem;
    font-size: 0.8rem;
    white-space: nowrap;
    background: transparent;
    color: var(--bg);
    border: 1px solid color-mix(in srgb, var(--bg) 45%, transparent);
    border-radius: 0;
    transition: background 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .authbar__logout-btn:hover,
  .authbar__logout-btn:focus-visible {
    background: color-mix(in srgb, var(--bg) 18%, transparent);
    color: var(--bg);
    border-color: var(--bg);
  }

  /* --- Auth block (mobile drawer) --- */
  .drawer__auth { margin-top: var(--space-m); display: grid; gap: 0.25rem; }
  .drawer__theme {
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: 1px solid var(--border-soft);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }
  .drawer__member {
    display: grid;
    gap: 0.15rem;
    margin-top: var(--space-xs);
    padding: 0.4rem var(--space-s) var(--space-xs);
    background: var(--ink);
    border-radius: 0;
  }
  .drawer__member .drawer__link { color: var(--bg); border-bottom-color: color-mix(in srgb, var(--bg) 16%, transparent); }
  .drawer__member .drawer__link.is-current { color: var(--bg); }
  .drawer__member .drawer__num { color: color-mix(in srgb, var(--bg) 70%, transparent); }
  .drawer__logout {
    width: 100%;
    text-align: left;
    background: none;
    border: 0;
    border-bottom: 0;
    cursor: pointer;
    font: inherit;
    padding-block: var(--space-s);
  }

  @media (max-width: 1180px) {
    .nav { display: none; }
    .burger { display: inline-flex; }
  }

  /* ================================================================ Phone
     The tab bar replaces the burger; the top bar carries the brand + the
     primary call to action and slides away while reading downwards. */
  .masthead__join { display: none; }
  .dock, .sheet { display: none; }

  @media (max-width: 760px) {
    .masthead {
      transition: translate 0.45s var(--ease-out), background 0.35s var(--ease), border-color 0.35s var(--ease);
    }
    .masthead.is-hidden:not(.is-open) { translate: 0 -101%; }
    .masthead__inner { gap: var(--space-s); }
    .burger { display: none; }
    .wordmark :global(.logo-mark) { --logo-mark-size: 2.4em !important; }
    .wordmark__text { font-size: 1rem; }
    .masthead__join {
      display: inline-flex;
      min-height: 40px;
      padding: 0 0.95rem;
      font-size: 0.8125rem;
    }

    /* ---- Tab bar */
    .dock {
      position: fixed;
      inset: auto 0 0;
      z-index: 110;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      height: var(--dock-space);
      padding: 0 env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
      background: color-mix(in srgb, var(--bg) 86%, transparent);
      -webkit-backdrop-filter: saturate(1.6) blur(18px);
      backdrop-filter: saturate(1.6) blur(18px);
      border-top: 1px solid var(--border);
    }
    /* Reading progress runs along the bar's top rule. */
    .dock__progress {
      position: absolute;
      inset: -1px 0 auto;
      height: 2px;
      background: var(--blue);
      transform-origin: 0 50%;
      transform: scaleX(0);
    }
    .dock__item {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      height: var(--dock-h);
      font-family: var(--font-sans);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      color: var(--text-muted);
      transition: color 0.2s var(--ease);
    }
    .dock__item svg {
      width: 24px;
      height: 24px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.7;
      stroke-linejoin: miter;
      transition: transform 0.3s var(--ease-out);
    }
    .dock__item:active svg { transform: scale(0.84); transition-duration: 0.1s; }
    .dock__item.is-current { color: var(--blue); font-weight: 800; }
    .dock__item.is-current svg { stroke-width: 2.2; }
    /* A short keyline under the current tab's label. */
    .dock__item.is-current::after {
      content: '';
      position: absolute;
      bottom: 5px;
      width: 14px;
      height: 2px;
      background: currentColor;
    }

    /* ---- More sheet */
    .sheet { display: block; position: fixed; inset: 0; z-index: 160; }
    .sheet[hidden] { display: none; }
    .sheet__scrim {
      position: absolute;
      inset: 0;
      background: rgba(12, 12, 11, 0.55);
      opacity: 0;
      transition: opacity 0.4s var(--ease);
    }
    .sheet.is-open .sheet__scrim { opacity: calc(1 - var(--dragp, 0)); }
    .sheet__panel {
      position: absolute;
      inset: auto 0 0;
      max-height: 88svh;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 0 var(--gutter) calc(var(--space-m) + env(safe-area-inset-bottom, 0px));
      background: var(--surface);
      border-top: 2px solid var(--ink);
      transform: translateY(100%);
      /* iOS's own sheet curve: fast out, long settle. */
      transition: transform 0.5s cubic-bezier(0.32, 0.72, 0, 1);
    }
    .sheet.is-open .sheet__panel { transform: translateY(var(--drag, 0px)); }
    .sheet.is-dragging .sheet__panel,
    .sheet.is-dragging .sheet__scrim { transition: none; }

    .sheet__grab { touch-action: none; cursor: grab; }
    .sheet__handle { display: flex; justify-content: center; padding: 10px 0 4px; }
    .sheet__handle i { width: 40px; height: 4px; background: var(--border-strong); }
    .sheet__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: var(--space-xs);
      border-bottom: 2px solid var(--ink);
    }
    .sheet__title {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--text-muted);
    }
    .sheet__close {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      color: var(--text-strong);
    }
    .sheet__close:active { color: var(--blue); }

    .sheet__list li,
    .sheet__rows,
    .sheet__socials {
      opacity: 0;
      translate: 0 14px;
    }
    .sheet.is-open .sheet__list li,
    .sheet.is-open .sheet__rows,
    .sheet.is-open .sheet__socials {
      animation: sheet-in 0.55s var(--ease-out) forwards;
      animation-delay: calc(var(--i) * 55ms + 120ms);
    }
    .sheet__link {
      display: grid;
      grid-template-columns: 2rem 1fr auto;
      align-items: center;
      gap: var(--space-xs);
      padding-block: 1rem;
      border-bottom: 1px solid var(--border);
      color: var(--text-strong);
    }
    .sheet__link:active { background: var(--accent-wash); }
    .sheet__num {
      font-size: 0.8125rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--blue);
    }
    .sheet__text { display: grid; gap: 2px; }
    .sheet__label {
      font-family: var(--font-display);
      font-size: var(--step-2);
      font-weight: 800;
      line-height: 1.05;
      letter-spacing: -0.02em;
    }
    .sheet__note { font-size: 0.875rem; color: var(--text-muted); }
    .sheet__link.is-current .sheet__label { color: var(--blue); }
    .sheet__arrow { font-size: 1.25rem; color: var(--blue); transition: translate 0.3s var(--ease-out); }
    .sheet__link:active .sheet__arrow { translate: 4px 0; }

    .sheet__rows { display: grid; margin-top: var(--space-s); }
    .sheet__member { display: grid; }
    .sheet__row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      min-height: 52px;
      border-bottom: 1px solid var(--border-soft);
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-strong);
      text-align: left;
    }
    .sheet__row:not(.sheet__row--static):active { color: var(--blue); }
    .sheet__logout { font: inherit; font-weight: 600; }

    .sheet__socials {
      display: flex;
      gap: var(--space-m);
      margin-top: var(--space-s);
      font-size: 0.8125rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.14em;
    }
    .sheet__socials a { display: inline-flex; align-items: center; min-height: 44px; color: var(--text-muted); }
    .sheet__socials a:active { color: var(--blue); }
  }

  @keyframes sheet-in { to { opacity: 1; translate: 0 0; } }

  @media (prefers-reduced-motion: reduce) {
    .sheet__list li, .sheet__rows, .sheet__socials { opacity: 1; translate: none; animation: none !important; }
    .masthead { transition: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer__link { opacity: 1; transform: none; animation: none; }
    .nav__panel { transition: none; }
  }
</style>

<script is:inline>
  (() => {
    // Reveal the members-only nav from the (non-sensitive) mca_hint cookie.
    const match = document.cookie.match(/(?:^|;\s*)mca_hint=([^;]+)/);
    let info = null;
    if (match) {
      try { info = JSON.parse(decodeURIComponent(match[1])); } catch { info = null; }
    }
    document.querySelectorAll('[data-auth]').forEach((bar) => {
      const guest = bar.querySelector('[data-auth-guest]');
      const member = bar.querySelector('[data-auth-member]');
      if (info && info.name && member) {
        if (guest) guest.hidden = true;
        member.hidden = false;
        if (info.role === 'admin') {
          bar.querySelectorAll('[data-auth-home]').forEach((el) => {
            el.textContent = 'Admin';
            el.setAttribute('href', '/admin');
          });
        }
      }
    });

    const header = document.querySelector('[data-header]');
    const burger = document.querySelector('[data-burger]');
    const drawer = document.querySelector('[data-drawer]');

    // Keep aria-expanded honest on the dropdown triggers.
    document.querySelectorAll('.nav__item--has-children').forEach((group) => {
      const trigger = group.querySelector('.nav__link');
      const sync = () => trigger && trigger.setAttribute('aria-expanded', String(group.matches(':hover, :focus-within')));
      group.addEventListener('mouseenter', sync);
      group.addEventListener('mouseleave', sync);
      group.addEventListener('focusin', sync);
      group.addEventListener('focusout', sync);
      group.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && document.activeElement && document.activeElement.blur) document.activeElement.blur();
      });
    });

    // Swap the transparent masthead to solid once the hero is behind it.
    if (header && header.classList.contains('masthead--transparent')) {
      const sentinel = document.createElement('div');
      sentinel.style.cssText = 'position:absolute;top:0;height:1px;width:1px;';
      document.body.prepend(sentinel);
      new IntersectionObserver(
        ([e]) => header.classList.toggle('is-stuck', !e.isIntersecting),
        { threshold: 0 },
      ).observe(sentinel);
    }

    if (burger && drawer) {
      const setOpen = (open) => {
        burger.setAttribute('aria-expanded', String(open));
        drawer.hidden = !open;
        if (header) header.classList.toggle('is-open', open);
        document.body.style.overflow = open ? 'hidden' : '';
        const label = burger.querySelector('.burger__label');
        if (label) label.textContent = open ? 'Close' : 'Menu';
      };

      burger.addEventListener('click', () => setOpen(drawer.hidden));
      drawer.addEventListener('click', (e) => {
        if (e.target.closest('a')) setOpen(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !drawer.hidden) { setOpen(false); burger.focus(); }
      });
      matchMedia('(min-width: 1181px)').addEventListener('change', (e) => {
        if (e.matches && !drawer.hidden) setOpen(false);
      });
    }

    // ---- Phone "More" sheet: slide-up panel, drag the top down to dismiss.
    const sheet = document.querySelector('[data-sheet]');
    const opener = document.querySelector('[data-sheet-open]');
    if (sheet && opener) {
      const panel = sheet.querySelector('[data-sheet-panel]');
      const grab = sheet.querySelector('[data-sheet-grab]');
      const root = document.documentElement;
      let closeTimer = 0;

      const focusables = () =>
        Array.from(panel.querySelectorAll('a[href], button:not([disabled])')).filter((el) => !el.closest('[hidden]'));

      const open = () => {
        clearTimeout(closeTimer);
        sheet.hidden = false;
        root.classList.add('is-locked');
        opener.setAttribute('aria-expanded', 'true');
        panel.scrollTop = 0;
        requestAnimationFrame(() => requestAnimationFrame(() => sheet.classList.add('is-open')));
        const first = panel.querySelector('.sheet__link');
        if (first) setTimeout(() => first.focus({ preventScroll: true }), 60);
      };
      const close = () => {
        if (sheet.hidden) return;
        sheet.classList.remove('is-open');
        opener.setAttribute('aria-expanded', 'false');
        root.classList.remove('is-locked');
        closeTimer = setTimeout(() => {
          sheet.hidden = true;
          panel.style.removeProperty('--drag');
          sheet.style.removeProperty('--dragp');
        }, 480);
        opener.focus({ preventScroll: true });
      };

      opener.addEventListener('click', () => (sheet.hidden ? open() : close()));
      sheet.addEventListener('click', (e) => {
        if (e.target.closest('[data-sheet-close]') || e.target.closest('a[href]')) close();
      });
      document.addEventListener('keydown', (e) => {
        if (sheet.hidden) return;
        if (e.key === 'Escape') close();
        if (e.key === 'Tab') {
          const f = focusables();
          const first = f[0], last = f[f.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      });

      // Drag: follow the finger 1:1, then either spring back or dismiss on a
      // long enough pull or a quick flick. Pointer capture only starts once
      // the finger has actually moved, so a plain tap on the close button
      // stays a click.
      let startY = 0, dy = 0, t0 = 0, down = false, dragging = false, pid = 0;
      grab.addEventListener('pointerdown', (e) => {
        down = true; dragging = false; startY = e.clientY; dy = 0; t0 = performance.now(); pid = e.pointerId;
      });
      grab.addEventListener('pointermove', (e) => {
        if (!down) return;
        const d = e.clientY - startY;
        if (!dragging && Math.abs(d) > 6) {
          dragging = true;
          sheet.classList.add('is-dragging');
          try { grab.setPointerCapture(pid); } catch (err) {}
        }
        if (!dragging) return;
        dy = Math.max(0, d);
        panel.style.setProperty('--drag', dy + 'px');
        sheet.style.setProperty('--dragp', String(Math.min(1, dy / panel.offsetHeight)));
      });
      const end = () => {
        if (!down) return;
        down = false;
        if (!dragging) return;
        dragging = false;
        sheet.classList.remove('is-dragging');
        const v = dy / Math.max(1, performance.now() - t0);
        if (dy > 110 || (dy > 30 && v > 0.55)) {
          close();
        } else {
          panel.style.setProperty('--drag', '0px');
          sheet.style.setProperty('--dragp', '0');
        }
      };
      grab.addEventListener('pointerup', end);
      grab.addEventListener('pointercancel', end);

      matchMedia('(min-width: 761px)').addEventListener('change', (e) => { if (e.matches) close(); });
    }
  })();
</script>

<script>
  // Phone chrome: the top bar slides away while reading downwards and comes
  // back on any upward scroll; the tab bar's top rule shows reading progress.
  import { subscribe, phone } from '../scripts/motion';

  const header = document.querySelector<HTMLElement>('[data-header]');
  const progress = document.querySelector<HTMLElement>('[data-dock-progress]');
  const root = document.documentElement;
  let hidden = false;
  let docH = 0;
  let run = 0;

  const setHidden = (h: boolean) => {
    if (h === hidden || !header) return;
    hidden = h;
    header.classList.toggle('is-hidden', h);
  };
  header?.addEventListener('focusin', () => setHidden(false));

  subscribe({
    measure() {
      docH = root.scrollHeight;
    },
    update({ y, vh, dy }) {
      if (!phone.matches) {
        setHidden(false);
        return;
      }
      if (progress) {
        const p = docH > vh ? Math.min(1, Math.max(0, y / (docH - vh))) : 0;
        progress.style.transform = `scaleX(${p.toFixed(4)})`;
      }
      if (root.classList.contains('is-locked')) return;
      // Direction with a little hysteresis, so tiny touch jitters don't
      // flicker the bar.
      run = Math.sign(dy) === Math.sign(run) ? run + dy : dy;
      if (y < 80) setHidden(false);
      else if (run > 28) setHidden(true);
      else if (run < -18) setHidden(false);
    },
  });
</script>
