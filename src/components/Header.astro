---
import { nav } from '../data/site';
import type { NavItem } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import LogoMark from './LogoMark.astro';

interface Props { transparent?: boolean }
const { transparent = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const matches = (href?: string) =>
  !!href && (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const isActive = (item: NavItem) =>
  matches(item.href) || (item.children?.some((c) => matches(c.href)) ?? false);

// Side menu (phones and tablets): Home first, then the main nav.
const drawerNav: NavItem[] = [{ label: 'Home', href: '/' }, ...nav];
---

<header class:list={['masthead', transparent && 'masthead--transparent']} data-header>
  <div class="shell shell--wide masthead__inner">
    <a class="wordmark" href="/" aria-label="MCA Heart - home">
      <LogoMark size="2.7em" kind="wordmark" />
      <span class="wordmark__text"><b>MCA</b> Heart</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {nav.map((item) => (
          <li class:list={['nav__item', item.children && 'nav__item--has-children']}>
            <a
              class:list={['nav__link', isActive(item) && 'is-current']}
              href={item.href ?? item.children?.[0]?.href}
              aria-current={isActive(item) ? 'page' : undefined}
              aria-haspopup={item.children ? 'true' : undefined}
              aria-expanded={item.children ? 'false' : undefined}
            >
              {item.label}
              {item.children && (
                <svg class="nav__caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                  <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              )}
            </a>
            {item.children && (
              <div class="nav__panel">
                <ul>
                  {item.children.map((c) => (
                    <li>
                      <a
                        class:list={['nav__sublink', matches(c.href) && 'is-current']}
                        href={c.href}
                        aria-current={matches(c.href) ? 'page' : undefined}
                      >{c.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>

      {/* Members-only. Rendered for everyone, revealed by the mca_hint cookie;
          the /pipeline and /admin routes enforce access server-side. */}
      <div class="authbar" data-auth>
        <a class="btn btn--ghost authbar__login" href="/login" data-auth-guest>Log in</a>
        <span class="authbar__account" data-auth-member hidden>
          {/* One link into the app. JS swaps it to "Admin" → /admin for admins. */}
          <a
            class:list={['nav__link', (matches('/pipeline') || matches('/admin')) && 'is-current']}
            href="/pipeline" data-auth-home
          >Workflow</a>
          <form method="post" action="/logout" class="authbar__logout">
            <button class="authbar__logout-btn" type="submit">Log out</button>
          </form>
        </span>
      </div>
      <ThemeToggle />
    </nav>

    <div class="masthead__tools">
      <ThemeToggle />
      <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" data-burger>
        <span class="burger__bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

{/* Side menu - outside <header> on purpose: the header slides away on
    scroll via a transform, and a transformed ancestor would drag this
    fixed panel with it. */}
<div class="drawer" id="mobile-nav" data-drawer hidden>
  <div class="drawer__scrim" data-drawer-close></div>
  <nav class="drawer__panel" aria-label="Menu">
    <div class="drawer__head" data-auth>
      <a class="drawer__login" href="/login" data-auth-guest>Log in</a>
      <span class="drawer__member" data-auth-member hidden>
        <a class="drawer__login" href="/pipeline" data-auth-home>Workflow</a>
        <form method="post" action="/logout">
          <button class="drawer__logout" type="submit">Log out</button>
        </form>
      </span>
      <button class="drawer__close" type="button" aria-label="Close menu" data-drawer-close>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
      </button>
    </div>

    <ul class="drawer__list">
      {drawerNav.map((item, i) => (
        <li style={`--i:${i}`}>
          {item.children ? (
            <details class="drawer__group" open={isActive(item)}>
              <summary class="drawer__link drawer__summary">
                <span>{item.label}</span>
                <svg class="drawer__caret" width="14" height="9" viewBox="0 0 14 9" aria-hidden="true">
                  <path d="M1 1l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" />
                </svg>
              </summary>
              <ul class="drawer__sublist">
                {item.children.map((c) => (
                  <li>
                    <a class:list={['drawer__sublink', matches(c.href) && 'is-current']} href={c.href}>{c.label}</a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a class:list={['drawer__link', matches(item.href) && 'is-current']} href={item.href}>{item.label}</a>
          )}
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--ink);
    transition: background 0.35s var(--ease), border-color 0.35s var(--ease);
  }

  /* Transparent variant sits over a hero until the page scrolls. */
  .masthead--transparent:not(.is-stuck):not(.is-open) {
    background: transparent;
    border-bottom-color: transparent;
  }

  .masthead__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
  }

  /* --- Wordmark --- */
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    flex-shrink: 0;
  }
  /* Same lockup as the admin app bar's brand text (AppBar.astro), scaled
     up to match this header's bigger logo mark. */
  .wordmark__text {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.3rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--text-strong);
  }
  .wordmark__text b { color: var(--blue); font-weight: 800; }

  /* --- Desktop nav --- */
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 0.1rem + 1.4vw, 1.9rem);
    min-width: 0;
  }
  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 0.1rem + 1.4vw, 1.9rem);
  }
  .nav__item { position: relative; }
  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.003em;
    color: var(--text);
    padding-block: 0.5rem;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--font-sans);
    transition: color 0.2s var(--ease);
    white-space: nowrap;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0; bottom: 0;
    width: 100%; height: 2px;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out);
  }
  .nav__link:hover { color: var(--text-strong); }
  .nav__link:hover::after { transform: scaleX(1); transform-origin: left; }
  .nav__link.is-current { color: var(--blue); }
  .nav__link.is-current::after { transform: scaleX(1); }

  .nav__caret { margin-left: 0.4em; opacity: 0.65; transition: transform 0.25s var(--ease); }
  .nav__item--has-children:hover .nav__caret,
  .nav__item--has-children:focus-within .nav__caret { transform: rotate(180deg); }

  /* Dropdown panel - pure CSS reveal */
  .nav__panel {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 4px);
    min-width: 230px;
    padding: 0.25rem;
    background: var(--surface);
    border: 1px solid var(--ink);
    border-radius: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s var(--ease), transform 0.15s var(--ease), visibility 0.15s;
    z-index: 120;
  }
  .nav__panel::before {
    content: '';
    position: absolute;
    left: 0; right: 0; top: -8px; height: 8px;
  }
  .nav__item--has-children:hover .nav__panel,
  .nav__item--has-children:focus-within .nav__panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }
  .nav__sublink {
    display: block;
    padding: 0.6rem 0.85rem;
    border-radius: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    transition: background 0.12s var(--ease), color 0.12s var(--ease);
  }
  .nav__sublink:hover { background: var(--ink); color: var(--bg); }
  .nav__sublink.is-current { color: var(--blue); }

  /* --- Burger + theme (phones and tablets) --- */
  .masthead__tools { display: none; align-items: center; gap: 0.35rem; }
  .burger {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    color: var(--text-strong);
  }
  .burger:active { color: var(--blue); }
  .burger__bars { display: grid; gap: 5px; width: 22px; }
  .burger__bars i { display: block; height: 2px; background: currentColor; }

  /* --- Side menu --- */
  .drawer { position: fixed; inset: 0; z-index: 200; }
  .drawer[hidden] { display: none; }
  .drawer__scrim {
    position: absolute;
    inset: 0;
    background: rgba(12, 12, 11, 0.55);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  .drawer__panel {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(86vw, 380px);
    display: flex;
    flex-direction: column;
    padding: 0 var(--gutter) calc(var(--space-l) + env(safe-area-inset-bottom, 0px));
    background: var(--surface);
    border-left: 2px solid var(--ink);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(100%);
    transition: transform 0.45s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .drawer.is-open .drawer__scrim { opacity: 1; }
  .drawer.is-open .drawer__panel { transform: none; }

  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: var(--header-h);
    border-bottom: 2px solid var(--ink);
  }
  .drawer__login {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 1rem;
    font-weight: 700;
    color: var(--blue);
  }
  .drawer__member { display: flex; align-items: center; gap: var(--space-s); }
  .drawer__member form { display: flex; margin: 0; }
  .drawer__logout {
    min-height: 44px;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .drawer__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    color: var(--text-strong);
  }

  .drawer__list { display: grid; }
  .drawer__list > li {
    opacity: 0;
    transform: translateX(16px);
  }
  .drawer.is-open .drawer__list > li {
    animation: drawer-in 0.45s var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 45ms + 120ms);
  }
  .drawer__link {
    display: flex;
    align-items: center;
    width: 100%;
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-strong);
  }
  .drawer__link.is-current { color: var(--blue); }
  .drawer__link:active,
  .drawer__sublink:active { color: var(--blue); }

  .drawer__group { border-bottom: 1px solid var(--border); }
  .drawer__group .drawer__link { border-bottom: 0; }
  .drawer__summary { list-style: none; cursor: pointer; }
  .drawer__summary::-webkit-details-marker { display: none; }
  .drawer__caret { margin-left: auto; transition: transform 0.25s var(--ease); }
  .drawer__group[open] .drawer__caret { transform: rotate(180deg); }
  .drawer__sublist { display: grid; padding: 0 0 var(--space-s) var(--space-s); }
  .drawer__sublink {
    display: block;
    padding-block: 0.7rem;
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--text-muted);
  }
  .drawer__sublink.is-current { color: var(--blue); }

  @keyframes drawer-in { to { opacity: 1; transform: none; } }

  /* --- Auth bar (desktop) --- */
  [data-auth] [hidden] { display: none !important; }
  .authbar { display: flex; align-items: center; gap: 0.9rem; }
  .authbar__login { padding-block: 0.4rem; padding-inline: 0.9rem; font-size: 0.8rem; }

  /* Members zone: same colours as the rest of the header (light and dark),
     set apart only by a soft half-transparent rounded outline. */
  .authbar__account {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 0.4rem + 0.7vw, 1.3rem);
    padding: 0.3rem 0.3rem 0.3rem 1.05rem;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--text-strong) 50%, transparent);
    border-radius: 999px;
  }
  .authbar__account .nav__link { font-weight: 700; font-size: 0.82rem; }
  .authbar__logout { display: flex; margin: 0; }
  .authbar__logout-btn {
    cursor: pointer;
    font-family: inherit;
    font-weight: 700;
    padding-block: 0.4rem;
    padding-inline: 0.95rem;
    font-size: 0.8rem;
    white-space: nowrap;
    background: transparent;
    color: var(--text-strong);
    border: 0;
    border-radius: 999px;
    transition: background 0.2s var(--ease);
  }
  .authbar__logout-btn:hover,
  .authbar__logout-btn:focus-visible {
    background: color-mix(in srgb, var(--text-strong) 8%, transparent);
  }

  @media (max-width: 1180px) {
    .nav { display: none; }
    .masthead__tools { display: flex; }
  }

  /* Phone: the top bar slides away while reading downwards. */
  @media (max-width: 760px) {
    .masthead {
      transition: translate 0.45s var(--ease-out), background 0.35s var(--ease), border-color 0.35s var(--ease);
    }
    .masthead.is-hidden { translate: 0 -101%; }
    .masthead__inner { gap: var(--space-s); }
    .wordmark :global(.logo-mark) { --logo-mark-size: 2.4em !important; }
    .wordmark__text { font-size: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .masthead, .drawer__panel, .drawer__scrim { transition: none; }
    .drawer__list > li { opacity: 1; transform: none; animation: none !important; }
    .nav__panel { transition: none; }
  }
</style>

<script is:inline>
  (() => {
    // Reveal the members-only nav from the (non-sensitive) mca_hint cookie.
    const match = document.cookie.match(/(?:^|;\s*)mca_hint=([^;]+)/);
    let info = null;
    if (match) {
      try { info = JSON.parse(decodeURIComponent(match[1])); } catch { info = null; }
    }
    document.querySelectorAll('[data-auth]').forEach((bar) => {
      const guest = bar.querySelector('[data-auth-guest]');
      const member = bar.querySelector('[data-auth-member]');
      if (info && info.name && member) {
        if (guest) guest.hidden = true;
        member.hidden = false;
        if (info.role === 'admin') {
          bar.querySelectorAll('[data-auth-home]').forEach((el) => {
            el.textContent = 'Admin';
            el.setAttribute('href', '/admin');
          });
        }
      }
    });

    const header = document.querySelector('[data-header]');
    const burger = document.querySelector('[data-burger]');
    const drawer = document.querySelector('[data-drawer]');

    // Keep aria-expanded honest on the dropdown triggers.
    document.querySelectorAll('.nav__item--has-children').forEach((group) => {
      const trigger = group.querySelector('.nav__link');
      const sync = () => trigger && trigger.setAttribute('aria-expanded', String(group.matches(':hover, :focus-within')));
      group.addEventListener('mouseenter', sync);
      group.addEventListener('mouseleave', sync);
      group.addEventListener('focusin', sync);
      group.addEventListener('focusout', sync);
      group.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && document.activeElement && document.activeElement.blur) document.activeElement.blur();
      });
    });

    // Swap the transparent masthead to solid once the hero is behind it.
    if (header && header.classList.contains('masthead--transparent')) {
      const sentinel = document.createElement('div');
      sentinel.style.cssText = 'position:absolute;top:0;height:1px;width:1px;';
      document.body.prepend(sentinel);
      new IntersectionObserver(
        ([e]) => header.classList.toggle('is-stuck', !e.isIntersecting),
        { threshold: 0 },
      ).observe(sentinel);
    }

    if (burger && drawer) {
      const panel = drawer.querySelector('.drawer__panel');
      const root = document.documentElement;
      let closeTimer = 0;
      const setOpen = (open) => {
        clearTimeout(closeTimer);
        burger.setAttribute('aria-expanded', String(open));
        root.classList.toggle('is-locked', open);
        if (open) {
          drawer.hidden = false;
          if (panel) panel.scrollTop = 0;
          requestAnimationFrame(() => requestAnimationFrame(() => drawer.classList.add('is-open')));
          const first = drawer.querySelector('.drawer__login:not([hidden]), .drawer__member:not([hidden]) a');
          if (first) setTimeout(() => first.focus({ preventScroll: true }), 60);
        } else {
          drawer.classList.remove('is-open');
          closeTimer = setTimeout(() => { drawer.hidden = true; }, 450);
        }
      };

      burger.addEventListener('click', () => setOpen(true));
      drawer.addEventListener('click', (e) => {
        if (e.target.closest('[data-drawer-close]')) { setOpen(false); burger.focus(); }
        else if (e.target.closest('a[href]')) setOpen(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !drawer.hidden) { setOpen(false); burger.focus(); }
      });
      matchMedia('(min-width: 1181px)').addEventListener('change', (e) => {
        if (e.matches && !drawer.hidden) setOpen(false);
      });
    }
  })();
</script>

<script>
  // Phone chrome: the top bar slides away while reading downwards and comes
  // back on any upward scroll.
  import { subscribe, phone } from '../scripts/motion';

  const header = document.querySelector<HTMLElement>('[data-header]');
  const root = document.documentElement;
  let hidden = false;
  let run = 0;

  const setHidden = (h: boolean) => {
    if (h === hidden || !header) return;
    hidden = h;
    header.classList.toggle('is-hidden', h);
  };
  header?.addEventListener('focusin', () => setHidden(false));

  subscribe({
    update({ y, dy }) {
      if (!phone.matches) {
        setHidden(false);
        return;
      }
      if (root.classList.contains('is-locked')) return;
      // Direction with a little hysteresis, so tiny touch jitters don't
      // flicker the bar.
      run = Math.sign(dy) === Math.sign(run) ? run + dy : dy;
      if (y < 80) setHidden(false);
      else if (run > 28) setHidden(true);
      else if (run < -18) setHidden(false);
    },
  });
</script>
