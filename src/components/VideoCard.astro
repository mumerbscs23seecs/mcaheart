---
import type { Video } from '../data/site';

interface Props { video: Video; index?: number }
const { video, index = 0 } = Astro.props;
---

{/*
  Click-to-load facade: we ship a static thumbnail and only inject the YouTube
  iframe on activation. No third-party script or cookie until the user asks.
*/}
<article
  class="vcard"
  data-reveal
  style={`--reveal-delay:${(index % 3) * 90}ms`}
>
  <button
    class="vcard__trigger"
    type="button"
    data-video-id={video.youtubeId}
    data-video-title={video.title}
    aria-label={`Play: ${video.title}`}
  >
    <span class="media vcard__media">
      <img
        src={video.thumb}
        alt=""
        loading={index < 3 ? 'eager' : 'lazy'}
        decoding="async"
        width="800"
        height="450"
      />
      <span class="vcard__play" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26">
          <path d="M8 5v14l11-7L8 5Z" />
        </svg>
      </span>
    </span>
  </button>

  <div class="vcard__body">
    <h3 class="vcard__title">{video.title}</h3>
    <p class="vcard__blurb">{video.blurb}</p>
  </div>
</article>

<style>
  .vcard {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0;
    overflow: hidden;
    transition: border-color 0.3s var(--ease);
  }
  .vcard:hover { border-color: var(--ink); }

  .vcard__trigger { display: block; width: 100%; padding: 0; }
  .vcard__media { display: block; aspect-ratio: 16 / 9; }
  .vcard__media img { width: 100%; height: 100%; object-fit: cover; }
  .vcard__media img { transition: transform 0.5s var(--ease); }
  .vcard:hover .vcard__media img { transform: scale(1.04); }

  .vcard__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--surface);
    transition: background 0.4s var(--ease);
    background: rgba(0, 0, 0, 0.18);
  }
  .vcard__play svg {
    padding: 0.85rem;
    box-sizing: content-box;
    background: var(--blue);
    border-radius: 0;
    transition: transform 0.45s var(--ease-out), background 0.35s var(--ease);
  }
  .vcard__trigger:hover .vcard__play { background: rgba(0, 0, 0, 0.32); }
  .vcard__trigger:hover .vcard__play svg { transform: scale(1.1); background: var(--blue-deep); }

  .vcard__body { padding: var(--space-s) var(--space-s) var(--space-m); }
  .vcard__title {
    font-size: var(--step-1);
    letter-spacing: -0.012em;
    font-weight: 700;
    line-height: 1.25;
  }
  .vcard__blurb {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--text-muted);
  }
</style>
