---
import { site, footerLinks } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="foot__bg" aria-hidden="true"></div>

  <div class="shell shell--wide foot__inner">
    <div class="foot__brand">
      <a class="wordmark" href="/" aria-label="MCA Heart — home">
      <span class="wordmark__badge" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M12 21s-8-5.2-8-10.6A4.4 4.4 0 0 1 12 7.6a4.4 4.4 0 0 1 8 2.8C20 15.8 12 21 12 21Z"/>
        </svg>
      </span>
      <span class="wordmark__text"><span class="wordmark__mca">MCA</span> <span class="wordmark__heart">HEART</span></span>
    </a>
      <p class="foot__tag">{site.tagline}</p>
      <a class="foot__yt" href={site.youtube} target="_blank" rel="noopener noreferrer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/>
        </svg>
        <span>Watch on YouTube</span>
      </a>
    </div>

    <nav class="foot__col" aria-labelledby="foot-quick">
      <h2 class="foot__head" id="foot-quick">Quick Links</h2>
      <ul class="foot__list">
        {footerLinks.quick.map((l) => (
          <li><a class="link-underline" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="foot__col" aria-labelledby="foot-other">
      <h2 class="foot__head" id="foot-other">Other Links</h2>
      <ul class="foot__list">
        {footerLinks.other.map((l) => (
          <li><a class="link-underline" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="foot__mark" aria-hidden="true">
      <img src="/assets/brand/heart-2.png" alt="" loading="lazy" decoding="async" width="360" height="360" />
    </div>
  </div>

  <div class="shell shell--wide foot__base">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <ul class="foot__legal">
      {footerLinks.legal.map((l) => (
        <li><a class="link-underline" href={l.href}>{l.label}</a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    isolation: isolate;
    background: var(--dark);
    color: rgba(248, 250, 252, 0.72);
    padding-top: var(--space-xl);
    overflow: hidden;
  }
  /* The old paper texture muddied the navy; a dot grid and a soft accent
     wash keep the footer in the palette. */
  .foot__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      radial-gradient(circle at 2px 2px, rgba(248, 250, 252, 0.06) 1px, transparent 0),
      radial-gradient(ellipse at 15% 0%, rgba(43, 57, 144, 0.55), transparent 60%),
      radial-gradient(ellipse at 90% 100%, rgba(158, 27, 30, 0.22), transparent 55%);
    background-size: 40px 40px, 100% 100%, 100% 100%;
  }

  .foot__inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr auto;
    gap: var(--space-l);
    align-items: start;
    padding-bottom: var(--space-l);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1;
  }

  .wordmark__badge {
    display: grid;
    place-items: center;
    width: 2.1em; height: 2.1em;
    flex-shrink: 0;
    color: #fff;
    background: linear-gradient(140deg, var(--blue), var(--red));
    border-radius: 0.55em;
    font-size: 0.66em;
    transition: transform 0.35s var(--ease);
  }
  .wordmark:hover .wordmark__badge { transform: scale(1.08); }
  .wordmark__text { display: inline-flex; gap: 0.32em; align-items: baseline; }
  .wordmark__mca { color: #8f9bd8; }
  .wordmark__heart { color: var(--on-dark); }

  .foot__tag {
    margin-top: var(--space-xs);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: rgba(248, 250, 252, 0.6);
    max-width: 22ch;
  }

  .foot__yt {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--space-m);
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--on-dark);
    transition: color 0.3s var(--ease);
  }
  .foot__yt:hover { color: #8f9bd8; }

  .foot__head {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #8f9bd8;
    margin-bottom: var(--space-s);
  }
  .foot__list { display: grid; gap: 0.7rem; font-size: var(--step--1); }
  .foot__list a { color: rgba(248, 250, 252, 0.78); }
  .foot__list a:hover { color: var(--on-dark); }

  .foot__mark { width: 180px; opacity: 0.5; justify-self: end; }
  .foot__mark img { width: 100%; height: auto; }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-s);
    border-top: 1px solid rgba(248, 250, 252, 0.14);
    font-size: var(--step--1);
    color: rgba(248, 250, 252, 0.55);
  }
  .foot__legal { display: flex; gap: var(--space-m); }

  @media (max-width: 1080px) {
    .foot__inner { grid-template-columns: 1.4fr 1fr 1fr; }
    .foot__mark { display: none; }
  }
  @media (max-width: 700px) {
    .foot__inner { grid-template-columns: 1fr 1fr; }
    .foot__brand { grid-column: 1 / -1; }
    .foot__base { justify-content: flex-start; }
  }
</style>
