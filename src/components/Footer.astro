---
import { site, footerLinks } from '../data/site';
import LogoMark from './LogoMark.astro';
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="shell shell--wide foot__inner">
    <div class="foot__brand">
      <a class="wordmark" href="/" aria-label="MCA Heart - home">
        <LogoMark size="3.6em" kind="wordmark" background="dark" />
      </a>
      <p class="foot__tag">{site.tagline}</p>
      <div class="foot__socials">
        <a class="foot__social" href={site.youtube} target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/>
          </svg>
          <span>Watch on YouTube</span>
        </a>
        <a class="foot__social" href={site.instagram} target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 3.9a5.94 5.94 0 1 0 0 11.88 5.94 5.94 0 0 0 0-11.88Zm0 9.8a3.86 3.86 0 1 1 0-7.72 3.86 3.86 0 0 1 0 7.72Zm6.16-10.04a1.39 1.39 0 1 1-2.77 0 1.39 1.39 0 0 1 2.77 0Z"/>
          </svg>
          <span>Follow on Instagram</span>
        </a>
        <a class="foot__social" href={site.x} target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
          <span>Follow on X</span>
        </a>
      </div>
    </div>

    <nav class="foot__col" aria-labelledby="foot-quick">
      <h2 class="foot__head" id="foot-quick">Quick Links</h2>
      <ul class="foot__list">
        {footerLinks.quick.map((l) => (
          <li><a class="link-underline" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="foot__col" aria-labelledby="foot-other">
      <h2 class="foot__head" id="foot-other">Other Links</h2>
      <ul class="foot__list">
        {footerLinks.other.map((l) => (
          <li><a class="link-underline" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="foot__mark" aria-hidden="true">
      <img src="/assets/brand/heart-2.png" alt="" loading="lazy" decoding="async" width="360" height="360" />
    </div>
  </div>

  <div class="shell shell--wide foot__base">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <ul class="foot__legal">
      {footerLinks.legal.map((l) => (
        <li><a class="link-underline" href={l.href}>{l.label}</a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    isolation: isolate;
    background: var(--dark);
    color: var(--on-dark);
    padding-top: var(--space-l);
    overflow: hidden;
  }

  .foot__inner {
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr auto;
    gap: var(--space-l);
    align-items: start;
    padding-block: var(--space-l);
    border-top: 2px solid var(--on-dark-strong);
  }

  .wordmark { display: inline-flex; align-items: center; }

  .foot__tag {
    margin-top: var(--space-s);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.015em;
    color: var(--on-dark-strong);
    max-width: 18ch;
    line-height: 1.15;
  }

  .foot__socials {
    display: grid;
    gap: 0.55rem;
    margin-top: var(--space-m);
  }
  .foot__social {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--on-dark-strong);
    transition: color 0.3s var(--ease);
  }
  .foot__social:hover { color: var(--on-dark-accent); }

  .foot__head {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--on-dark-faint);
    padding-bottom: 0.7rem;
    margin-bottom: var(--space-s);
    border-bottom: 1px solid var(--on-dark-border);
  }
  .foot__list { display: grid; gap: 0.7rem; font-size: 0.9rem; font-weight: 500; }
  .foot__list a { color: var(--on-dark); }
  .foot__list a:hover { color: var(--on-dark-strong); }

  .foot__mark { width: 180px; opacity: 0.5; justify-self: end; }
  .foot__mark img { width: 100%; height: auto; }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-s);
    border-top: 1px solid var(--on-dark-border);
    font-size: var(--step--1);
    color: var(--on-dark-faint);
  }
  .foot__legal { display: flex; gap: var(--space-m); }

  @media (max-width: 1080px) {
    .foot__inner { grid-template-columns: 1.4fr 1fr 1fr; }
    .foot__mark { display: none; }
  }
  @media (max-width: 700px) {
    .foot__inner { grid-template-columns: 1fr 1fr; }
    .foot__brand { grid-column: 1 / -1; }
    .foot__base { justify-content: flex-start; }
  }
</style>
