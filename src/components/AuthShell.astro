---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'MCA Research Group members area.' } = Astro.props;
const pageTitle = `${title} | ${site.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f8fafc" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=Hanken+Grotesque:ital,wght@0,300..800;1,300..600&display=swap"
    />
  </head>

  <body class="authbody">
    <main class="authpage">
      <div class="authpage__inner">
        <a class="authpage__brand" href="/" aria-label="MCA Heart — home">
          <span class="authpage__badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M12 21s-8-5.2-8-10.6A4.4 4.4 0 0 1 12 7.6a4.4 4.4 0 0 1 8 2.8C20 15.8 12 21 12 21Z"/>
            </svg>
          </span>
          <span class="authpage__word"><b>MCA</b> HEART</span>
        </a>

        <slot />

        <p class="authpage__foot"><a href="/">&larr; Back to main site</a></p>
      </div>
    </main>

    <style is:global>
      .authbody {
        min-height: 100dvh;
        background:
          radial-gradient(circle at 15% 0%, rgba(43, 57, 144, 0.06), transparent 45%),
          radial-gradient(circle at 90% 100%, rgba(158, 27, 30, 0.05), transparent 45%),
          var(--bg);
      }
      .authpage {
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: var(--space-l) var(--gutter);
      }
      .authpage__inner {
        width: 100%;
        max-width: 380px;
        display: grid;
        gap: var(--space-m);
      }

      .authpage__brand {
        justify-self: center;
        display: inline-flex;
        align-items: center;
        gap: 0.55em;
        font-family: var(--font-serif);
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--text-strong);
      }
      .authpage__brand b { color: var(--blue); font-weight: 700; }
      .authpage__badge {
        display: grid;
        place-items: center;
        width: 1.9em; height: 1.9em;
        color: #fff;
        background: linear-gradient(140deg, var(--blue), var(--red));
        border-radius: 0.5em;
      }

      /* --- The card --- */
      .auth-card {
        display: grid;
        gap: var(--space-s);
        padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.15rem);
        background: var(--surface);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius-lg);
        box-shadow: 0 24px 60px -34px rgba(43, 57, 144, 0.35);
      }
      .auth-card__title {
        font-size: 1.45rem;
        line-height: 1.2;
        color: var(--text-strong);
      }
      .auth-card__sub {
        margin-top: -0.55rem;
        font-size: 0.86rem;
        color: var(--text-muted);
      }

      .auth-field { display: grid; gap: 0.4rem; }
      .auth-field label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text);
      }
      .auth-field input {
        width: 100%;
        padding: 0.7rem 0.85rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font-size: 0.95rem;
        color: var(--text-strong);
      }
      .auth-field input:focus {
        outline: none;
        border-color: var(--blue);
        box-shadow: 0 0 0 3px rgba(43, 57, 144, 0.14);
      }

      .auth-card .btn {
        width: 100%;
        justify-content: center;
        margin-top: 0.3rem;
        padding-block: 0.8em;
      }

      .auth-card__link {
        justify-self: start;
        font-size: 0.85rem;
        color: var(--blue);
      }
      .auth-card__link:hover { text-decoration: underline; }

      .auth-card__lead { font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; }
      .auth-card__lead strong { color: var(--text-strong); }

      .auth-alert {
        padding: 0.65rem 0.85rem;
        border-radius: var(--radius);
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--red);
        background: rgba(158, 27, 30, 0.06);
        border: 1px solid rgba(158, 27, 30, 0.3);
      }
      .auth-ok-box {
        padding: 0.85rem 1rem;
        border-radius: var(--radius);
        font-size: 0.86rem;
        line-height: 1.6;
        color: #166534;
        background: rgba(22, 101, 52, 0.09);
        border: 1px solid rgba(22, 101, 52, 0.3);
      }
      .auth-linkbox {
        padding: 0.75rem 0.9rem;
        background: var(--bg-tint);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius);
        font-size: 0.78rem;
        line-height: 1.55;
        overflow-wrap: anywhere;
      }
      .auth-linkbox a { color: var(--blue); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }

      /* --- Below-card bits --- */
      .authpage__note {
        justify-self: center;
        text-align: center;
        font-size: 0.8rem;
        color: var(--text-muted);
      }
      .authpage__note a { color: var(--blue); }

      .authpage__demo {
        border: 1px solid var(--border-soft);
        border-radius: var(--radius);
        background: var(--surface);
        font-size: 0.8rem;
      }
      .authpage__demo summary {
        padding: 0.6rem 0.9rem;
        cursor: pointer;
        color: var(--text-muted);
        font-weight: 600;
        list-style: none;
      }
      .authpage__demo summary::-webkit-details-marker { display: none; }
      .authpage__demo summary::before { content: '▸ '; }
      .authpage__demo[open] summary::before { content: '▾ '; }
      .authpage__demo table { width: 100%; border-collapse: collapse; }
      .authpage__demo td {
        padding: 0.35rem 0.9rem 0.35rem 0;
        border-top: 1px solid var(--border-soft);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.76rem;
        color: var(--text);
      }
      .authpage__demo td:first-child { padding-left: 0.9rem; color: var(--text-muted); font-family: var(--font-sans); }

      .authpage__foot {
        justify-self: center;
        font-size: 0.8rem;
      }
      .authpage__foot a { color: var(--text-muted); }
      .authpage__foot a:hover { color: var(--blue); }
    </style>
  </body>
</html>
