---
import { pendingIdeaCount } from '../lib/ideas';
import { pendingApplicationCount } from '../lib/applications';
import { unreadRequestCount } from '../lib/requests';
import { hiddenProjectCount } from '../lib/hidden-papers';
import { getNotifications } from '../lib/notifications';
import ThemeToggle from './ThemeToggle.astro';
import LogoMark from './LogoMark.astro';

interface Props {
  active?: 'dashboard' | 'pipeline' | 'ideas' | 'applicants' | 'mentees' | 'requests' | 'testimonials' | 'hidden' | 'access' | 'tasks' | 'new-idea';
  name: string;
  role: string;
  email: string;
}
const { active, name, role, email } = Astro.props;

const isAdmin = role === 'admin';
const nameLetters = name.split(/\s+/).map((w) => w.match(/[A-Za-z]/)?.[0]).filter(Boolean) as string[];
const initials = ((nameLetters[0] ?? '?') + (nameLetters.length > 1 ? nameLetters[nameLetters.length - 1] : '')).toUpperCase();
const { items: notifs, unread } = await getNotifications(email);
const fmtNotif = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

// These three now hit Supabase (applications/ideas/contact_requests tables) -
// if the migration SQL hasn't been run yet, they throw. AppBar renders on
// every single admin page, so letting that propagate would 500 the entire
// admin area over one missing badge count. Degrade to 0 instead.
const safeCount = async (fn: () => Promise<number>) => {
  try {
    return await fn();
  } catch {
    return 0;
  }
};
const pendingIdeas = isAdmin ? await safeCount(pendingIdeaCount) : 0;
const pendingApps = isAdmin ? await safeCount(pendingApplicationCount) : 0;
const unreadRequests = isAdmin ? await safeCount(unreadRequestCount) : 0;
const hiddenCount = isAdmin ? await safeCount(hiddenProjectCount) : 0;

// Two kinds of entry: a plain link, or a dropdown ('menu') grouping a few
// related pages - Review (things waiting on a decision) and Manage
// (admin-only settings/content, not day-to-day pipeline work).
type NavLink = { type: 'link'; key: string; label: string; href: string; badge: number };
type NavMenu = { type: 'menu'; key: string; label: string; badge: number; items: Omit<NavLink, 'type'>[] };
const navItems: (NavLink | NavMenu)[] = isAdmin
  ? [
      { type: 'link', key: 'dashboard', label: 'Dashboard', href: '/admin', badge: 0 },
      { type: 'link', key: 'pipeline', label: 'Workflow', href: '/pipeline', badge: 0 },
      {
        type: 'menu', key: 'review', label: 'Review', badge: pendingIdeas + pendingApps + unreadRequests,
        items: [
          { key: 'ideas', label: 'Ideas', href: '/admin/ideas', badge: pendingIdeas },
          { key: 'applicants', label: 'Applicants', href: '/admin/applications', badge: pendingApps },
          { key: 'requests', label: 'Requests', href: '/admin/requests', badge: unreadRequests },
        ],
      },
      {
        type: 'menu', key: 'manage', label: 'Manage', badge: 0,
        items: [
          { key: 'access', label: 'Members', href: '/admin/access', badge: 0 },
          { key: 'testimonials', label: 'Testimonials', href: '/admin/testimonials', badge: 0 },
          { key: 'mentees', label: 'Mentees', href: '/admin/mentees', badge: 0 },
          { key: 'hidden', label: 'Hidden', href: '/admin/hidden', badge: hiddenCount },
          { key: 'tasks', label: 'Tasks', href: '/pipeline/tasks', badge: 0 },
        ],
      },
      { type: 'link', key: 'new-idea', label: 'New Idea', href: '/pipeline/ideas', badge: 0 },
    ]
  : [];
---

<header class="appbar">
  <div class="appbar__inner">
    <a class="appbar__brand" href="/" aria-label="MCA Heart - home">
      <LogoMark size="1.9em" />
      <span><b>MCA</b> HEART</span>
    </a>

    {navItems.length > 0 && (
      <nav class="appbar__nav" aria-label="Members">
        {navItems.map((item) =>
          item.type === 'link' ? (
            <a
              class:list={['appbar__link', active === item.key && 'is-active']}
              href={item.href}
              aria-current={active === item.key ? 'page' : undefined}
            >{item.label}{item.badge > 0 && <span class="appbar__badge-n">{item.badge}</span>}</a>
          ) : (
            <span class="appbar__menu" data-menu>
              <button
                type="button"
                class:list={['appbar__link', 'appbar__menu-trigger', item.items.some((s) => s.key === active) && 'is-active']}
                data-menu-toggle
                aria-haspopup="true"
                aria-expanded="false"
              >
                {item.label}
                {item.badge > 0 && <span class="appbar__badge-n">{item.badge}</span>}
                <svg class="appbar__menu-chev" viewBox="0 0 20 20" width="12" height="12" aria-hidden="true">
                  <path fill="none" stroke="currentColor" stroke-width="1.8" d="m5 7.5 5 5 5-5" />
                </svg>
              </button>
              <div class="appbar__menu-panel" data-menu-panel hidden>
                {item.items.map((sub) => (
                  <a
                    class:list={['appbar__menu-item', active === sub.key && 'is-active']}
                    href={sub.href}
                    aria-current={active === sub.key ? 'page' : undefined}
                  >{sub.label}{sub.badge > 0 && <span class="appbar__badge-n">{sub.badge}</span>}</a>
                ))}
              </div>
            </span>
          ),
        )}
      </nav>
    )}

    <div class="appbar__account">
      <span class="nbell" data-nbell>
        <button type="button" class="nbell__btn" data-nbell-toggle aria-label="Notifications" aria-expanded="false">
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M10 2a5 5 0 0 0-5 5v3.2l-1.4 2.5A1 1 0 0 0 4.5 16h11a1 1 0 0 0 .9-1.3L15 10.2V7a5 5 0 0 0-5-5Zm0 16a2.5 2.5 0 0 0 2.4-1.8H7.6A2.5 2.5 0 0 0 10 18Z"
            />
          </svg>
          {unread > 0 && <span class="nbell__dot" data-nbell-count>{unread > 9 ? '9+' : unread}</span>}
        </button>
        <div class="nbell__panel" data-nbell-panel hidden>
          <p class="nbell__head">Notifications</p>
          {notifs.length === 0 && <p class="nbell__empty">Nothing yet.</p>}
          {notifs.map((n) => (
            <a class:list={['nbell__item', !n.read_at && 'is-unread']} href={n.link ?? '#'}>
              <b>{n.title}</b>
              {n.body && <span>{n.body}</span>}
              <time>{fmtNotif(n.created_at)}</time>
            </a>
          ))}
        </div>
      </span>

      <span class="acct" data-acct>
        <button type="button" class="acct__trigger" data-acct-toggle aria-haspopup="true" aria-expanded="false">
          <span class="acct__avatar">{initials}</span>
          <svg class="acct__chev" viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-width="1.8" d="m5 7.5 5 5 5-5" />
          </svg>
        </button>
        <div class="acct__panel" data-acct-panel hidden>
          <div class="acct__head">
            <span class="acct__avatar acct__avatar--lg">{initials}</span>
            <span class="acct__id">
              <b>{name}</b>
              <em>{role}</em>
            </span>
          </div>
          <hr class="acct__rule" />
          <a class="acct__signout" href="/account/password">
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
              <rect x="4" y="9" width="12" height="8" rx="1" fill="none" stroke="currentColor" stroke-width="1.6" />
              <path fill="none" stroke="currentColor" stroke-width="1.6" d="M7 9V6.5a3 3 0 0 1 6 0V9" />
            </svg>
            Change password
          </a>
          <form method="post" action="/logout">
            <button class="acct__signout" type="submit">
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
                <path fill="none" stroke="currentColor" stroke-width="1.6" d="M8 3.5H4.5a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1H8" />
                <path fill="none" stroke="currentColor" stroke-width="1.6" d="M9 10h7.5m0 0-3-3m3 3-3 3" />
              </svg>
              Sign out
            </button>
          </form>
        </div>
      </span>

      <span class="appbar__divider" aria-hidden="true"></span>
      <ThemeToggle />
    </div>
  </div>
</header>

<style is:global>
  .appbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--ink);
  }
  .appbar__inner {
    max-width: 1400px;
    margin-inline: auto;
    padding: 0 var(--gutter);
    height: 60px;
    display: grid;
    /* 1fr / auto / 1fr, not auto / 1fr / auto - the brand and account groups
       are different widths, so giving them the equal flexible columns (and
       the nav the auto one, sized to its own content) is what makes the nav
       truly centered on the bar instead of centered only within whatever
       space happens to be left between two unevenly sized neighbors. */
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: clamp(0.75rem, 0.3rem + 1.6vw, 2rem);
  }
  .appbar__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--text-strong);
    flex-shrink: 0;
  }
  .appbar__brand b { color: var(--blue); font-weight: 800; }

  /* More tabs have been added over time than reliably fit next to the account
     area (bell/name/logout/theme) at laptop-window widths - min-width: 0 lets
     this flex item actually shrink instead of forcing the whole bar, and the
     page under it, wider than the viewport; overflow-x makes the tab strip
     itself the thing that scrolls, so account controls stay fully visible. */
  .appbar__nav {
    display: flex; align-items: stretch; justify-content: center;
    gap: clamp(1rem, 0.5rem + 1.6vw, 2rem);
    min-width: 0;
    /* No overflow-x:auto here on purpose: setting one overflow axis to
       anything but 'visible' forces the browser to treat the OTHER axis
       as 'auto' too (CSS spec, not a bug) - that silently clipped the
       Review/Manage dropdown panels below, even though they measured as
       on-screen and were clickable in automated tests. Down to 5 top-level
       items now (was 8-9 when this was added), they fit without scrolling. */
  }
  .appbar__link {
    display: inline-flex;
    align-items: center;
    padding: 0 0.15rem;
    font-size: 0.86rem;
    font-weight: 800;
    color: var(--text-strong);
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease);
  }
  .appbar__link:hover { color: var(--blue); }
  .appbar__link.is-active { border-bottom-color: var(--blue); }
  /* dropdown nav items (Review, Manage) - same trigger look as a plain
     .appbar__link, a small caret added, and a panel that follows the
     .acct/.nbell open/close pattern below. */
  .appbar__menu { position: relative; display: inline-flex; align-items: stretch; }
  .appbar__menu-trigger {
    /* font-family only, not the `font` shorthand - that resets EVERY font
       property (weight, size...) back to what a <button> inherits by
       default, wiping the bold/size .appbar__link already set below and
       leaving Review/Manage looking lighter than the plain nav links. */
    background: none; border: 0; cursor: pointer; font-family: inherit;
    gap: 0.3em;
  }
  .appbar__menu-chev { color: var(--text-muted); transition: transform 0.15s var(--ease); flex-shrink: 0; }
  .appbar__menu.is-open .appbar__menu-chev { transform: rotate(180deg); }
  .appbar__menu-panel {
    position: absolute; top: calc(100% + 10px); left: 50%; translate: -50% 0; z-index: 130;
    min-width: 170px; padding: 0.4rem;
    background: var(--surface); border: 1px solid var(--border-soft); border-radius: 14px;
    box-shadow: 0 10px 30px rgba(20, 20, 18, 0.14);
  }
  .appbar__menu-panel[hidden] { display: none; }
  .appbar__menu-item {
    display: flex; align-items: center; justify-content: space-between; gap: 0.6rem;
    padding: 0.55rem 0.6rem; border-radius: 9px;
    font-size: 0.86rem; font-weight: 700; color: var(--text-strong);
  }
  .appbar__menu-item:hover { background: var(--bg-tint); }
  .appbar__menu-item.is-active { color: var(--blue); }
  .appbar__badge-n {
    display: inline-grid;
    place-items: center;
    min-width: 1.3em;
    height: 1.3em;
    margin-left: 0.4em;
    padding: 0 0.35em;
    font-size: 0.68rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: #fff;
    background: var(--blue);
    border-radius: 999px;
  }

  .appbar__account { margin-left: auto; display: flex; align-items: center; gap: 0.9rem; flex-shrink: 0; }

  /* notification bell */
  .nbell { position: relative; display: inline-flex; }
  .nbell__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px; height: 32px;
    border: 0; background: none;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: 0;
  }
  .nbell__btn:hover, .nbell.is-open .nbell__btn { color: var(--blue); background: var(--bg-tint); }
  .nbell__dot {
    position: absolute;
    top: -2px; right: -3px;
    min-width: 16px; height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--blue);
    color: #fff;
    font: 700 0.62rem/16px var(--font-sans);
    font-variant-numeric: tabular-nums;
    text-align: center;
    box-shadow: 0 0 0 2px var(--bg);
  }
  .nbell__panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: min(360px, 88vw);
    max-height: 70vh;
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--ink);
    border-radius: 0;
    z-index: 130;
  }
  .nbell__panel[hidden] { display: none; }
  .nbell__head {
    margin: 0;
    padding: 12px 16px;
    font: 700 0.68rem/1 var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-soft);
  }
  .nbell__empty { margin: 0; padding: 20px 16px; font-size: 0.85rem; color: var(--text-muted); }
  .nbell__item {
    display: block;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-soft);
    color: inherit;
  }
  .nbell__item:last-child { border-bottom: 0; }
  .nbell__item:hover { background: var(--bg-tint); }
  .nbell__item.is-unread { background: var(--accent-wash); }
  .nbell__item b { display: block; font-size: 0.85rem; font-weight: 700; color: var(--text-strong); }
  .nbell__item span { display: block; font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; }
  .nbell__item time { display: block; font-size: 0.72rem; color: var(--text-faint); margin-top: 4px; }
  .appbar__divider { width: 1px; height: 26px; background: var(--border-soft); flex-shrink: 0; }

  /* ---------- account menu ---------- */
  .acct { position: relative; }
  .acct__trigger {
    display: inline-flex; align-items: center; gap: 0.35rem;
    padding: 0.3rem 0.55rem 0.3rem 0.3rem;
    background: var(--accent-wash);
    border: 0; border-radius: 999px;
    color: var(--text);
    cursor: pointer;
  }
  .acct__trigger:hover { background: var(--accent-wash-strong); }
  .acct__chev { color: var(--text-muted); transition: transform 0.15s var(--ease); }
  .acct.is-open .acct__chev { transform: rotate(180deg); }

  .acct__avatar {
    display: grid; place-items: center;
    width: 30px; height: 30px; border-radius: 50%;
    background: var(--accent-wash-strong); color: var(--blue);
    font-size: 0.74rem; font-weight: 800; letter-spacing: 0.01em;
    flex-shrink: 0;
  }
  .acct__avatar--lg { width: 42px; height: 42px; font-size: 0.9rem; }

  .acct__panel {
    position: absolute; top: calc(100% + 10px); right: 0; z-index: 130;
    width: 240px; padding: 0.9rem;
    background: var(--surface); border: 1px solid var(--border-soft); border-radius: 14px;
    box-shadow: 0 10px 30px rgba(20, 20, 18, 0.14);
  }
  .acct__panel[hidden] { display: none; }
  .acct__head { display: flex; align-items: center; gap: 0.7rem; }
  .acct__id { display: grid; min-width: 0; }
  .acct__id b { font-size: 1rem; font-weight: 700; color: var(--text-strong); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .acct__id em { font-style: normal; font-size: 0.82rem; color: var(--text-muted); }

  .acct__rule { border: 0; border-top: 1px solid var(--border-soft); margin: 0.8rem 0; }

  .acct__signout {
    width: 100%; display: flex; align-items: center; gap: 0.6rem;
    padding: 0.55rem 0.4rem; border-radius: 9px;
    background: none; border: 0; cursor: pointer;
    font-size: 0.9rem; font-weight: 600; color: var(--text-strong);
  }
  .acct__signout:hover { background: var(--bg-tint); }

  @media (max-width: 720px) {
    /* Centering the nav only makes sense once there's slack room either
       side of it - below this width it goes back to stacked flex rows
       (brand, then nav, then account), same as before today's change. */
    .appbar__inner { display: flex; flex-wrap: wrap; height: auto; gap: 0.5rem; padding-block: 0.5rem; }
    .appbar__account { width: 100%; }
    /* flex-wrap: wrap (not the base row's nowrap+scroll) - needed so a
       dropdown trigger can actually get its own full-width line to expand
       its panel into below, instead of staying pinned to a narrow column
       inside what's otherwise still a single scrollable row. */
    .appbar__nav { width: 100%; justify-content: flex-start; flex-wrap: wrap; }
    /* The account cluster sits left-aligned on its own row at this width,
       not flush against the viewport edge - anchoring a panel's right edge
       (correct on desktop, where the cluster IS flush right) pushes it off
       the left side of the screen instead. Open both panels from the
       trigger's left edge here. (nbell__panel had this bug before today -
       same root cause, same fix, so it's included here too.) */
    .acct__panel, .nbell__panel { left: 0; right: auto; }
    /* Review/Manage sit mid-row in the wrapped nav, not pinned to an edge
       like the account/bell triggers - left:0 (their fix) isn't enough,
       since it's relative to wherever the trigger itself landed, which
       still overflows when that's already near the right edge. Expand the
       panel inline instead of floating it, so it can never go off-screen. */
    .appbar__menu { flex-direction: column; width: 100%; }
    .appbar__menu-panel {
      position: static; translate: none; margin-top: 4px;
      width: 100%; box-shadow: none;
    }
  }
</style>

<script is:inline>
  (() => {
    // One open/close/outside-click/Escape behavior shared by the notification
    // bell and the account menu, so adding the account menu didn't mean a
    // second copy of this logic.
    function setupMenu(root, toggle, panel, onOpen) {
      if (!root || !toggle || !panel) return;
      let open = false;
      function setOpen(v) {
        open = v;
        panel.hidden = !v;
        root.classList.toggle('is-open', v);
        toggle.setAttribute('aria-expanded', String(v));
        if (v && onOpen) onOpen();
      }
      toggle.addEventListener('click', () => {
        // No stopPropagation - the click must still reach document so any
        // OTHER open menu's own outside-click listener sees it and closes.
        setOpen(!open);
      });
      document.addEventListener('click', (e) => {
        if (open && !root.contains(e.target)) setOpen(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && open) setOpen(false);
      });
    }

    const bell = document.querySelector('[data-nbell]');
    if (bell) {
      const dot = bell.querySelector('[data-nbell-count]');
      setupMenu(bell, bell.querySelector('[data-nbell-toggle]'), bell.querySelector('[data-nbell-panel]'), () => {
        if (!dot) return;
        fetch('/admin/notifications/read', { method: 'POST' })
          .then(() => {
            dot.remove();
            bell.querySelectorAll('.nbell__item.is-unread').forEach((e) => e.classList.remove('is-unread'));
          })
          .catch(() => {});
      });
    }

    const acct = document.querySelector('[data-acct]');
    if (acct) {
      setupMenu(acct, acct.querySelector('[data-acct-toggle]'), acct.querySelector('[data-acct-panel]'));
    }

    document.querySelectorAll('[data-menu]').forEach((menu) => {
      setupMenu(menu, menu.querySelector('[data-menu-toggle]'), menu.querySelector('[data-menu-panel]'));
    });
  })();
</script>
