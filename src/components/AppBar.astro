---
import { pendingIdeaCount } from '../lib/ideas';
import { pendingApplicationCount } from '../lib/applications';
import { unreadRequestCount } from '../lib/requests';
import { getNotifications } from '../lib/notifications';
import ThemeToggle from './ThemeToggle.astro';
import LogoMark from './LogoMark.astro';

interface Props {
  active?: 'dashboard' | 'pipeline' | 'ideas' | 'applicants' | 'requests' | 'access';
  name: string;
  role: string;
  email: string;
}
const { active, name, role, email } = Astro.props;

const isAdmin = role === 'admin';
const { items: notifs, unread } = await getNotifications(email);
const fmtNotif = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

const pendingIdeas = isAdmin ? pendingIdeaCount() : 0;
const pendingApps = isAdmin ? pendingApplicationCount() : 0;
const unreadRequests = isAdmin ? unreadRequestCount() : 0;
const navItems = isAdmin
  ? [
      { key: 'dashboard', label: 'Dashboard', href: '/admin', badge: 0 },
      { key: 'pipeline', label: 'Pipeline', href: '/pipeline', badge: 0 },
      { key: 'ideas', label: 'Ideas', href: '/admin/ideas', badge: pendingIdeas },
      { key: 'applicants', label: 'Applicants', href: '/admin/applications', badge: pendingApps },
      { key: 'requests', label: 'Requests', href: '/admin/requests', badge: unreadRequests },
      { key: 'access', label: 'Access', href: '/admin/access', badge: 0 },
    ]
  : [];
---

<header class="appbar">
  <div class="appbar__inner">
    <a class="appbar__brand" href="/" aria-label="MCA Heart - home">
      <LogoMark size="1.9em" />
      <span><b>MCA</b> HEART</span>
    </a>

    {navItems.length > 0 && (
      <nav class="appbar__nav" aria-label="Members">
        {navItems.map((item) => (
          <a
            class:list={['appbar__link', active === item.key && 'is-active']}
            href={item.href}
            aria-current={active === item.key ? 'page' : undefined}
          >{item.label}{item.badge > 0 && <span class="appbar__badge-n">{item.badge}</span>}</a>
        ))}
      </nav>
    )}

    <div class="appbar__account">
      <span class="nbell" data-nbell>
        <button type="button" class="nbell__btn" data-nbell-toggle aria-label="Notifications" aria-expanded="false">
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M10 2a5 5 0 0 0-5 5v3.2l-1.4 2.5A1 1 0 0 0 4.5 16h11a1 1 0 0 0 .9-1.3L15 10.2V7a5 5 0 0 0-5-5Zm0 16a2.5 2.5 0 0 0 2.4-1.8H7.6A2.5 2.5 0 0 0 10 18Z"
            />
          </svg>
          {unread > 0 && <span class="nbell__dot" data-nbell-count>{unread > 9 ? '9+' : unread}</span>}
        </button>
        <div class="nbell__panel" data-nbell-panel hidden>
          <p class="nbell__head">Notifications</p>
          {notifs.length === 0 && <p class="nbell__empty">Nothing yet.</p>}
          {notifs.map((n) => (
            <a class:list={['nbell__item', !n.read_at && 'is-unread']} href={n.link ?? '#'}>
              <b>{n.title}</b>
              {n.body && <span>{n.body}</span>}
              <time>{fmtNotif(n.created_at)}</time>
            </a>
          ))}
        </div>
      </span>

      <span class="appbar__user">{name} <em>({role})</em></span>
      <form method="post" action="/logout">
        <button class="appbar__logout" type="submit">Log out</button>
      </form>
      <ThemeToggle />
    </div>
  </div>
</header>

<style is:global>
  .appbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--ink);
  }
  .appbar__inner {
    max-width: 1400px;
    margin-inline: auto;
    padding: 0 var(--gutter);
    height: 60px;
    display: flex;
    align-items: stretch;
    gap: clamp(0.75rem, 0.3rem + 1.6vw, 2rem);
  }
  .appbar__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--text-strong);
    flex-shrink: 0;
  }
  .appbar__brand b { color: var(--blue); font-weight: 800; }

  .appbar__nav { display: flex; align-items: stretch; gap: clamp(0.1rem, 0.6vw, 0.6rem); }
  .appbar__link {
    display: inline-flex;
    align-items: center;
    padding: 0 0.45rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease);
  }
  .appbar__link:hover { color: var(--text-strong); }
  .appbar__link.is-active { color: var(--text-strong); border-bottom-color: var(--blue); }
  .appbar__badge-n {
    display: inline-grid;
    place-items: center;
    min-width: 1.3em;
    height: 1.3em;
    margin-left: 0.4em;
    padding: 0 0.35em;
    font-size: 0.68rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: #fff;
    background: var(--blue);
    border-radius: 999px;
  }

  .appbar__account { margin-left: auto; display: flex; align-items: center; gap: 0.9rem; flex-shrink: 0; }

  /* notification bell */
  .nbell { position: relative; display: inline-flex; }
  .nbell__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px; height: 32px;
    border: 0; background: none;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: 0;
  }
  .nbell__btn:hover, .nbell.is-open .nbell__btn { color: var(--blue); background: var(--bg-tint); }
  .nbell__dot {
    position: absolute;
    top: -2px; right: -3px;
    min-width: 16px; height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--blue);
    color: #fff;
    font: 700 0.62rem/16px var(--font-sans);
    font-variant-numeric: tabular-nums;
    text-align: center;
    box-shadow: 0 0 0 2px var(--bg);
  }
  .nbell__panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: min(360px, 88vw);
    max-height: 70vh;
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--ink);
    border-radius: 0;
    z-index: 130;
  }
  .nbell__panel[hidden] { display: none; }
  .nbell__head {
    margin: 0;
    padding: 12px 16px;
    font: 700 0.68rem/1 var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-soft);
  }
  .nbell__empty { margin: 0; padding: 20px 16px; font-size: 0.85rem; color: var(--text-muted); }
  .nbell__item {
    display: block;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-soft);
    color: inherit;
  }
  .nbell__item:last-child { border-bottom: 0; }
  .nbell__item:hover { background: var(--bg-tint); }
  .nbell__item.is-unread { background: var(--accent-wash); }
  .nbell__item b { display: block; font-size: 0.85rem; font-weight: 700; color: var(--text-strong); }
  .nbell__item span { display: block; font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; }
  .nbell__item time { display: block; font-size: 0.72rem; color: var(--text-faint); margin-top: 4px; }
  .appbar__user {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text);
    max-width: 22ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .appbar__user em { font-style: normal; font-weight: 500; color: var(--text-faint); }
  .appbar__logout {
    padding: 0.42rem 0.9rem;
    border: 1px solid var(--ink);
    border-radius: 0;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink);
    background: transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s var(--ease), color 0.15s var(--ease);
  }
  .appbar__logout:hover { background: var(--ink); color: var(--bg); }

  @media (max-width: 720px) {
    .appbar__inner { height: auto; flex-wrap: wrap; gap: 0.5rem; padding-block: 0.5rem; }
    .appbar__account { width: 100%; }
    .appbar__user { display: none; }
    /* Five nav links no longer fit one row at phone widths - scroll them
       horizontally (same fix as the pipeline tab strip) instead of letting
       them spill past the viewport and force the whole page to scroll sideways. */
    .appbar__nav {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .appbar__nav::-webkit-scrollbar { display: none; }
  }
</style>

<script is:inline>
  (() => {
    const bell = document.querySelector('[data-nbell]');
    if (!bell) return;
    const btn = bell.querySelector('[data-nbell-toggle]');
    const panel = bell.querySelector('[data-nbell-panel]');
    const dot = bell.querySelector('[data-nbell-count]');
    let open = false;

    function setOpen(v) {
      open = v;
      panel.hidden = !v;
      bell.classList.toggle('is-open', v);
      btn.setAttribute('aria-expanded', String(v));
      if (v && dot) {
        fetch('/admin/notifications/read', { method: 'POST' })
          .then(() => {
            dot.remove();
            bell.querySelectorAll('.nbell__item.is-unread').forEach((e) => e.classList.remove('is-unread'));
          })
          .catch(() => {});
      }
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(!open);
    });
    document.addEventListener('click', (e) => {
      if (open && !bell.contains(e.target)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) setOpen(false);
    });
  })();
</script>
