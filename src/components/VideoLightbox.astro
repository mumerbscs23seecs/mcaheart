---
// Single shared player for every [data-video-id] trigger on the page.
---

<dialog class="lb" data-lightbox aria-label="Video player">
  <button class="lb__close" type="button" data-lb-close aria-label="Close video">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7">
      <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
    </svg>
  </button>
  <div class="lb__frame" data-lb-frame></div>
  <p class="lb__caption" data-lb-caption></p>
</dialog>

<style>
  .lb {
    width: min(1100px, 92vw);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--on-dark);
    overflow: visible;
  }
  .lb::backdrop { background: rgba(12, 9, 7, 0.9); backdrop-filter: blur(3px); }

  .lb__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0;
    overflow: hidden;
  }
  .lb__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .lb__caption {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.75);
  }

  .lb__close {
    position: absolute;
    top: -3rem;
    right: 0;
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--on-dark);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 0;
    transition: background 0.3s var(--ease);
  }
  .lb__close:hover { background: var(--blue); border-color: var(--blue); }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const frame = document.querySelector<HTMLElement>('[data-lb-frame]');
  const caption = document.querySelector<HTMLElement>('[data-lb-caption]');

  if (dialog && frame && caption) {
    const open = (id: string, title: string) => {
      // youtube-nocookie keeps this out of the ad-tracking cookie jar.
      frame.innerHTML =
        `<iframe src="https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0"` +
        ` title="${title.replace(/"/g, '&quot;')}" allow="accelerometer; autoplay; clipboard-write;` +
        ` encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
      caption.textContent = title;
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      frame.innerHTML = '';           // stop playback
      document.body.style.overflow = '';
    };

    document.querySelectorAll<HTMLElement>('[data-video-id]').forEach((btn) => {
      btn.addEventListener('click', () =>
        open(btn.dataset.videoId!, btn.dataset.videoTitle ?? 'Video'),
      );
    });

    dialog.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', close);
    // Click on the backdrop (outside the dialog box) closes it.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  }
</script>
