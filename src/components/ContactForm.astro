---
import { INTENT_LABELS, VISA_OPTIONS, OBS_CV } from '../lib/contact-schema';

const mb = (b: number) => `${Math.round(b / 1024 / 1024)} MB`;
const intents = Object.entries(INTENT_LABELS) as [keyof typeof INTENT_LABELS, string][];
---

<form
  class="cform"
  action="/api/contact"
  method="post"
  enctype="multipart/form-data"
  novalidate
  data-contact-form
>
  <div class="cform__row">
    <div class="field">
      <label class="field__label" for="fullName">Full name <span aria-hidden="true">*</span></label>
      <input class="field__input" id="fullName" name="fullName" type="text"
             autocomplete="name" required maxlength="120" />
      <p class="field__error" data-error-for="fullName" hidden></p>
    </div>

    <div class="field">
      <label class="field__label" for="email">Email <span aria-hidden="true">*</span></label>
      <input class="field__input" id="email" name="email" type="email"
             autocomplete="email" required maxlength="200" />
      <p class="field__error" data-error-for="email" hidden></p>
    </div>
  </div>

  <div class="cform__row">
    <div class="field">
      <label class="field__label" for="phone">Phone</label>
      <input class="field__input" id="phone" name="phone" type="tel"
             autocomplete="tel" maxlength="40" />
      <p class="field__error" data-error-for="phone" hidden></p>
    </div>

    <div class="field">
      <label class="field__label" for="location">Location</label>
      <input class="field__input" id="location" name="location" type="text"
             autocomplete="address-level2" maxlength="160" />
      <p class="field__error" data-error-for="location" hidden></p>
    </div>
  </div>

  <div class="field">
    <label class="field__label" for="designation">Designation</label>
    <input class="field__input" id="designation" name="designation" type="text"
           autocomplete="organization-title" maxlength="160"
           placeholder="e.g. IM Resident, Interventional Fellow, Medical Student" />
    <p class="field__error" data-error-for="designation" hidden></p>
  </div>

  <fieldset class="field choices">
    <legend class="field__label">Why are you getting in touch? <span aria-hidden="true">*</span></legend>
    {intents.map(([value, label], i) => (
      <label class="choice">
        <input type="radio" name="intent" value={value} required checked={i === 0} data-intent-radio />
        <span class="choice__mark" aria-hidden="true"></span>
        <span class="choice__text">{label}</span>
      </label>
    ))}
    <p class="field__error" data-error-for="intent" hidden></p>
  </fieldset>

  {/* ------------------------------------------------------- Collaboration */}
  <div class="cform__panel" data-intent-panel="collaborate">
    <div class="field">
      <label class="field__label" for="message">How can we help? <span aria-hidden="true">*</span></label>
      <textarea class="field__input field__input--area" id="message" name="message"
                rows="6" maxlength="4000"
                placeholder="Example: I am a PGY-2 IM resident interested in joining the MCA Heart Research Lab."></textarea>
      <p class="field__error" data-error-for="message" hidden></p>
    </div>
  </div>

  {/* --------------------------------------------------- Recommendation */}
  <div class="cform__panel" data-intent-panel="recommendation" hidden>
    <div class="field">
      <label class="field__label" for="recName">Full name <span aria-hidden="true">*</span></label>
      <p class="field__help">We'll add a few more questions here soon - for now, your name is enough to get started.</p>
      <input class="field__input" id="recName" name="recName" type="text" maxlength="120" />
      <p class="field__error" data-error-for="recName" hidden></p>
    </div>
  </div>

  {/* ---------------------------------------------------- Observership */}
  <div class="cform__panel" data-intent-panel="observership" hidden>
    <div class="field">
      <label class="field__label" for="obsName">What is your name? <span aria-hidden="true">*</span></label>
      <input class="field__input" id="obsName" name="obsName" type="text" maxlength="120" />
      <p class="field__error" data-error-for="obsName" hidden></p>
    </div>

    <div class="field">
      <label class="field__label" for="obsApplyDate">
        When do you plan to apply for Internal Medicine match? <span aria-hidden="true">*</span>
      </label>
      <p class="field__help">Mention the year, e.g. Sept 2027.</p>
      <input class="field__input" id="obsApplyDate" name="obsApplyDate" type="text" maxlength="60" placeholder="e.g. Sept 2027" />
      <p class="field__error" data-error-for="obsApplyDate" hidden></p>
    </div>

    <fieldset class="field choices">
      <legend class="field__label">Would you be needing a letter confirming the rotation? <span aria-hidden="true">*</span></legend>
      <label class="choice">
        <input type="radio" name="obsNeedsLetter" value="yes" />
        <span class="choice__mark" aria-hidden="true"></span>
        <span class="choice__text">Yes</span>
      </label>
      <label class="choice">
        <input type="radio" name="obsNeedsLetter" value="no" />
        <span class="choice__mark" aria-hidden="true"></span>
        <span class="choice__text">No</span>
      </label>
      <p class="field__error" data-error-for="obsNeedsLetter" hidden></p>
    </fieldset>

    <div class="field">
      <label class="field__label" for="obsStatus">
        Please tell your exact professional status <span aria-hidden="true">*</span>
      </label>
      <p class="field__help">E.g. Graduate from XYZ school planning to apply for IM residency.</p>
      <textarea class="field__input field__input--area" id="obsStatus" name="obsStatus" rows="3" maxlength="2000"></textarea>
      <p class="field__error" data-error-for="obsStatus" hidden></p>
    </div>

    <div class="field">
      <label class="field__label" for="obsUsmle">Have you completed any USMLEs?</label>
      <p class="field__help">If so, please mention the ones taken. Mentioning scores is not compulsory though encouraged.</p>
      <textarea class="field__input field__input--area" id="obsUsmle" name="obsUsmle" rows="3" maxlength="2000"></textarea>
      <p class="field__error" data-error-for="obsUsmle" hidden></p>
    </div>

    <fieldset class="field choices">
      <legend class="field__label">Please choose what best suits you <span aria-hidden="true">*</span></legend>
      {VISA_OPTIONS.map((v) => (
        <label class="choice">
          <input type="radio" name="obsVisa" value={v} />
          <span class="choice__mark" aria-hidden="true"></span>
          <span class="choice__text">{v}</span>
        </label>
      ))}
      <p class="field__error" data-error-for="obsVisa" hidden></p>
    </fieldset>

    <div class="field">
      <label class="field__label" for="obsGradYear">What is your Year of graduation? <span aria-hidden="true">*</span></label>
      <input class="field__input" id="obsGradYear" name="obsGradYear" type="text" maxlength="40" />
      <p class="field__error" data-error-for="obsGradYear" hidden></p>
    </div>

    <div class="cform__row">
      <div class="field">
        <label class="field__label" for="obsStart">Intended rotation start <span aria-hidden="true">*</span></label>
        <input class="field__input" id="obsStart" name="obsStart" type="date" />
        <p class="field__error" data-error-for="obsStart" hidden></p>
      </div>
      <div class="field">
        <label class="field__label" for="obsEnd">Intended rotation end <span aria-hidden="true">*</span></label>
        <input class="field__input" id="obsEnd" name="obsEnd" type="date" />
        <p class="field__error" data-error-for="obsEnd" hidden></p>
      </div>
    </div>
    <p class="field__help">
      Please be advised that while we will try our best to give you the rotation at the intended
      dates, we may reach out to you with alternative dates in case the requested dates are not
      available.
    </p>

    <div class="field">
      <label class="field__label" for="obsCv">Please attach your CV</label>
      <p class="field__help">PDF or Word, up to {mb(OBS_CV.maxBytes)}.</p>
      <input class="field__file" id="obsCv" name="obsCv" type="file" accept={OBS_CV.extensions.join(',')} />
      <p class="field__error" data-error-for="obsCv" hidden></p>
    </div>
  </div>

  {/* Honeypot - hidden from people, tempting to bots. */}
  <div class="hp" aria-hidden="true">
    <label for="company">Company</label>
    <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="cform__foot">
    <button class="btn cform__submit" type="submit" data-submit>
      <span data-submit-label>Submit enquiry</span>
      <span class="btn__arrow" aria-hidden="true">&rarr;</span>
    </button>
    <p class="cform__small">We reply to most enquiries within a few working days.</p>
  </div>

  <p class="cform__status" role="status" aria-live="polite" data-status hidden></p>
</form>

<style>
  .cform {
    display: grid;
    gap: var(--space-m);
    padding: clamp(1.4rem, 1rem + 2vw, 2.6rem);
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
  }

  .cform__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
  }
  @media (max-width: 620px) { .cform__row { grid-template-columns: 1fr; } }

  .field { display: grid; gap: 0.5rem; border: 0; padding: 0; margin: 0; min-width: 0; }

  .field__label {
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text);
    padding: 0;
  }
  .field__label span { color: var(--blue); }
  .field__help { font-size: 0.82rem; line-height: 1.5; color: var(--text-muted); margin: -0.15rem 0 0; }

  .field__input {
    width: 100%;
    padding: 0.9rem 1rem;
    background: var(--bg);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    font-size: var(--step-0);
    color: var(--text-strong);
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease),
                box-shadow 0.3s var(--ease);
  }
  .field__input::placeholder { color: var(--text-hint); opacity: 1; }
  .field__input:focus {
    outline: none;
    background: var(--surface);
    border-color: var(--blue);
    box-shadow: 0 0 0 3px var(--accent-wash-strong);
  }
  .field__input--area { resize: vertical; min-height: 8rem; line-height: 1.6; }

  .field__input[aria-invalid='true'] {
    border-color: var(--red);
    background: var(--red-wash);
  }

  .field__file {
    width: 100%;
    padding: 0.7rem 0.9rem;
    background: var(--bg);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    font-size: var(--step--1);
    color: var(--text-strong);
  }
  .field__file[aria-invalid='true'] { border-color: var(--red); background: var(--red-wash); }

  .field__error {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--red);
  }

  /* --- Conditional intent panels --- */
  .cform__panel { display: grid; gap: var(--space-m); }
  .cform__panel[hidden] { display: none; }

  /* --- Radio choices --- */
  .choices { display: grid; gap: 0.6rem; }
  .choice {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 0.85rem 0.95rem;
    background: var(--bg);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .choice:hover { border-color: var(--border); }
  .choice input {
    position: absolute;
    opacity: 0;
    width: 1px; height: 1px;
  }
  .choice__mark {
    flex-shrink: 0;
    width: 17px; height: 17px;
    margin-top: 0.22rem;
    border: 1.5px solid var(--border-strong);
    border-radius: 50%;
    display: grid;
    place-items: center;
    transition: border-color 0.25s var(--ease);
  }
  .choice__mark::after {
    content: '';
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--blue);
    transform: scale(0);
    transition: transform 0.25s var(--ease-out);
  }
  .choice input:checked ~ .choice__mark { border-color: var(--blue); }
  .choice input:checked ~ .choice__mark::after { transform: scale(1); }
  .choice:has(input:checked) { border-color: var(--blue); background: var(--surface); }
  .choice input:focus-visible ~ .choice__mark {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }
  .choice__text { font-size: var(--step--1); line-height: 1.5; }

  /* --- Honeypot --- */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px; height: 1px;
    overflow: hidden;
  }

  /* --- Footer --- */
  .cform__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    padding-top: var(--space-xs);
  }
  .cform__submit[disabled] { opacity: 0.6; cursor: progress; }
  .cform__small { font-size: 0.8rem; color: var(--text-muted); }

  .cform__status {
    padding: 0.95rem 1.1rem;
    border-radius: var(--radius);
    font-size: var(--step--1);
    font-weight: 600;
    border: 1px solid;
  }
  .cform__status[data-tone='ok'] {
    color: var(--ok);
    background: var(--ok-bg);
    border-color: var(--ok-border);
  }
  .cform__status[data-tone='error'] {
    color: var(--red);
    background: var(--red-wash);
    border-color: var(--red-border);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const original = label.textContent;

    // Show only the panel matching the selected reason for getting in touch.
    const panels = Array.from(form.querySelectorAll<HTMLElement>('[data-intent-panel]'));
    const syncPanels = () => {
      const picked = form.querySelector<HTMLInputElement>('[data-intent-radio]:checked')?.value;
      for (const panel of panels) panel.hidden = panel.dataset.intentPanel !== picked;
    };
    form.querySelectorAll<HTMLInputElement>('[data-intent-radio]').forEach((r) =>
      r.addEventListener('change', syncPanels),
    );
    syncPanels();

    const clearErrors = () => {
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
        el.hidden = true;
        el.textContent = '';
      });
      form.querySelectorAll('[aria-invalid]').forEach((el) =>
        el.removeAttribute('aria-invalid'),
      );
    };

    const showErrors = (fieldErrors: Record<string, string>) => {
      let first: HTMLElement | null = null;
      for (const [name, message] of Object.entries(fieldErrors)) {
        const slot = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
        if (slot) {
          slot.textContent = message;
          slot.hidden = false;
        }
        const input = form.querySelector<HTMLElement>(`[name="${name}"]`);
        if (input) {
          input.setAttribute('aria-invalid', 'true');
          first ??= input;
        }
      }
      first?.focus();
      first?.scrollIntoView({ block: 'center', behavior: 'smooth' });
    };

    const setStatus = (message: string, tone: 'ok' | 'error') => {
      status.textContent = message;
      status.dataset.tone = tone;
      status.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();
      status.hidden = true;

      submit.disabled = true;
      label.textContent = 'Sending…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await res.json();

        if (res.ok && data.ok) {
          form.reset();
          syncPanels();
          setStatus(data.message ?? 'Thank you - your enquiry has been received.', 'ok');
          status.scrollIntoView({ block: 'center', behavior: 'smooth' });
        } else {
          setStatus(data.error ?? 'Something went wrong. Please try again.', 'error');
          if (data.fieldErrors) showErrors(data.fieldErrors);
        }
      } catch {
        setStatus(
          'We could not reach the server. Please check your connection and try again.',
          'error',
        );
      } finally {
        submit.disabled = false;
        label.textContent = original;
      }
    });
  }
</script>
