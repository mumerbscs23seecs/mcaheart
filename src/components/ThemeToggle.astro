---
// Dark-mode toggle. Safe to include more than once per page (mobile drawer +
// desktop bar, say) — the click handler binds exactly once no matter how many
// copies of this component render, and every copy's icon stays in sync.
---
<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark theme">
  <svg class="theme-toggle__sun" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
    <circle cx="10" cy="10" r="3.6" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path
      d="M10 1.6v2.1M10 16.3v2.1M18.4 10h-2.1M3.7 10H1.6M15.7 4.3l-1.5 1.5M5.8 14.2l-1.5 1.5M15.7 15.7l-1.5-1.5M5.8 5.8 4.3 4.3"
      stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
    />
  </svg>
  <svg class="theme-toggle__moon" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
    <path d="M17.2 12.4A7.6 7.6 0 1 1 7.6 2.8a6.1 6.1 0 0 0 9.6 9.6Z" fill="currentColor" />
  </svg>
</button>

<style is:global>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    flex-shrink: 0;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.15s var(--ease, ease), color 0.15s var(--ease, ease);
  }
  .theme-toggle:hover,
  .theme-toggle:active { background: var(--ink); color: var(--bg); }
  @media (pointer: coarse) {
    .theme-toggle { width: 2.75rem; height: 2.75rem; }
  }
  .theme-toggle__moon { display: none; }
  :root[data-theme='dark'] .theme-toggle__sun { display: none; }
  :root[data-theme='dark'] .theme-toggle__moon { display: block; }
</style>

<script is:inline>
  (() => {
    if (window.__mcaThemeToggleBound) return;
    window.__mcaThemeToggleBound = true;

    const sync = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
        btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
      });
    };

    document.addEventListener('click', (e) => {
      const btn = e.target && e.target.closest ? e.target.closest('[data-theme-toggle]') : null;
      if (!btn) return;
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('mca-theme', next); } catch (err) {}
      sync();
    });

    sync();
  })();
</script>
