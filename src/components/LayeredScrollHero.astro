---
/**
 * Nine-layer scroll-parallax hero built from the client-supplied
 * mca_heart_layers set - the whole "MCA Heart Research Lab" graphic split
 * into independent pieces (background, ECG trace, orbit rings, stent scene,
 * center wordmark, right panel, anatomical heart) so they can drift apart
 * as the visitor scrolls, then read as one flat composition at rest.
 *
 * Design, deliberately: the JS below does the least possible amount of
 * work. It computes a single number each frame (the eased pin progress)
 * and writes it to one CSS custom property on the stage. Every layer's
 * motion is a plain CSS calc() off that one property, and a short CSS
 * transition on each layer absorbs the frame-to-frame smoothing - not a
 * hand-rolled JS lerp. There is no per-layer imperative style write, no
 * manual GPU-layer promotion/demotion bookkeeping, and no mutable
 * animation state that two script instances (e.g. a stray HMR reload)
 * could ever disagree about - both would compute the same target from
 * the same scrollY and write the same value. That's what makes this
 * version robust against the blank-flash bug earlier attempts had:
 * there's nothing left to desync.
 *
 * Respects prefers-reduced-motion (everything sits at rest, no listener
 * attached) and skips the scroll-lock height on narrow screens, where a
 * long pinned scroll fights the page instead of introducing it.
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
const base = '/assets/research/hero-layers';
---

<section class="lshero">
  <div class="lshero__space" id="lsheroSpace">
    <div class="lshero__pin">
      <h1 class="visually-hidden">{title}</h1>
      <div class="lshero__stage" id="lsheroStage">
        <img class="lslayer" id="ls-bg" src={`${base}/00_background.jpg`} alt="" fetchpriority="high" />
        <img class="lslayer lslayer--side" id="ls-tl" src={`${base}/01_top_left_orbit.png`} alt="" />
        <img class="lslayer lslayer--side" id="ls-ecg" src={`${base}/02_ecg.png`} alt="" />
        <img class="lslayer lslayer--side" id="ls-blorbit" src={`${base}/03_bottom_left_orbit.png`} alt="" />
        <img class="lslayer lslayer--side" id="ls-bl" src={`${base}/04_bottom_left_stent_scene.png`} alt="" />
        <img class="lslayer" id="ls-logo" src={`${base}/05_center_logo.png`} alt="" />
        <img class="lslayer lslayer--side" id="ls-rorbit" src={`${base}/06_right_orbit.png`} alt="" />
        <img class="lslayer lslayer--side" id="ls-panel" src={`${base}/07_right_panel.png`} alt="" />
        <img class="lslayer lslayer--side" id="ls-heart" src={`${base}/08_right_heart.png`} alt="" />
      </div>
    </div>
  </div>
</section>

<style>
  .lshero {
    position: relative;
    background: var(--bg);
    border-bottom: 2px solid var(--ink);
  }

  /* The tall scroll track the pinned stage rides inside of. Shorter on
     narrow screens - a 4x-viewport pin makes little sense on a phone. */
  .lshero__space { position: relative; height: 340vh; }
  @media (max-width: 760px) { .lshero__space { height: 190vh; } }

  .lshero__pin {
    position: sticky;
    top: 0;
    height: 100vh;
    max-height: 900px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  /* Full-bleed - no side gutters, no max-width cap. The stage always
     spans the entire window width; height follows from the aspect ratio.
     --p / --pSide (written by the script below) live here so every child
     layer can read them - a single write per frame instead of nine. */
  .lshero__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1672 / 941;
    --p: 0;
    --pside: 0;
  }

  /* The supplied artwork (background photo + all 9 layers) is fixed light
     artwork with no dark-mode version, and every themed attempt to
     recolor it (a dark scrim, then an invert filter) made the logo/
     linework harder to read than the plain original. Simplest and most
     legible: render it exactly as-is, unconditionally - same as light
     mode - regardless of the site's theme setting. */

  .lslayer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
    user-select: none;
    transform-origin: center center;
    /* The browser smooths every frame-to-frame jump on its own timeline -
       a single dropped or duplicate JS write just gets interpolated away
       instead of snapping the layer to a wildly different state. */
    transition: transform 120ms linear, opacity 120ms linear;
  }
  #ls-bg { z-index: 0; }
  #ls-tl { z-index: 10; }
  #ls-ecg { z-index: 20; }
  #ls-blorbit { z-index: 30; }
  #ls-bl { z-index: 40; }
  #ls-logo { z-index: 50; }
  #ls-rorbit { z-index: 60; }
  #ls-panel { z-index: 70; }
  #ls-heart { z-index: 80; }

  /* Each side layer's exit motion, expressed once as calc() off the two
     shared custom properties instead of nine separate JS style writes
     per frame. Side art exits fully off-stage by 55% of the pin - the
     script maps that window into --pside so this is just 0..1 here. */
  #ls-tl {
    transform: translate3d(calc(var(--pside) * -160%), calc(var(--pside) * -70%), 0)
      scale(calc(1 + var(--pside) * 0.08));
  }
  #ls-ecg {
    transform: translate3d(calc(var(--pside) * -170%), calc(var(--pside) * 20%), 0)
      scale(calc(1 + var(--pside) * 0.03));
  }
  #ls-blorbit {
    transform: translate3d(calc(var(--pside) * -150%), calc(var(--pside) * 90%), 0)
      rotate(calc(var(--pside) * -3deg));
  }
  #ls-bl {
    transform: translate3d(calc(var(--pside) * -140%), calc(var(--pside) * 110%), 0)
      scale(calc(1 + var(--pside) * 0.12));
  }
  #ls-rorbit {
    transform: translate3d(calc(var(--pside) * 150%), calc(var(--pside) * -70%), 0)
      rotate(calc(var(--pside) * 3deg));
  }
  #ls-panel {
    transform: translate3d(calc(var(--pside) * 160%), calc(var(--pside) * 20%), 0)
      scale(calc(1 + var(--pside) * 0.08));
  }
  #ls-heart {
    transform: translate3d(calc(var(--pside) * 175%), calc(var(--pside) * -40%), 0)
      scale(calc(1 + var(--pside) * 0.16)) rotate(calc(var(--pside) * 4deg));
  }
  .lslayer--side { opacity: calc(1 - var(--pside)); }

  /* The wordmark rises on its own, slower and more contained than the
     side art leaving - it settles near the top, still fully readable,
     rather than exiting the frame. */
  #ls-logo {
    transform: translate3d(0, calc(var(--p) * -46%), 0) scale(calc(1 - var(--p) * 0.08));
  }

  /* Reduced motion / narrow screens: freeze the hero at rest, no scroll-
     lock, no per-layer transforms. */
  @media (prefers-reduced-motion: reduce), (max-width: 760px) {
    .lshero__pin { position: relative; height: auto; max-height: none; padding-block: var(--space-xl); }
    .lshero__space { height: auto; }
    .lslayer { transition: none; }
  }
</style>

<script>
  const space = document.getElementById('lsheroSpace');
  const stage = document.getElementById('lsheroStage');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const narrow = matchMedia('(max-width: 760px)').matches;

  if (space && stage && !reduced && !narrow) {
    const clamp = (v: number, min = 0, max = 1) => Math.min(max, Math.max(min, v));
    const ease = (v: number) => (v < 0.5 ? 4 * v * v * v : 1 - Math.pow(-2 * v + 2, 3) / 2);

    function pinProgress() {
      const max = Math.max(0, space!.offsetHeight - window.innerHeight);
      return max <= 0 ? 0 : clamp(window.scrollY / max);
    }

    let ticking = false;
    function update() {
      ticking = false;
      const p = ease(pinProgress());
      const pSide = clamp(p / 0.55);
      // One write, two properties - every layer's own calc() picks these
      // up on the next style recalc. No per-layer JS, nothing to desync.
      stage!.style.setProperty('--p', String(p));
      stage!.style.setProperty('--pside', String(pSide));
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }
</script>
