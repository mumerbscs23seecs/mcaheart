---
/**
 * Nine-layer scroll-parallax hero built from the client-supplied
 * mca_heart_layers set - the whole "MCA Heart Research Lab" graphic split
 * into independent pieces (background, ECG trace, orbit rings, stent scene,
 * center wordmark, right panel, anatomical heart) so they can drift apart
 * as the visitor scrolls, then read as one flat composition at rest.
 *
 * The director's portrait is a single element, not two: it rises into view
 * late in the hero scroll, then - once the hero un-pins - travels (fixed
 * position, tracking real getBoundingClientRect() each frame) into
 * #aboutPortraitSlot, the empty placeholder the About section reserves for
 * it. It never exists as a separate static image anywhere else.
 *
 * Respects prefers-reduced-motion (everything sits at rest, no listener
 * attached, portrait renders straight into its slot) and skips the
 * scroll-lock height on narrow screens, where a long pinned scroll fights
 * the page instead of introducing it.
 */
interface Props {
  title: string;
  directorPhoto?: string;
  directorName?: string;
}
const {
  title,
  directorPhoto = '/assets/research/alraies.jpg',
  directorName = 'M Chadi Alraies',
} = Astro.props;
const base = '/assets/research/hero-layers';
---

<section class="lshero">
  <div class="lshero__space" id="lsheroSpace">
    <div class="lshero__pin">
      <h1 class="visually-hidden">{title}</h1>
      <div class="lshero__stage" id="lsheroStage">
        <img class="lslayer" id="ls-bg" src={`${base}/00_background.jpg`} alt="" fetchpriority="high" />
        <img class="lslayer" id="ls-tl" src={`${base}/01_top_left_orbit.png`} alt="" />
        <img class="lslayer" id="ls-ecg" src={`${base}/02_ecg.png`} alt="" />
        <img class="lslayer" id="ls-blorbit" src={`${base}/03_bottom_left_orbit.png`} alt="" />
        <img class="lslayer" id="ls-bl" src={`${base}/04_bottom_left_stent_scene.png`} alt="" />
        <img class="lslayer" id="ls-logo" src={`${base}/05_center_logo.png`} alt="" />
        <img class="lslayer" id="ls-rorbit" src={`${base}/06_right_orbit.png`} alt="" />
        <img class="lslayer" id="ls-panel" src={`${base}/07_right_panel.png`} alt="" />
        <img class="lslayer" id="ls-heart" src={`${base}/08_right_heart.png`} alt="" />
      </div>
    </div>
  </div>

  <img class="lsportrait" id="lsPortrait" src={directorPhoto} alt={directorName} />
</section>

<style>
  .lshero {
    position: relative;
    background: var(--bg);
    border-bottom: 2px solid var(--ink);
  }

  /* The tall scroll track the pinned stage rides inside of. Shorter on
     narrow screens - a 4x-viewport pin makes little sense on a phone. */
  .lshero__space { position: relative; height: 340vh; }
  @media (max-width: 760px) { .lshero__space { height: 190vh; } }

  .lshero__pin {
    position: sticky;
    top: 0;
    height: 100vh;
    max-height: 900px;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: var(--gutter);
  }

  .lshero__stage {
    position: relative;
    width: min(100%, 1500px);
    aspect-ratio: 1672 / 941;
  }

  .lslayer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
    user-select: none;
    transform-origin: center center;
    will-change: transform, opacity;
    backface-visibility: hidden;
  }
  #ls-bg { z-index: 0; }
  #ls-tl { z-index: 10; }
  #ls-ecg { z-index: 20; }
  #ls-blorbit { z-index: 30; }
  #ls-bl { z-index: 40; }
  #ls-logo { z-index: 50; }
  #ls-rorbit { z-index: 60; }
  #ls-panel { z-index: 70; }
  #ls-heart { z-index: 80; }

  /* The traveling portrait - fixed to the viewport, positioned every frame
     by JS (either "floating in the hero" or "docking into the About
     section's slot"). Starts invisible; JS controls opacity/transform. */
  .lsportrait {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 90;
    width: 220px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 6px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity, width, height;
  }

  /* Reduced motion / narrow screens: freeze the hero at rest, no scroll-
     lock, no per-layer transforms - and let the portrait render normally
     inside its slot instead of floating/traveling. */
  @media (prefers-reduced-motion: reduce), (max-width: 760px) {
    .lshero__pin { position: relative; height: auto; max-height: none; padding-block: var(--space-xl); }
    .lshero__space { height: auto; }
    .lsportrait { display: none; }
  }
</style>

<script>
  const space = document.getElementById('lsheroSpace');
  const stage = document.getElementById('lsheroStage');
  const portrait = document.getElementById('lsPortrait') as HTMLImageElement | null;
  const slot = document.getElementById('aboutPortraitSlot');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const narrow = matchMedia('(max-width: 760px)').matches;

  if (space && stage && portrait && slot && !reduced && !narrow) {
    const layers = {
      tl: document.getElementById('ls-tl'),
      ecg: document.getElementById('ls-ecg'),
      blOrbit: document.getElementById('ls-blorbit'),
      bl: document.getElementById('ls-bl'),
      logo: document.getElementById('ls-logo'),
      rOrbit: document.getElementById('ls-rorbit'),
      panel: document.getElementById('ls-panel'),
      heart: document.getElementById('ls-heart'),
    } as Record<string, HTMLImageElement>;

    let current = 0; // smoothed hero-pin progress, 0..1
    let raf = 0;
    let lastHeroRect: { left: number; top: number; width: number; height: number } | null = null;

    const clamp = (v: number, min = 0, max = 1) => Math.min(max, Math.max(min, v));
    const ease = (v: number) => (v < 0.5 ? 4 * v * v * v : 1 - Math.pow(-2 * v + 2, 3) / 2);
    /** Remap p from [start,end] to [0,1] - lets one layer's motion run on
     *  its own window of the scroll instead of the full 0-1 range. */
    const remap = (p: number, start: number, end: number) => clamp((p - start) / (end - start));
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    function pinEnd() {
      return Math.max(0, space!.offsetHeight - window.innerHeight);
    }
    function pinProgress() {
      const max = pinEnd();
      return max <= 0 ? 0 : clamp(window.scrollY / max);
    }

    // How far past the end of the pin the portrait's journey continues -
    // combined with starting the journey partway through the pin itself
    // (see journeyStartY below), this stretches the whole rise-and-travel
    // out gradually rather than snapping across in a short burst.
    const TRAVEL_PX = 900;

    // The portrait's rect while it's still "in" the hero - a fixed spot
    // near the bottom-center of the stage, derived from the stage's own
    // live position so it tracks correctly at any viewport size.
    function heroRect() {
      const s = stage!.getBoundingClientRect();
      const w = s.width * 0.19;
      const h = w * 1.25; // 4:5
      return { left: s.left + s.width / 2 - w / 2, top: s.top + s.height * 0.96 - h, width: w, height: h };
    }

    function render() {
      const targetP = ease(pinProgress());
      current += (targetP - current) * 0.16;
      if (Math.abs(targetP - current) < 0.0005) current = targetP;
      const p = current;

      // Side art exits fully off-stage (percentages, so it scales with the
      // stage's own size) - finished by 55% of the pin, so it's well clear
      // in time for the portrait to appear "not very late".
      const pSide = remap(p, 0, 0.55);
      layers.tl.style.transform = `translate(${-160 * pSide}%, ${-70 * pSide}%) scale(${1 + 0.08 * pSide})`;
      layers.ecg.style.transform = `translate(${-170 * pSide}%, ${20 * pSide}%) scale(${1 + 0.03 * pSide})`;
      layers.blOrbit.style.transform = `translate(${-150 * pSide}%, ${90 * pSide}%) rotate(${-3 * pSide}deg)`;
      layers.bl.style.transform = `translate(${-140 * pSide}%, ${110 * pSide}%) scale(${1 + 0.12 * pSide})`;
      layers.rOrbit.style.transform = `translate(${150 * pSide}%, ${-70 * pSide}%) rotate(${3 * pSide}deg)`;
      layers.panel.style.transform = `translate(${160 * pSide}%, ${20 * pSide}%) scale(${1 + 0.08 * pSide})`;
      layers.heart.style.transform = `translate(${175 * pSide}%, ${-40 * pSide}%) scale(${1 + 0.16 * pSide}) rotate(${4 * pSide}deg)`;

      layers.tl.style.opacity = `${1 - pSide}`;
      layers.ecg.style.opacity = `${1 - pSide}`;
      layers.blOrbit.style.opacity = `${1 - pSide}`;
      layers.bl.style.opacity = `${1 - pSide}`;
      layers.rOrbit.style.opacity = `${1 - pSide}`;
      layers.panel.style.opacity = `${1 - pSide}`;
      layers.heart.style.opacity = `${1 - pSide}`;

      // The wordmark rises on its own, slower and more contained than the
      // side art leaving - it settles near the top, still fully readable,
      // rather than exiting the frame.
      layers.logo.style.transform = `translate3d(0, ${-46 * p}%, 0) scale(${1 - 0.08 * p})`;

      // --- Portrait: two clear beats, not one blurred-together motion.
      // 1) Appear: fades/lifts in at its hero spot, right as the side art
      //    finishes clearing (not very late) - done well before the pin
      //    itself ends.
      // 2) Travel: only once it's fully visible does it start easing
      //    toward the About slot - a long, gradual glide (spans the rest
      //    of the pin plus extra scroll after), never a quick snap.
      const pinY = pinEnd();
      const revealStartY = pinY * 0.35;
      const revealEndY = pinY * 0.55;
      const pReveal = remap(window.scrollY, revealStartY, revealEndY);
      const pTravel = ease(remap(window.scrollY, revealEndY, pinY + TRAVEL_PX));

      // Freeze the "from" rect at the instant the pin releases - past that
      // point the stage has scrolled away, so its live rect is no longer
      // meaningful as a start reference.
      if (window.scrollY <= pinY) lastHeroRect = heroRect();

      const from = lastHeroRect ?? heroRect();
      const to = slot!.getBoundingClientRect();
      const rect = {
        left: lerp(from.left, to.left, pTravel),
        top: lerp(from.top, to.top, pTravel),
        width: lerp(from.width, to.width, pTravel),
        height: lerp(from.height, to.height, pTravel),
      };

      const pVisible = Math.max(pReveal, pTravel > 0 ? 1 : 0);
      portrait.style.opacity = `${pVisible}`;
      portrait.style.width = `${rect.width}px`;
      portrait.style.height = `${rect.height}px`;
      portrait.style.transform = `translate(${rect.left}px, ${rect.top}px) scale(${0.94 + 0.06 * pVisible})`;
      // Once fully docked, the shadow is redundant with the slot's own
      // card frame - fade it out over the tail of the travel.
      portrait.style.boxShadow = pTravel > 0.9 ? 'none' : '0 18px 40px rgba(0, 0, 0, 0.22)';

      raf = requestAnimationFrame(render);
    }

    // Nothing needed on the scroll event itself - render() reads
    // window.scrollY fresh every animation frame, so the rAF loop alone
    // keeps everything in sync.
    render();

    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });
  } else if (portrait && slot) {
    // Reduced motion / narrow screens: skip the traveling animation - move
    // the same <img> (not a clone, so it's never fetched twice) straight
    // into the About section's slot as a plain static photo.
    portrait.removeAttribute('id');
    portrait.className = '';
    portrait.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius:inherit;display:block;';
    slot.appendChild(portrait);
  }
</script>
