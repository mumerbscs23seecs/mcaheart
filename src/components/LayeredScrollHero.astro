---
/**
 * Nine-layer scroll-parallax hero built from the client-supplied
 * mca_heart_layers set - the whole "MCA Heart Research Lab" graphic split
 * into independent pieces (background, ECG trace, orbit rings, stent scene,
 * center wordmark, right panel, anatomical heart) so they can drift apart
 * as the visitor scrolls, then read as one flat composition at rest.
 *
 * Respects prefers-reduced-motion (everything sits at rest, no listener
 * attached) and skips the scroll-lock height on narrow screens, where a
 * long pinned scroll fights the page instead of introducing it.
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
const base = '/assets/research/hero-layers';
---

<section class="lshero">
  <div class="lshero__space" id="lsheroSpace">
    <div class="lshero__pin">
      <h1 class="visually-hidden">{title}</h1>
      <div class="lshero__stage" id="lsheroStage">
        <img class="lslayer" id="ls-bg" src={`${base}/00_background.jpg`} alt="" fetchpriority="high" />
        <img class="lslayer" id="ls-tl" src={`${base}/01_top_left_orbit.png`} alt="" />
        <img class="lslayer" id="ls-ecg" src={`${base}/02_ecg.png`} alt="" />
        <img class="lslayer" id="ls-blorbit" src={`${base}/03_bottom_left_orbit.png`} alt="" />
        <img class="lslayer" id="ls-bl" src={`${base}/04_bottom_left_stent_scene.png`} alt="" />
        <img class="lslayer" id="ls-logo" src={`${base}/05_center_logo.png`} alt="" />
        <img class="lslayer" id="ls-rorbit" src={`${base}/06_right_orbit.png`} alt="" />
        <img class="lslayer" id="ls-panel" src={`${base}/07_right_panel.png`} alt="" />
        <img class="lslayer" id="ls-heart" src={`${base}/08_right_heart.png`} alt="" />
      </div>
    </div>
  </div>
</section>

<style>
  .lshero {
    position: relative;
    background: var(--bg);
    border-bottom: 2px solid var(--ink);
  }

  /* The tall scroll track the pinned stage rides inside of. Shorter on
     narrow screens - a 4x-viewport pin makes little sense on a phone. */
  .lshero__space { position: relative; height: 340vh; }
  @media (max-width: 760px) { .lshero__space { height: 190vh; } }

  .lshero__pin {
    position: sticky;
    top: 0;
    height: 100vh;
    max-height: 900px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  /* Full-bleed - no side gutters, no max-width cap. The stage always
     spans the entire window width; height follows from the aspect ratio. */
  .lshero__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1672 / 941;
  }

  /* The supplied artwork (background photo + all 9 layers) is fixed light
     artwork with no dark-mode version, and every themed attempt to
     recolor it (a dark scrim, then an invert filter) made the logo/
     linework harder to read than the plain original. Simplest and most
     legible: render it exactly as-is, unconditionally - same as light
     mode - regardless of the site's theme setting. */

  .lslayer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
    user-select: none;
    transform-origin: center center;
    /* No permanent transform/will-change here. Forcing all 9 large,
       fully-overlapping images into their own GPU compositing layer at
       all times (an earlier attempt) keeps 9 large textures resident in
       GPU memory even when nothing is animating - under memory pressure
       the browser evicts and re-uploads a layer's backing store, which
       is exactly what showed up as a layer briefly going blank and
       reappearing. Layers are promoted only while the scroll script is
       actually animating them (see the script below) and released once
       the pin settles. */
  }
  #ls-bg { z-index: 0; }
  #ls-tl { z-index: 10; }
  #ls-ecg { z-index: 20; }
  #ls-blorbit { z-index: 30; }
  #ls-bl { z-index: 40; }
  #ls-logo { z-index: 50; }
  #ls-rorbit { z-index: 60; }
  #ls-panel { z-index: 70; }
  #ls-heart { z-index: 80; }

  /* Reduced motion / narrow screens: freeze the hero at rest, no scroll-
     lock, no per-layer transforms. */
  @media (prefers-reduced-motion: reduce), (max-width: 760px) {
    .lshero__pin { position: relative; height: auto; max-height: none; padding-block: var(--space-xl); }
    .lshero__space { height: auto; }
  }
</style>

<script>
  const space = document.getElementById('lsheroSpace');
  const stage = document.getElementById('lsheroStage');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const narrow = matchMedia('(max-width: 760px)').matches;

  if (space && stage && !reduced && !narrow) {
    const layers = {
      tl: document.getElementById('ls-tl'),
      ecg: document.getElementById('ls-ecg'),
      blOrbit: document.getElementById('ls-blorbit'),
      bl: document.getElementById('ls-bl'),
      logo: document.getElementById('ls-logo'),
      rOrbit: document.getElementById('ls-rorbit'),
      panel: document.getElementById('ls-panel'),
      heart: document.getElementById('ls-heart'),
    } as Record<string, HTMLImageElement>;

    const allLayers = Object.values(layers);

    let current = 0; // smoothed hero-pin progress, 0..1
    let raf = 0;
    let promoted = false;

    /** Only keep layers on their own GPU compositing layer while they're
     *  actually being animated - holding 9 large, fully-overlapping
     *  images permanently promoted keeps 9 textures resident in GPU
     *  memory even at rest, and under memory pressure the browser can
     *  evict + re-upload one, which is what showed up as a layer
     *  flashing blank for a moment mid-scroll. */
    function setPromoted(on: boolean) {
      if (on === promoted) return;
      promoted = on;
      for (const el of allLayers) el.style.willChange = on ? 'transform, opacity' : 'auto';
    }

    const clamp = (v: number, min = 0, max = 1) => Math.min(max, Math.max(min, v));
    const ease = (v: number) => (v < 0.5 ? 4 * v * v * v : 1 - Math.pow(-2 * v + 2, 3) / 2);
    /** Remap p from [start,end] to [0,1] - lets one layer's motion run on
     *  its own window of the scroll instead of the full 0-1 range. */
    const remap = (p: number, start: number, end: number) => clamp((p - start) / (end - start));

    function pinEnd() {
      return Math.max(0, space!.offsetHeight - window.innerHeight);
    }
    function pinProgress() {
      const max = pinEnd();
      return max <= 0 ? 0 : clamp(window.scrollY / max);
    }

    function render() {
      const targetP = ease(pinProgress());
      current += (targetP - current) * 0.16;
      if (Math.abs(targetP - current) < 0.0005) current = targetP;
      const p = current;

      // Side art exits fully off-stage (percentages, so it scales with the
      // stage's own size) - finished by 55% of the pin.
      const pSide = remap(p, 0, 0.55);
      // translate3d (not translate) on every layer, matching the logo below -
      // mixing 2D and 3D transforms across these 9 stacked, overlapping
      // layers made the browser re-decide GPU compositing/paint order every
      // scroll frame, which showed up as a visible flicker/strobe.
      layers.tl.style.transform = `translate3d(${-160 * pSide}%, ${-70 * pSide}%, 0) scale(${1 + 0.08 * pSide})`;
      layers.ecg.style.transform = `translate3d(${-170 * pSide}%, ${20 * pSide}%, 0) scale(${1 + 0.03 * pSide})`;
      layers.blOrbit.style.transform = `translate3d(${-150 * pSide}%, ${90 * pSide}%, 0) rotate(${-3 * pSide}deg)`;
      layers.bl.style.transform = `translate3d(${-140 * pSide}%, ${110 * pSide}%, 0) scale(${1 + 0.12 * pSide})`;
      layers.rOrbit.style.transform = `translate3d(${150 * pSide}%, ${-70 * pSide}%, 0) rotate(${3 * pSide}deg)`;
      layers.panel.style.transform = `translate3d(${160 * pSide}%, ${20 * pSide}%, 0) scale(${1 + 0.08 * pSide})`;
      layers.heart.style.transform = `translate3d(${175 * pSide}%, ${-40 * pSide}%, 0) scale(${1 + 0.16 * pSide}) rotate(${4 * pSide}deg)`;

      layers.tl.style.opacity = `${1 - pSide}`;
      layers.ecg.style.opacity = `${1 - pSide}`;
      layers.blOrbit.style.opacity = `${1 - pSide}`;
      layers.bl.style.opacity = `${1 - pSide}`;
      layers.rOrbit.style.opacity = `${1 - pSide}`;
      layers.panel.style.opacity = `${1 - pSide}`;
      layers.heart.style.opacity = `${1 - pSide}`;

      // The wordmark rises on its own, slower and more contained than the
      // side art leaving - it settles near the top, still fully readable,
      // rather than exiting the frame.
      layers.logo.style.transform = `translate3d(0, ${-46 * p}%, 0) scale(${1 - 0.08 * p})`;

      // Once the pin has fully released, everything here is settled - stop
      // spending a frame budget on it for the rest of the page. Scrolling
      // back up re-arms the loop via the listener below.
      const settled = window.scrollY > pinEnd() + 200;
      if (settled) {
        looping = false;
        setPromoted(false);
        return;
      }
      raf = requestAnimationFrame(render);
    }

    let looping = false;
    function ensureLooping() {
      if (looping) return;
      looping = true;
      setPromoted(true);
      render();
    }

    ensureLooping();
    window.addEventListener('scroll', ensureLooping, { passive: true });
    window.addEventListener('resize', ensureLooping);

    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });
  }
</script>
