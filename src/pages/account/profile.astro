---
/**
 * Every member edits their own profile here: full name, affiliation and
 * sign-in email; mentees also choose the skills they can help with.
 * Needs mca-pipeline/add-profiles.sql (skills: add-skills.sql).
 */
import PipelineLayout from '../../layouts/PipelineLayout.astro';
import '../../styles/calm.css';
import { SKILL_SHORT } from '../../lib/skills';
import { supabaseAdmin } from '../../lib/supabase';
import { forgetPerson } from '../../lib/pipeline-auth';
import { changeEmail } from '../../lib/profile';
import { SKILLS, isSkill } from '../../lib/skills';

export const prerender = false;

// The middleware guarantees a signed-in member here.
const { supabase, person } = Astro.locals as any;
const home = person.role === 'admin' ? '/admin' : '/pipeline';

let error: string | null = null;
let saved = Astro.url.searchParams.get('saved') === '1';

// Affiliation exists only once add-profiles.sql has been run.
const { data: extra, error: extraErr } = await supabaseAdmin().from('people').select('affiliation,expertise,is_mentee').eq('id', person.id).maybeSingle();
const ready = !extraErr;
const isMentee = !!(extra as any)?.is_mentee;
const currentSkills: string[] = ((extra as any)?.expertise ?? []).filter(isSkill);

let form = {
  full_name: person.full_name as string,
  email: person.email as string,
  affiliation: ((extra as any)?.affiliation as string | null) ?? '',
  skills: currentSkills,
};

if (ready && Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  form = {
    full_name: String(data.get('full_name') ?? '').trim(),
    email: String(data.get('email') ?? '').trim(),
    affiliation: String(data.get('affiliation') ?? '').trim(),
    skills: data.getAll('skills').map(String).filter(isSkill),
  };
  const password = String(data.get('password') ?? '');

  const { error: e } = await supabase.rpc('update_my_profile', { p_full_name: form.full_name, p_affiliation: form.affiliation });
  if (e) error = e.message;

  const skillsChanged = [...form.skills].sort().join('|') !== [...currentSkills].sort().join('|');
  if (!error && isMentee && skillsChanged) {
    const { error: se } = await supabase.rpc('set_my_skills', { p_skills: form.skills });
    if (se) error = /could not find the function/i.test(se.message) ? 'Saving skills needs add-skills.sql to be run first.' : se.message;
  }
  if (!error && form.email.toLowerCase() !== String(person.email).toLowerCase()) {
    error = await changeEmail({ personId: person.id, authId: person.auth_id, currentEmail: person.email, newEmail: form.email, password });
  }

  forgetPerson(person.auth_id);
  if (!error) return Astro.redirect('/account/profile?saved=1', 303);
  saved = false;
}
---

<PipelineLayout title="Your profile">
  <div class="cv acct">
    <div class="cv-bar"><h1 class="cv-h1">Your profile</h1></div>
    <p class="acct-sub">Used on papers and conference submissions.</p>

    {!ready && <p class="cv-flash cv-flash--err" role="alert">Profile editing isn't switched on yet. A coordinator needs to run add-profiles.sql.</p>}
    {error && <p class="cv-flash cv-flash--err" role="alert">{error}</p>}
    {saved && <p class="cv-flash" role="status">Saved.</p>}

    {ready && (
      <form class="acct-card" method="post" novalidate>
        <label class="cv-field"><span>Full name</span>
          <input name="full_name" required maxlength="120" value={form.full_name} autocomplete="name" />
        </label>
        <label class="cv-field"><span>Affiliation</span>
          <input name="affiliation" maxlength="200" value={form.affiliation} placeholder="Hospital, university or institution" autocomplete="organization" />
        </label>
        <label class="cv-field"><span>Email <small>you sign in with this</small></span>
          <input name="email" type="email" required maxlength="254" value={form.email} autocomplete="email" data-prof-email data-current={person.email} />
        </label>
        <label class="cv-field" data-prof-pw hidden><span>Current password <small>needed to change your email</small></span>
          <input name="password" type="password" autocomplete="current-password" />
        </label>

        {isMentee && (
          <fieldset class="acct-skills">
            <legend>What you can help with</legend>
            <div class="acct-skills__grid">
              {SKILLS.map((sk) => (
                <label class="acct-skill">
                  <input type="checkbox" name="skills" value={sk} checked={form.skills.includes(sk)} />
                  <span>{SKILL_SHORT[sk]}</span>
                </label>
              ))}
            </div>
          </fieldset>
        )}

        <div class="acct-foot">
          <button class="cv-btn cv-btn--pri" type="submit">Save profile</button>
          <a class="cv-btn" href="/account/password">Change password</a>
        </div>
      </form>
    )}
  </div>
</PipelineLayout>

<script>
  // Ask for the current password only once the email is actually changed.
  const email = document.querySelector<HTMLInputElement>('[data-prof-email]');
  const pw = document.querySelector<HTMLElement>('[data-prof-pw]');
  const sync = () => {
    if (!email || !pw) return;
    pw.hidden = email.value.trim().toLowerCase() === (email.dataset.current ?? '').toLowerCase();
  };
  email?.addEventListener('input', sync);
  sync();
</script>

<style>
  .acct { max-width: 640px; margin-inline: auto; }
  .acct .cv-bar { margin-bottom: 6px; }
  .acct-sub { margin: 0 0 22px; font-size: 0.9375rem; opacity: 0.7; }
  .acct-card { display: grid; gap: 18px; padding: 24px; border: 1px solid var(--cv-line); border-radius: 12px; }
  [data-prof-pw][hidden] { display: none; }
  .acct-skills { border: 0; margin: 0; padding: 0; min-width: 0; }
  .acct-skills legend { padding: 0; margin-bottom: 8px; font-size: 0.8125rem; font-weight: 700; }
  .acct-skills__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .acct-skill { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--cv-line); border-radius: 8px; font-size: 0.9375rem; cursor: pointer; }
  .acct-skill:has(input:checked) { border-color: var(--cv-accent); background: var(--cv-tint); }
  .acct-skill input { width: 16px; height: 16px; margin: 0; accent-color: var(--cv-accent); }
  .acct-foot { display: flex; gap: 8px; padding-top: 4px; }
  .acct-foot .cv-btn { padding: 10px 18px; font-size: 0.9rem; }
  @media (max-width: 520px) { .acct-skills__grid { grid-template-columns: 1fr; } }
</style>
