---
import PipelineLayout from '../../layouts/PipelineLayout.astro';
import '../../styles/calm.css';
import { currentUser } from '../../lib/auth';
import { clearMustChange, MIN_PASSWORD, DEFAULT_PASSWORD } from '../../lib/accounts';

export const prerender = false;

// The middleware guarantees a signed-in user here (and sends anyone still on
// the starting password to this page before anything else).
const me = currentUser(Astro.cookies)!;
const { supabase } = Astro.locals;
const first = Astro.url.searchParams.get('first') === '1';
const home = me.role === 'admin' ? '/admin' : '/pipeline';

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirm') ?? '');
  if (password.length < MIN_PASSWORD) error = `Use at least ${MIN_PASSWORD} characters.`;
  else if (password !== confirm) error = 'The two passwords do not match.';
  else if (DEFAULT_PASSWORD && password === DEFAULT_PASSWORD) error = 'Choose a password different from the starting one.';
  else {
    const { data, error: updErr } = await supabase.auth.updateUser({ password });
    if (updErr || !data.user) error = updErr?.message ?? 'Could not save the password.';
    else {
      await clearMustChange(data.user.id);
      return Astro.redirect(`${home}?ok=${encodeURIComponent('Password changed.')}`, 303);
    }
  }
}
---

<PipelineLayout title="Change password">
  <div class="cv acct">
    <div class="cv-bar"><h1 class="cv-h1">{first ? 'Choose your password' : 'Change password'}</h1></div>
    <p class="acct-sub">{first ? 'You signed in with the starting password. Pick your own to continue.' : `Signed in as ${me.email}`}</p>
    {error && <p class="cv-flash cv-flash--err" role="alert">{error}</p>}
    <form class="acct-card" method="post" novalidate>
      <label class="cv-field"><span>New password <small>at least {MIN_PASSWORD} characters</small></span>
        <input name="password" type="password" autocomplete="new-password" minlength={MIN_PASSWORD} required />
      </label>
      <label class="cv-field"><span>Confirm password</span>
        <input name="confirm" type="password" autocomplete="new-password" minlength={MIN_PASSWORD} required />
      </label>
      <div class="acct-foot">
        <button class="cv-btn cv-btn--pri" type="submit">Save password</button>
        {first ? <a class="cv-btn" href="/logout">Sign out</a> : <a class="cv-btn" href="/account/profile">Cancel</a>}
      </div>
    </form>
  </div>
</PipelineLayout>

<style>
  .acct { max-width: 520px; margin-inline: auto; }
  .acct .cv-bar { margin-bottom: 6px; }
  .acct-sub { margin: 0 0 22px; font-size: 0.9375rem; opacity: 0.7; }
  .acct-card { display: grid; gap: 18px; padding: 24px; border: 1px solid var(--cv-line); border-radius: 12px; }
  .acct-foot { display: flex; gap: 8px; padding-top: 4px; }
  .acct-foot .cv-btn { padding: 10px 18px; font-size: 0.9rem; }
</style>
