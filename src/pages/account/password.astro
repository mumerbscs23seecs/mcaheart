---
import AuthShell from '../../components/AuthShell.astro';
import { currentUser } from '../../lib/auth';
import { clearMustChange, MIN_PASSWORD, DEFAULT_PASSWORD } from '../../lib/accounts';

export const prerender = false;

// The middleware guarantees a signed-in user here (and sends anyone still on
// the starting password to this page before anything else).
const me = currentUser(Astro.cookies)!;
const { supabase } = Astro.locals;
const first = Astro.url.searchParams.get('first') === '1';
const home = me.role === 'admin' ? '/admin' : '/pipeline';

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirm') ?? '');
  if (password.length < MIN_PASSWORD) error = `Use at least ${MIN_PASSWORD} characters.`;
  else if (password !== confirm) error = 'The two passwords do not match.';
  else if (DEFAULT_PASSWORD && password === DEFAULT_PASSWORD) error = 'Choose a password different from the starting one.';
  else {
    const { data, error: updErr } = await supabase.auth.updateUser({ password });
    if (updErr || !data.user) error = updErr?.message ?? 'Could not save the password.';
    else {
      await clearMustChange(data.user.id);
      return Astro.redirect(`${home}?ok=${encodeURIComponent('Password changed.')}`, 303);
    }
  }
}
---

<AuthShell title="Change password" description="Choose a new password for the members area.">
  <form class="auth-card" method="post" novalidate>
    <h1 class="auth-card__title">{first ? 'Choose your password' : 'Change password'}</h1>
    <p class="auth-card__sub">
      {first
        ? 'You signed in with the starting password. Pick your own to continue.'
        : `Signed in as ${me.email}`}
    </p>

    {error && <p class="auth-alert" role="alert">{error}</p>}

    <div class="auth-field">
      <label for="password">New password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength={MIN_PASSWORD} required />
    </div>
    <div class="auth-field">
      <label for="confirm">Confirm password</label>
      <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength={MIN_PASSWORD} required />
    </div>

    <button class="btn" type="submit">Save password</button>
    {!first && <a class="auth-card__link" href={home}>&larr; Cancel</a>}
    {first && <a class="auth-card__link" href="/logout">Sign out</a>}
  </form>
</AuthShell>
