---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="That page does not exist.">
  <section class="section--tall nf grid-ground">
    <div class="shell shell--narrow center">
      <p class="eyebrow eyebrow--center">Error 404</p>
      <h1 class="display nf__title">This page has no pulse</h1>
      <p class="lede nf__body">
        The page you were looking for is not here. Try the homepage, or head
        straight to the work.
      </p>
      <div class="nf__actions">
        <a class="btn" href="/">Back home <span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
        <a class="btn btn--ghost" href="/contact">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { display: grid; place-items: center; min-height: 62svh; }
  .nf__title { margin-top: var(--space-s); font-size: var(--step-4); }
  .nf__body { margin-top: var(--space-m); margin-inline: auto; }
  .nf__actions {
    display: flex; flex-wrap: wrap; gap: var(--space-xs);
    justify-content: center; margin-top: var(--space-l);
  }
</style>
