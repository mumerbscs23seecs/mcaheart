---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { director, researchStats, societies } from '../data/site';

// Icon-only profile-link buttons on the director card. X and LinkedIn are
// single-color (currentColor) SVGs, so they follow the button's own text
// color with no separate light/dark asset needed. DMC uses a plain
// hospital-cross pictogram (Material Design icons, Apache-2.0) - its actual
// trademarked logo wasn't sourced. WSU and ResearchGate use their real
// logos (supplied directly) as image assets instead - see the markup below;
// ResearchGate's mark is flat dark ink, so it gets a white dark-mode
// variant the same way the society logos do, WSU's shield already has its
// own light outline so one image works in both themes.
const DIRECTOR_ICONS: Record<string, string> = {
  x: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
  linkedin:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
  hospital:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-1 11h-4v4h-4v-4H6v-4h4V6h4v4h4v4z"/></svg>',
};
---

<BaseLayout title="Home" transparentHeader>
  {/* ---------------------------------------------------------------- Hero */}
  <section class="hero grid-ground">
    <div class="shell shell--wide hero__inner">
      <div class="hero__copy">
        <h1 class="display hero__title">
          <span class="hero__line">Charting</span>
          <span class="hero__line">New Paths</span>
          <span class="hero__line">in <em>Cardiology</em></span>
        </h1>
        <p class="lede hero__lede">
          A collaboration of more than three hundred researcher-physicians,
          publishing, presenting, and teaching at the frontiers of cardiovascular medicine.
        </p>
        <div class="hero__actions">
          <a class="btn" href="/research-group">
            Explore the group <span class="btn__arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn btn--ghost" href="/heart-trending">Watch Heart Trending</a>
        </div>
      </div>

      <div class="hero__art" aria-hidden="true">
        <img
          src="/assets/brand/heart-anatomical.png"
          alt=""
          fetchpriority="high"
          decoding="async"
          width="381"
          height="690"
        />
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------------- Director */}
  <section class="section director">
    <div class="shell shell--wide director__grid">
      <figure class="director__portrait" data-reveal>
        <img
          src="/assets/home/alraies-portrait.webp"
          alt={`Portrait of ${director.name}`}
          loading="lazy"
          decoding="async"
          width="700"
          height="850"
        />
      </figure>

      <div class="director__copy" data-reveal style="--reveal-delay:120ms">
        <h2 class="director__name">
          {director.name}<span class="director__creds">, {director.credentialsFull}</span>
        </h2>
        <ul class="director__roles">
          {director.roles.map((r) => <li>{r}</li>)}
        </ul>
        <p class="prose director__body">
          {director.name}, {director.credentials} leads the MCA Heart Research Lab's clinical and
          academic programme, mentoring trainees from medical school through interventional
          fellowship and anchoring the group's presence at the major cardiology congresses.
        </p>
        <p class="director__socials-label">Connect</p>
        <ul class="director__socials">
          {director.links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener noreferrer" aria-label={l.label} title={l.label}>
                {l.icon === 'university' ? (
                  <img class="director__socials-wsu" src="/assets/home/logo-wsu.webp" alt="" loading="lazy" decoding="async" />
                ) : l.icon === 'researchgate' ? (
                  <>
                    <img class="director__socials-light" src="/assets/home/logo-researchgate.webp" alt="" loading="lazy" decoding="async" />
                    <img class="director__socials-dark" src="/assets/home/logo-researchgate-dark.webp" alt="" loading="lazy" decoding="async" />
                  </>
                ) : (
                  <Fragment set:html={DIRECTOR_ICONS[l.icon]} />
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ Societies */}
  <section class="section--tight societies">
    <div class="shell shell--wide">
      <p class="societies__label">Our work has been presented at</p>
      <ul class="societies__list">
        {societies.map((s) => (
          <li class="societies__item">
            <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.name} - view M Chadi Alraies' work indexed here`}>
              <img class="societies__logo--light" src={s.logo} alt={s.name} loading="lazy" decoding="async" height="60" />
              {s.logoDark && (
                <img class="societies__logo--dark" src={s.logoDark} alt={s.name} loading="lazy" decoding="async" height="60" />
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------------------ Impact */}
  <section class="section--tall impact dark-ground">
    <div class="impact__bg" aria-hidden="true">
      <img src="/assets/home/aorta.webp" alt="" loading="lazy" decoding="async" />
    </div>

    <div class="shell shell--wide">
      <header class="impact__head section-head" data-reveal>
        <h2 class="display impact__title">Impact<br />through<br />excellence</h2>
      </header>

      <dl class="impact__grid impact__grid--research">
        {researchStats.map((s, i) => (
          <div class="stat" data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <dt class="stat__value" data-count={s.value}>{s.value}</dt>
            <dd class="stat__label">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* --------------------------------------------------------------- Pillars */}
  <section class="section pillars">
    <div class="shell shell--wide">
      <header class="pillars__head section-head" data-reveal>
        <h2 class="display pillars__title">Three arms, one mission</h2>
      </header>

      <div class="pillars__grid">
        <a class="pillar card" href="/research-group" data-reveal>
          <span class="media pillar__media">
            <img src="/assets/research/acc-2024.webp" alt="" loading="lazy" decoding="async" />
          </span>
          <span class="pillar__body">
            <h3 class="pillar__title">MCA Heart Research Lab</h3>
            <span class="pillar__text">
              300+ researchers, 75+ manuscripts and 150+ abstracts a year across
              SCAI, AHA, TCT and ACC.
            </span>
            <span class="link-underline pillar__link">Explore &rarr;</span>
          </span>
        </a>

        <a class="pillar card" href="/heart-trending" data-reveal style="--reveal-delay:110ms">
          <span class="media pillar__media">
            <img src="/assets/trending/video-1.jpg" alt="" loading="lazy" decoding="async" />
          </span>
          <span class="pillar__body">
            <h3 class="pillar__title">Heart Trending</h3>
            <span class="pillar__text">
              Interviews with leading cardiologists, congress wrap-ups, journal
              reviews and webinars.
            </span>
            <span class="link-underline pillar__link">Watch &rarr;</span>
          </span>
        </a>

        <a class="pillar card" href="/education" data-reveal style="--reveal-delay:220ms">
          <span class="media pillar__media">
            <img src="/assets/education/hotm-thumb.jpg" alt="" loading="lazy" decoding="async" />
          </span>
          <span class="pillar__body">
            <h3 class="pillar__title">Education</h3>
            <span class="pillar__text">
              Heart of the Matter and the monthly webinar series, reviewing the
              science shaping heart health.
            </span>
            <span class="link-underline pillar__link">Learn &rarr;</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <CTABanner
    title="Learn more about us"
    body="Whether you are an aspiring research fellow seeking mentorship or a seasoned professional looking to contribute, there is a place for you here."
    ctaLabel="Get in touch"
    ctaHref="/contact"
    image="/assets/home/group-photo.webp"
  />
</BaseLayout>

<script>
  // Count-up on the impact figures. Values like "100+" keep their suffix.
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (nums.length && !reduced && 'IntersectionObserver' in window) {
    const run = (el: HTMLElement) => {
      const raw = el.dataset.count ?? '';
      const target = parseInt(raw.replace(/D/g, ''), 10);
      const suffix = raw.replace(/[0-9]/g, '');
      if (!target) return;

      const DURATION = 1400;
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min((now - start) / DURATION, 1);
        // easeOutExpo - fast then settling, reads as precise rather than bouncy
        const eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
        el.textContent = Math.round(target * eased) + suffix;
        if (t < 1) requestAnimationFrame(tick);
      };
      el.textContent = '0' + suffix;
      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { run(e.target as HTMLElement); io.unobserve(e.target); }
      }
    }, { threshold: 0.5 });

    nums.forEach((n) => io.observe(n));
  }
</script>

<style>
  /* ---------------------------------------------------------------- Hero */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + var(--space-l)) var(--space-xl);
    margin-top: calc(var(--header-h) * -1);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-l);
    align-items: center;
    width: 100%;
  }

  .hero__title {
    margin-top: -6px;
    /* Sized so the longest line ("in CARDIOLOGY") never wraps. */
    font-size: clamp(2.3rem, 1.35rem + 3.7vw, 5rem);
    color: var(--text-strong);
  }
  .hero__line { display: block; white-space: nowrap; }
  /* Italic serif accent with the blue-to-crimson wash, as in the source build. */
  .hero__title em {
    font-style: italic;
    background: linear-gradient(100deg, var(--blue) 0%, var(--red) 62%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__lede { margin-top: var(--space-m); }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  .hero__art {
    position: relative;
    justify-self: center;
    animation: float 9s ease-in-out infinite;
  }
  .hero__art img {
    width: auto;
    height: min(74svh, 640px);
    max-width: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    filter: drop-shadow(0 34px 64px rgba(0, 0, 0, 0.20));
    /* Cardiac 'lub-dub': two quick contractions, then a long rest. */
    transform-origin: 50% 55%;
    animation: heartbeat 1.5s ease-in-out infinite;
    will-change: transform;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-14px); }
  }

  @keyframes heartbeat {
    0%   { transform: scale(1); }
    8%   { transform: scale(1.045); }   /* lub */
    16%  { transform: scale(0.998); }
    24%  { transform: scale(1.028); }   /* dub */
    36%  { transform: scale(1); }
    100% { transform: scale(1); }        /* rest - ~64% of the cycle */
  }

  @media (max-width: 900px) {
    .hero { min-height: auto; }
    .hero__inner { grid-template-columns: 1fr; gap: var(--space-m); }
    /* Keep the art from eating the whole first screen so the headline
       still lands above the fold on a phone. */
    .hero__art { order: -1; justify-self: start; }
    .hero__art img { height: min(34svh, 290px); }
  }

  /* ----------------------------------------------------------- Societies */
  .societies { padding-block: var(--space-l); border-block: 1px solid var(--border-soft); }
  .societies__label {
    text-align: center;
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--text-faint);
  }
  .societies__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 1rem + 5vw, 5.5rem);
    margin-top: var(--space-m);
  }
  .societies__item a { display: block; line-height: 0; }
  .societies__item img {
    height: clamp(52px, 40px + 2vw, 76px);
    width: auto;
    filter: grayscale(1) contrast(1.1);
    opacity: 0.8;
    mix-blend-mode: multiply;
    transition: opacity 0.4s var(--ease), filter 0.4s var(--ease);
  }
  .societies__item a:hover img,
  .societies__item a:focus-visible img { opacity: 1; filter: grayscale(0); }

  /* Dark-mode logo variants: the default logos are dark ink on a transparent
     background (mix-blend-mode:multiply relies on a light page behind them),
     so on a dark ground they'd vanish. Swap to a white-on-transparent
     version instead - no multiply blend, since white through "multiply"
     is a no-op and would stay invisible too. */
  .societies__logo--dark { display: none; }
  :root[data-theme='dark'] .societies__logo--light { display: none; }
  :root[data-theme='dark'] .societies__logo--dark {
    display: inline-block;
    mix-blend-mode: normal;
  }
  .societies__item a:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }

  /* ------------------------------------------------------------ Director */
  /* The hero already carries its own bottom padding, so stacking the
     section default on top of it left a big empty gap before the photo. */
  .director { padding-top: var(--space-l); }
  .director__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .director__portrait {
    position: relative;
    padding: 0;
    max-width: 92%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .director__portrait img { width: 100%; height: auto; object-fit: cover; }

  .director__name {
    margin-top: var(--space-s);
    font-size: var(--step-3);
  }
  .director__creds {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    color: var(--text-strong);
  }

  .director__roles {
    display: grid;
    gap: 0.4rem;
    margin-top: var(--space-m);
    font-family: var(--font-sans);
    font-size: var(--step-0);
    color: var(--text);
  }
  .director__roles li {
    list-style: none;
    padding-left: 1.1em;
    position: relative;
    line-height: 1.5;
  }
  .director__roles li::before {
    content: '';
    position: absolute;
    left: 0.15em;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--blue);
  }

  .director__body { margin-block: var(--space-m); }

  .director__socials-label {
    margin: 0 0 0.6rem;
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-faint);
  }

  .director__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .director__socials a {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--ink);
    color: var(--ink);
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .director__socials svg { width: 1.15rem; height: 1.15rem; }
  .director__socials img { width: 1.5rem; height: 1.5rem; object-fit: contain; }
  /* The WSU shield reads smaller than the others at the same box size - its
     ink doesn't reach the edges the way a square glyph does - so it gets a
     bigger box to visually match the rest of the row's zoom/weight. */
  .director__socials-wsu { width: 2.05rem !important; height: 2.05rem !important; }
  .director__socials-dark { display: none; }
  :root[data-theme='dark'] .director__socials-light { display: none; }
  :root[data-theme='dark'] .director__socials-dark { display: block; }
  .director__socials a:hover,
  .director__socials a:focus-visible {
    background: var(--ink);
    color: var(--bg);
    outline: none;
  }

  @media (max-width: 820px) {
    .director__grid { grid-template-columns: 1fr; }
    .director__portrait { max-width: 420px; }
  }

  /* -------------------------------------------------------------- Impact */
  .impact { position: relative; isolation: isolate; overflow: hidden; }
  .impact__bg { position: absolute; inset: 0; z-index: -1; }
  .impact__bg img {
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.15;
    filter: saturate(0.8);
  }

  .impact__title { font-size: var(--step-4); margin-top: var(--space-s); }

  .impact__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin-top: var(--space-xl);
    background: var(--on-dark-border);
    border: 1px solid var(--on-dark-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .stat {
    background: var(--dark);
    padding: var(--space-m) var(--space-s);
  }
  .stat__value {
    font-family: var(--font-serif);
    font-size: var(--step-4);
    font-weight: 600;
    line-height: 1;
    color: var(--on-dark-accent);
  }
  .stat__label {
    margin-top: 0.7rem;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--on-dark-muted);
    max-width: 22ch;
  }

  @media (max-width: 860px) { .impact__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .impact__grid { grid-template-columns: 1fr; } }

  /* Second row, same tile language - the research page's manuscript/
     abstract/researcher counts, three compartments instead of four. */
  .impact__grid--research { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 700px) { .impact__grid--research { grid-template-columns: 1fr; } }

  /* ------------------------------------------------------------- Pillars */
  .pillars__title { font-size: var(--step-3); margin-top: var(--space-s); }

  .pillars__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--space-m);
    margin-top: var(--space-l);
  }

  .pillar { display: flex; flex-direction: column; overflow: hidden; }
  .pillar__media { display: block; aspect-ratio: 4 / 3; }
  .pillar__media img { width: 100%; height: 100%; object-fit: cover; }

  .pillar__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: var(--space-m) var(--space-s) var(--space-m);
    flex: 1;
  }
  .pillar__title {
    font-size: var(--step-2);
    letter-spacing: -0.015em;
  }
  .pillar__text { font-size: var(--step--1); line-height: 1.65; color: var(--text-muted); }
  .pillar__link {
    margin-top: auto;
    padding-top: var(--space-s);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--blue);
  }
</style>
