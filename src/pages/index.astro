---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import Societies from '../components/Societies.astro';
import { researchStats } from '../data/site';

---

<BaseLayout title="Home" transparentHeader>
  {/* ---------------------------------------------------------------- Hero */}
  <section class="hero grid-ground" data-exit-scene>
    <div class="shell shell--wide hero__inner">
      <h1 class="display hero__title">
        <span class="hero__line" style="--k:0">Charting</span>
        <span class="hero__line" style="--k:1">New Paths</span>
        <span class="hero__line" style="--k:2">in <em>Cardiology</em></span>
      </h1>

      <div class="hero__art" aria-hidden="true">
        <img
          src="/assets/brand/heart-anatomical.png"
          alt=""
          fetchpriority="high"
          decoding="async"
          width="381"
          height="690"
        />
      </div>

      <div class="hero__rest">
        <p class="lede hero__lede">
          A collaboration of more than three hundred researcher-physicians,
          publishing, presenting, and teaching at the frontiers of cardiovascular medicine.
        </p>
        <div class="hero__actions">
          <a class="btn" href="/research-group">
            Explore the lab <span class="btn__arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn btn--ghost" href="/education#heart-trending">Watch Heart Trending</a>
        </div>
      </div>
    </div>
  </section>

  <Societies />

  {/* ------------------------------------------------------------------ Impact */}
  <section class="section--tall impact dark-ground">
    <div class="impact__bg" aria-hidden="true">
      <img src="/assets/home/aorta.webp" alt="" loading="lazy" decoding="async" data-parallax="0.12" />
    </div>

    <div class="shell shell--wide">
      <header class="impact__head section-head" data-reveal>
        <h2 class="display impact__title">Impact<br />through<br />excellence</h2>
      </header>

      <dl class="impact__grid impact__grid--research">
        {researchStats.map((s, i) => (
          <div class="stat" data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <dt class="stat__value" data-count={s.value}>{s.value}</dt>
            <dd class="stat__label">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* --------------------------------------------------------------- Pillars */}
  <section class="section pillars">
    <div class="shell shell--wide">
      <header class="pillars__head section-head" data-reveal>
        <h2 class="display pillars__title">Two domains, one mission</h2>
      </header>

      <div class="pillars__grid pillars__grid--two" data-stack>
        <a class="pillar card" href="/research-group" data-reveal>
          <span class="media pillar__media">
            <img src="/assets/research/mca-research-lab-team.webp" alt="" loading="lazy" decoding="async" />
          </span>
          <span class="pillar__body">
            <h3 class="pillar__title">MCA Heart Research Lab</h3>
            <span class="pillar__text">
              300+ researchers, 75+ manuscripts and 150+ abstracts a year across
              SCAI, AHA, TCT and ACC.
            </span>
            <span class="link-underline pillar__link">Explore &rarr;</span>
          </span>
        </a>

        <a class="pillar card" href="/education" data-reveal style="--reveal-delay:110ms">
          <span class="media pillar__media">
            <img src="/assets/education/hotm-thumb.jpg" alt="" loading="lazy" decoding="async" />
          </span>
          <span class="pillar__body">
            <h3 class="pillar__title">Education</h3>
            <span class="pillar__text">
              Heart Trending and Heart of the Matter - interviews between
              cardiologists, and residents reviewing the latest research.
            </span>
            <span class="link-underline pillar__link">Learn &rarr;</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <CTABanner
    title="Learn more about us"
    body="Whether you are an aspiring research fellow seeking mentorship or a seasoned professional looking to contribute, there is a place for you here."
    ctaLabel="Get in touch"
    ctaHref="/contact"
    image="/assets/home/group-photo.webp"
  />
</BaseLayout>

<script>
  // Count-up on the impact figures. Values like "100+" keep their suffix.
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (nums.length && !reduced && 'IntersectionObserver' in window) {
    const run = (el: HTMLElement) => {
      const raw = el.dataset.count ?? '';
      const target = parseInt(raw.replace(/\D/g, ''), 10);
      const suffix = raw.replace(/[0-9]/g, '');
      if (!target) return;

      const DURATION = 1400;
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min((now - start) / DURATION, 1);
        // easeOutExpo - fast then settling, reads as precise rather than bouncy
        const eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
        el.textContent = Math.round(target * eased) + suffix;
        if (t < 1) requestAnimationFrame(tick);
      };
      el.textContent = '0' + suffix;
      requestAnimationFrame(tick);
    };

    // Replays whenever the figures come back up from below, matching the
    // reversible reveals around them.
    const armed = new WeakSet<Element>(nums);
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting && armed.has(e.target)) {
          armed.delete(e.target);
          run(e.target as HTMLElement);
        } else if (!e.isIntersecting && e.boundingClientRect.top > 0) {
          armed.add(e.target);
        }
      }
    }, { threshold: 0.5 });

    nums.forEach((n) => io.observe(n));
  }
</script>

<style>
  /* ---------------------------------------------------------------- Hero */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + var(--space-l)) var(--space-xl);
    margin-top: calc(var(--header-h) * -1);
    overflow: hidden;
  }

  /* Three named grid items (title / art / rest, "rest" being the lede +
     buttons) instead of one bundled copy block, so the art can share a
     row with just the title on mobile instead of sitting above the
     whole copy stack. */
  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    grid-template-areas: 'title art' 'rest art';
    gap: var(--space-l);
    align-items: center;
    width: 100%;
  }

  .hero__title {
    grid-area: title;
    margin-top: -6px;
    /* Sized so the longest line ("in CARDIOLOGY") never wraps. */
    font-size: clamp(2.3rem, 1.35rem + 3.7vw, 5rem);
    color: var(--text-strong);
  }
  .hero__line { display: block; white-space: nowrap; }
  /* Italic serif accent with the blue-to-crimson wash, as in the source build. */
  .hero__title em {
    font-style: italic;
    background: linear-gradient(100deg, var(--blue) 0%, var(--red) 62%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__rest { grid-area: rest; }
  .hero__lede { margin-top: var(--space-m); }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  .hero__art {
    grid-area: art;
    position: relative;
    justify-self: center;
    animation: float 9s ease-in-out infinite;
  }
  .hero__art img {
    width: auto;
    height: min(74svh, 640px);
    max-width: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    /* Cardiac 'lub-dub': two quick contractions, then a long rest. */
    transform-origin: 50% 55%;
    animation: heartbeat 1.5s ease-in-out infinite;
    will-change: transform;
  }

  /* The heart's shadow is a painted ellipse, not filter: drop-shadow() - the
     filter had to be re-rendered every frame while the heart scales and
     turns on scroll-away, which cost ~10 dropped frames per pass. */
  .hero__art::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: 14%;
    right: 14%;
    bottom: -3%;
    height: 9%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.26), transparent);
    pointer-events: none;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-14px); }
  }

  @keyframes heartbeat {
    0%   { transform: scale(1); }
    8%   { transform: scale(1.045); }   /* lub */
    16%  { transform: scale(0.998); }
    24%  { transform: scale(1.028); }   /* dub */
    36%  { transform: scale(1); }
    100% { transform: scale(1); }        /* rest - ~64% of the cycle */
  }

  @media (max-width: 900px) {
    .hero { min-height: auto; }
    /* The heart sits beside the title, not above the whole copy block -
       title takes the wider column, art the narrower one, and the lede +
       buttons drop to a full-width row underneath both. */
    .hero__inner {
      --art-col: clamp(84px, 26vw, 190px);
      grid-template-columns: minmax(0, 1fr) var(--art-col);
      grid-template-areas: 'title art' 'rest rest';
      column-gap: var(--space-s);
      row-gap: var(--space-m);
    }
    /* The lines never wrap, so the size is capped by what's left beside the
       art: the longest line ("in Cardiology") is ~6.2em wide. Without the
       cap the title pushed the grid past the screen below ~440px and the
       lede + heart were clipped. */
    .hero__title {
      align-self: center;
      font-size: min(
        clamp(2.3rem, 1.35rem + 3.7vw, 5rem),
        calc((100vw - 2 * var(--gutter) - var(--art-col) - var(--space-s)) / 6.5)
      );
    }
    .hero__art { justify-self: end; align-self: center; }
    .hero__art img { height: auto; width: 100%; }
  }

  /* Phone: same composition as tablet - headline left, heart right beside
     it, lede + two full-width actions underneath in thumb reach. The
     headline is sized to the room left beside the heart: its longest line
     ("in Cardiology") is ~6.2em, 6.45 leaves room for the italic y. */
  @media (max-width: 760px) {
    .hero {
      min-height: calc(100svh - var(--dock-space));
      padding-block: calc(var(--header-h) + var(--space-s)) var(--space-m);
    }
    .hero__inner {
      --art-col: clamp(100px, 33vw, 200px);
      column-gap: var(--space-s);
      row-gap: var(--space-m);
    }
    .hero__art { animation-name: float-sm; }
    .hero__title {
      margin-top: 0;
      line-height: 0.98;
      font-size: min(
        4.25rem,
        calc((100vw - 2 * var(--gutter) - var(--art-col) - var(--space-s)) / 6.45)
      );
    }
    .hero__lede { margin-top: 0; font-size: 1.125rem; max-width: 36ch; }
    .hero__actions {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      margin-top: var(--space-m);
    }
    .hero__actions .btn { min-height: 50px; font-size: 0.9375rem; }
  }
  @keyframes float-sm {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }

  /* Scroll-away (every size): as the hero leaves, the three headline lines
     shear apart in alternating directions, the heart lifts, swells and
     turns, and the copy lifts away. --xs is written by effects.ts. */
  .hero__line {
    translate: calc(var(--xs, 0) * var(--dir) * 42vw) 0;
  }
  .hero__line:nth-child(1) { --dir: -1; }
  .hero__line:nth-child(2) { --dir: 0.8; }
  .hero__line:nth-child(3) { --dir: -0.55; }
  .hero__title { opacity: calc(1 - var(--xs, 0) * 1.2); }
  .hero__art {
    translate: 0 calc(var(--xs, 0) * -24svh);
    scale: calc(1 + var(--xs, 0) * 0.3);
    rotate: calc(var(--xs, 0) * -10deg);
  }
  .hero__rest {
    opacity: calc(1 - var(--xs, 0) * 1.7);
    translate: 0 calc(var(--xs, 0) * -56px);
  }

  /* First paint: the lines slide in from their own exit direction. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__line { animation: hero-line-in 1s var(--ease-out) both; animation-delay: calc(var(--k) * 90ms + 80ms); }
    .hero__rest { animation: hero-rest-in 0.9s var(--ease-out) 0.38s both; }
  }
  @keyframes hero-line-in { from { opacity: 0; transform: translateX(calc(var(--dir) * 12%)); } }
  @keyframes hero-rest-in { from { opacity: 0; transform: translateY(18px); } }

  /* -------------------------------------------------------------- Impact */
  .impact { position: relative; isolation: isolate; overflow: hidden; }
  .impact__bg { position: absolute; inset: 0; z-index: -1; }
  .impact__bg img {
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.15;
    filter: saturate(0.8);
  }

  .impact__title { font-size: var(--step-4); margin-top: var(--space-s); }

  .impact__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin-top: var(--space-xl);
    background: var(--on-dark-border);
    border: 1px solid var(--on-dark-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .stat {
    background: var(--dark);
    padding: var(--space-m) var(--space-s);
  }
  .stat__value {
    font-family: var(--font-serif);
    font-size: var(--step-4);
    font-weight: 600;
    line-height: 1;
    color: var(--on-dark-accent);
    /* Count-up runs through every digit - fixed-width digits stop the
       figure (and its label on phones) from jittering sideways. */
    font-variant-numeric: tabular-nums;
  }
  .stat__label {
    margin-top: 0.7rem;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--on-dark-muted);
    max-width: 22ch;
  }

  @media (max-width: 860px) { .impact__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .impact__grid { grid-template-columns: 1fr; } }

  /* Second row, same tile language - the research page's manuscript/
     abstract/researcher counts, three compartments instead of four. */
  .impact__grid--research { grid-template-columns: repeat(3, 1fr); }
  /* Wider tiles (3 columns instead of 4) - let the label use the room
     instead of wrapping at the general 22ch cap. */
  .impact__grid--research .stat__label { max-width: none; white-space: nowrap; }
  @media (max-width: 700px) { .impact__grid--research .stat__label { white-space: normal; } }
  @media (max-width: 700px) { .impact__grid--research { grid-template-columns: 1fr; } }

  /* Phones: a compact ledger - figure and label on one row per stat instead
     of three tall tiles that each fill most of a screen. */
  @media (max-width: 560px) {
    .impact__grid { margin-top: var(--space-l); }
    .stat {
      display: grid;
      grid-template-columns: 6.4rem 1fr;
      align-items: center;
      column-gap: var(--space-s);
      padding: var(--space-s);
    }
    .stat__value { font-size: clamp(2rem, 1.3rem + 3vw, 2.4rem); }
    .stat__label { margin-top: 0; font-size: 0.875rem; }
  }

  /* ------------------------------------------------------------- Pillars */
  .pillars__title { font-size: var(--step-3); margin-top: var(--space-s); }

  .pillars__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--space-m);
    margin-top: var(--space-l);
  }
  /* Two cards only, not three - capped and centered so they don't stretch
     into two oversized panels on a wide desktop screen. Still auto-fit, so
     it collapses to one column on its own once the container gets tight
     (tablet widths), same as the three-card version did. */
  .pillars__grid--two {
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: var(--space-xl);
    max-width: 980px;
    margin-inline: auto;
  }
  /* Only this section's heading centers - .section-head is shared with
     Impact above it, which stays left-aligned. */
  .pillars__head { text-align: center; }

  .pillar { display: flex; flex-direction: column; overflow: hidden; }
  .pillar__media { display: block; aspect-ratio: 4 / 3; }
  .pillar__media img { width: 100%; height: 100%; object-fit: cover; }

  .pillar__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: var(--space-m) var(--space-s) var(--space-m);
    flex: 1;
  }
  .pillar__title {
    font-size: var(--step-2);
    letter-spacing: -0.015em;
  }
  .pillar__text { font-size: var(--step--1); line-height: 1.65; color: var(--text-muted); }
  .pillar__link {
    margin-top: auto;
    padding-top: var(--space-s);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--blue);
  }

  /* One column on phones - a wider, shorter image keeps each card to about
     one screen instead of an image-then-scroll-then-text sequence. */
  /* Phones: the three arms stack like a deck (data-stack) - each card pins
     near the top and the next one slides up over it. */
  @media (max-width: 760px) {
    .pillars__grid { margin-top: var(--space-m); gap: var(--space-l); }
    .pillar__media { aspect-ratio: 16 / 10; }
    .pillar__body { padding: var(--space-s) var(--space-s) var(--space-m); }
    .pillar__title { font-size: 1.75rem; }
    .pillar__text { font-size: 1rem; }
  }
</style>
