---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import Societies from '../components/Societies.astro';
import { director, researchStats } from '../data/site';

// Icon-only profile-link buttons on the director card. X and LinkedIn are
// single-color (currentColor) SVGs, so they follow the button's own text
// color with no separate light/dark asset needed. DMC uses a plain
// hospital-cross pictogram (Material Design icons, Apache-2.0) - its actual
// trademarked logo wasn't sourced. WSU and ResearchGate use their real
// logos (supplied directly) as image assets instead - see the markup below;
// ResearchGate's mark is flat dark ink, so it gets a white dark-mode
// variant the same way the society logos do, WSU's shield already has its
// own light outline so one image works in both themes.
const DIRECTOR_ICONS: Record<string, string> = {
  x: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
  linkedin:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
  hospital:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-1 11h-4v4h-4v-4H6v-4h4V6h4v4h4v4z"/></svg>',
};
---

<BaseLayout title="Home" transparentHeader>
  {/* ---------------------------------------------------------------- Hero */}
  <section class="hero grid-ground" data-exit-scene>
    <div class="shell shell--wide hero__inner">
      <h1 class="display hero__title">
        <span class="hero__line" style="--k:0">Charting</span>
        <span class="hero__line" style="--k:1">New Paths</span>
        <span class="hero__line" style="--k:2">in <em>Cardiology</em></span>
      </h1>

      <div class="hero__art" aria-hidden="true">
        <img
          src="/assets/brand/heart-anatomical.png"
          alt=""
          fetchpriority="high"
          decoding="async"
          width="381"
          height="690"
        />
      </div>

      <div class="hero__rest">
        <p class="lede hero__lede">
          A collaboration of more than three hundred researcher-physicians,
          publishing, presenting, and teaching at the frontiers of cardiovascular medicine.
        </p>
        <div class="hero__actions">
          <a class="btn" href="/research-group">
            Explore the group <span class="btn__arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn btn--ghost" href="/heart-trending">Watch Heart Trending</a>
        </div>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------------- Director */}
  <section class="section director">
    <div class="shell shell--wide director__grid">
      <figure class="director__portrait" data-reveal>
        {/* No data-parallax here: the parallax utility zooms an image ~16%
            to buffer its drift, which cropped the head off this portrait -
            headroom that's fine on a wide background photo isn't fine on a
            tight headshot. */}
        <img
          src="/assets/home/alraies-portrait.webp"
          alt={`Portrait of ${director.name}`}
          loading="lazy"
          decoding="async"
          width="700"
          height="850"
        />
      </figure>

      <div class="director__copy" data-reveal style="--reveal-delay:120ms">
        <h2 class="director__name">
          {director.name}<span class="director__creds"><span class="director__comma">, </span>{director.credentialsFull}</span>
        </h2>
        <ul class="director__roles">
          {director.roles.map((r) => <li>{r}</li>)}
        </ul>
        <p class="prose director__body">
          {director.name}, {director.credentials} leads the MCA Heart Research Lab's clinical and
          academic programme, mentoring trainees from medical school through interventional
          fellowship and anchoring the group's presence at the major cardiology congresses.
        </p>
        <p class="director__socials-label">Connect</p>
        <ul class="director__socials">
          {director.links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener noreferrer" aria-label={l.label} title={l.label}>
                {l.icon === 'university' ? (
                  <img class="director__socials-wsu" src="/assets/home/logo-wsu.webp" alt="" loading="lazy" decoding="async" />
                ) : l.icon === 'researchgate' ? (
                  <>
                    <img class="director__socials-light" src="/assets/home/logo-researchgate.webp" alt="" loading="lazy" decoding="async" />
                    <img class="director__socials-dark" src="/assets/home/logo-researchgate-dark.webp" alt="" loading="lazy" decoding="async" />
                  </>
                ) : (
                  <Fragment set:html={DIRECTOR_ICONS[l.icon]} />
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Societies />

  {/* ------------------------------------------------------------------ Impact */}
  <section class="section--tall impact dark-ground">
    <div class="impact__bg" aria-hidden="true">
      <img src="/assets/home/aorta.webp" alt="" loading="lazy" decoding="async" data-parallax="0.12" />
    </div>

    <div class="shell shell--wide">
      <header class="impact__head section-head" data-reveal>
        <h2 class="display impact__title">Impact<br />through<br />excellence</h2>
      </header>

      <dl class="impact__grid impact__grid--research">
        {researchStats.map((s, i) => (
          <div class="stat" data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <dt class="stat__value" data-count={s.value}>{s.value}</dt>
            <dd class="stat__label">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* --------------------------------------------------------------- Pillars */}
  <section class="section pillars">
    <div class="shell shell--wide">
      <header class="pillars__head section-head" data-reveal>
        <h2 class="display pillars__title">Three arms, one mission</h2>
      </header>

      <div class="pillars__grid" data-stack>
        <a class="pillar card" href="/research-group" data-reveal>
          <span class="media pillar__media">
            <img src="/assets/research/mca-research-lab-team.webp" alt="" loading="lazy" decoding="async" />
          </span>
          <span class="pillar__body">
            <h3 class="pillar__title">MCA Heart Research Lab</h3>
            <span class="pillar__text">
              300+ researchers, 75+ manuscripts and 150+ abstracts a year across
              SCAI, AHA, TCT and ACC.
            </span>
            <span class="link-underline pillar__link">Explore &rarr;</span>
          </span>
        </a>

        <a class="pillar card" href="/heart-trending" data-reveal style="--reveal-delay:110ms">
          <span class="media pillar__media">
            <img src="/assets/trending/video-1.jpg" alt="" loading="lazy" decoding="async" />
          </span>
          <span class="pillar__body">
            <h3 class="pillar__title">Heart Trending</h3>
            <span class="pillar__text">
              Interviews with leading cardiologists, congress wrap-ups, journal
              reviews and webinars.
            </span>
            <span class="link-underline pillar__link">Watch &rarr;</span>
          </span>
        </a>

        <a class="pillar card" href="/education" data-reveal style="--reveal-delay:220ms">
          <span class="media pillar__media">
            <img src="/assets/education/hotm-thumb.jpg" alt="" loading="lazy" decoding="async" />
          </span>
          <span class="pillar__body">
            <h3 class="pillar__title">Education</h3>
            <span class="pillar__text">
              Heart of the Matter and the monthly webinar series, reviewing the
              science shaping heart health.
            </span>
            <span class="link-underline pillar__link">Learn &rarr;</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <CTABanner
    title="Learn more about us"
    body="Whether you are an aspiring research fellow seeking mentorship or a seasoned professional looking to contribute, there is a place for you here."
    ctaLabel="Get in touch"
    ctaHref="/contact"
    image="/assets/home/group-photo.webp"
  />
</BaseLayout>

<script>
  // Count-up on the impact figures. Values like "100+" keep their suffix.
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (nums.length && !reduced && 'IntersectionObserver' in window) {
    const run = (el: HTMLElement) => {
      const raw = el.dataset.count ?? '';
      const target = parseInt(raw.replace(/\D/g, ''), 10);
      const suffix = raw.replace(/[0-9]/g, '');
      if (!target) return;

      const DURATION = 1400;
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min((now - start) / DURATION, 1);
        // easeOutExpo - fast then settling, reads as precise rather than bouncy
        const eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
        el.textContent = Math.round(target * eased) + suffix;
        if (t < 1) requestAnimationFrame(tick);
      };
      el.textContent = '0' + suffix;
      requestAnimationFrame(tick);
    };

    // Replays whenever the figures come back up from below, matching the
    // reversible reveals around them.
    const armed = new WeakSet<Element>(nums);
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting && armed.has(e.target)) {
          armed.delete(e.target);
          run(e.target as HTMLElement);
        } else if (!e.isIntersecting && e.boundingClientRect.top > 0) {
          armed.add(e.target);
        }
      }
    }, { threshold: 0.5 });

    nums.forEach((n) => io.observe(n));
  }
</script>

<style>
  /* ---------------------------------------------------------------- Hero */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + var(--space-l)) var(--space-xl);
    margin-top: calc(var(--header-h) * -1);
    overflow: hidden;
  }

  /* Three named grid items (title / art / rest, "rest" being the lede +
     buttons) instead of one bundled copy block, so the art can share a
     row with just the title on mobile instead of sitting above the
     whole copy stack. */
  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    grid-template-areas: 'title art' 'rest art';
    gap: var(--space-l);
    align-items: center;
    width: 100%;
  }

  .hero__title {
    grid-area: title;
    margin-top: -6px;
    /* Sized so the longest line ("in CARDIOLOGY") never wraps. */
    font-size: clamp(2.3rem, 1.35rem + 3.7vw, 5rem);
    color: var(--text-strong);
  }
  .hero__line { display: block; white-space: nowrap; }
  /* Italic serif accent with the blue-to-crimson wash, as in the source build. */
  .hero__title em {
    font-style: italic;
    background: linear-gradient(100deg, var(--blue) 0%, var(--red) 62%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__rest { grid-area: rest; }
  .hero__lede { margin-top: var(--space-m); }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  .hero__art {
    grid-area: art;
    position: relative;
    justify-self: center;
    animation: float 9s ease-in-out infinite;
  }
  .hero__art img {
    width: auto;
    height: min(74svh, 640px);
    max-width: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    /* Cardiac 'lub-dub': two quick contractions, then a long rest. */
    transform-origin: 50% 55%;
    animation: heartbeat 1.5s ease-in-out infinite;
    will-change: transform;
  }

  /* The heart's shadow is a painted ellipse, not filter: drop-shadow() - the
     filter had to be re-rendered every frame while the heart scales and
     turns on scroll-away, which cost ~10 dropped frames per pass. */
  .hero__art::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: 14%;
    right: 14%;
    bottom: -3%;
    height: 9%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.26), transparent);
    pointer-events: none;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-14px); }
  }

  @keyframes heartbeat {
    0%   { transform: scale(1); }
    8%   { transform: scale(1.045); }   /* lub */
    16%  { transform: scale(0.998); }
    24%  { transform: scale(1.028); }   /* dub */
    36%  { transform: scale(1); }
    100% { transform: scale(1); }        /* rest - ~64% of the cycle */
  }

  @media (max-width: 900px) {
    .hero { min-height: auto; }
    /* The heart sits beside the title, not above the whole copy block -
       title takes the wider column, art the narrower one, and the lede +
       buttons drop to a full-width row underneath both. */
    .hero__inner {
      --art-col: clamp(84px, 26vw, 190px);
      grid-template-columns: minmax(0, 1fr) var(--art-col);
      grid-template-areas: 'title art' 'rest rest';
      column-gap: var(--space-s);
      row-gap: var(--space-m);
    }
    /* The lines never wrap, so the size is capped by what's left beside the
       art: the longest line ("in Cardiology") is ~6.2em wide. Without the
       cap the title pushed the grid past the screen below ~440px and the
       lede + heart were clipped. */
    .hero__title {
      align-self: center;
      font-size: min(
        clamp(2.3rem, 1.35rem + 3.7vw, 5rem),
        calc((100vw - 2 * var(--gutter) - var(--art-col) - var(--space-s)) / 6.5)
      );
    }
    .hero__art { justify-self: end; align-self: center; }
    .hero__art img { height: auto; width: 100%; }
  }

  /* Phone: a full-screen poster, not the desktop grid shrunk. The heart is
     the image - large, bleeding off the right edge and tucked behind the
     headline - with the headline set as big as the width allows, then the
     lede and two full-width actions in thumb reach. */
  @media (max-width: 760px) {
    .hero {
      align-items: stretch;
      min-height: calc(100svh - var(--dock-space));
      padding-block: calc(var(--header-h) + var(--space-2xs)) var(--space-m);
    }
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(28svh, 1fr) auto auto;
      grid-template-areas: 'art' 'title' 'rest';
      row-gap: var(--space-s);
      align-items: end;
    }
    .hero__art {
      align-self: stretch;
      justify-self: stretch;
      animation-name: float-sm;
    }
    .hero__art::after { left: auto; right: 2%; width: 58%; bottom: calc(-7svh - 1%); height: 7%; }
    /* Absolutely placed so the 690px-tall source image never sizes the row. */
    .hero__art img {
      position: absolute;
      right: calc(-0.06 * 100vw);
      bottom: -7svh;
      height: calc(100% + 7svh);
      width: auto;
      max-width: none;
    }
    .hero__title {
      position: relative;
      z-index: 1;
      align-self: end;
      margin-top: 0;
      font-size: min(4.25rem, calc((100vw - 2 * var(--gutter)) / 6.35));
      line-height: 0.94;
    }
    .hero__lede { margin-top: 0; font-size: 1.125rem; max-width: 36ch; }
    .hero__actions {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      margin-top: var(--space-m);
    }
    .hero__actions .btn { min-height: 50px; font-size: 0.9375rem; }
  }
  @keyframes float-sm {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }

  /* Scroll-away (every size): as the hero leaves, the three headline lines
     shear apart in alternating directions, the heart lifts, swells and
     turns, and the copy lifts away. --xs is written by effects.ts. */
  .hero__line {
    translate: calc(var(--xs, 0) * var(--dir) * 42vw) 0;
  }
  .hero__line:nth-child(1) { --dir: -1; }
  .hero__line:nth-child(2) { --dir: 0.8; }
  .hero__line:nth-child(3) { --dir: -0.55; }
  .hero__title { opacity: calc(1 - var(--xs, 0) * 1.2); }
  .hero__art {
    translate: 0 calc(var(--xs, 0) * -24svh);
    scale: calc(1 + var(--xs, 0) * 0.3);
    rotate: calc(var(--xs, 0) * -10deg);
  }
  .hero__rest {
    opacity: calc(1 - var(--xs, 0) * 1.7);
    translate: 0 calc(var(--xs, 0) * -56px);
  }

  /* First paint: the lines slide in from their own exit direction. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__line { animation: hero-line-in 1s var(--ease-out) both; animation-delay: calc(var(--k) * 90ms + 80ms); }
    .hero__rest { animation: hero-rest-in 0.9s var(--ease-out) 0.38s both; }
  }
  @keyframes hero-line-in { from { opacity: 0; transform: translateX(calc(var(--dir) * 12%)); } }
  @keyframes hero-rest-in { from { opacity: 0; transform: translateY(18px); } }

  /* ------------------------------------------------------------ Director */
  /* The hero already carries its own bottom padding, so stacking the
     section default on top of it left a big empty gap before the photo. */
  .director { padding-top: var(--space-l); }
  .director__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .director__portrait {
    position: relative;
    padding: 0;
    max-width: 92%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .director__portrait img { width: 100%; height: auto; object-fit: cover; }

  .director__name {
    margin-top: var(--space-s);
    font-size: var(--step-3);
  }
  .director__creds {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    color: var(--text-strong);
  }

  .director__roles {
    display: grid;
    gap: 0.4rem;
    margin-top: var(--space-m);
    font-family: var(--font-sans);
    font-size: var(--step-0);
    color: var(--text);
  }
  .director__roles li {
    list-style: none;
    padding-left: 1.1em;
    position: relative;
    line-height: 1.5;
  }
  .director__roles li::before {
    content: '';
    position: absolute;
    left: 0.15em;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--blue);
  }

  .director__body { margin-block: var(--space-m); }

  .director__socials-label {
    margin: 0 0 0.6rem;
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-faint);
  }

  .director__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .director__socials a {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--ink);
    color: var(--ink);
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .director__socials svg { width: 1.15rem; height: 1.15rem; }
  .director__socials img { width: 1.5rem; height: 1.5rem; object-fit: contain; }
  /* The WSU shield reads smaller than the others at the same box size - its
     ink doesn't reach the edges the way a square glyph does - so it gets a
     bigger box to visually match the rest of the row's zoom/weight. */
  .director__socials-wsu { width: 2.05rem !important; height: 2.05rem !important; }
  .director__socials-dark { display: none; }
  :root[data-theme='dark'] .director__socials-light { display: none; }
  :root[data-theme='dark'] .director__socials-dark { display: block; }
  .director__socials a:hover,
  .director__socials a:focus-visible {
    background: var(--ink);
    color: var(--bg);
    outline: none;
  }

  @media (max-width: 820px) {
    .director__grid { grid-template-columns: 1fr; }
    .director__portrait { max-width: 420px; }
  }
  /* Phone: a magazine cover - the portrait runs edge to edge and the name is
     set over it, instead of a photo followed by a separate heading. The
     copy column dissolves (display: contents) so its heading can share the
     portrait's grid cell. */
  @media (max-width: 760px) {
    .director { padding-top: 0; }
    .director__grid { row-gap: var(--space-m); }
    .director__copy { display: contents; }
    .director__portrait {
      grid-area: 1 / 1;
      max-width: none;
      margin-inline: calc(-1 * var(--gutter));
      aspect-ratio: 4 / 5;
    }
    .director__portrait img { height: 100%; }
    .director__portrait::after {
      content: '';
      position: absolute;
      inset: 45% 0 0;
      background: linear-gradient(to bottom, transparent, rgba(12, 12, 11, 0.86));
      pointer-events: none;
    }
    .director__name {
      grid-area: 1 / 1;
      align-self: end;
      position: relative;
      z-index: 1;
      margin: 0 0 var(--space-m);
      font-size: clamp(2rem, 1.2rem + 4vw, 2.6rem);
      color: #fff;
    }
    .director__creds {
      display: block;
      margin-top: 0.35rem;
      font-size: 0.9375rem;
      font-family: var(--font-sans);
      letter-spacing: 0.12em;
      color: rgba(255, 255, 255, 0.8);
    }
    .director__comma { display: none; }
    .director__roles { margin-top: 0; }
    .director__socials { gap: 0.6rem; }
    .director__socials a { width: 2.75rem; height: 2.75rem; }
    .director__socials a:active { background: var(--ink); color: var(--bg); }
  }

  /* -------------------------------------------------------------- Impact */
  .impact { position: relative; isolation: isolate; overflow: hidden; }
  .impact__bg { position: absolute; inset: 0; z-index: -1; }
  .impact__bg img {
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.15;
    filter: saturate(0.8);
  }

  .impact__title { font-size: var(--step-4); margin-top: var(--space-s); }

  .impact__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin-top: var(--space-xl);
    background: var(--on-dark-border);
    border: 1px solid var(--on-dark-border);
    border-radius: var(--radius-lg);
