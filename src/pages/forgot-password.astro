---
import AuthShell from '../components/AuthShell.astro';
import { sendResetLink } from '../lib/accounts';

export const prerender = false;

let submitted = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  // Same response whether or not the email has an account.
  if (email) await sendResetLink(email, Astro.url.origin).catch((e) => console.error('[auth] reset link failed:', e));
  submitted = true;
}
---

<AuthShell title="Reset password" description="Request a password reset link.">
  {submitted ? (
    <div class="auth-card">
      <h1 class="auth-card__title">Check your email</h1>
      <p class="auth-ok-box">
        If that email belongs to an account, a reset link is on its way. Links expire after one hour.
      </p>
      <a class="auth-card__link" href="/login">&larr; Back to sign in</a>
    </div>
  ) : (
    <form class="auth-card" method="post" novalidate>
      <h1 class="auth-card__title">Reset your password</h1>
      <p class="auth-card__sub">We'll email you a link to set a new one.</p>

      <div class="auth-field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>

      <button class="btn" type="submit">Send reset link</button>
      <a class="auth-card__link" href="/login">&larr; Back to sign in</a>
    </form>
  )}
</AuthShell>
