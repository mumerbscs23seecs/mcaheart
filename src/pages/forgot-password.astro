---
import AuthShell from '../components/AuthShell.astro';
import { createResetToken } from '../lib/auth';

export const prerender = false;

let submitted = false;
let demoLink: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const token = createResetToken(email);
  submitted = true;
  if (token) demoLink = `${Astro.url.origin}/reset-password?token=${token}`;
}
---

<AuthShell title="Reset password" description="Request a password reset link.">
  {submitted ? (
    <div class="auth-card">
      <h1 class="auth-card__title">Check your email</h1>
      <p class="auth-ok-box">
        If that email belongs to an account, a reset link is on its way. Links expire after one hour.
      </p>
      {demoLink && (
        <p class="auth-linkbox">
          <strong>Demo mode —</strong> no email is sent. Use this link:<br />
          <a href={demoLink}>{demoLink}</a>
        </p>
      )}
      <a class="auth-card__link" href="/login">&larr; Back to sign in</a>
    </div>
  ) : (
    <form class="auth-card" method="post" novalidate>
      <h1 class="auth-card__title">Reset your password</h1>
      <p class="auth-card__sub">We'll email you a link to set a new one.</p>

      <div class="auth-field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>

      <button class="btn" type="submit">Send reset link</button>
      <a class="auth-card__link" href="/login">&larr; Back to sign in</a>
    </form>
  )}
</AuthShell>
