---
import BaseLayout from '../layouts/BaseLayout.astro';
import LayeredScrollHero from '../components/LayeredScrollHero.astro';
import CTABanner from '../components/CTABanner.astro';
import { testimonials, missionVision, director, societies } from '../data/site';
---

<BaseLayout
  title="MCA Heart Research Lab"
  description="Over 300 cardiology researchers led by M Chadi Alraies, MD MPH - 75+ manuscripts and 150+ abstracts a year at SCAI, AHA, TCT and ACC."
>
  <LayeredScrollHero title="MCA Heart Research Lab" />

  {/* ----------------------------------------------------------------- About */}
  <section class="section about" id="about">
    <div class="shell shell--wide about__grid">
      <figure class="about__portrait" data-reveal>
        <img
          src="/assets/research/alraies.jpg"
          alt={`Portrait of ${director.name}`}
          loading="lazy"
          decoding="async"
          width="800"
          height="950"
        />
        <figcaption>
          {director.name}<span>{director.credentials}</span>
        </figcaption>
      </figure>

      <div class="about__copy" data-reveal style="--reveal-delay:120ms">
        <h2 class="about__title">
          Excellence and productivity, at scale
        </h2>
        <div class="prose about__body">
          <p>
            Welcome to the MCA Heart Research Lab, a thriving hub of innovation and
            collaboration in cardiovascular research. Led by M Chadi Alraies, MD MPH and
            supported by two research coordinators, our group unites over 300
            dedicated cardiology researchers.
          </p>
          <p>
            Annually, our research fellows publish 75+ manuscripts in top journals
            and present 150+ abstracts at leading conferences including SCAI, AHA,
            TCT and ACC. Through diverse research opportunities, fellows contribute
            to cardiology&rsquo;s progress while advancing their careers.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------- Mission/Vision */}
  <section class="section--tight mv">
    <div class="shell shell--wide mv__grid">
      {missionVision.map((m, i) => (
        <article class="mv__card" data-reveal style={`--reveal-delay:${i * 120}ms`}>
          <div class="mv__figure">
            <img src={m.image} alt="" loading="lazy" decoding="async" />
          </div>
          <div class="mv__body">
            <h2 class="mv__kind">{m.kind}</h2>
            <p class="mv__text">{m.body}</p>
          </div>
        </article>
      ))}

    </div>
  </section>

  {/* ------------------------------------------------------------------ PubMed */}
  <section class="section--tight pub">
    <div class="shell shell--wide">
      <div class="pub__main" data-reveal>
        <a
          class="pub__logo"
          href="https://pubmed.ncbi.nlm.nih.gov/?term=chadi+alraies&sort=date&size=200"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View our publications on PubMed"
        >
          <img src="/assets/research/pubmed-logo-blue.svg" alt="PubMed" loading="lazy" decoding="async" />
        </a>
        <p class="pub__title">Our Publications on PubMed</p>
        <a
          class="pub__cta"
          href="https://pubmed.ncbi.nlm.nih.gov/?term=chadi+alraies&sort=date&size=200"
          target="_blank"
          rel="noopener noreferrer"
        >
          View Our Publications <span class="pub__cta-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <dl class="pub__stats" data-reveal style="--reveal-delay:120ms">
        <div class="pub__stat">
          <dt>75+</dt>
          <dd>manuscripts published a year</dd>
        </div>
        <div class="pub__stat">
          <dt>150+</dt>
          <dd>abstracts presented a year</dd>
        </div>
        <div class="pub__stat">
          <dt>300+</dt>
          <dd>active researchers &amp; trainees</dd>
        </div>
      </dl>
    </div>
  </section>

  {/* --------------------------------------------------------------- Societies */}
  <section class="section--tight societies">
    <div class="shell shell--wide">
      <p class="societies__label">Our work has been presented at</p>
      <ul class="societies__list">
        {societies.map((s) => (
          <li class="societies__item">
            <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.name} - view M Chadi Alraies' work indexed here`}>
              <img src={s.logo} alt={s.name} loading="lazy" decoding="async" height="60" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------------- Testimonials */}
  <section class="section voices" id="voices">
    <div class="shell shell--wide">
      <header class="voices__head" data-reveal>
        <h2 class="display voices__title">What our members say</h2>
      </header>

      <div class="voices__grid">
        {testimonials.map((t, i) => (
          <figure class="voice" data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
            <blockquote class="voice__quote">{t.quote}</blockquote>
            <figcaption class="voice__by">
              <img
                class="voice__avatar"
                src={t.photo}
                alt=""
                loading="lazy"
                decoding="async"
                width="400"
                height="400"
              />
              <span class="voice__meta">
                <span class="voice__name">{t.name}</span>
                <span class="voice__affil">{t.affiliation}</span>
                <span class="voice__future">Next: {t.future}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------- Why us */}
  <section class="section--tall why dark-ground" id="why-us">
    <div class="why__bg" aria-hidden="true">
      <img src="/assets/research/networking.jpg" alt="" loading="lazy" decoding="async" />
    </div>

    <div class="shell shell--narrow center" data-reveal>
      <h2 class="display why__title">A supportive ecosystem</h2>
      <div class="prose why__body">
        <p>
          Joining the MCA Heart Research Lab means becoming part of a dynamic ecosystem
          that values collaboration, innovation and excellence.
        </p>
        <p>
          Whether you are an aspiring research fellow seeking unparalleled mentorship
          or a seasoned professional looking to make impactful contributions, our
          group provides the resources, guidance and community to help you succeed.
        </p>
        <p>
          With us, you are not just advancing your career - you are making a
          difference in the lives of patients worldwide.
        </p>
      </div>
    </div>
  </section>

  <CTABanner
    title="Get in touch with us"
    body="Tell us where you are in your training and what you want to work on. We will point you to the right project."
    ctaLabel="Start the conversation"
    ctaHref="/contact"
    image="/assets/home/group-photo.jpg"
  />
</BaseLayout>

<style>
  /* ----------------------------------------------------------------- About */
  .about__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }

  .about__portrait {
    position: relative;
    padding: 0.5rem 0.5rem 0;
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  .about__portrait img {
    width: 100%; height: auto;
    border-radius: calc(var(--radius-lg) - 6px);
  }
  .about__portrait figcaption {
    display: grid;
    gap: 0.2rem;
    padding: var(--space-s) 0.2rem 0.3rem;
    font-family: var(--font-serif);
    font-size: var(--step-1);
  }
  .about__portrait figcaption span {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .about__title { font-size: var(--step-3); margin-top: var(--space-s); max-width: 16ch; }
  .about__body { margin-top: var(--space-m); }

  @media (max-width: 880px) {
    .about__grid { grid-template-columns: 1fr; }
    .about__portrait { max-width: 400px; }
  }

  /* ------------------------------------------------------- Mission / Vision */
  .mv__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
  }
  @media (max-width: 760px) {
    .mv__grid { grid-template-columns: 1fr; }
  }
  .mv__card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-l);
    align-items: center;
    padding: var(--space-l);
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-top: 2px solid var(--blue);
    border-radius: var(--radius);
  }

  /* The supplied artwork is flat vector stock; a small tinted plate keeps it
     as a supporting mark rather than a competing background. */
  .mv__figure {
    width: clamp(96px, 70px + 6vw, 148px);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0;
    background: var(--bg-tint);
    border: 1px solid var(--border-soft);
  }
  .mv__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
    filter: saturate(0.75) contrast(0.95);
  }

  .mv__kind {
    font-size: var(--step-2);
    letter-spacing: -0.015em;
    color: var(--text-strong);
  }
  .mv__text {
    margin-top: var(--space-xs);
    font-size: var(--step-0);
    line-height: 1.75;
    color: var(--text);
    max-width: 70ch;
  }

  @media (max-width: 620px) {
    .mv__card { grid-template-columns: 1fr; align-items: start; }
  }

  /* ------------------------------------------------------------------ PubMed */
  .pub { padding-block: var(--space-xl); background: var(--bg-tint); border-block: 1px solid var(--border-soft); }

  .pub__main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    text-align: center;
  }
  .pub__logo {
    display: grid;
    place-items: center;
    width: clamp(150px, 110px + 10vw, 220px);
    padding: 0.8rem 1.2rem;
  }
  .pub__logo img {
    width: 100%;
    height: auto;
    display: block;
    transition: opacity 0.25s var(--ease);
  }
  .pub__logo:hover img,
  .pub__logo:focus-visible img { opacity: 0.75; }
  .pub__logo:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }
  .pub__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    color: var(--text-strong);
    letter-spacing: -0.012em;
    margin-top: var(--space-xs);
  }

  .pub__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    margin-top: var(--space-s);
    padding: 0.95em 1.8em;
    background: var(--blue);
    color: #fff;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 700;
    transition: background 0.25s var(--ease);
  }
  .pub__cta:hover,
  .pub__cta:focus-visible { background: var(--blue-deep); }
  .pub__cta-arrow { transition: transform 0.25s var(--ease-out); }
  .pub__cta:hover .pub__cta-arrow,
  .pub__cta:focus-visible .pub__cta-arrow { transform: translateX(4px); }

  .pub__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: var(--space-xl);
    border-left: 1px solid var(--border-soft);
  }
  .pub__stat {
    min-height: 148px;
    padding: var(--space-s);
    border-right: 1px solid var(--border-soft);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .pub__stat:last-child { border-right: 0; }
  .pub__stat dt {
    font-family: var(--font-serif);
    font-size: var(--step-4);
    font-weight: 700;
    color: var(--blue);
    line-height: 1;
  }
  .pub__stat dd {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    line-height: 1.35;
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .pub__stats { grid-template-columns: 1fr; border-left: 0; border-top: 1px solid var(--border-soft); }
    .pub__stat { border-right: 0; border-bottom: 1px solid var(--border-soft); min-height: auto; padding-block: var(--space-m); }
    .pub__stat:last-child { border-bottom: 0; }
  }

  /* --------------------------------------------------------------- Societies */
  .societies { padding-block: var(--space-l); border-bottom: 1px solid var(--border-soft); }
  .societies__label {
    text-align: center;
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--text-faint);
  }
  .societies__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 1rem + 5vw, 5.5rem);
    margin-top: var(--space-m);
  }
  .societies__item a { display: block; line-height: 0; }
  .societies__item img {
    height: clamp(52px, 40px + 2vw, 76px);
    width: auto;
    filter: grayscale(1) contrast(1.1);
    opacity: 0.8;
    mix-blend-mode: multiply;
    transition: opacity 0.4s var(--ease), filter 0.4s var(--ease);
  }
  .societies__item a:hover img,
  .societies__item a:focus-visible img { opacity: 1; filter: grayscale(0); }
  .societies__item a:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }

  /* ------------------------------------------------------------ Testimonials */
  .voices__title { font-size: var(--step-3); margin-top: var(--space-s); }

  .voices__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: var(--space-m);
    margin-top: var(--space-l);
  }

  .voice {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding: var(--space-m);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0;
    transition: border-color 0.3s var(--ease);
  }
  .voice:hover { border-color: var(--ink); }

  .voice__quote {
    flex: 1;
    font-size: var(--step--1);
    line-height: 1.75;
    color: var(--text);
    position: relative;
    padding-top: 2.2rem;
  }
  .voice__quote::before {
    content: '\201C';
    position: absolute;
    top: -0.6rem;
    left: -0.2rem;
    font-family: var(--font-serif);
    font-size: 4.5rem;
    line-height: 1;
    color: var(--border);
  }

  .voice__by {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding-top: var(--space-s);
    border-top: 1px solid var(--border-soft);
  }
  .voice__avatar {
    width: 52px;
    height: 52px;
    border-radius: 0;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--border);
  }
  .voice__meta { display: grid; gap: 0.15rem; }
  .voice__name {
    font-family: var(--font-serif);
    font-size: var(--step-0);
    font-weight: 600;
  }
  .voice__affil { font-size: 0.76rem; line-height: 1.4; color: var(--text-muted); }
  .voice__future {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--blue);
  }

  /* ---------------------------------------------------------------- Why us */
  .why { position: relative; isolation: isolate; overflow: hidden; }
  .why__bg { position: absolute; inset: 0; z-index: -1; }
  .why__bg img { width: 100%; height: 100%; object-fit: cover; opacity: 0.18; }

  .why__title { font-size: var(--step-4); margin-top: var(--space-s); }
  .why__body { margin-top: var(--space-m); margin-inline: auto; }
</style>
