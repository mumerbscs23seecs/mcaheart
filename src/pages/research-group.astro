---
// Live PubMed sync (fetchRecentPublications) needs to run per-request, not
// just once at build time - see src/lib/pubmed-feed.ts.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import LayeredScrollHero from '../components/LayeredScrollHero.astro';
import CTABanner from '../components/CTABanner.astro';
import { testimonials, missionVision, societies, recentPublications as fallbackPublications } from '../data/site';
import { fetchRecentPublications } from '../lib/pubmed-feed';

// Fall back to the static seed list only if PubMed has never once answered
// successfully (no cache yet, and this fetch also failed) - once a real
// fetch has ever succeeded, the live list (however small) is always shown
// instead of quietly reverting to stale placeholder titles.
const livePublications = await fetchRecentPublications(6);
const recentPublications = livePublications.length > 0 ? livePublications : fallbackPublications;
---

<BaseLayout
  title="MCA Heart Research Lab"
  description="Over 300 cardiology researchers led by M Chadi Alraies, MD MPH - 75+ manuscripts and 150+ abstracts a year at SCAI, AHA, TCT and ACC."
>
  <LayeredScrollHero title="MCA Heart Research Lab" />

  {/* --------------------------------------------------------- Mission/Vision */}
  <section class="section--tight mv">
    <div class="shell shell--wide mv__grid">
      {missionVision.map((m, i) => (
        <article class="mv__card" data-reveal style={`--reveal-delay:${i * 120}ms`}>
          <div class="mv__figure">
            <img src={m.image} alt="" loading="lazy" decoding="async" />
          </div>
          <div class="mv__body">
            <h2 class="mv__kind">{m.kind}</h2>
            <p class="mv__text">{m.body}</p>
          </div>
        </article>
      ))}

    </div>
  </section>

  {/* ------------------------------------------------------------------ PubMed */}
  <section class="section--tight pub">
    <div class="shell shell--wide">
      <div class="pub__main" data-reveal>
        <a
          class="pub__logo"
          href="https://pubmed.ncbi.nlm.nih.gov/?term=chadi+alraies&sort=date&size=200"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View our publications on PubMed"
        >
          <img src="/assets/research/pubmed-logo-blue.svg" alt="PubMed" loading="lazy" decoding="async" />
        </a>
        <p class="pub__title">Our Publications on PubMed</p>
        <a
          class="pub__cta"
          href="https://pubmed.ncbi.nlm.nih.gov/?term=chadi+alraies&sort=date&size=200"
          target="_blank"
          rel="noopener noreferrer"
        >
          View Our Publications <span class="pub__cta-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <ul class="pub__papers" data-reveal style="--reveal-delay:80ms">
        {recentPublications.map((p) => (
          <li class="paper">
            <p class="paper__meta">{p.journal} <span class="paper__dot">&middot;</span> <span class="paper__date">{p.date}</span></p>
            <h3 class="paper__title">{p.title}</h3>
            <p class="paper__authors">{p.authors}</p>
            <a class="paper__link" href={p.url} target="_blank" rel="noopener noreferrer">
              Read on PubMed
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7M9 7h8v8" />
              </svg>
            </a>
          </li>
        ))}
      </ul>

    </div>
  </section>

  {/* --------------------------------------------------------------- Societies */}
  <section class="section--tight societies">
    <div class="shell shell--wide">
      <p class="societies__label">Our work has been presented at</p>
      <ul class="societies__list">
        {societies.map((s) => (
          <li class="societies__item">
            <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.name} - view M Chadi Alraies' work indexed here`}>
              <img class="societies__logo--light" src={s.logo} alt={s.name} loading="lazy" decoding="async" height="60" />
              {s.logoDark && (
                <img class="societies__logo--dark" src={s.logoDark} alt={s.name} loading="lazy" decoding="async" height="60" />
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------------- Testimonials */}
  <section class="section voices" id="voices">
    <div class="shell shell--wide">
      <header class="voices__head" data-reveal>
        <h2 class="display voices__title">What our members say</h2>
      </header>

      <div class="voices__grid">
        {testimonials.map((t, i) => (
          <figure class="voice" data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
            <blockquote class="voice__quote">{t.quote}</blockquote>
            <figcaption class="voice__by">
              <img
                class="voice__avatar"
                src={t.photo}
                alt=""
                loading="lazy"
                decoding="async"
                width="400"
                height="400"
              />
              <span class="voice__meta">
                <span class="voice__name">{t.name}</span>
                <span class="voice__affil">{t.affiliation}</span>
                <span class="voice__future">Next: {t.future}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------- Why us */}
  <section class="section--tall why dark-ground" id="why-us">
    <div class="why__bg" aria-hidden="true">
      <img src="/assets/research/networking.jpg" alt="" loading="lazy" decoding="async" />
    </div>

    <div class="shell shell--narrow center" data-reveal>
      <h2 class="display why__title">A supportive ecosystem</h2>
      <div class="prose why__body">
        <p>
          Joining the MCA Heart Research Lab means becoming part of a dynamic ecosystem
          that values collaboration, innovation and excellence.
        </p>
        <p>
          Whether you are an aspiring research fellow seeking unparalleled mentorship
          or a seasoned professional looking to make impactful contributions, our
          group provides the resources, guidance and community to help you succeed.
        </p>
        <p>
          With us, you are not just advancing your career - you are making a
          difference in the lives of patients worldwide.
        </p>
      </div>
    </div>
  </section>

  <CTABanner
    title="Get in touch with us"
    body="Tell us where you are in your training and what you want to work on. We will point you to the right project."
    ctaLabel="Start the conversation"
    ctaHref="/contact"
    image="/assets/home/group-photo.webp"
  />
</BaseLayout>

<style>
  /* ------------------------------------------------------- Mission / Vision */
  .mv__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
  }
  @media (max-width: 760px) {
    .mv__grid { grid-template-columns: 1fr; }
  }
  .mv__card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-l);
    align-items: center;
    padding: var(--space-l);
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-top: 2px solid var(--blue);
    border-radius: var(--radius);
  }

  /* The supplied artwork is flat vector stock drawn on a solid white plate -
     it isn't designed to sit directly on a dark ground, and multiply-blending
     it onto one (mix-blend-mode:multiply) crushed its own reds/blues toward
     black instead of hiding the white. Pin the plate itself to a fixed light
     tint in both themes (like a photo in its own mat) instead of trying to
     "invert" full-color stock art - the frame around it still reads as part
     of the (theme-aware) card. */
  .mv__figure {
    width: clamp(96px, 70px + 6vw, 148px);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0;
    background: #f3f1ec;
    border: 1px solid var(--border-soft);
  }
  .mv__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(0.97);
  }

  .mv__kind {
    font-size: var(--step-2);
    letter-spacing: -0.015em;
    color: var(--text-strong);
  }
  .mv__text {
    margin-top: var(--space-xs);
    font-size: var(--step-0);
    line-height: 1.75;
    color: var(--text);
    max-width: 70ch;
  }

  @media (max-width: 620px) {
    .mv__card { grid-template-columns: 1fr; align-items: start; }
  }

  /* ------------------------------------------------------------------ PubMed */
  .pub { padding-block: var(--space-xl); background: var(--bg-tint); border-block: 1px solid var(--border-soft); }

  .pub__main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    text-align: center;
  }
  .pub__logo {
    display: grid;
    place-items: center;
    width: clamp(150px, 110px + 10vw, 220px);
    padding: 0.8rem 1.2rem;
  }
  .pub__logo img {
    width: 100%;
    height: auto;
    display: block;
    transition: opacity 0.25s var(--ease);
  }
  .pub__logo:hover img,
  .pub__logo:focus-visible img { opacity: 0.75; }
  .pub__logo:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }
  .pub__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    color: var(--text-strong);
    letter-spacing: -0.012em;
    margin-top: var(--space-xs);
  }

  .pub__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    margin-top: var(--space-s);
    padding: 0.95em 1.8em;
    background: var(--blue);
    color: #fff;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 700;
    transition: background 0.25s var(--ease);
  }
  .pub__cta:hover,
  .pub__cta:focus-visible { background: var(--blue-deep); }
  .pub__cta-arrow { transition: transform 0.25s var(--ease-out); }
  .pub__cta:hover .pub__cta-arrow,
  .pub__cta:focus-visible .pub__cta-arrow { transform: translateX(4px); }

  .pub__papers {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: var(--space-m);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Same card language as the testimonials below (.voice): its own full
     border, real breathing room between tiles, border darkens on hover -
     not a hairline-seam grid where the tiles touch. */
  .paper {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    min-height: 200px;
    padding: var(--space-m);
    background: var(--surface);
    border: 1px solid var(--border);
    transition: border-color 0.3s var(--ease);
  }
  .paper:hover { border-color: var(--ink); }
  .paper__meta {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .paper__dot { color: var(--text-faint); font-weight: 400; }
  .paper__date { color: var(--text-faint); font-weight: 600; letter-spacing: 0.02em; text-transform: none; }
  .paper__title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--step-0);
    line-height: 1.4;
    color: var(--text-strong);
  }
  .paper__authors { margin: 0; font-size: 0.78rem; line-height: 1.5; color: var(--text-muted); }
  .paper__link {
    margin-top: auto;
    padding-top: var(--space-s);
    border-top: 1px solid var(--border-soft);
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--text-strong);
    text-decoration: none;
  }
  .paper__link svg { width: 11px; height: 11px; transition: transform 0.2s var(--ease-out); }
  .paper:hover .paper__link svg,
  .paper__link:focus-visible svg { transform: translate(2px, -2px); }

  /* --------------------------------------------------------------- Societies */
  .societies { padding-block: var(--space-l); border-bottom: 1px solid var(--border-soft); }
  .societies__label {
    text-align: center;
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--text-faint);
  }
  .societies__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 1rem + 5vw, 5.5rem);
    margin-top: var(--space-m);
  }
  .societies__item a { display: block; line-height: 0; }
  .societies__item img {
    height: clamp(52px, 40px + 2vw, 76px);
    width: auto;
    filter: grayscale(1) contrast(1.1);
    opacity: 0.8;
    mix-blend-mode: multiply;
    transition: opacity 0.4s var(--ease), filter 0.4s var(--ease);
  }
  .societies__item a:hover img,
  .societies__item a:focus-visible img { opacity: 1; filter: grayscale(0); }
  .societies__item a:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }

  /* Dark-mode logo variants: the default logos are dark ink on a transparent
     background (mix-blend-mode:multiply relies on a light page behind them),
     so on a dark ground they'd vanish. Swap to a white-on-transparent
     version instead - no multiply blend, since white through "multiply"
     is a no-op and would stay invisible too. */
  .societies__logo--dark { display: none; }
  :root[data-theme='dark'] .societies__logo--light { display: none; }
  :root[data-theme='dark'] .societies__logo--dark {
    display: inline-block;
    mix-blend-mode: normal;
  }

  /* ------------------------------------------------------------ Testimonials */
  .voices__title { font-size: var(--step-3); margin-top: var(--space-s); }

  .voices__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: var(--space-m);
    margin-top: var(--space-l);
  }

  .voice {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding: var(--space-m);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0;
    transition: border-color 0.3s var(--ease);
  }
  .voice:hover { border-color: var(--ink); }

  .voice__quote {
    flex: 1;
    font-size: var(--step--1);
    line-height: 1.75;
    color: var(--text);
    position: relative;
    padding-top: 2.2rem;
  }
  .voice__quote::before {
    content: '\201C';
    position: absolute;
    top: -0.6rem;
    left: -0.2rem;
    font-family: var(--font-serif);
    font-size: 4.5rem;
    line-height: 1;
    color: var(--border);
  }

  .voice__by {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding-top: var(--space-s);
    border-top: 1px solid var(--border-soft);
  }
  .voice__avatar {
    width: 52px;
    height: 52px;
    border-radius: 0;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--border);
  }
  .voice__meta { display: grid; gap: 0.15rem; }
  .voice__name {
    font-family: var(--font-serif);
    font-size: var(--step-0);
    font-weight: 600;
  }
  .voice__affil { font-size: 0.76rem; line-height: 1.4; color: var(--text-muted); }
  .voice__future {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--blue);
  }

  /* ---------------------------------------------------------------- Why us */
  .why { position: relative; isolation: isolate; overflow: hidden; }
  .why__bg { position: absolute; inset: 0; z-index: -1; }
  .why__bg img { width: 100%; height: 100%; object-fit: cover; opacity: 0.18; }

  .why__title { font-size: var(--step-4); margin-top: var(--space-s); }
  .why__body { margin-top: var(--space-m); margin-inline: auto; }
</style>
