---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RecruitmentForm from '../components/RecruitmentForm.astro';
---

<BaseLayout
  title="Join the Lab"
  description="Apply to join the MCA Heart Research Lab - a cardiovascular research collective publishing 75+ manuscripts and presenting 150+ abstracts a year across interventional cardiology, heart failure, endovascular and structural heart disease."
  transparentHeader
>
  <PageHero
    title="Join the MCA Heart Research Lab"
    align="center"
    subtitle="We publish 75+ manuscripts and present 150+ abstracts annually across interventional cardiology, heart failure, endovascular intervention, structural heart disease, and related areas of cardiovascular medicine. Join a structured, collaborative research environment with opportunities for mentorship, skill development, and involvement in high-quality cardiovascular research."
    image="/assets/brand/get-involved-bg.webp"
  />

  <section class="section section--tight" id="form">
    <div class="shell shell--wide">
      <div class="iskin-intro">
        <p>
          This form takes about <strong>10 minutes</strong>. After you submit, you will receive an email with
          the outcome, usually within <strong>five days</strong>. No response within three weeks? Follow up at
          <a href="mailto:researchlab@mcaheart.com">researchlab@mcaheart.com</a>.
        </p>
      </div>
      <RecruitmentForm />
    </div>
  </section>
</BaseLayout>

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Merriweather+Sans:wght@400;500;600;700&display=swap" />

<style>
  /* Same hero scale as Submit an Idea and Contact; the centred, justified
     text style comes from src/styles/form-skin.css. */
  :global(.phero h1.phero__title) { font-size: clamp(2.3rem, 1.35rem + 3.7vw, 5rem); }
</style>
