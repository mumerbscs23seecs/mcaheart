---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RecruitmentForm from '../components/RecruitmentForm.astro';
---

<BaseLayout
  title="Join the Lab"
  description="Apply to join the MCA Research Lab — a cardiovascular research collective publishing 75+ manuscripts and presenting 150+ abstracts a year across interventional cardiology, heart failure, endovascular and structural heart disease."
>
  <PageHero
    eyebrow="Recruitment"
    title="Join the MCA Research Lab"
    subtitle="We publish 75+ manuscripts and present 150+ abstracts every year across interventional cardiology, heart failure, endovascular intervention and structural heart disease. If you want structured mentorship and a prolific, collaborative research environment, apply below."
  />

  <section class="section section--tight">
    <div class="shell shell--narrow join-intro">
      <p>
        This form takes about <strong>10 minutes</strong>. After you submit, you'll get an email with the
        outcome — accepted or not — usually within <strong>five days</strong>.
      </p>
      <p class="join-intro__note">
        No response within three weeks? Follow up at
        <a class="link-underline" href="mailto:researchoperations@mcaheart.com">researchoperations@mcaheart.com</a>.
      </p>
    </div>
  </section>

  <section class="section section--tight" id="form">
    <div class="shell shell--narrow">
      <RecruitmentForm />
    </div>
  </section>
</BaseLayout>

<style>
  .join-intro { display: grid; gap: var(--space-s); color: var(--text); line-height: 1.75; }
  .join-intro strong { color: var(--text-strong); }
  .join-intro__note {
    padding: 0.9rem 1.1rem;
    background: var(--accent-wash);
    border-left: 2px solid var(--blue);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.9rem;
  }
  .join-intro__note a { color: var(--blue); }
</style>
