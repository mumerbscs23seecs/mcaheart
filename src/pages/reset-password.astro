---
import AuthShell from '../components/AuthShell.astro';
import { peekResetToken, consumeReset } from '../lib/auth';

export const prerender = false;

const token = Astro.url.searchParams.get('token') ?? '';
let error: string | null = null;
let done = false;

const user = token ? peekResetToken(token) : null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirm') ?? '');
  if (password !== confirm) {
    error = 'The two passwords do not match.';
  } else {
    const result = consumeReset(token, password);
    if (result.ok) done = true;
    else error = result.error ?? 'That link is not valid.';
  }
}
---

<AuthShell title="Set a new password" description="Choose a new password for the members area.">
  {done ? (
    <div class="auth-card">
      <h1 class="auth-card__title">Password set</h1>
      <p class="auth-ok-box">You can now sign in with your new password.</p>
      <a class="btn" href="/login">Go to sign in</a>
    </div>
  ) : !user ? (
    <div class="auth-card">
      <h1 class="auth-card__title">Link expired</h1>
      <p class="auth-alert" role="alert">
        This reset link is invalid or has expired. Ask the site admin to send a new one.
      </p>
      <a class="auth-card__link" href="/forgot-password">Request a new link</a>
    </div>
  ) : (
    <form class="auth-card" method="post" novalidate>
      <h1 class="auth-card__title">Set a new password</h1>
      <p class="auth-card__lead">For <strong>{user.email}</strong></p>

      {error && <p class="auth-alert" role="alert">{error}</p>}

      <div class="auth-field">
        <label for="password">New password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required />
      </div>
      <div class="auth-field">
        <label for="confirm">Confirm password</label>
        <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="8" required />
      </div>

      <button class="btn" type="submit">Save password</button>
    </form>
  )}
</AuthShell>
