---
import AuthShell from '../components/AuthShell.astro';
import { supabaseForRequest } from '../lib/supabase';
import { clearMustChange, MIN_PASSWORD, DEFAULT_PASSWORD } from '../lib/accounts';

export const prerender = false;

// The emailed link carries a one-time recovery token. It's only redeemed when
// the form is submitted, so opening the link (or an email scanner fetching
// it) doesn't use it up.
const tokenHash = Astro.url.searchParams.get('token_hash') ?? '';
let error: string | null = null;
let expired = !tokenHash;
let done = false;

if (tokenHash && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirm') ?? '');
  if (password.length < MIN_PASSWORD) error = `Use at least ${MIN_PASSWORD} characters.`;
  else if (password !== confirm) error = 'The two passwords do not match.';
  else if (DEFAULT_PASSWORD && password === DEFAULT_PASSWORD) error = 'Choose a password different from the starting one.';
  else {
    const supabase = supabaseForRequest(Astro.request, Astro.cookies);
    const { data, error: otpErr } = await supabase.auth.verifyOtp({ type: 'recovery', token_hash: tokenHash });
    if (otpErr || !data.user) {
      expired = true;
    } else {
      const { error: updErr } = await supabase.auth.updateUser({ password });
      if (updErr) error = updErr.message;
      else {
        await clearMustChange(data.user.id);
        await supabase.auth.signOut();
        done = true;
      }
    }
  }
}
---

<AuthShell title="Set a new password" description="Choose a new password for the members area.">
  {done ? (
    <div class="auth-card">
      <h1 class="auth-card__title">Password set</h1>
      <p class="auth-ok-box">You can now sign in with your new password.</p>
      <a class="btn" href="/login">Go to sign in</a>
    </div>
  ) : expired ? (
    <div class="auth-card">
      <h1 class="auth-card__title">Link expired</h1>
      <p class="auth-alert" role="alert">
        This reset link is invalid, already used, or has expired. Request a new one.
      </p>
      <a class="auth-card__link" href="/forgot-password">Request a new link</a>
    </div>
  ) : (
    <form class="auth-card" method="post" novalidate>
      <h1 class="auth-card__title">Set a new password</h1>

      {error && <p class="auth-alert" role="alert">{error}</p>}

      <div class="auth-field">
        <label for="password">New password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength={MIN_PASSWORD} required />
      </div>
      <div class="auth-field">
        <label for="confirm">Confirm password</label>
        <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength={MIN_PASSWORD} required />
      </div>

      <button class="btn" type="submit">Save password</button>
    </form>
  )}
</AuthShell>
