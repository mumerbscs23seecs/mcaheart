---
import BaseLayout from '../layouts/BaseLayout.astro';
import { director, team } from '../data/site';
import { DIRECTOR_ICONS } from '../lib/director-icons';

const initials = (name: string) =>
  name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
// Dr. Alraies' name on one line, the surname in red.
const [first, ...rest] = director.name.split(' ');
const surname = rest.pop() ?? '';
const middle = rest.join(' ');
---

<BaseLayout
  title="Our Team"
  description="Meet the people behind the MCA Heart Research Lab: Dr. M. Chadi Alraies and the team who coordinate the lab's research and run it day to day."
  transparentHeader
>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Merriweather+Sans:wght@400;500;600;700;800&display=swap" />

  <div class="ot" data-bg="current">
  {/* PREVIEW: ?bg=ecg | type | block | none */}
  <script is:inline>(() => { const v = new URLSearchParams(location.search).get('bg'); if (v) document.currentScript.parentElement.dataset.bg = v; })();</script>
    {/* ---------------------------------------------------------- Intro
        A layered scene: as you scroll, the heading and the artwork split
        apart in opposite directions while the frame turns the other way. */}
    <section class="ot-hero" data-ot-hero>
      <svg class="ot-x ot-x--ecg" viewBox="0 0 1200 200" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M0 120 H1000 q12 -16 24 0 H1050 l8 10 l12 -84 l14 112 l8 -38 H1112 q20 -26 40 0 H1200" /></svg>
      <div class="ot-hero__copy" data-ot-copy>
        <h1 class="display ot-hero__title">
          <span class="ot-hero__line" style="--k:0">The people</span>
          <span class="ot-hero__line" style="--k:1">behind</span>
          <span class="ot-hero__line" style="--k:2"><em>MCA Heart</em></span>
        </h1>
      </div>
      <div class="ot-hero__visual" data-ot-visual aria-hidden="true">
        <span class="ot-hero__disc"></span>
        {/* PREVIEW: background options */}
        <span class="ot-x ot-x--word">Heart</span>
        <span class="ot-x ot-x--block"></span>
        <img src="/assets/brand/heart-anatomical.png" alt="" width="381" height="690" data-ot-art />
      </div>
    </section>

    {/* ---------------------------------------------------- Leadership */}
    <section class="ot-lead" id="leadership" data-ot-lead>
      <div class="ot-lead__inner">
        <div class="ot-lead__portrait" data-ot-portrait>
          {/* PREVIEW: background options */}
          <span class="ot-x ot-x--word">MCA</span>
          <span class="ot-x ot-x--block"></span>
          <svg class="ot-x ot-x--ecg" viewBox="0 0 1200 200" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M0 120 H1000 q12 -16 24 0 H1050 l8 10 l12 -84 l14 112 l8 -38 H1112 q20 -26 40 0 H1200" /></svg>
          <img src="/assets/team/alraies-portrait.jpg" alt={`Portrait of ${director.name}`} width="1150" height="1550" loading="lazy" decoding="async" />
        </div>
        <div class="ot-lead__copy" data-ot-leadcopy>
          <h2 class="display ot-lead__name">{first}{middle && ` ${middle}`} <span>{surname}</span></h2>
          <p class="ot-lead__creds">{director.credentialsFull}</p>
          <ul class="ot-lead__roles">
            {director.roles.map((r, i) => <li class:list={[i < 2 && 'is-key']}>{r}</li>)}
          </ul>
          <a class="ot-lead__email" href={`mailto:${director.email}`}>{director.email}</a>
          <ul class="ot-links">
            {director.academicLinks.map((l) => (
              <li>
                <a href={l.url} target="_blank" rel="noopener noreferrer" aria-label={l.label} title={l.label}>
                  {l.icon === 'university' ? (
                    <img src="/assets/home/logo-wsu.webp" alt="" loading="lazy" decoding="async" />
                  ) : l.icon === 'hospital' ? (
                    <img class="ot-links__wide" src="/assets/home/logo-dmc.webp" alt="" loading="lazy" decoding="async" />
                  ) : l.icon === 'researchgate' ? (
                    <>
                      <img class="ot-links__light" src="/assets/home/logo-researchgate.webp" alt="" loading="lazy" decoding="async" />
                      <img class="ot-links__dark" src="/assets/home/logo-researchgate-dark.webp" alt="" loading="lazy" decoding="async" />
                    </>
                  ) : (
                    <Fragment set:html={DIRECTOR_ICONS[l.icon]} />
                  )}
                </a>
              </li>
            ))}
          </ul>
          <p class="ot-links__label">Connect</p>
          <ul class="ot-links ot-links--social">
            {director.socialLinks.map((l) => (
              <li>
                <a href={l.url} target="_blank" rel="noopener noreferrer" aria-label={l.label} title={l.label}>
                  <Fragment set:html={DIRECTOR_ICONS[l.icon]} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* --------------------------------------------------------- Team
        Two on top, then one centred per row below. A card shows the photo,
        name and title; hovering (or tapping) it brings it to the middle,
        larger, with the details. */}
    <section class="ot-team" aria-labelledby="ot-team-title">
      <h2 class="ot-team__title" id="ot-team-title">Our Team</h2>
      <div class="ot-tri" data-ot-tri>
        {team.map((m, i) => (
          <article class="ot-card" style={`--i:${i}`} data-ot-card>
            <div class="ot-card__body" tabindex="0" aria-label={`${m.name}, ${m.title}`} data-ot-body>
              <div class="ot-card__photo">
                {m.photo ? (
                  <img src={m.photo} alt={`Portrait of ${m.name}`} loading="lazy" decoding="async" />
                ) : (
                  <span class="ot-card__initials" aria-hidden="true">{initials(m.name)}</span>
                )}
              </div>
              <h3 class="display ot-card__name">{m.name}</h3>
              <p class="ot-card__title">{m.title}</p>
              <div class="ot-card__details">
                {m.details.map((d) => <p>{d}</p>)}
                {m.email && <a href={`mailto:${m.email}`}>{m.email}</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .ot {
    --ot-red: var(--blue);
    --ot-ink: var(--text-strong);
    --ot-muted: var(--text);
    --ot-line: var(--border-soft);
    --ot-disc: color-mix(in srgb, var(--ink) 7%, var(--bg));
    font-family: 'Merriweather Sans', system-ui, sans-serif;
    color: var(--ot-ink);
    overflow-x: clip;
  }
  /* Headings use the landing page's heading face (.display: Archivo Expanded). */
  .ot :is(h1, h2, h3).display { font-family: var(--font-display); }

  /* ------------------------------------------------------------ Intro */
  .ot-hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    max-width: 1460px;
    margin: 0 auto;
    padding: var(--space-l) var(--gutter) var(--space-xl);
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 3vw;
    isolation: isolate;
  }
  .ot-hero__copy { position: relative; z-index: 3; will-change: transform, opacity; }
  .ot-hero__title {
    margin: 0;
    font-size: clamp(2.6rem, 1.1rem + 5vw, 6.4rem);
    line-height: 0.98;
  }
  .ot-hero__line { display: block; white-space: nowrap; }
  /* Same accent as the landing page's "in Cardiology". */
  .ot-hero__title em { font-style: italic; color: var(--ot-red); }

  .ot-hero__visual {
    position: relative;
    height: min(68vh, 680px);
    min-height: 380px;
    display: grid;
    place-items: center;
    will-change: transform, opacity;
    --p: 0;
  }
  .ot-hero__disc {
    position: absolute; width: 82%; aspect-ratio: 1; border-radius: 50%;
    background: var(--ot-disc); border: 1px solid var(--ot-line);
    transform: translate3d(calc(var(--p) * 30px), calc(var(--p) * -24px), 0);
  }
  .ot-hero__visual img {
    position: relative; z-index: 1; height: 92%; width: auto; max-width: 100%;
    object-fit: contain; will-change: transform;
    filter: drop-shadow(0 24px 40px rgba(0, 0, 0, 0.12));
  }

  /* ---------------- PREVIEW: background options (?bg=…) ---------------- */
  .ot-x { display: none; pointer-events: none; }
  .ot:not([data-bg="current"]) .ot-hero__disc { display: none; }
  .ot:not([data-bg="current"]) .ot-lead__portrait::before { display: none; }

  /* 1. ECG: one heartbeat line that draws itself, behind the art. */
  .ot[data-bg="ecg"] .ot-x--ecg { display: block; position: absolute; z-index: 0; overflow: visible; max-width: none; }
  .ot[data-bg="ecg"] .ot-hero > .ot-x--ecg { left: 42%; top: 46%; width: 58%; height: 180px; }
  .ot[data-bg="ecg"] .ot-lead__portrait > .ot-x--ecg { left: -10%; width: 134%; top: 60%; height: 160px; }
  .ot-x--ecg path {
    fill: none; stroke: var(--ot-red); stroke-width: 1.6; vector-effect: non-scaling-stroke;
    stroke-linejoin: round; opacity: 0.55;
    stroke-dasharray: 1; stroke-dashoffset: 1; animation: ot-ecg 2.4s cubic-bezier(0.6, 0, 0.3, 1) 0.4s forwards;
  }
  @keyframes ot-ecg { to { stroke-dashoffset: 0; } }

  /* 2. Type: one huge outlined word behind the art. */
  .ot[data-bg="type"] .ot-x--word {
    display: block; position: absolute; z-index: 0; left: 50%; top: 50%; translate: -50% -50%;
    font-family: var(--font-display); font-weight: 800; line-height: 0.8; letter-spacing: -0.04em;
    color: transparent; -webkit-text-stroke: 1.5px color-mix(in srgb, var(--ot-red) 30%, transparent);
    white-space: nowrap;
  }
  .ot[data-bg="type"] .ot-hero__visual .ot-x--word { font-size: clamp(7rem, 15vw, 15rem); }
  .ot[data-bg="type"] .ot-lead__portrait .ot-x--word { font-size: clamp(7rem, 14vw, 14rem); top: 0; translate: -50% -38%; }

  /* 3. Block: a flat, square-cornered colour block offset behind the art. */
  .ot[data-bg="block"] .ot-x--block { display: block; position: absolute; z-index: 0; }
  .ot[data-bg="block"] .ot-hero__visual .ot-x--block { inset: 14% 8% 10% 22%; background: var(--ot-red); }
  .ot[data-bg="block"] .ot-lead__portrait .ot-x--block { inset: 18% -9% -5% 14%; background: var(--ot-ink); }

  /* ------------------------------------------------------- Leadership */
  .ot-lead { position: relative; padding: clamp(6rem, 4rem + 8vw, 12rem) var(--gutter) clamp(4rem, 3rem + 6vw, 9rem); }
  .ot-lead__inner {
    max-width: 1280px; margin: 0 auto;
    display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    column-gap: clamp(3rem, 1rem + 7vw, 8rem); row-gap: 2.5rem; align-items: center;
  }
  /* A plain rectangle; 4:5 trims the extra backdrop above the head. */
  .ot-lead__portrait {
    position: relative; width: min(100%, 460px); aspect-ratio: 4 / 5; justify-self: center;
    --x: 0px; --y: 0px;
  }
  .ot-lead__portrait::before {
    content: ''; position: absolute; inset: 5% -8% -3% 12%; z-index: 0;
    background: var(--ot-disc); border-radius: 2px; transform: rotate(4deg);
  }
  .ot-lead__portrait img {
    position: relative; z-index: 1; width: 100%; height: 100%;
    object-fit: cover; object-position: center bottom;
    border-radius: 2px;
    will-change: transform;
  }
  .ot-lead__copy { will-change: transform, opacity; }
  .ot-lead__name {
    margin: 0; font-size: clamp(1.8rem, 0.9rem + 2.4vw, 3.1rem);
    line-height: 1.05; white-space: nowrap;
  }
  .ot-lead__name span { color: var(--ot-red); }
  .ot-lead__creds { margin: 1rem 0 0; font-weight: 700; letter-spacing: 0.02em; }
  .ot-lead__roles { list-style: none; margin: 1.5rem 0 0; padding: 1.25rem 0 0; border-top: 1px solid var(--ot-line); display: grid; gap: 0.45rem; }
  .ot-lead__roles li { font-size: 0.9rem; line-height: 1.5; color: var(--ot-muted); }
  .ot-lead__roles li:not(.is-key) { position: relative; padding-left: 1.1rem; }
  .ot-lead__roles li:not(.is-key)::before {
    content: ''; position: absolute; left: 0; top: 0.6em;
    width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--ot-red);
  }
  @media (min-width: 1180px) { .ot-lead__roles li:not(.is-key) { white-space: nowrap; } }
  .ot-lead__roles li.is-key { font-size: 1.05rem; font-weight: 700; color: var(--ot-ink); }
  .ot-lead__roles li.is-key + li:not(.is-key) { margin-top: 0.5rem; }

  .ot-lead__email { display: inline-block; margin-top: 1.25rem; font-weight: 700; color: var(--ot-red); text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .ot-links { list-style: none; margin: 1.75rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .ot-links__label { margin: 1.5rem 0 0; font-size: 0.95rem; font-weight: 700; color: var(--ot-ink); }
  .ot-links--social { margin-top: 0.6rem; }
  .ot-links a {
    display: grid; place-items: center; width: 2.6rem; height: 2.6rem;
    border: 1px solid var(--ink); color: var(--ink);
    transition: background 0.2s, color 0.2s;
  }
  .ot-links a :global(svg) { width: 1.35rem; height: 1.35rem; }
  .ot-links img { width: 1.4rem; height: 1.4rem; object-fit: contain; }
  .ot-links img.ot-links__wide { width: 1.9rem; height: 1.9rem; }
  .ot-links a :global(svg.director__socials-instagram) { color: var(--ot-red); }
  .ot-links a:hover, .ot-links a:focus-visible { background: var(--ink); color: var(--bg); outline: none; }
  .ot-links__dark { display: none; }
  :global(:root[data-theme='dark']) .ot-links__light { display: none; }
  :global(:root[data-theme='dark']) .ot-links__dark { display: block; }

  /* ------------------------------------------------------------ Team */
  .ot-team__title {
    margin: 0 0 clamp(2.5rem, 1.5rem + 3vw, 4rem); text-align: center;
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.2rem); font-weight: 600; letter-spacing: 0; color: var(--ot-ink);
  }
  .ot-team { padding: clamp(3rem, 2rem + 4vw, 6rem) var(--gutter) clamp(5rem, 3rem + 6vw, 9rem); }
  .ot-tri {
    position: relative; max-width: 1000px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: clamp(1.25rem, 5vw, 5rem); row-gap: clamp(3rem, 6vw, 5.5rem);
  }
  .ot-card { grid-column: span 3; display: flex; justify-content: center; position: relative; }
  .ot-card:nth-child(1) { grid-column: 2 / span 2; }
  .ot-card:nth-child(2) { grid-column: 4 / span 2; }
  .ot-card:nth-child(3) { grid-column: 3 / span 2; }
  .ot-card:nth-child(4) { grid-column: 3 / span 2; }

  .ot-card__body {
    --tx: 0px; --ty: 0px;
    position: relative; width: 100%; max-width: 280px;
    display: grid; justify-items: center; text-align: center;
    padding: 10px; border-radius: 18px; cursor: pointer; outline: none;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease, background 0.4s ease, box-shadow 0.4s ease;
  }
  .ot-card__body:focus-visible { box-shadow: 0 0 0 3px color-mix(in srgb, var(--ot-red) 35%, transparent); }
  .ot-card__photo {
    width: clamp(160px, 19vw, 240px); aspect-ratio: 1; border-radius: 50%; overflow: hidden;
    background: var(--ot-disc); display: grid; place-items: center; position: relative;
  }
  .ot-card__photo::after { content: ''; position: absolute; inset: 8px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.7); pointer-events: none; }
  .ot-card__photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; filter: grayscale(35%); transition: filter 0.6s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
  .ot-card__initials { font-weight: 800; font-size: clamp(2.4rem, 1.6rem + 2.6vw, 3.6rem); letter-spacing: -0.04em; color: var(--ot-red); }
  .ot-card__name { margin: 1.1rem 0 0; font-size: clamp(1.1rem, 0.9rem + 0.7vw, 1.45rem); line-height: 1.15; }
  .ot-card__title { margin: 0.4rem 0 0; font-size: 0.95rem; font-weight: 700; color: var(--ot-red); }

  /* Details sit below the card, out of the layout, so opening one doesn't
     push anything around. */
  .ot-card__details {
    position: absolute; top: 100%; left: 50%; width: min(340px, 90vw); translate: -50% 0;
    padding: 0.9rem 1.1rem 1rem; border-radius: 14px;
    background: var(--surface); box-shadow: 0 18px 44px -18px rgba(0, 0, 0, 0.3);
    display: grid; gap: 0.35rem; font-size: 0.875rem; line-height: 1.5; color: var(--ot-muted);
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 0.35s;
  }
  .ot-card__details p { margin: 0; }
  .ot-card__details a { margin-top: 0.25rem; font-weight: 700; color: var(--ot-red); overflow-wrap: anywhere; text-decoration: underline; text-underline-offset: 3px; }

  /* Opened: the card grows and glides to the middle of the triangle; the
     others fall back. --tx / --ty are measured by the script below. */
  .ot-tri.has-open .ot-card__body { opacity: 0.16; transform: scale(0.94); }
  .ot-tri.has-open .ot-card.is-open { z-index: 5; }
  .ot-tri.has-open .ot-card.is-open .ot-card__body {
    opacity: 1; transform: translate3d(var(--tx), var(--ty), 0) scale(1.18);
  }
  .ot-card.is-open .ot-card__photo img { filter: grayscale(0%); transform: scale(1.04); }
  /* A soft frosted panel behind the opened tile (photo, name and details),
     so it stands apart from whatever it floats over. --dh is the height of
     the details, set by the script. */
  .ot-card__body::before {
    content: ''; position: absolute; z-index: -1; pointer-events: none;
    inset: -16px -34px calc(-1 * var(--dh, 0px) - 16px);
    border-radius: 26px;
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    box-shadow: 0 30px 70px -28px rgba(0, 0, 0, 0.35), 0 0 0 1px color-mix(in srgb, var(--ot-ink) 6%, transparent);
    opacity: 0; transition: opacity 0.4s ease;
  }
  .ot-tri.has-open .ot-card.is-open .ot-card__body::before { opacity: 1; }
  @media (min-width: 641px) {
    .ot-card.is-open .ot-card__details { background: transparent; box-shadow: none; }
  }
  .ot-card.is-open .ot-card__details { opacity: 1; visibility: visible; transform: translateY(0); transition-delay: 0.15s, 0.15s, 0s; }

  /* Entrance: the two on top come in from their own sides, the third from below. */
  @media (prefers-reduced-motion: no-preference) {
    .ot-hero__line { animation: ot-line 1s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: calc(var(--k) * 110ms + 80ms); }
    .ot-hero__visual { animation: ot-fade 1.2s ease 0.3s both; }
    .ot-card { opacity: 0; transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease; transition-delay: calc(var(--i) * 0.12s); }
    .ot-card:nth-child(1) { transform: translate3d(-70px, 45px, 0) scale(0.92); }
    .ot-card:nth-child(2) { transform: translate3d(70px, 45px, 0) scale(0.92); }
    .ot-card:nth-child(3) { transform: translate3d(0, 65px, 0) scale(0.92); }
    .ot-card:nth-child(4) { transform: translate3d(0, 65px, 0) scale(0.92); }
    .ot-card.in-view { opacity: 1; transform: none; }
  }
  @keyframes ot-line { from { opacity: 0; transform: translateX(-8%); } }
  @keyframes ot-fade { from { opacity: 0; transform: translateY(24px); } }

  @media (max-width: 1000px) { .ot-lead__name { white-space: normal; } }
  @media (max-width: 860px) {
    .ot-hero { grid-template-columns: 1fr; padding-top: var(--space-m); gap: 1rem; }
    .ot-hero__visual { height: 44vh; min-height: 280px; grid-row: 1; }
    .ot-lead__inner { grid-template-columns: 1fr; }
    .ot-lead__portrait { width: min(78%, 360px); }
  }
  @media (max-width: 640px) {
    /* Phones: one card per row, so an opened card's details get the full width. */
    .ot-tri { grid-template-columns: minmax(0, 1fr); row-gap: 2.75rem; }
    .ot-card:nth-child(n) { grid-column: 1; }
    .ot-card__body { max-width: 340px; }
    .ot-card__photo { width: clamp(150px, 52vw, 210px); }
    /* On phones a tapped card grows in place; the details sit under it. */
    .ot-tri.has-open .ot-card.is-open .ot-card__body { transform: scale(1.04); }
    .ot-card__details { position: static; translate: none; width: 100%; margin-top: 0.75rem; display: none; }
    .ot-card.is-open .ot-card__details { display: grid; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ot-card__body, .ot-card__photo img, .ot-card__details { transition: none; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = <T extends Element>(s: string) => document.querySelector<T>(s);
  const clamp = (n: number) => Math.max(0, Math.min(1, n));
  const smooth = (p: number) => { p = clamp(p); return p * p * (3 - 2 * p); };

  /* ------------- layered scroll: each layer moves its own way ------------- */
  const hero = $<HTMLElement>('[data-ot-hero]');
  const copy = $<HTMLElement>('[data-ot-copy]');
  const visual = $<HTMLElement>('[data-ot-visual]');
  const art = $<HTMLElement>('[data-ot-art]');
  const lead = $<HTMLElement>('[data-ot-lead]');
  const portrait = $<HTMLElement>('[data-ot-portrait]');
  const portraitImg = portrait?.querySelector<HTMLElement>('img');
  const leadCopy = $<HTMLElement>('[data-ot-leadcopy]');

  function scene() {
    const vh = innerHeight || 800;
    if (hero && copy && visual && art) {
      const p = smooth(-hero.getBoundingClientRect().top / (vh * 0.8));
      copy.style.transform = `translate3d(${-90 * p}px, ${-60 * p}px, 0) scale(${1 - 0.05 * p})`;
      copy.style.opacity = String(1 - 0.75 * p);
      visual.style.transform = `translate3d(${110 * p}px, ${45 * p}px, 0) scale(${1 + 0.1 * p}) rotate(${3 * p}deg)`;
      visual.style.opacity = String(1 - 0.35 * p);
      visual.style.setProperty('--p', String(p));
      art.style.transform = `translate3d(${-30 * p}px, ${-18 * p}px, 0) scale(${1 + 0.14 * p})`;
    }
    if (lead && portrait && portraitImg && leadCopy) {
      const q = smooth((vh * 0.88 - lead.getBoundingClientRect().top) / (vh * 0.95));
      portraitImg.style.transform = `translate3d(${-24 * q}px, ${-14 * q}px, 0) scale(${1 + 0.08 * q})`;
      portrait.style.setProperty('--x', `${26 * q}px`);
      portrait.style.setProperty('--y', `${-18 * q}px`);
      leadCopy.style.transform = `translate3d(${55 * (1 - q)}px, ${22 * (1 - q)}px, 0)`;
      leadCopy.style.opacity = String(0.2 + 0.8 * q);
    }
  }
  if (!reduce) {
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { scene(); ticking = false; });
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    scene();
  }

  /* ------------------------- team: fly in once ------------------------- */
  const cards = [...document.querySelectorAll<HTMLElement>('[data-ot-card]')];
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); }
    }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
    cards.forEach((c) => io.observe(c));
  } else cards.forEach((c) => c.classList.add('in-view'));

  /* ------------- open a card: it grows and moves to the middle ------------- */
  const tri = $<HTMLElement>('[data-ot-tri]');
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
  let open: HTMLElement | null = null;

  function openCard(card: HTMLElement | null) {
    if (!tri || card === open) return;
    if (open) open.classList.remove('is-open');
    open = card;
    tri.classList.toggle('has-open', !!card);
    if (!card) return;
    const body = card.querySelector<HTMLElement>('[data-ot-body]')!;
    body.style.setProperty('--tx', '0px');
    body.style.setProperty('--ty', '0px');
    body.style.setProperty('--dh', '0px');
    if (innerWidth > 640) {
      // To the middle of the screen (photo, name and details centred together).
      const c = body.getBoundingClientRect();
      const details = body.querySelector<HTMLElement>('.ot-card__details');
      const extra = details ? details.offsetHeight : 0;
      const tx = innerWidth / 2 - (c.left + c.width / 2);
      const ty = innerHeight / 2 - (c.top + (c.height + extra) / 2);
      body.style.setProperty('--tx', `${Math.round(tx)}px`);
      body.style.setProperty('--ty', `${Math.round(ty)}px`);
      body.style.setProperty('--dh', `${extra}px`);
    }
    card.classList.add('is-open');
  }

  if (tri) {
    // Hover opens a tile and brings it to the middle of the screen; leaving it
    // sends it back. A short grace period lets the pointer cross from the
    // tile's spot to where it moved (e.g. to click the email) without it
    // snapping back on the way.
    let closing: number | undefined;
    const stay = () => { if (closing) { clearTimeout(closing); closing = undefined; } };
    for (const card of cards) {
      const body = card.querySelector<HTMLElement>('[data-ot-body]')!;
      if (canHover) {
        card.addEventListener('pointerenter', () => { stay(); openCard(card); });
        card.addEventListener('pointerleave', () => {
          stay();
          closing = window.setTimeout(() => { if (open === card) openCard(null); }, 220);
        });
        body.addEventListener('focus', () => openCard(card));
      } else {
        // Touch: tap to open, tap again (or anywhere else) to close.
        body.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) return;
          openCard(open === card ? null : card);
        });
      }
      body.addEventListener('keydown', (e) => { if (e.key === 'Escape') { openCard(null); body.blur(); } });
    }
    tri.addEventListener('focusout', (e) => { if (canHover && !tri.contains(e.relatedTarget as Node)) openCard(null); });
    document.addEventListener('click', (e) => { if (open && !tri.contains(e.target as Node)) openCard(null); });
    // The tile is placed relative to the screen, so scrolling sends it back.
    addEventListener('scroll', () => { if (open && innerWidth > 640) openCard(null); }, { passive: true });
  }
</script>
