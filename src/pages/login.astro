---
import AuthShell from '../components/AuthShell.astro';
import { currentUser, setHintCookie } from '../lib/auth';
import { supabaseForRequest } from '../lib/supabase';
import { getPipelineSession } from '../lib/pipeline-auth';

export const prerender = false;

const rawNext = Astro.url.searchParams.get('next') ?? '';
const next = rawNext.startsWith('/') && !rawNext.startsWith('//') ? rawNext : '';

/** Admins land on the dashboard; members go straight to their pipeline. */
const homeFor = (role: string) => next || (role === 'admin' ? '/admin' : '/pipeline');

// Already signed in: go home, ignoring ?next - a signed-in visitor only gets
// bounced here with ?next when that page couldn't see the session (e.g. a
// not-found URL under /pipeline), so sending them back would loop forever.
const existing = currentUser(Astro.cookies);
if (existing) return Astro.redirect(existing.role === 'admin' ? '/admin' : '/pipeline', 302);

let error: string | null = null;
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim().toLowerCase();
  const password = String(form.get('password') ?? '');
  const supabase = supabaseForRequest(Astro.request, Astro.cookies);
  const { error: signInError } = await supabase.auth.signInWithPassword({ email, password });
  // Same message either way - never reveal which emails have accounts.
  error = 'Email or password is incorrect.';
  if (!signInError) {
    const session = await getPipelineSession(Astro.request, Astro.cookies, supabase);
    if (session) {
      const role = session.person.role === 'admin' ? 'admin' : 'member';
      setHintCookie(Astro.cookies, { id: session.person.id, name: session.person.full_name, email, role });
      if (session.mustChangePassword) return Astro.redirect('/account/password?first=1', 303);
      return Astro.redirect(homeFor(role), 303);
    }
    // Valid password but no active person behind it - don't leave a half session.
    await supabase.auth.signOut();
    error = 'This account does not have access. Contact info@mcaheart.com.';
  }
}
---

<AuthShell title="Log in" description="Sign in to the MCA Heart Research Lab members area.">
  <form class="auth-card" method="post" novalidate>
    <h1 class="auth-card__title">Sign in</h1>
    <p class="auth-card__sub">MCA Heart Research Lab members area</p>

    {error && <p class="auth-alert" role="alert">{error}</p>}

    <div class="auth-field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required value={email} />
    </div>

    <div class="auth-field">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required />
    </div>

    <button class="btn" type="submit">Sign in</button>

    <a class="auth-card__link" href="/forgot-password">Forgot your password?</a>
  </form>

  <p class="authpage__note">New member? Use the starting password you were given - you'll choose your own right after signing in.</p>
</AuthShell>
