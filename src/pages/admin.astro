---
import AppLayout from '../layouts/AppLayout.astro';
import { currentUser } from '../lib/auth';
import { getPipelineSession, bridgeAdminSession } from '../lib/pipeline-auth';
import { sweepPipelineReminders, type PipelineSweepResult } from '../lib/pipeline-reminders';

export const prerender = false;

const me = currentUser(Astro.cookies);
if (!me) return Astro.redirect('/login', 302);
if (me.role !== 'admin') return Astro.redirect('/pipeline', 302);

type Flash = { tone: 'ok' | 'error'; text: string };
let flash: Flash | null = null;
let pipelineSweep: PipelineSweepResult | null = null;

// The admin dashboard has its own in-memory login, not a Supabase session - bridge
// one transparently (same trick /pipeline uses) so every number below comes from
// the real database, not a placeholder store.
let session = await getPipelineSession(Astro.request, Astro.cookies);
session = session ?? (await bridgeAdminSession(Astro.request, Astro.cookies));
const supabase = session?.supabase ?? null;

if (Astro.request.method === 'POST' && supabase) {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  if (action === 'sweep' || action === 'sweep-dry') {
    const dry = action === 'sweep-dry';
    pipelineSweep = await sweepPipelineReminders(dry);
    const parts = [
      `${pipelineSweep.sent.length} reminder(s) sent`,
      pipelineSweep.flagged.length ? `${pipelineSweep.flagged.length} flagged for reassignment` : '',
    ].filter(Boolean);
    flash = pipelineSweep.error
      ? { tone: 'error', text: pipelineSweep.error }
      : { tone: 'ok', text: (dry ? 'Preview - ' : 'Sweep complete - ') + (parts.join(', ') || 'nothing due') };
  }
}

const PHASES = [
  { key: 'idea', label: 'Idea', color: '#2a78d6' },
  { key: 'conference', label: 'Conference', color: '#eb6834' },
  { key: 'manuscript', label: 'Manuscript', color: '#1baf7a' },
  { key: 'journal', label: 'Journal', color: '#eda100' },
  { key: 'published', label: 'Published', color: '#e87ba4' },
] as const;
type PhaseKey = (typeof PHASES)[number]['key'];

const rawPhase = Astro.url.searchParams.get('phase') ?? '';
const phaseFilter = (PHASES.some((p) => p.key === rawPhase) ? rawPhase : '') as PhaseKey | '';
const rangeParam = Astro.url.searchParams.get('range');
const rangeDays = rangeParam === '7' ? 7 : rangeParam === '90' ? 90 : 30;
const q = Astro.url.searchParams.get('q') ?? '';

const now = new Date();
const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
const weekday = (d: Date) => d.toLocaleDateString('en-US', { weekday: 'long' });
const firstOfMonth = new Date(now.getFullYear(), now.getMonth(), 1).toISOString();
const rangeStart = new Date(now.getTime() - (rangeDays - 1) * 86400000).toISOString().slice(0, 10);

/** Apply the header's phase scope to a projects/project_list query. "Published"
 *  is a stage within the journal phase, not a phase of its own. */
function scoped<T extends { eq: (...a: any[]) => T; neq: (...a: any[]) => T }>(query: T): T {
  if (phaseFilter === 'published') return query.eq('phase', 'journal').eq('stage', 'published');
  if (phaseFilter) return query.eq('phase', phaseFilter);
  return query;
}

let total = 0;
let published = 0;
let awaiting = 0;
let stagnant = 0;
let createdThisMonth = 0;
const buckets: Record<PhaseKey, number> = { idea: 0, conference: 0, manuscript: 0, journal: 0, published: 0 };
let trend: { day: string; n: number }[] = [];
let dataError: string | null = null;

if (supabase) {
  const [totalRes, pubRes, reqRes, monthRes, stageRes, eventRes] = await Promise.all([
    scoped(supabase.from('projects').select('id', { count: 'exact', head: true }).is('archived_at', null)),
    supabase.from('projects').select('id', { count: 'exact', head: true }).eq('phase', 'journal').eq('stage', 'published').is('archived_at', null),
    supabase.from('stage_change_requests').select('id', { count: 'exact', head: true }).eq('status', 'pending'),
    scoped(supabase.from('projects').select('id', { count: 'exact', head: true }).is('archived_at', null).gte('created_at', firstOfMonth)),
    scoped(supabase.from('project_list').select('phase,stage,days_in_stage,parked').is('archived_at', null)),
    supabase.from('events').select('at').gte('at', rangeStart),
  ]);

  dataError =
    totalRes.error?.message ?? pubRes.error?.message ?? reqRes.error?.message ??
    stageRes.error?.message ?? eventRes.error?.message ?? null;

  total = totalRes.count ?? 0;
  published = pubRes.count ?? 0;
  awaiting = reqRes.count ?? 0;
  createdThisMonth = monthRes.count ?? 0;

  for (const r of stageRes.data ?? []) {
    if (r.phase === 'journal' && r.stage === 'published') buckets.published++;
    else if (r.phase in buckets) buckets[r.phase as PhaseKey]++;
    const isPublished = r.phase === 'journal' && r.stage === 'published';
    if (!r.parked && !isPublished && (r.days_in_stage ?? 0) >= 7) stagnant++;
  }

  const byDay = new Map<string, number>();
  for (let i = rangeDays - 1; i >= 0; i--) {
    byDay.set(new Date(now.getTime() - i * 86400000).toISOString().slice(0, 10), 0);
  }
  for (const ev of eventRes.data ?? []) {
    const key = String(ev.at).slice(0, 10);
    if (byDay.has(key)) byDay.set(key, (byDay.get(key) ?? 0) + 1);
  }
  trend = [...byDay.entries()].map(([day, n]) => ({ day, n }));
}

const active = Math.max(0, total - published);
const activePct = total ? Math.round((active / total) * 100) : 0;
const publishedPct = total ? Math.round((published / total) * 100) : 0;
const bucketTotal = Object.values(buckets).reduce((a, b) => a + b, 0);
const bucketMax = Math.max(1, ...Object.values(buckets));
const trendMax = Math.max(1, ...trend.map((t) => t.n));

const R = 68;
const CIRC = 2 * Math.PI * R;
let acc = 0;
const donutSegs = PHASES.map((p) => {
  const n = buckets[p.key] ?? 0;
  const pct = bucketTotal ? n / bucketTotal : 0;
  const seg = { ...p, n, pct, dash: pct * CIRC, gap: CIRC - pct * CIRC, offset: -acc * CIRC };
  acc += pct;
  return seg;
});

const initials =
  me.name
    .split(/\s+/)
    .map((s) => s[0])
    .filter(Boolean)
    .slice(0, 2)
    .join('')
    .toUpperCase() || 'A';

const fmtDay = (iso: string) => new Date(iso + 'T00:00:00').toLocaleDateString('en-US', { day: 'numeric', month: 'short' });
---

<AppLayout title="Dashboard" heading="Dashboard" user={me} active="dashboard">
  <div class="adash">
    {flash && (
      <div class:list={['adash-flash', `adash-flash--${flash.tone}`]} role="status">
        <p>{flash.text}</p>
      </div>
    )}
    {!supabase && (
      <div class="adash-flash adash-flash--error" role="status">
        <p>Could not reach the live database, so every number below is 0. Refresh, or check SUPABASE_* in .env.</p>
      </div>
    )}
    {supabase && dataError && (
      <div class="adash-flash adash-flash--error" role="status"><p>{dataError}</p></div>
    )}

    {/* ---------------------------------------------------------- Header */}
    <header class="adash-head">
      <div class="adash-head__intro">
        <p class="adash-head__eyebrow">Welcome back, {me.name.split(/\s+/)[0]}!</p>
        <h1 class="adash-head__title">Research Submissions<br />Dashboard</h1>
        <p class="adash-head__tag">Track progress. Meet deadlines. Advance science.</p>
      </div>

      <div class="adash-head__tools">
        <form class="adash-search" method="get" action="/pipeline/submissions" role="search">
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M13.6 12.2 17 15.6l-1.4 1.4-3.4-3.4A6 6 0 1 1 13.6 12.2ZM9 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" fill="currentColor"/></svg>
          <input type="search" name="q" placeholder="Search projects…" value={q} aria-label="Search projects" />
        </form>

        <div class="adash-date">
          <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><path d="M6 2v2M14 2v2M3 8h14M4 4h12a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
          <div><b>{fmtDate(now)}</b><span>{weekday(now)}</span></div>
        </div>

        <span class="adash-avatar" title={me.name}>{initials}</span>

        <form method="get" class="adash-scope">
          {q && <input type="hidden" name="q" value={q} />}
          <select name="phase" aria-label="Filter by phase" onchange="this.form.submit()">
            <option value="" selected={!phaseFilter}>All Projects</option>
            {PHASES.map((p) => <option value={p.key} selected={phaseFilter === p.key}>{p.label}</option>)}
          </select>
        </form>
      </div>
    </header>

    {/* -------------------------------------------------------- Stat cards */}
    <div class="adash-stats">
      <div class="adash-stat">
        <span class="adash-stat__icon adash-stat__icon--blue">
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M5 2h7l3 3v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M12 2v3h3" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        </span>
        <span class="adash-stat__n">{total}</span>
        <span class="adash-stat__l">Total Submissions</span>
        <span class="adash-stat__sub adash-stat__sub--up">
          {createdThisMonth > 0 ? `↑ +${createdThisMonth} this month` : 'No new ones this month'}
        </span>
      </div>

      <div class="adash-stat">
        <span class="adash-stat__icon adash-stat__icon--teal">
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M3 14l4-4 3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span class="adash-stat__n">{active}</span>
        <span class="adash-stat__l">Active in Pipeline</span>
        <span class="adash-stat__track"><span class="adash-stat__fill adash-stat__fill--teal" style={`width:${activePct}%`}></span></span>
        <span class="adash-stat__sub">{activePct}% of total</span>
      </div>

      <div class="adash-stat">
        <span class="adash-stat__icon adash-stat__icon--amber">
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="7.3" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10 6v4.5l3 2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        </span>
        <span class="adash-stat__n">{awaiting}</span>
        <span class="adash-stat__l">Awaiting Coordinator Review</span>
        <span class:list={['adash-stat__sub', awaiting > 0 ? 'adash-stat__sub--warn' : 'adash-stat__sub--ok']}>
          {awaiting > 0 ? 'Needs follow-up' : 'All clear'}
        </span>
      </div>

      <div class="adash-stat">
        <span class="adash-stat__icon adash-stat__icon--red">
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="7.3" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10 6v4.5l3 2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        </span>
        <span class="adash-stat__n">{stagnant}</span>
        <span class="adash-stat__l">No Update in 7+ Days</span>
        <span class:list={['adash-stat__sub', stagnant > 0 ? 'adash-stat__sub--danger' : 'adash-stat__sub--ok']}>
          {stagnant > 0 ? 'Requires attention' : 'All caught up'}
        </span>
      </div>

      <div class="adash-stat">
        <span class="adash-stat__icon adash-stat__icon--green">
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 2 12 7l5.5.8-4 3.9.9 5.5L10 14.7 5.6 17.2l.9-5.5-4-3.9L8 7Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
        </span>
        <span class="adash-stat__n">{published}</span>
        <span class="adash-stat__l">Published</span>
        <span class="adash-stat__track"><span class="adash-stat__fill adash-stat__fill--green" style={`width:${publishedPct}%`}></span></span>
        <span class="adash-stat__sub">{publishedPct}% of total</span>
      </div>
    </div>

    {/* --------------------------------------------------- Stage + status */}
    <div class="adash-grid2">
      <section class="adash-card">
        <h2 class="adash-card__title">Submissions by Stage</h2>
        {bucketTotal === 0 ? (
          <p class="adash-empty">Nothing to show yet.</p>
        ) : (
          <ul class="adash-bars">
            {PHASES.map((p) => (
              <li class="adash-bar">
                <span class="adash-bar__label">{p.label}</span>
                <span class="adash-bar__track">
                  <span class="adash-bar__fill" style={`width:${(buckets[p.key] / bucketMax) * 100}%;background:${p.color}`}></span>
                </span>
                <span class="adash-bar__n">{buckets[p.key]}</span>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="adash-card">
        <h2 class="adash-card__title">Submission Status</h2>
        {bucketTotal === 0 ? (
          <p class="adash-empty">Nothing to show yet.</p>
        ) : (
          <div class="adash-donut">
            <svg viewBox="0 0 160 160" width="150" height="150" role="img" aria-label={`${bucketTotal} submissions by phase`}>
              <circle cx="80" cy="80" r={R} fill="none" stroke="var(--adash-track)" stroke-width="20" />
              {donutSegs.filter((s) => s.n > 0).map((s) => (
                <circle
                  cx="80" cy="80" r={R} fill="none" stroke={s.color} stroke-width="20"
                  stroke-dasharray={`${s.dash} ${s.gap}`} stroke-dashoffset={s.offset}
                  transform="rotate(-90 80 80)" stroke-linecap="butt"
                >
                  <title>{`${s.label}: ${s.n} (${Math.round(s.pct * 100)}%)`}</title>
                </circle>
              ))}
            </svg>
            <div class="adash-donut__center"><b>{bucketTotal}</b><span>Total</span></div>
            <ul class="adash-legend">
              {PHASES.map((p) => (
                <li>
                  <span class="adash-legend__dot" style={`background:${p.color}`}></span>
                  <span class="adash-legend__label">{p.label}</span>
                  <span class="adash-legend__n">{buckets[p.key]} ({bucketTotal ? Math.round((buckets[p.key] / bucketTotal) * 100) : 0}%)</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    </div>

    {/* ------------------------------------------------------ Activity trend */}
    <section class="adash-card">
      <div class="adash-trend__head">
        <h2 class="adash-card__title">Activity Trend</h2>
        <form method="get">
          {phaseFilter && <input type="hidden" name="phase" value={phaseFilter} />}
          {q && <input type="hidden" name="q" value={q} />}
          <select name="range" aria-label="Date range" onchange="this.form.submit()">
            <option value="7" selected={rangeDays === 7}>Last 7 Days</option>
            <option value="30" selected={rangeDays === 30}>Last 30 Days</option>
            <option value="90" selected={rangeDays === 90}>Last 90 Days</option>
          </select>
        </form>
      </div>
      {trend.every((t) => t.n === 0) ? (
        <p class="adash-empty">No recorded events in this range.</p>
      ) : (
        <div class="adash-trendchart" role="img" aria-label={`Events per day, last ${rangeDays} days`}>
          {trend.map((t) => (
            <span class="adash-trendchart__col" title={`${fmtDay(t.day)}: ${t.n} event${t.n === 1 ? '' : 's'}`}>
              <span class="adash-trendchart__bar" style={`height:${Math.max(3, (t.n / trendMax) * 100)}%`}></span>
            </span>
          ))}
        </div>
      )}
    </section>

    {/* ------------------------------------------------------- Reminders */}
    <section class="adash-card">
      <div class="adash-trend__head">
        <h2 class="adash-card__title">Stagnation reminders</h2>
        <div class="adash-reminders__actions">
          <form method="post" class="adash-inline">
            <button class="adash-btn adash-btn--ghost" name="action" value="sweep-dry" type="submit">Preview</button>
          </form>
          <form method="post" class="adash-inline">
            <button class="adash-btn adash-btn--primary" name="action" value="sweep" type="submit">Run sweep now</button>
          </form>
        </div>
      </div>
      {pipelineSweep ? (
        <div class="adash-sweep">
          <p>
            <strong>{pipelineSweep.checked}</strong> manuscript(s) checked ·
            <strong> {pipelineSweep.sent.length}</strong> reminder(s) sent ·
            <strong> {pipelineSweep.flagged.length}</strong> flagged for reassignment
          </p>
          {pipelineSweep.sent.length > 0 && (
            <ul class="adash-sweep__list">
              {pipelineSweep.sent.map((s) => <li>{s.ref} - level {s.level} → {s.recipients.join(', ')}</li>)}
            </ul>
          )}
        </div>
      ) : (
        <p class="adash-hint">
          Manuscript-phase projects idle 7+ days get an email nudge (escalating at 12 and 20 days,
          then flagged for reassignment). Runs automatically once a day via
          <span class="adash-mono"> /api/cron/reminders</span> - “Run sweep now” fires it immediately.
        </p>
      )}
    </section>
  </div>
</AppLayout>

<style>
  .adash {
    --adash-blue: #2a78d6;
    --adash-teal: #1baf7a;
    --adash-amber: #eda100;
    --adash-red: #a51c30;
    --adash-green: #166534;
    --adash-track: #e7eaf2;
    --adash-ink: #12213f;
    --adash-muted: #667085;
    background: #eef1f6;
    border-radius: 20px;
    padding: clamp(18px, 2vw, 30px);
    display: grid;
    gap: 20px;
    font-family: var(--font-sans);
  }
  :global(.app:has(.adash) .app__heading) { display: none; }

  .adash-flash { margin: 0; padding: 12px 16px; border-radius: 10px; font-size: 0.88rem; }
  .adash-flash--ok { background: #e7f6ee; color: #166534; }
  .adash-flash--error { background: #fdecec; color: #a51c30; }
  .adash-flash p { margin: 0; }

  /* ------------------------------------------------------------- header */
  .adash-head {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: flex-start;
    justify-content: space-between;
  }
  .adash-head__eyebrow { margin: 0; color: var(--adash-muted); font-size: 0.9rem; }
  .adash-head__title {
    margin: 2px 0 0;
    font-size: clamp(1.7rem, 1.3rem + 1.6vw, 2.35rem);
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--adash-ink);
  }
  .adash-head__tag { margin: 8px 0 0; color: var(--adash-muted); font-size: 0.95rem; }

  .adash-head__tools { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .adash-search {
    display: flex; align-items: center; gap: 8px;
    background: #fff; border: 1px solid #e2e6ef; border-radius: 12px;
    padding: 10px 14px; color: var(--adash-muted); min-width: 220px;
  }
  .adash-search input { border: 0; outline: 0; font: inherit; color: var(--adash-ink); background: none; width: 100%; }
  .adash-date {
    display: flex; align-items: center; gap: 8px; color: var(--adash-muted);
    background: #fff; border: 1px solid #e2e6ef; border-radius: 12px; padding: 9px 14px;
  }
  .adash-date b { display: block; color: var(--adash-ink); font-size: 0.85rem; line-height: 1.3; }
  .adash-date span { display: block; font-size: 0.76rem; }
  .adash-avatar {
    display: inline-grid; place-items: center; width: 38px; height: 38px; border-radius: 50%;
    background: var(--adash-ink); color: #fff; font-weight: 700; font-size: 0.82rem; flex-shrink: 0;
  }
  .adash-scope select {
    background: #fff; border: 1px solid #e2e6ef; border-radius: 12px; padding: 10px 14px;
    font: inherit; color: var(--adash-ink); cursor: pointer;
  }

  /* --------------------------------------------------------- stat cards */
  .adash-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .adash-stat {
    background: #fff; border-radius: 16px; padding: 20px 22px;
    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 1px 3px rgba(16, 24, 40, 0.06);
    display: grid; gap: 4px; align-content: start;
  }
  .adash-stat__icon {
    width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; margin-bottom: 6px;
  }
  .adash-stat__icon--blue { background: rgba(42, 120, 214, 0.12); color: var(--adash-blue); }
  .adash-stat__icon--teal { background: rgba(27, 175, 122, 0.12); color: var(--adash-teal); }
  .adash-stat__icon--amber { background: rgba(237, 161, 0, 0.14); color: var(--adash-amber); }
  .adash-stat__icon--red { background: rgba(165, 28, 48, 0.1); color: var(--adash-red); }
  .adash-stat__icon--green { background: rgba(22, 101, 52, 0.1); color: var(--adash-green); }
  .adash-stat__n { font-size: 2.1rem; font-weight: 800; letter-spacing: -0.02em; color: var(--adash-ink); line-height: 1; }
  .adash-stat__l { color: var(--adash-muted); font-size: 0.88rem; }
  .adash-stat__track { height: 6px; border-radius: 999px; background: var(--adash-track); overflow: hidden; margin-top: 6px; }
  .adash-stat__fill { display: block; height: 100%; border-radius: 999px; }
  .adash-stat__fill--teal { background: var(--adash-teal); }
  .adash-stat__fill--green { background: var(--adash-green); }
  .adash-stat__sub { font-size: 0.8rem; color: var(--adash-muted); margin-top: 2px; }
  .adash-stat__sub--up { color: var(--adash-teal); font-weight: 600; }
  .adash-stat__sub--warn { color: var(--adash-amber); font-weight: 600; }
  .adash-stat__sub--danger { color: var(--adash-red); font-weight: 600; }
  .adash-stat__sub--ok { color: var(--adash-teal); font-weight: 600; }

  /* -------------------------------------------------------------- cards */
  .adash-grid2 { display: grid; grid-template-columns: 1.1fr 1fr; gap: 16px; }
  @media (max-width: 860px) { .adash-grid2 { grid-template-columns: 1fr; } }
  .adash-card {
    background: #fff; border-radius: 16px; padding: 22px 24px;
