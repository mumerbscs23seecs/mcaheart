---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import IdeaForm from '../components/IdeaForm.astro';
import { director } from '../data/site';
---

<BaseLayout
  title="Submit a Research Idea"
  description="Propose a database or meta-analysis research idea to the MCA Heart Research Lab. The team reviews each submission for feasibility, database suitability and publication value."
  transparentHeader
>
  <PageHero
    title="Submit a research idea"
    subtitle={`Propose a database or meta-analysis project to ${director.name}, ${director.credentials} and the MCA Heart Research Lab team. Every submission is reviewed for clinical relevance, novelty, feasibility, appropriate data source, and publication potential before a project lead is assigned.`}
    image="/assets/brand/heart.webp"
  />

  <section class="section section--tight">
    <div class="shell shell--narrow idea-intro">
      <p>
        <strong>Before you submit:</strong> please complete a thorough and up-to-date literature
        review. Understanding what has already been published is essential for identifying
        meaningful research gaps and assessing publication potential. Frame your research question
        using <strong>PICO</strong> - Population, Intervention/Exposure, Comparison, Outcomes - and
        have your most recent and relevant citation, DOI, or PubMed link ready to support the
        rationale for your proposed study.
      </p>
      <p class="idea-intro__note">
        <strong>Data source:</strong> access to the <strong>DMC PCI Database</strong> requires an
        approved Wayne State University (WSU) IRB. If you don't have WSU IRB access, choose another
        available database or "Not sure" - the research team will help determine the most
        appropriate data source for your question.
      </p>
    </div>
  </section>

  <section class="section section--tight" id="form">
    <div class="shell shell--narrow">
      <IdeaForm />
    </div>
  </section>
</BaseLayout>

<style>
  .idea-intro { display: grid; gap: var(--space-s); color: var(--text); line-height: 1.75; }
  .idea-intro strong { color: var(--text-strong); }
  .idea-intro__note {
    padding: 0.9rem 1.1rem;
    background: var(--accent-wash);
    border-left: 2px solid var(--blue);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.9rem;
  }
</style>
