---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import IdeaForm from '../components/IdeaForm.astro';
import { director } from '../data/site';
---

<BaseLayout
  title="Submit a Research Idea"
  description="Propose a database or meta-analysis research idea to the MCA Research Group. The team reviews each submission for feasibility, database suitability and publication value."
>
  <PageHero
    eyebrow="MCA Research Group"
    title="Submit a research idea"
    subtitle={`Propose a database or meta-analysis project to ${director.name} and the team. Each idea is reviewed for feasibility, the right data source, and publication value before a lead is assigned.`}
  />

  <section class="section section--tight">
    <div class="shell shell--narrow idea-intro">
      <p>
        Before you start, do a real literature review — the publication value of an idea often
        depends on what has already been published. Frame the question as <strong>PICO</strong>
        (Population, Intervention, Comparison, Outcomes) and have your most recent key citation ready.
      </p>
      <p class="idea-intro__note">
        Access to the <strong>DMC PCI Database</strong> requires a WSU IRB. If you don't have one,
        choose another database or “Not sure” and the team will advise.
      </p>
    </div>
  </section>

  <section class="section section--tight" id="form">
    <div class="shell shell--narrow">
      <IdeaForm />
    </div>
  </section>
</BaseLayout>

<style>
  .idea-intro { display: grid; gap: var(--space-s); color: var(--text); line-height: 1.75; }
  .idea-intro strong { color: var(--text-strong); }
  .idea-intro__note {
    padding: 0.9rem 1.1rem;
    background: rgba(43, 57, 144, 0.06);
    border-left: 2px solid var(--blue);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.9rem;
  }
</style>
