---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ParallaxVideoHero from '../components/ParallaxVideoHero.astro';
import VideoCard from '../components/VideoCard.astro';
import VideoLightbox from '../components/VideoLightbox.astro';
import { site } from '../data/site';
import { fetchLatestVideos } from '../lib/youtube-feed';

// Pulled live from the channel's public RSS feed - no API key, cached for
// 20 minutes server-side so it stays fresh without hammering YouTube.
const channelId = site.youtube.split('/').filter(Boolean).pop()!;
const latestVideos = await fetchLatestVideos(channelId, 12);
---

<BaseLayout
  title="Heart Trending"
  description="MCA Heart Trending is a cardiovascular education platform led by Dr. M. Chadi Alraies, featuring conversations with cardiologists, researchers, and other experts on emerging evidence, clinical practice, and important developments in cardiovascular medicine."
  transparentHeader
>
  <ParallaxVideoHero
    title="Heart Trending"
    layout="lockup"
    bg="/assets/trending/hero-layers/bg.jpg"
    layer1={{ src: '/assets/trending/hero-layers/logo.webp', alt: 'Heart Trending logo mark' }}
    layer2={{ src: '/assets/trending/hero-layers/wordmark.webp', alt: 'Heart Trending' }}
    tagline="Interviews · Research · Journal Reviews · Webinars"
    finalTitle="Every beat tells a story."
    finalSub="Heart Trending"
    accent="#e2001f"
    navy="#0a1d33"
    navyDeep="#040d1c"
    ctaPrimary={{ label: 'Watch Episodes', href: '#gallery' }}
    ctaSecondary={{ label: 'Subscribe on YouTube', href: site.youtube }}
  />

  {/* -------------------------------------------------------------- Intro */}
  <section class="section--tight trending-intro">
    <div class="shell shell--narrow">
      <p class="prose center">
        Through expert interviews, research discussions, and educational webinars, we explore new
        ideas, examine the evidence behind evolving practices, and share insights that help advance
        cardiovascular knowledge and patient care.
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------- Just in */}
  {latestVideos.length > 0 && (
    <section class="section justin" id="gallery">
      <div class="shell shell--wide">
        <header class="library__head" data-reveal>
          <h2 class="display library__title">Just uploaded</h2>
          <p class="prose library__note">
            Pulled automatically from the channel - no editing needed on our end
            when a new episode goes up.
          </p>
        </header>

        <div class="library__grid">
          {latestVideos.map((v, i) => <VideoCard video={v} index={i} />)}
        </div>
      </div>
    </section>
  )}

  {/* ------------------------------------------------------------ Collaborate */}
  <section class="section collab dark-ground">
    <div class="shell shell--wide collab__grid">
      <div class="collab__copy" data-reveal>
        <h2 class="display collab__title">Have a story to share?</h2>
        <div class="prose collab__body">
          <p>
            MCA Heart invites you to be part of our video series. Whether it is an
            expert interview, a research discussion, or a webinar idea, we are
            excited to collaborate and amplify your voice.
          </p>
          <p>Contact us today to explore how we can create impactful content together.</p>
        </div>
        <a class="btn btn--light collab__cta" href="/contact">
          Collaborate with us <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <figure class="collab__art" data-reveal style="--reveal-delay:120ms">
        <img src="/assets/trending/collab.png" alt="" loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <VideoLightbox />
</BaseLayout>

<style>
  .phero__cta { margin-top: var(--space-l); }

  .library__title { font-size: var(--step-3); margin-top: var(--space-s); }
  .library__note { margin-top: var(--space-s); }

  .library__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(330px, 100%), 1fr));
    gap: var(--space-m);
    margin-top: var(--space-l);
  }

  .collab { overflow: hidden; }
  .collab__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .collab__title { font-size: var(--step-3); margin-top: var(--space-s); }
  .collab__body { margin-top: var(--space-m); }
  .collab__cta { margin-top: var(--space-l); }

  /* Line art drawn in black - inverted so it reads on the ink ground. */
  .collab__art img {
    width: 100%;
    height: auto;
    filter: invert(1);
    opacity: 0.9;
  }

  @media (max-width: 860px) {
    .collab__grid { grid-template-columns: 1fr; }
    .collab__art { order: -1; max-width: 460px; }
  }
</style>
