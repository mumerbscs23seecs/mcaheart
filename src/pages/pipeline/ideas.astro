---
/**
 * Propose a research idea, from inside the members portal.
 *
 * Same intake form and same review queue as the public /submit-idea page -
 * the only difference is that a signed-in member doesn't retype their name
 * and email (IdeaForm's `prefill`), and gets to see what happened to the
 * ideas they've already sent in. Admins still approve/withhold/decline at
 * /admin/ideas; nothing is decided here.
 */
import PipelineLayout from '../../layouts/PipelineLayout.astro';
import IdeaForm from '../../components/IdeaForm.astro';
import CalmDock from '../../components/calm/CalmDock.astro';
import '../../styles/calm.css';
import { icon } from '../../lib/calm';
import { listIdeas, OUTCOME_LABEL } from '../../lib/ideas';
import { CONFERENCE_LABELS } from '../../lib/idea-schema';

export const prerender = false;
const { person } = Astro.locals;

// The store is keyed by submitter email, so this is everything they've sent
// in - from here or from the public form, before they had an account.
const mine = (await listIdeas()).filter(
  (i) => i.leadEmail.toLowerCase() === person.email.toLowerCase(),
);

const STATUS_LABEL: Record<string, string> = {
  pending: 'Awaiting review',
  approved: 'Approved',
  withheld: 'Held for later',
  declined: 'Not taken forward',
};

const fmt = (t: number | null) => {
  if (!t) return '-';
  const d = new Date(t);
  return `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}-${d.getFullYear()}`;
};
---

<PipelineLayout title="New idea" active={person.role === 'admin' ? 'ideas' : 'requests'}>
  <div class="cv ni">
    <div class="ni-head">
    {person.role !== 'admin' && <a class="ni-back" href="/pipeline/requests"><Fragment set:html={icon('up')} />Requests</a>}
    <div class="cv-bar ni-bar">
      <div>
        <h1 class="cv-h1">New research idea</h1>
        <p class="ni-sub">Reviewed by the research team. You'll hear back by email, usually within five working days.</p>
      </div>
    </div>

    {mine.length > 0 && (
      <details class="ni-mine" open={mine.some((i) => i.status === 'pending')}>
        <summary><span class="cv-h2">Your ideas <span>{mine.length}</span></span></summary>
        <table class="cv-table">
          <thead>
            <tr><th>Idea</th><th style="width:110px">Sent</th><th style="width:180px">Status</th></tr>
          </thead>
          <tbody>
            {mine.map((i) => (
              <tr>
                <td class="t ni-t">{i.title}<div class="cv-sub">{i.researchType}, {CONFERENCE_LABELS[i.conference]}</div>{i.decisionNote && <div class="cv-sub">“{i.decisionNote}”</div>}</td>
                <td class="sm num">{fmt(i.submittedAt)}</td>
                <td><span class="cv-dot" style={`--c:${i.status === 'approved' ? '#166534' : i.status === 'declined' ? '#a12a2a' : i.status === 'pending' ? '#b06a0a' : '#2563a8'}`}>{i.decisionOutcome ? OUTCOME_LABEL[i.decisionOutcome] : (STATUS_LABEL[i.status] ?? i.status)}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>
    )}
    </div>

    <div class="ni-form">
      <IdeaForm prefill={{ name: person.full_name, email: person.email }} />
    </div>
  </div>
  <CalmDock drawer={false} />
</PipelineLayout>

<style>
  .ni-head { max-width: 720px; margin-inline: auto; }
  .ni-back { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 10px; font-size: 0.875rem; font-weight: 600; opacity: 0.7; }
  .ni-back:hover { opacity: 1; color: var(--cv-accent); }
  .ni-back :global(.cv-ic) { width: 15px; height: 15px; transform: rotate(-90deg); }
  .ni-sub { margin: 8px 0 0; font-size: 0.9375rem; opacity: 0.7; }
  .ni-mine { margin: 8px 0 12px; }
  .ni-mine > summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 12px; }
  .ni-mine > summary::-webkit-details-marker { display: none; }
  .ni-mine > summary::after { content: ''; width: 8px; height: 8px; border: solid currentColor; border-width: 0 2px 2px 0; transform: rotate(45deg); margin: -4px 0 0 4px; opacity: 0.6; transition: transform 0.15s; }
  .ni-mine[open] > summary::after { transform: rotate(-135deg); margin-top: 4px; }
  .ni-mine .cv-h2 { margin: 0; }
  .ni-t { font-weight: 500; }
  /* The idea form is shared with the public site; inside the workflow it
     takes the calm colours and a quieter heading size. */
  .ni-form :global(.iskin) { --accent: var(--cv-accent); --tint: var(--cv-tint); --soft: var(--cv-soft); --line: var(--cv-line); }
  .ni-form :global(.iskin .iform__legend) { font-size: 1.25rem; }
  .ni-form :global(.iskin .iform__group) { padding: 36px 0; }
  .ni-form :global(.iskin .iform__group:first-of-type) { padding-top: 12px; }
  .ni-form :global(.iskin .iform__prefill) { margin: 0; padding: 11px 14px; border: 1px solid var(--cv-line); border-radius: 8px; background: var(--cv-soft); font-weight: 600; }
  .ni-form :global(.iskin .ichoice) { border: 1px solid var(--cv-line); margin-bottom: 6px; }
  .ni-form :global(.iskin .ichoices) { gap: 0; }
  .ni-form :global(.iskin .ichoice:has(input:checked)) { border-color: var(--cv-accent); font-weight: 600; }
  .ni-form :global(.iskin .iform__submit) { padding: 12px 24px; font-size: 0.9375rem; }
  .ni-form :global(.iskin .iform__submit .btn__arrow) { display: none; }
</style>
