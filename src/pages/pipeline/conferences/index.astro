---
import PipelineLayout from '../../../layouts/PipelineLayout.astro';
import PipelineStatusCell from '../../../components/PipelineStatusCell.astro';
import { scopeProjects } from '../../../lib/pipeline-scope';

export const prerender = false;
const { supabase, person } = Astro.locals;
const isAdmin = person.role === 'admin';

const SERIES = ['ACC', 'SCAI', 'TCT'] as const;
const active = (Astro.url.searchParams.get('series') ?? '').toUpperCase();
const activeSeries = SERIES.includes(active as any) ? active : null;

const fmtDate = (d: string | null) =>
  d ? new Date(d).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' }) : '-';

let flash: { tone: 'ok' | 'error'; text: string } | null = null;
let newNameDraft = '';

if (isAdmin && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('action') ?? '') === 'add-conference') {
    const name = String(form.get('name') ?? '').trim();
    const deadline = String(form.get('abstract_deadline') ?? '').trim();
    newNameDraft = name;
    if (!name || !deadline) {
      flash = { tone: 'error', text: 'Name and abstract deadline are both required.' };
    } else {
      const { error } = await supabase.rpc('add_conference', { p_name: name, p_abstract_deadline: deadline });
      if (error) {
        flash = { tone: 'error', text: error.message };
      } else {
        flash = { tone: 'ok', text: `Added "${name}".` };
        newNameDraft = '';
      }
    }
  }
}

// ---- Members: their own conference-phase papers, as a table.
let mine: any[] = [];
if (!isAdmin) {
  let q = supabase
    .from('project_list')
    .select('id,ref,title,phase,stage,stage_label,lead_name,analyst_name,current_conference,days_in_stage,created_at,stage_changed_at,archived_at')
    .eq('phase', 'conference')
    .is('archived_at', null)
    .order('stage_changed_at', { ascending: false });
  q = scopeProjects(q, person);
  const { data } = await q;
  mine = data ?? [];
}

// ---- Admins: the conference scorecard list.
let rows: any[] = [];
if (isAdmin) {
  const [{ data: conferences }, { data: scorecard }] = await Promise.all([
    supabase.from('conferences').select('id,name,abstract_deadline').order('abstract_deadline', { ascending: false }),
    supabase.from('conference_scorecard').select('*'),
  ]);
  const score = new Map((scorecard ?? []).map((s: any) => [s.name, s]));
  rows = (conferences ?? [])
    .filter((c: any) => !activeSeries || c.name.startsWith(activeSeries))
    .map((c: any) => ({ ...c, ...(score.get(c.name) ?? { submitted: 0, accepted: 0, rejected: 0, accept_pct: null, recycled_in: 0 }) }));
}
---

<PipelineLayout title="Conferences" active="conferences">
  <h1 class="pl-h1">Conferences</h1>

  {isAdmin ? (
    <>
      <p class="pl-sub">Every abstract submission, permanent once the meeting is over.</p>

      {flash && <p class:list={['pl-flash', flash.tone === 'ok' ? 'pl-flash--ok' : 'pl-flash--err']}>{flash.text}</p>}

      <div class="pl-filter">
        <a class:list={['pl-chip', !activeSeries && 'is-active']} href="/pipeline/conferences">All</a>
        {SERIES.map((s) => (
          <a class:list={['pl-chip', activeSeries === s && 'is-active']} href={`/pipeline/conferences?series=${s}`}>{s}</a>
        ))}
      </div>

      <details class="pl-inline-details" style="margin:14px 0 0">
        <summary>+ Add {activeSeries ?? 'a'} conference</summary>
        <form method="post" class="pl-mini pl-mini--col" style="margin-top:10px">
          <input type="hidden" name="action" value="add-conference" />
          {activeSeries && <input type="hidden" name="series" value={activeSeries} />}
          <label class="pl-field">
            <span>Name</span>
            <input
              name="name"
              required
              placeholder="e.g. ACC 2028"
              value={newNameDraft || (activeSeries ? `${activeSeries} ` : '')}
            />
          </label>
          <label class="pl-field">
            <span>Abstract deadline</span>
            <input type="date" name="abstract_deadline" required />
          </label>
          <button class="pl-btn" type="submit">Add conference</button>
        </form>
      </details>

      {rows.length === 0 && <p class="pl-muted" style="margin-top:20px">No conferences match.</p>}

      {rows.length > 0 && (
        <div class="pl-tablewrap">
          <table class="pl-table">
            <thead>
              <tr>
                <th>Conference</th>
                <th>Abstract deadline</th>
                <th>Submitted</th>
                <th>Accepted</th>
                <th>Rejected</th>
                <th>Accept %</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((c) => (
                <tr>
                  <td class="pl-t__title" data-th="Conference">
                    <a href={`/pipeline/conferences/${c.id}`}>{c.name}</a>
                    {c.recycled_in > 0 && <span class="pl-t__ref">{c.recycled_in} recycled in</span>}
                  </td>
                  <td class="pl-t__date" data-th="Abstract deadline">{fmtDate(c.abstract_deadline)}</td>
                  <td data-th="Submitted">{c.submitted}</td>
                  <td data-th="Accepted">{c.accepted}</td>
                  <td data-th="Rejected">{c.rejected}</td>
                  <td data-th="Accept %">{c.accept_pct != null ? `${c.accept_pct}%` : '-'}</td>
                  <td class="pl-t__actions" data-th="Actions">
                    <a href={`/pipeline/conferences/${c.id}`}>View conference &nearr;</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      <p class="pl-count">Deadlines are approximate placeholders from the import - verify before relying on them.</p>
    </>
  ) : (
    <>
      <p class="pl-sub">Your papers at the abstract stage - being written, submitted, or awaiting a decision.</p>

      {mine.length === 0 && <p class="pl-muted" style="margin-top:20px">Nothing here.</p>}

      {mine.length > 0 && (
        <div class="pl-tablewrap">
          <table class="pl-table">
            <thead>
              <tr>
                <th>Submission title</th>
                <th>Conference</th>
                <th>Opened</th>
                <th>Last updated</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {mine.map((p) => (
                <tr>
                  <td class="pl-t__title" data-th="Submission title">
                    <a href={`/pipeline/projects/${p.id}`} data-panel={p.id}>{p.title}</a>
                    <span class="pl-t__ref">{p.ref}{p.analyst_name ? ` · analyst ${p.analyst_name}` : ''}</span>
                  </td>
                  <td class="pl-t__venue" data-th="Conference">{p.current_conference ?? 'no conference yet'}</td>
                  <td class="pl-t__date" data-th="Opened">{fmtDate(p.created_at)}</td>
                  <td class="pl-t__date" data-th="Last updated">{fmtDate(p.stage_changed_at)}</td>
                  <td data-th="Status"><PipelineStatusCell project={p} isAdmin={false} /></td>
                  <td class="pl-t__actions" data-th="Actions">
                    <a href={`/pipeline/projects/${p.id}`}>Check progress &nearr;</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {mine.length > 0 && <p class="pl-count">{mine.length} {mine.length === 1 ? 'paper' : 'papers'}</p>}
    </>
  )}
</PipelineLayout>
