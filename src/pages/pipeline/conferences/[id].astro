---
import PipelineLayout from '../../../layouts/PipelineLayout.astro';
import PeoplePicker from '../../../components/PeoplePicker.astro';
import PipelineStatusCell from '../../../components/PipelineStatusCell.astro';
import { STUDY_TYPES } from '../../../lib/lifecycle.mjs';

export const prerender = false;
const { supabase, person } = Astro.locals;
const { id } = Astro.params;

// The per-conference scorecard is aggregate data - coordinators only.
if (person.role !== 'admin') return Astro.redirect('/pipeline/conferences', 302);

const { data: conf } = await supabase.from('conferences').select('*').eq('id', id).maybeSingle();
if (!conf) return Astro.redirect('/pipeline/conferences', 302);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('action') ?? '') === 'set-type') {
    const projectId = String(form.get('project_id') ?? '');
    const studyType = String(form.get('study_type') ?? '');
    const { error } = await supabase.rpc('set_study_type', { p_project: projectId, p_study_type: studyType });
    const msg = error ? `err=${encodeURIComponent(error.message)}` : `ok=${encodeURIComponent('Type of research updated.')}`;
    return Astro.redirect(`/pipeline/conferences/${id}?${msg}`);
  }
  if (String(form.get('action') ?? '') === 'add-paper') {
    const title = String(form.get('title') ?? '').trim();
    const studyType = String(form.get('study_type') ?? '');
    const leadId = String(form.get('lead_id') ?? '').trim() || null;
    const analystId = String(form.get('analyst_id') ?? '').trim() || null;
    if (!title || !studyType) {
      return Astro.redirect(`/pipeline/conferences/${id}?err=${encodeURIComponent('Title and study type are both required.')}`);
    }
    const { error } = await supabase.rpc('create_project_in_conference', {
      p_title: title,
      p_study_type: studyType,
      p_conference_id: id,
      p_lead_id: leadId,
      p_analyst_id: analystId,
    });
    if (error) {
      return Astro.redirect(`/pipeline/conferences/${id}?err=${encodeURIComponent(error.message)}`);
    }
    return Astro.redirect(`/pipeline/conferences/${id}?ok=${encodeURIComponent(`Added "${title}".`)}`);
  }
}

// For the "add a paper manually" form's lead/analyst pickers.
const { data: people } = await supabase
  .from('people')
  .select('id,full_name')
  .eq('active', true)
  .order('full_name');

const { data: score } = await supabase
  .from('conference_scorecard')
  .select('*')
  .eq('name', conf.name)
  .maybeSingle();

// Every attempt at this conference - including papers that have since moved on.
const { data: attempts } = await supabase
  .from('conference_attempts')
  .select('id, outcome, project_id')
  .eq('conference_id', id);

const projectIds = [...new Set((attempts ?? []).map((a: any) => a.project_id))];
const { data: projectRows } = projectIds.length
  ? await supabase
      .from('project_list')
      .select('id,ref,title,phase,stage,stage_label,study_type,lead_name,analyst_name,days_in_stage,archived_at,hidden_at')
      .in('id', projectIds)
  : { data: [] };
const projectById = new Map((projectRows ?? []).map((r: any) => [r.id, r]));

// Live papers first (still in this conference, undecided), then accepted,
// then rejected/withdrawn - alphabetical within each group.
const GROUP: Record<string, number> = { accepted: 1, rejected: 2, withdrawn: 2 };
const rows = (attempts ?? [])
  .map((a: any) => ({ attempt: a, p: projectById.get(a.project_id) }))
  .filter((r: any) => r.p && !r.p.hidden_at)
  .sort((x: any, y: any) =>
    (x.attempt.outcome ? GROUP[x.attempt.outcome] ?? 3 : 0) - (y.attempt.outcome ? GROUP[y.attempt.outcome] ?? 3 : 0) ||
    x.p.title.localeCompare(y.p.title),
  );

// Numeric MM-DD-YYYY - keeps the date column narrow so title/status columns
// have the room, instead of the long "September 2, 2024" form.
const fmtDate = (d: string | null) => {
  if (!d) return '-';
  const dt = new Date(d);
  return `${String(dt.getMonth() + 1).padStart(2, '0')}-${String(dt.getDate()).padStart(2, '0')}-${dt.getFullYear()}`;
};
const s = score ?? { submitted: 0, accepted: 0, rejected: 0, accept_pct: null };
const pending = Math.max(0, (s.submitted ?? 0) - (s.accepted ?? 0) - (s.rejected ?? 0));
const cap = (x: string | null) => (x ? x[0].toUpperCase() + x.slice(1) : 'Pending');
---

<PipelineLayout title={conf.name} active="conferences">
  <p class="pl-crumb"><a class="pl-link" href="/pipeline/conferences">← Conferences</a></p>
  <div class="cf-head">
    <div class="cf-head__main">
      <h1 class="pl-h1">{conf.name}</h1>
      <p class="pl-sub cf-deadline">Deadline: {fmtDate(conf.abstract_deadline)}</p>
    </div>

    <div class="cf-stats">
      <div class="cf-stats__nums">
        <div><b>{s.submitted}</b><span>Submitted</span></div>
        <div><b class="is-ok">{s.accepted}</b><span>Accepted</span></div>
        <div><b class="is-bad">{s.rejected}</b><span>Rejected</span></div>
        <div><b>{s.accept_pct != null ? `${s.accept_pct}%` : '-'}</b><span>Acceptance</span></div>
      </div>
      {s.submitted > 0 && (
        <>
          <div class="cf-bar" role="img" aria-label={`${s.accepted} accepted, ${s.rejected} rejected, ${pending} pending out of ${s.submitted}`}>
            <i class="cf-bar__ok" style={`width:${(s.accepted / s.submitted) * 100}%`}></i>
            <i class="cf-bar__bad" style={`width:${(s.rejected / s.submitted) * 100}%`}></i>
          </div>
          <p class="cf-legend">
            <span class="cf-legend__ok">Accepted {s.accepted}</span>
            <span class="cf-legend__bad">Rejected {s.rejected}</span>
            <span class="cf-legend__pending">Pending {pending}</span>
          </p>
        </>
      )}
    </div>
  </div>

  <details class="pl-inline-details" style="margin:14px 0 0">
    <summary>+ Add a paper manually</summary>
    <p class="pl-muted" style="padding:10px 0 0; font-size:.85rem">
      Skips idea submission entirely - creates the project straight into this conference, "Abstract being written".
    </p>
    <form method="post" class="pl-mini pl-mini--col" style="margin-top:10px">
      <input type="hidden" name="action" value="add-paper" />
      <label class="pl-field">
        <span>Title</span>
        <input name="title" required placeholder="Paper title" />
      </label>
      <label class="pl-field">
        <span>Study type</span>
        <select name="study_type" required>
          <option value="" selected disabled>Choose one</option>
          {STUDY_TYPES.map((t) => <option value={t}>{t}</option>)}
        </select>
      </label>
      <PeoplePicker name="lead_id" label="Lead (optional)" roster={people ?? []} />
      <PeoplePicker name="analyst_id" label="Analyst (optional)" roster={people ?? []} />
      <button class="pl-btn" type="submit">Add paper</button>
    </form>
  </details>

  {rows.length === 0 && (
    <p class="pl-muted" style="margin-top:20px">No papers in this conference yet.</p>
  )}

  {rows.length > 0 && (
    <div class="pl-tablewrap" style="margin-top:16px">
      <table class="pl-table pl-conf-table">
        <colgroup>
          <col class="c-title" /><col class="c-type" /><col class="c-person" /><col class="c-person" /><col class="c-status" /><col class="c-actions" />
        </colgroup>
        <thead>
          <tr>
            <th>Submission title</th>
            <th>Type</th>
            <th>Lead</th>
            <th>Analyst</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(({ attempt: a, p }: any) => {
            // Only a paper still sitting in this conference with its abstract
            // undecided gets the live dropdown; anything decided, or that has
            // since moved on to Ongoing/Submissions, shows this attempt's outcome.
            const live = !a.outcome && p.phase === 'conference';
            return (
              <tr>
                <td class="pl-t__title" data-th="Submission title">
                  <a href={`/pipeline/projects/${p.id}`} data-panel={p.id}>{p.title}</a>
                  <span class="pl-t__ref">{p.ref}</span>
                </td>
                <td data-th="Type">
                  <form method="post" class="pl-conf-type" data-type-form>
                    <input type="hidden" name="action" value="set-type" />
                    <input type="hidden" name="project_id" value={p.id} />
                    <select class="pl-status" name="study_type" aria-label={`Type of research for ${p.title}`}>
                      {STUDY_TYPES.map((t: string) => <option value={t} selected={t === p.study_type}>{t}</option>)}
                    </select>
                  </form>
                </td>
                <td class="pl-conf-person" data-th="Lead">{p.lead_name ?? <span class="pl-muted">-</span>}</td>
                <td class="pl-conf-person" data-th="Analyst">{p.analyst_name ?? <span class="pl-muted">-</span>}</td>
                <td data-th="Status">
                  {live ? (
                    <PipelineStatusCell project={{ ...p, open_conference_attempt_id: a.id }} isAdmin={true} />
                  ) : (
                    <span class:list={['pl-status', a.outcome === 'rejected' && 'pl-status--warn']}>{cap(a.outcome)}</span>
                  )}
                </td>
                <td class="pl-t__actions" data-th="Actions">
                  <a href={`/pipeline/projects/${p.id}`}>Check progress &nearr;</a>
                  <a href={`/pipeline/projects/${p.id}/email?from=/pipeline/conferences/${id}`}>Email &nearr;</a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
</PipelineLayout>

<style is:global>
  /* Fixed layout so the columns hold these proportions no matter what a cell
     holds: Type / Lead / Analyst share one equal width, Status gets a bit more
     for its longest label, and the title takes what's left. */
  .pl-conf-table { table-layout: fixed; min-width: 1040px; }
  .pl-conf-table .c-title { width: 28%; }
  .pl-conf-table .c-type,
  .pl-conf-table .c-person { width: 13%; }
  .pl-conf-table .c-status { width: 17%; }
  .pl-conf-table .c-actions { width: 16%; }
  .pl-conf-table td { overflow-wrap: anywhere; }
  .pl-conf-person { color: var(--text-strong); font-weight: 500; }
  .pl-conf-type { margin: 0; }
  /* Both dropdowns fill their column instead of PipelineStatusCell's fixed
     250px, so the Type and Status selects line up edge to edge. */
  .pl-conf-table select.pl-status,
  .pl-conf-table .pl-status { min-width: 0; max-width: none; width: 100%; }
  .pl-conf-table .pl-status-form { width: 100%; }

  /* Header: name on the left, the scorecard and a split bar on the right. */
  .cf-head { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 20px 40px; margin-bottom: 18px; }
  .cf-head__main { min-width: 0; }
  .cf-stats { flex: 0 1 420px; }
  .cf-stats__nums { display: flex; gap: clamp(18px, 3vw, 34px); }
  .cf-stats__nums b {
    display: block; font-family: var(--font-display, sans-serif); font-weight: 800;
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.2rem); line-height: 1; letter-spacing: -0.03em;
    color: var(--text-strong); font-variant-numeric: tabular-nums;
  }
  .cf-stats__nums b.is-ok { color: var(--pl-good, #166534); }
  .cf-stats__nums b.is-bad { color: var(--pl-accent); }
  .cf-stats__nums span { display: block; margin-top: 6px; font-size: 0.8rem; font-weight: 600; color: var(--text-muted); }
  .cf-bar { display: flex; height: 8px; margin-top: 16px; background: var(--border-soft); overflow: hidden; }
  .cf-bar i { display: block; height: 100%; }
  .cf-bar__ok { background: var(--pl-good, #166534); }
  .cf-bar__bad { background: var(--pl-accent); }
  .cf-legend { display: flex; flex-wrap: wrap; gap: 14px; margin: 8px 0 0; font-size: 0.78rem; color: var(--text-muted); }
  .cf-legend span::before { content: ''; display: inline-block; width: 8px; height: 8px; margin-right: 6px; vertical-align: 1px; }
  .cf-legend__ok::before { background: var(--pl-good, #166534); }
  .cf-legend__bad::before { background: var(--pl-accent); }
  .cf-legend__pending::before { background: var(--border-soft); outline: 1px solid var(--border); }
  .cf-deadline { margin-top: 10px; }
</style>

<script>
  // Type of research applies on change - it's metadata, no email/preview.
  document.addEventListener('change', (e) => {
    const select = e.target as HTMLElement | null;
    const form = select?.closest<HTMLFormElement>('[data-type-form]');
    if (form) form.submit();
  });
</script>
