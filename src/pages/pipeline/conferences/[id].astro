---
import PipelineLayout from '../../../layouts/PipelineLayout.astro';

export const prerender = false;
const { supabase, person } = Astro.locals;
const { id } = Astro.params;

// The per-conference scorecard is aggregate data - coordinators only.
if (person.role !== 'admin') return Astro.redirect('/pipeline/conferences', 302);

const { data: conf } = await supabase.from('conferences').select('*').eq('id', id).maybeSingle();
if (!conf) return Astro.redirect('/pipeline/conferences', 302);

const STUDY_TYPES = ['DMC PCI', 'NIS', 'TriNetX', 'SRMA', 'Other'] as const;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('action') ?? '') === 'add-paper') {
    const title = String(form.get('title') ?? '').trim();
    const studyType = String(form.get('study_type') ?? '');
    const leadId = String(form.get('lead_id') ?? '').trim() || null;
    const analystId = String(form.get('analyst_id') ?? '').trim() || null;
    if (!title || !studyType) {
      return Astro.redirect(`/pipeline/conferences/${id}?err=${encodeURIComponent('Title and study type are both required.')}`);
    }
    const { error } = await supabase.rpc('create_project_in_conference', {
      p_title: title,
      p_study_type: studyType,
      p_conference_id: id,
      p_lead_id: leadId,
      p_analyst_id: analystId,
    });
    if (error) {
      return Astro.redirect(`/pipeline/conferences/${id}?err=${encodeURIComponent(error.message)}`);
    }
    return Astro.redirect(`/pipeline/conferences/${id}?ok=${encodeURIComponent(`Added "${title}".`)}`);
  }
}

// For the "add a paper manually" form's lead/analyst pickers.
const { data: people } = await supabase
  .from('people')
  .select('id,full_name')
  .eq('active', true)
  .order('full_name');

const { data: score } = await supabase
  .from('conference_scorecard')
  .select('*')
  .eq('name', conf.name)
  .maybeSingle();

// Every attempt at this conference - including papers that have since moved on.
const { data: attempts } = await supabase
  .from('conference_attempts')
  .select(
    'id, outcome, decided_on, recycled_from, project:projects(id,ref,title,phase,stage), presenter:people!conference_attempts_presenter_id_fkey(full_name)',
  )
  .eq('conference_id', id)
  .order('outcome', { ascending: true });

// Numeric MM-DD-YYYY - keeps the date column narrow so title/status columns
// have the room, instead of the long "September 2, 2024" form.
const fmtDate = (d: string | null) => {
  if (!d) return '-';
  const dt = new Date(d);
  return `${String(dt.getMonth() + 1).padStart(2, '0')}-${String(dt.getDate()).padStart(2, '0')}-${dt.getFullYear()}`;
};
const s = score ?? { submitted: 0, accepted: 0, rejected: 0, accept_pct: null };
const phaseLabel = (p: string) =>
  ({ idea: 'idea', conference: 'conference', manuscript: 'manuscript', journal: 'journal', archived: 'archived' })[p] ?? p;
const cap = (x: string | null) => (x ? x[0].toUpperCase() + x.slice(1) : 'Pending');
---

<PipelineLayout title={conf.name} active="conferences">
  <p class="pl-crumb"><a class="pl-link" href="/pipeline/conferences">← Conferences</a></p>
  <h1 class="pl-h1">{conf.name}</h1>
  <p class="pl-sub">Abstract deadline {fmtDate(conf.abstract_deadline)}. This page never changes after the meeting.</p>

  <div class="pl-score">
    <div><b>{s.submitted}</b><span>Submitted</span></div>
    <div><b>{s.accepted}</b><span>Accepted</span></div>
    <div><b>{s.rejected}</b><span>Rejected</span></div>
    <div><b>{s.accept_pct != null ? `${s.accept_pct}%` : '-'}</b><span>Acceptance</span></div>
  </div>

  <details class="pl-inline-details" style="margin:14px 0 0">
    <summary>+ Add a paper manually</summary>
    <p class="pl-muted" style="padding:10px 0 0; font-size:.85rem">
      Skips idea submission entirely - creates the project straight into this conference, "Abstract being written".
    </p>
    <form method="post" class="pl-mini pl-mini--col" style="margin-top:10px">
      <input type="hidden" name="action" value="add-paper" />
      <label class="pl-field">
        <span>Title</span>
        <input name="title" required placeholder="Paper title" />
      </label>
      <label class="pl-field">
        <span>Study type</span>
        <select name="study_type" required>
          <option value="" selected disabled>Choose one</option>
          {STUDY_TYPES.map((t) => <option value={t}>{t}</option>)}
        </select>
      </label>
      <label class="pl-field">
        <span>Lead (optional)</span>
        <select name="lead_id">
          <option value="">Unassigned</option>
          {(people ?? []).map((p: any) => <option value={p.id}>{p.full_name}</option>)}
        </select>
      </label>
      <label class="pl-field">
        <span>Analyst (optional)</span>
        <select name="analyst_id">
          <option value="">Unassigned</option>
          {(people ?? []).map((p: any) => <option value={p.id}>{p.full_name}</option>)}
        </select>
      </label>
      <button class="pl-btn" type="submit">Add paper</button>
    </form>
  </details>

  {(!attempts || attempts.length === 0) && (
    <p class="pl-muted" style="margin-top:20px">No abstract outcomes recorded for this conference.</p>
  )}

  {attempts && attempts.length > 0 && (
    <div class="pl-tablewrap" style="margin-top:16px">
      <table class="pl-table">
        <thead>
          <tr>
            <th>Submission title</th>
            <th>Presenter</th>
            <th>Now in</th>
            <th>Decided</th>
            <th>Outcome</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {attempts.map((a: any) => (
            <tr>
              <td class="pl-t__title" data-th="Submission title">
                <a href={`/pipeline/projects/${a.project?.id}`} data-panel={a.project?.id}>
                  {a.project?.title ?? '(project removed)'}
                </a>
                <span class="pl-t__ref">
                  {a.project?.ref}{a.recycled_from ? ' · recycled from an earlier attempt' : ''}
                </span>
              </td>
              <td data-th="Presenter">{a.presenter?.full_name ?? '-'}</td>
              <td class="pl-t__venue" data-th="Now in">{phaseLabel(a.project?.phase ?? '')}</td>
              <td class="pl-t__date" data-th="Decided">{fmtDate(a.decided_on)}</td>
              <td data-th="Outcome">
                <span class:list={['pl-status', a.outcome === 'rejected' && 'pl-status--warn']}>{cap(a.outcome)}</span>
              </td>
              <td class="pl-t__actions" data-th="Actions">
                <a href={`/pipeline/projects/${a.project?.id}`}>Check progress &nearr;</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</PipelineLayout>
