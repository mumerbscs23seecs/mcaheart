---
import PipelineLayout from '../../layouts/PipelineLayout.astro';
import PipelineStatusCell from '../../components/PipelineStatusCell.astro';
import CalmBar from '../../components/calm/CalmBar.astro';
import CalmFilters from '../../components/calm/CalmFilters.astro';
import CalmActions from '../../components/calm/CalmActions.astro';
import CalmStatus from '../../components/calm/CalmStatus.astro';
import CalmDock from '../../components/calm/CalmDock.astro';
import { scopeProjects } from '../../lib/pipeline-scope';
import { stagesFor } from '../../lib/lifecycle.mjs';
import { stageColor, fmtDate } from '../../lib/calm';

export const prerender = false;
const { supabase, person } = Astro.locals;
const isAdmin = person.role === 'admin';

const showParked = Astro.url.searchParams.get('parked') === '1';

let query = supabase
  .from('project_list')
  .select('id,ref,title,full_title,phase,stage,stage_label,lead_name,analyst_name,current_conference,days_in_stage,days_overdue,parked,ms_version,created_at,stage_changed_at,archived_at,submission_order')
  .eq('phase', 'manuscript')
  .is('archived_at', null)
  .is('hidden_at', null)
  .is('deleted_at', null)
  .order('submission_order', { ascending: true, nullsFirst: false })
  .order('stage_changed_at', { ascending: false });
if (!showParked) query = query.eq('parked', false);
if (!isAdmin) query = scopeProjects(query, person);

const { data: rows, error } = await query;
const list = rows ?? [];

// Short chip names so all six fit on one line; the full name shows on hover.
const SHORT: Record<string, string> = {
  ms_1_4: '1/6 Analysis',
  ms_2_4: '2/6 Results & methods',
  ms_3_4: '3/6 Intro & discussion',
  ms_4_4: '4/6 Formatting',
  ms_5_review: '5/6 RG review',
  ms_6_comments: '6/6 RG comments',
};
const chips = stagesFor('manuscript').map((s: any) => ({
  key: s.code,
  label: SHORT[s.code] ?? s.label,
  title: s.label,
  count: list.filter((p: any) => p.stage === s.code).length,
}));
---

<PipelineLayout title="Ongoing" active="ongoing">
  <div class="cv">
    <CalmBar title="Ongoing" count={list.length}>
      <label class="cv-check">
        <input type="checkbox" checked={showParked}
          onchange={`location.href = this.checked ? '?parked=1' : location.pathname`} />
        Show parked
      </label>
    </CalmBar>
    {error && <p class="pl-flash pl-flash--err">{error.message}</p>}
    <CalmFilters items={chips} total={list.length} oneLine />

    {list.length === 0 ? (
      <p class="pl-muted cv-empty">Nothing here.</p>
    ) : (
      <table class="cv-table">
        <thead>
          <tr>
            <th>Submission title</th>
            <th class="cv-classic cv-hide-sm" style="width:130px">Conference</th>
            <th class="cv-classic cv-hide-sm" style="width:115px">Started</th>
            <th class="cv-classic cv-hide-sm" style="width:130px">Last updated</th>
            <th class="cv-stacked cv-hide-sm" style="width:230px">Conference &amp; dates</th>
            <th style="width:375px">Status</th>
            <th class="x" style={`width:${isAdmin ? 88 : 56}px`}>Actions</th>
          </tr>
        </thead>
        <tbody>
          {list.map((p: any) => (
            <tr data-cv-row data-cv-f={p.stage} data-cv-text={`${p.full_title ?? ''} ${p.title ?? ''} ${p.ref ?? ''}`}>
              <td class="t">
                <a href={`/pipeline/projects/${p.id}`} data-panel={p.id}>{p.full_title || p.title}</a>
                <div class="cv-sub">
                  {p.full_title && p.title ? `${p.title} · ` : ''}{p.ms_version ?? 'v1.0'}
                  {p.analyst_name ? ` · analyst ${p.analyst_name}` : ''}
                  {p.parked ? ' · parked' : ''}
                </div>
              </td>
              <td class="cv-classic cv-hide-sm sm">{p.current_conference ?? '-'}</td>
              <td class="cv-classic cv-hide-sm nw sm">{fmtDate(p.created_at)}</td>
              <td class="cv-classic cv-hide-sm nw sm">{fmtDate(p.stage_changed_at)}</td>
              <td class="cv-stacked cv-hide-sm">
                <div class="cv-ln">{p.current_conference ?? '-'}</div>
                <div class="cv-jn">Started {fmtDate(p.created_at)} · Updated {fmtDate(p.stage_changed_at)}</div>
              </td>
              <td>
                <CalmStatus color={stageColor(p.phase, p.stage)}>
                  <PipelineStatusCell project={p} isAdmin={isAdmin} />
                </CalmStatus>
              </td>
              <td class="x">
                <CalmActions actions={[
                  ...(isAdmin ? [{ icon: 'email', label: 'Email', href: `/pipeline/projects/${p.id}/email?from=/pipeline/ongoing` }] : []),
                  { icon: 'progress', label: 'Check progress', href: `/pipeline/projects/${p.id}` },
                ]} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
  <CalmDock />
</PipelineLayout>
