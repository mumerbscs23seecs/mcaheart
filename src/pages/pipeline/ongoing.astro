---
import PipelineLayout from '../../layouts/PipelineLayout.astro';
import PipelineStatusCell from '../../components/PipelineStatusCell.astro';
import { scopeProjects } from '../../lib/pipeline-scope';

export const prerender = false;
const { supabase, person } = Astro.locals;
const isAdmin = person.role === 'admin';

const showParked = Astro.url.searchParams.get('parked') === '1';
const q = (Astro.url.searchParams.get('q') ?? '').trim();

let query = supabase
  .from('project_list')
  .select('id,ref,title,phase,stage,stage_label,lead_name,analyst_name,current_conference,days_in_stage,days_overdue,parked,ms_version,created_at,stage_changed_at,archived_at')
  .eq('phase', 'manuscript')
  .is('archived_at', null)
  .order('stage_changed_at', { ascending: false });
if (!showParked) query = query.eq('parked', false);
if (q) query = query.ilike('title', `%${q}%`);
if (!isAdmin) query = scopeProjects(query, person);

const { data: rows, error } = await query;

const fmt = (d: string | null) =>
  d ? new Date(d).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' }) : '—';
---

<PipelineLayout title="Ongoing" active="ongoing">
  <h1 class="pl-h1">Ongoing</h1>
  <p class="pl-sub">
    {isAdmin
      ? 'Manuscript-phase projects — accepted abstracts now being written up.'
      : 'Your papers being written up after an accepted abstract.'}
  </p>

  <form class="pl-filter" method="get">
    <input type="search" name="q" placeholder="Filter by title" value={q} />
    <label class="pl-small"><input type="checkbox" name="parked" value="1" checked={showParked} onchange="this.form.submit()" /> show parked</label>
    <button class="pl-btn pl-btn--ghost" type="submit">Filter</button>
  </form>

  {error && <p class="pl-flash pl-flash--err">{error.message}</p>}
  {rows && rows.length === 0 && <p class="pl-muted" style="margin-top:20px">Nothing here.</p>}

  {rows && rows.length > 0 && (
    <div class="pl-tablewrap">
      <table class="pl-table">
        <thead>
          <tr>
            <th>Submission title</th>
            <th>Conference</th>
            <th>Started</th>
            <th>Last updated</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((p) => (
            <tr>
              <td class="pl-t__title" data-th="Submission title">
                <a href={`/pipeline/projects/${p.id}`} data-panel={p.id}>{p.title}</a>
                <span class="pl-t__ref">
                  {p.ref} · {p.ms_version ?? 'v1.0'}
                  {p.analyst_name ? ` · analyst ${p.analyst_name}` : ''}
                  {p.parked ? ' · parked' : ''}
                </span>
              </td>
              <td class="pl-t__venue" data-th="Conference">{p.current_conference ?? '—'}</td>
              <td class="pl-t__date" data-th="Started">{fmt(p.created_at)}</td>
              <td class="pl-t__date" data-th="Last updated">{fmt(p.stage_changed_at)}</td>
              <td data-th="Status"><PipelineStatusCell project={p} isAdmin={isAdmin} /></td>
              <td class="pl-t__actions" data-th="Actions">
                <a href={`/pipeline/projects/${p.id}`}>Check progress &nearr;</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <p class="pl-count">{(rows ?? []).length} projects</p>
</PipelineLayout>
