---
/**
 * Members' Requests page: one place to ask the lab for something.
 *
 *   New idea                  -> the existing idea form (/pipeline/ideas)
 *   Letter of recommendation  -> saved to the admin Requests inbox + emailed
 *   Join a new topic          -> saved to the admin Requests inbox + emailed
 *
 * The two requests reuse the contact-request store (contact_requests, payload
 * jsonb) with source 'member', so they appear in Admin -> Requests next to
 * the website enquiries, with the same unread badge.
 */
import PipelineLayout from '../../layouts/PipelineLayout.astro';
import { addRequest, listRequests, type RequestRecord } from '../../lib/requests';
import { deliverEnquiry } from '../../lib/mailer';
import { memberRequestSchema, INTENT_LABELS, type ContactPayload } from '../../lib/contact-schema';

export const prerender = false;
const { person } = Astro.locals;

type Kind = 'lor' | 'topic';
const KIND_INTENT = { lor: 'recommendation', topic: 'topic' } as const;
const kindParam = Astro.url.searchParams.get('type');
let kind: Kind | null = kindParam === 'lor' || kindParam === 'topic' ? kindParam : null;

let errors: Record<string, string> = {};
let values: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = Object.fromEntries([...form.entries()].map(([k, v]) => [k, String(v)]));
  kind = values.intent === 'topic' ? 'topic' : 'lor';
  const parsed = memberRequestSchema.safeParse(values);
  if (!parsed.success) {
    for (const issue of parsed.error.issues) errors[String(issue.path[0])] ??= issue.message;
  } else {
    const payload = {
      ...parsed.data,
      fullName: person.full_name,
      email: person.email,
      source: 'member',
    } as ContactPayload;
    try {
      await addRequest(payload, null);
      // Saved either way; don't hold the page on SMTP.
      deliverEnquiry(payload).catch((err) => console.error('[member request] email failed (record kept):', err));
      return Astro.redirect(`/pipeline/requests?ok=${encodeURIComponent('Request sent. The coordinator will get back to you by email.')}`, 303);
    } catch (err) {
      errors._form = 'Could not send the request. Please try again shortly.';
      console.error('[member request] could not save:', err);
    }
  }
}

// Their own earlier requests (LOR / topic), newest first.
let mine: RequestRecord[] = [];
try {
  mine = (await listRequests()).filter(
    (r) => r.source === 'member' && r.email.toLowerCase() === person.email.toLowerCase(),
  );
} catch {
  mine = [];
}

const fmt = (t: number) => {
  const d = new Date(t);
  return `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}-${d.getFullYear()}`;
};
const summary = (r: RequestRecord) =>
  r.intent === 'recommendation' ? `${r.recPurpose ?? ''}${r.recDeadline ? ` · due ${r.recDeadline}` : ''}` : (r.topicArea ?? '');

const ROLES = ['Literature search and data extraction', 'Statistical analysis', 'Writing the manuscript', 'Wherever I am needed'];
const v = (k: string) => values[k] ?? '';
---

<PipelineLayout title="Requests" active="requests">
  <h1 class="pl-h1">{kind ? INTENT_LABELS[KIND_INTENT[kind]] : 'Requests'}</h1>
  <p class="pl-sub">{kind ? 'Sent to the coordinator, who replies by email.' : 'Ask the lab for something.'}</p>

  {!kind && (
    <p class="rq-pickhint">
      <a href="/pipeline/ideas">New idea</a> · <a href="/pipeline/requests?type=lor">Letter of recommendation</a> · <a href="/pipeline/requests?type=topic">Join a new topic</a>
    </p>
  )}

  {kind && (
    <form method="post" class="rq-form" id="form" novalidate>
      <input type="hidden" name="intent" value={KIND_INTENT[kind]} />
      <p class="rq-from">From {person.full_name} &lt;{person.email}&gt;</p>
      {errors._form && <p class="rq-err" role="alert">{errors._form}</p>}

      {kind === 'lor' ? (
        <>
          <label class="pl-field">
            <span>What is the letter for?</span>
            <input name="recPurpose" maxlength="300" required value={v('recPurpose')} placeholder="e.g. Internal medicine residency application (ERAS)" />
            {errors.recPurpose && <em class="rq-ferr">{errors.recPurpose}</em>}
          </label>
          <label class="pl-field rq-short">
            <span>Deadline</span>
            <input type="date" name="recDeadline" required value={v('recDeadline')} />
            {errors.recDeadline && <em class="rq-ferr">{errors.recDeadline}</em>}
          </label>
          <label class="pl-field">
            <span>Your work with the lab</span>
            <textarea name="recWork" rows="5" maxlength="4000" required placeholder="Papers, abstracts and projects you worked on, and your part in each.">{v('recWork')}</textarea>
            {errors.recWork && <em class="rq-ferr">{errors.recWork}</em>}
          </label>
        </>
      ) : (
        <>
          <label class="pl-field">
            <span>Area or kind of topic</span>
            <input name="topicArea" maxlength="300" required value={v('topicArea')} placeholder="e.g. Structural heart, TAVR outcomes, a database study" />
            {errors.topicArea && <em class="rq-ferr">{errors.topicArea}</em>}
          </label>
          <label class="pl-field rq-short">
            <span>How you would like to help</span>
            <select name="topicRole" required>
              <option value="" selected={!v('topicRole')} disabled>Choose one</option>
              {ROLES.map((r) => <option selected={v('topicRole') === r}>{r}</option>)}
            </select>
            {errors.topicRole && <em class="rq-ferr">{errors.topicRole}</em>}
          </label>
          <label class="pl-field rq-short">
            <span>Hours per week (optional)</span>
            <input name="topicHours" maxlength="40" value={v('topicHours')} placeholder="e.g. 6" />
          </label>
          <label class="pl-field">
            <span>Anything else (optional)</span>
            <textarea name="topicNote" rows="4" maxlength="4000">{v('topicNote')}</textarea>
          </label>
        </>
      )}
      <button type="submit" class="pl-btn">Send request</button>
    </form>
  )}

  {mine.length > 0 && (
    <>
      <h2 class="pl-sech rq-mine">Your requests <span class="pl-h1__count">({mine.length})</span></h2>
      <div class="pl-tablewrap">
        <table class="pl-table">
          <thead><tr><th>Request</th><th>Details</th><th>Sent</th></tr></thead>
          <tbody>
            {mine.map((r) => (
              <tr>
                <td data-th="Request">{INTENT_LABELS[r.intent]}</td>
                <td data-th="Details">{summary(r) || '-'}</td>
                <td class="pl-t__date" data-th="Sent">{fmt(r.submittedAt)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
</PipelineLayout>

<style>
  .rq-pickhint { margin: 18px 0 0; font-weight: 700; }
  .rq-pickhint a { color: var(--pl-accent); }

  .rq-form { max-width: 640px; margin-top: 24px; }
  .rq-from { margin: -4px 0 18px; font-size: 0.875rem; color: var(--text-muted); }
  .rq-short { max-width: 320px; }
  .rq-form textarea { resize: vertical; }
  .rq-err { margin: 0 0 14px; color: var(--pl-danger); font-weight: 600; }
  .rq-ferr { font-style: normal; font-size: 0.8rem; color: var(--pl-danger); }
  .rq-mine { margin-top: 40px; }

</style>


