---
import PipelineLayout from '../../layouts/PipelineLayout.astro';

export const prerender = false;
const { supabase, person } = Astro.locals;

// Admin-only view. Members see published papers under Submissions.
if (person.role !== 'admin') return Astro.redirect('/pipeline/submissions', 302);

const q = (Astro.url.searchParams.get('q') ?? '').trim();

let query = supabase
  .from('project_list')
  .select('id,ref,title,lead_name,current_journal,journals_tried,created_at,stage_changed_at')
  .eq('phase', 'journal')
  .eq('stage', 'published')
  .is('archived_at', null)
  .order('stage_changed_at', { ascending: false });
if (q) query = query.ilike('title', `%${q}%`);

const { data: rows, error } = await query;

const fmt = (d: string | null) =>
  d ? new Date(d).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' }) : '-';
---

<PipelineLayout title="Published" active="published">
  <h1 class="pl-h1">Published <span class="pl-h1__count">({(rows ?? []).length})</span></h1>
  <p class="pl-sub">
    Papers that have appeared in a journal. Nothing here moves - it is the record of what the group has published.
  </p>

  <form class="pl-filter" method="get">
    <input type="search" name="q" placeholder="Filter by title" value={q} />
    <button class="pl-btn pl-btn--ghost" type="submit">Filter</button>
  </form>

  {error && <p class="pl-flash pl-flash--err">{error.message}</p>}
  {rows && rows.length === 0 && <p class="pl-muted" style="margin-top:20px">Nothing published yet.</p>}

  {rows && rows.length > 0 && (
    <div class="pl-tablewrap">
      <table class="pl-table">
        <thead>
          <tr>
            <th>Submission title</th>
            <th>Journal</th>
            <th>Submitted</th>
            <th>Published</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((p) => (
            <tr>
              <td class="pl-t__title" data-th="Submission title">
                <a href={`/pipeline/projects/${p.id}`} data-panel={p.id}>{p.title}</a>
                <span class="pl-t__ref">
                  {p.ref}{p.journals_tried >= 2 ? ` · ${p.journals_tried} journals tried` : ''}
                </span>
              </td>
              <td class="pl-t__venue" data-th="Journal">{p.current_journal ?? '-'}</td>
              <td class="pl-t__date" data-th="Submitted">{fmt(p.created_at)}</td>
              <td class="pl-t__date" data-th="Published">{fmt(p.stage_changed_at)}</td>
              <td data-th="Status"><span class="pl-status">Published</span></td>
              <td class="pl-t__actions" data-th="Actions">
                <a href={`/pipeline/projects/${p.id}`}>Check progress &nearr;</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

</PipelineLayout>
