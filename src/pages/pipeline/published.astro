---
import PipelineLayout from '../../layouts/PipelineLayout.astro';
import PipelineStatusCell from '../../components/PipelineStatusCell.astro';
import CalmBar from '../../components/calm/CalmBar.astro';
import CalmActions from '../../components/calm/CalmActions.astro';
import CalmStatus from '../../components/calm/CalmStatus.astro';
import CalmDock from '../../components/calm/CalmDock.astro';
import { journalSiteHref } from '../../lib/journal-links';
import { drawerInfo, stageColor, fmtDate } from '../../lib/calm';

export const prerender = false;
const { supabase, person } = Astro.locals;

// Admin-only view. Members see published papers under Submissions.
if (person.role !== 'admin') return Astro.redirect('/pipeline/submissions', 302);

const { data: rows, error } = await supabase
  .from('project_list')
  .select('id,ref,title,full_title,phase,stage,stage_label,lead_name,current_journal,journals_tried,open_journal_attempt_id,days_in_stage,created_at,stage_changed_at,archived_at,analyst_name,study_type,current_conference')
  .eq('phase', 'journal')
  .eq('stage', 'published')
  .is('archived_at', null)
  .is('hidden_at', null)
  .is('deleted_at', null)
  .order('stage_changed_at', { ascending: false });
const list = rows ?? [];

// "Open journal site": same lookup as Submissions (src/lib/journal-links.ts).
const attemptIds = list.map((p: any) => p.open_journal_attempt_id).filter(Boolean);
const { data: attempts } = attemptIds.length
  ? await supabase.from('journal_attempts').select('id,portal_url').in('id', attemptIds)
  : { data: [] };
const portal = new Map((attempts ?? []).map((a: any) => [a.id, a.portal_url]));
const journalHref = (p: any) => journalSiteHref(p.current_journal, portal.get(p.open_journal_attempt_id));
---

<PipelineLayout title="Published" active="published">
  <div class="cv">
    <CalmBar title="Published" count={list.length} />
    {error && <p class="pl-flash pl-flash--err">{error.message}</p>}

    {list.length === 0 ? (
      <p class="pl-muted cv-empty">Nothing published yet.</p>
    ) : (
      <table class="cv-table">
        <thead>
          <tr>
            <th>Submission title</th>
            <th class="cv-classic cv-hide-sm" style="width:185px">Lead</th>
            <th class="cv-classic cv-hide-sm" style="width:190px">Journal</th>
            <th class="cv-stacked cv-hide-sm" style="width:230px">Lead &amp; journal</th>
            <th style="width:270px">Status</th>
            <th class="x" style="width:120px">Actions</th>
          </tr>
        </thead>
        <tbody>
          {list.map((p: any) => {
            const journal = journalHref(p);
            return (
              <tr data-cv-row data-cv-info={drawerInfo(p)} data-cv-f={p.stage} data-cv-text={`${p.full_title ?? ''} ${p.title ?? ''} ${p.ref ?? ''}`}>
                <td class="t">
                  <a href={`/pipeline/projects/${p.id}`} data-panel={p.id}>{p.full_title || p.title}</a>
                  <div class="cv-sub">
                    {p.full_title && p.title ? `${p.title} · ` : ''}Published {fmtDate(p.stage_changed_at)}
                    {p.journals_tried >= 2 ? ` · ${p.journals_tried} journals tried` : ''}
                  </div>
                </td>
                <td class="cv-classic cv-hide-sm">{p.lead_name ?? '-'}</td>
                <td class="cv-classic cv-hide-sm sm">{p.current_journal ?? '-'}</td>
                <td class="cv-stacked cv-hide-sm">
                  <div class="cv-ln">{p.lead_name ?? '-'}</div>
                  <div class="cv-jn">{p.current_journal ?? '-'}</div>
                </td>
                <td>
                  <CalmStatus color={stageColor(p.phase, p.stage)}>
                    <PipelineStatusCell project={p} isAdmin={true} />
                  </CalmStatus>
                </td>
                <td class="x">
                  <CalmActions actions={[
                    ...(journal ? [{ icon: 'journal', label: 'Open journal site', href: journal, external: true }] : []),
                    { icon: 'email', label: 'Email', href: `/pipeline/projects/${p.id}/email?from=/pipeline/published` },
                    { icon: 'progress', label: 'Check progress', href: `/pipeline/projects/${p.id}` },
                  ]} />
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    )}
  </div>
  <CalmDock />
</PipelineLayout>
