---
import PipelineLayout from '../../layouts/PipelineLayout.astro';
import { scopeProjects } from '../../lib/pipeline-scope';

export const prerender = false;
const { supabase, person } = Astro.locals;
const isAdmin = person.role === 'admin';

const q = (Astro.url.searchParams.get('q') ?? '').trim();

let query = supabase
  .from('project_list')
  .select('id,ref,title,stage_label,lead_name,current_journal,journals_tried,revision_round,days_in_stage')
  .eq('phase', 'journal')
  .is('archived_at', null)
  .order('days_in_stage', { ascending: false });
// Admins get a dedicated "Published" tab, so keep those out of here.
// Members see everything (incl. published) under Submissions.
if (isAdmin) query = query.neq('stage', 'published');
if (q) query = query.ilike('title', `%${q}%`);
if (!isAdmin) query = scopeProjects(query, person);

const { data: rows, error } = await query;
---

<PipelineLayout title="Submissions" active="submissions">
  <h1 class="pl-h1">Submissions</h1>
  <p class="pl-sub">
    {isAdmin
      ? 'Journal-phase projects — manuscripts under review at a journal.'
      : 'Your papers currently under review at a journal.'}
  </p>

  <form class="pl-filter" method="get">
    <input type="search" name="q" placeholder="Filter by title" value={q} />
    <button class="pl-btn pl-btn--ghost" type="submit">Filter</button>
  </form>

  {error && <p class="pl-flash pl-flash--err">{error.message}</p>}
  {rows && rows.length === 0 && <p class="pl-muted" style="margin-top:20px">Nothing here.</p>}

  <ul class="pl-list">
    {(rows ?? []).map((p) => (
      <li class:list={['pl-card', p.journals_tried >= 4 && 'pl-card--warn']}>
        <p class="pl-card__title"><a href={`/pipeline/projects/${p.id}`} data-panel={p.id}>{p.title}</a></p>
        <p class="pl-card__meta">
          {p.lead_name ?? '(no lead)'}
          {p.journals_tried >= 4 && <> · <span class="pl-warn">multiple rejections ({p.journals_tried})</span></>}
        </p>
        <p class="pl-card__ref">{p.ref}{p.revision_round ? ` · revision round ${p.revision_round}` : ''}</p>
        <div class="pl-card__status">
          <b>{p.stage_label}</b>
          {p.current_journal && <span class="pl-when"><em>{p.current_journal}</em></span>}
          <span class="pl-when">{p.days_in_stage ?? 0} days in stage</span>
        </div>
        <p class="pl-card__link"><a href={`/pipeline/projects/${p.id}`}>View project details →</a></p>
      </li>
    ))}
  </ul>

  <p class="pl-count">{(rows ?? []).length} projects · submission dates are the import date, not real</p>
</PipelineLayout>
