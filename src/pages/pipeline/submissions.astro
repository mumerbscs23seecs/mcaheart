---
import PipelineLayout from '../../layouts/PipelineLayout.astro';
import PipelineStatusCell from '../../components/PipelineStatusCell.astro';
import CalmBar from '../../components/calm/CalmBar.astro';
import CalmFilters from '../../components/calm/CalmFilters.astro';
import CalmActions from '../../components/calm/CalmActions.astro';
import CalmStatus from '../../components/calm/CalmStatus.astro';
import CalmDock from '../../components/calm/CalmDock.astro';
import { scopeProjects } from '../../lib/pipeline-scope';
import { stagesFor } from '../../lib/lifecycle.mjs';
import { stageColor } from '../../lib/calm';

export const prerender = false;
const { supabase, person } = Astro.locals;
const isAdmin = person.role === 'admin';

let query = supabase
  .from('project_list')
  .select('id,ref,title,full_title,phase,stage,stage_label,lead_name,current_journal,journals_tried,revision_round,open_journal_attempt_id,days_in_stage,created_at,stage_changed_at,archived_at,submission_order')
  .eq('phase', 'journal')
  .is('archived_at', null)
  .is('hidden_at', null)
  .is('deleted_at', null)
  .order('submission_order', { ascending: true, nullsFirst: false })
  .order('stage_changed_at', { ascending: false });
// Admins get a dedicated "Published" tab, so keep those out of here.
// Members see everything (incl. published) under Submissions.
if (isAdmin) query = query.neq('stage', 'published');
if (!isAdmin) query = scopeProjects(query, person);

const { data: rows, error } = await query;
const list = rows ?? [];

// "Open journal site": the attempt's own portal link when one was saved,
// otherwise a web search for the journal's name.
const attemptIds = list.map((p: any) => p.open_journal_attempt_id).filter(Boolean);
const { data: attempts } = attemptIds.length
  ? await supabase.from('journal_attempts').select('id,portal_url').in('id', attemptIds)
  : { data: [] };
const portal = new Map((attempts ?? []).map((a: any) => [a.id, a.portal_url]));
const journalHref = (p: any) =>
  portal.get(p.open_journal_attempt_id) ||
  (p.current_journal ? `https://www.google.com/search?q=${encodeURIComponent(`${p.current_journal} journal`)}` : null);

const chips = stagesFor('journal').map((s: any) => ({
  key: s.code,
  label: s.label,
  count: list.filter((p: any) => p.stage === s.code).length,
}));
---

<PipelineLayout title="Submissions" active="submissions">
  <div class="cv">
    <CalmBar title="Submissions" count={list.length} />
    {error && <p class="pl-flash pl-flash--err">{error.message}</p>}
    <CalmFilters items={chips} total={list.length} />

    {list.length === 0 ? (
      <p class="pl-muted cv-empty">Nothing here.</p>
    ) : (
      <table class="cv-table">
        <thead>
          <tr>
            <th>Submission title</th>
            <th class="cv-classic cv-hide-sm" style="width:185px">Lead</th>
            <th class="cv-classic cv-hide-sm" style="width:190px">Journal</th>
            <th class="cv-stacked cv-hide-sm" style="width:230px">Lead &amp; journal</th>
            <th style="width:270px">Status</th>
            <th class="x" style={`width:${isAdmin ? 120 : 88}px`}>Actions</th>
          </tr>
        </thead>
        <tbody>
          {list.map((p: any) => {
            const journal = journalHref(p);
            return (
              <tr data-cv-row data-cv-f={p.stage} data-cv-text={`${p.full_title ?? ''} ${p.title ?? ''} ${p.ref ?? ''}`}>
                <td class="t">
                  <a href={`/pipeline/projects/${p.id}`} data-panel={p.id}>{p.full_title || p.title}</a>
                  {p.full_title && p.title && <div class="cv-sub">{p.title}</div>}
                </td>
                <td class="cv-classic cv-hide-sm nw">{p.lead_name ?? '-'}</td>
                <td class="cv-classic cv-hide-sm sm">{p.current_journal ?? '-'}</td>
                <td class="cv-stacked cv-hide-sm">
                  <div class="cv-ln">{p.lead_name ?? '-'}</div>
                  <div class="cv-jn">{p.current_journal ?? '-'}</div>
                </td>
                <td>
                  <CalmStatus color={stageColor(p.phase, p.stage)}>
                    <PipelineStatusCell project={p} isAdmin={isAdmin} />
                  </CalmStatus>
                </td>
                <td class="x">
                  <CalmActions actions={[
                    ...(journal ? [{ icon: 'journal', label: 'Open journal site', href: journal, external: true }] : []),
                    ...(isAdmin ? [{ icon: 'email', label: 'Email', href: `/pipeline/projects/${p.id}/email?from=/pipeline/submissions` }] : []),
                    { icon: 'progress', label: 'Check progress', href: `/pipeline/projects/${p.id}` },
                  ]} />
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    )}
  </div>
  <CalmDock />
</PipelineLayout>
