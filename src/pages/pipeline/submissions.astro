---
import PipelineLayout from '../../layouts/PipelineLayout.astro';
import PipelineStatusCell from '../../components/PipelineStatusCell.astro';
import { scopeProjects } from '../../lib/pipeline-scope';

export const prerender = false;
const { supabase, person } = Astro.locals;
const isAdmin = person.role === 'admin';

const q = (Astro.url.searchParams.get('q') ?? '').trim();

let query = supabase
  .from('project_list')
  .select('id,ref,title,phase,stage,stage_label,lead_name,current_journal,journals_tried,revision_round,days_in_stage,created_at,stage_changed_at,archived_at')
  .eq('phase', 'journal')
  .is('archived_at', null)
  .order('stage_changed_at', { ascending: false });
// Admins get a dedicated "Published" tab, so keep those out of here.
// Members see everything (incl. published) under Submissions.
if (isAdmin) query = query.neq('stage', 'published');
if (q) query = query.ilike('title', `%${q}%`);
if (!isAdmin) query = scopeProjects(query, person);

const { data: rows, error } = await query;

// Numeric MM-DD-YYYY - keeps the date column narrow so title/status columns
// have the room, instead of the long "September 2, 2024" form.
const fmt = (d: string | null) => {
  if (!d) return '-';
  const dt = new Date(d);
  return `${String(dt.getMonth() + 1).padStart(2, '0')}-${String(dt.getDate()).padStart(2, '0')}-${dt.getFullYear()}`;
};
---

<PipelineLayout title="Submissions" active="submissions">
  <h1 class="pl-h1">Submissions <span class="pl-h1__count">({(rows ?? []).length})</span></h1>
  <p class="pl-sub">
    {isAdmin
      ? 'Journal-phase projects - manuscripts under review at a journal.'
      : 'Your papers currently under review at a journal.'}
  </p>

  <form class="pl-filter" method="get">
    <input type="search" name="q" placeholder="Filter by title" value={q} />
    <button class="pl-btn pl-btn--ghost" type="submit">Filter</button>
  </form>

  {error && <p class="pl-flash pl-flash--err">{error.message}</p>}
  {rows && rows.length === 0 && <p class="pl-muted" style="margin-top:20px">Nothing here.</p>}

  {rows && rows.length > 0 && (
    <div class="pl-tablewrap">
      <table class="pl-table">
        <thead>
          <tr>
            <th>Submission title</th>
            <th>Journal</th>
            <th>Submitted</th>
            <th>Last updated</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((p) => (
            <tr>
              <td class="pl-t__title" data-th="Submission title">
                <a href={`/pipeline/projects/${p.id}`} data-panel={p.id}>{p.title}</a>
                <span class="pl-t__ref">
                  {p.ref}
                  {p.revision_round ? ` · revision ${p.revision_round}` : ''}
                  {p.journals_tried >= 4 ? ` · ${p.journals_tried} journals tried` : ''}
                </span>
              </td>
              <td class="pl-t__venue" data-th="Journal">{p.current_journal ?? '-'}</td>
              <td class="pl-t__date" data-th="Submitted">{fmt(p.created_at)}</td>
              <td class="pl-t__date" data-th="Last updated">{fmt(p.stage_changed_at)}</td>
              <td data-th="Status"><PipelineStatusCell project={p} isAdmin={isAdmin} /></td>
              <td class="pl-t__actions" data-th="Actions">
                <a href={`/pipeline/projects/${p.id}`}>Check progress &nearr;</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <p class="pl-count">Submission dates are the import date, not real.</p>
</PipelineLayout>
