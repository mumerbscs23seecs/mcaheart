---
// Every project action that changes status lands here first. An Astro page
// (not a bare API route) on purpose - wrapping the preview in <PipelineLayout>
// gives it the real nav bar, notification bell, and dark/light toggle for
// free instead of a hand-rolled orphan page. Nothing is written to the
// database and no email sends until step=confirm ("Send email & apply").
import PipelineLayout from '../../../../layouts/PipelineLayout.astro';
import { renderTransitionEmail, type TransitionTemplate } from '../../../../lib/pipeline-mailer';
import { sendEmail } from '../../../../lib/email';
import { isDocLink, DOC_LINK_HINT } from '../../../../lib/doc-links';
import { stagesFor } from '../../../../lib/lifecycle.mjs';

export const prerender = false;

const { supabase, person } = Astro.locals;
const projectId = Astro.params.id!;
const back = `/pipeline/projects/${projectId}`;

if (Astro.request.method !== 'POST') return Astro.redirect(back);
if (person.role !== 'admin') return Astro.redirect(`${back}?err=${encodeURIComponent('Admins only.')}`);

const REAL = (e: string | null | undefined) => !!e && !e.endsWith('@import.invalid');
async function recipientsFor(ids: (string | null)[]) {
  const clean = [...new Set(ids.filter(Boolean))] as string[];
  if (!clean.length) return [] as string[];
  const { data } = await supabase.from('people').select('email').in('id', clean);
  return (data ?? []).map((r: any) => r.email).filter(REAL);
}

const form = await Astro.request.formData();
const gate = String(form.get('gate') ?? '');
// Status changes apply straight away with no email. Emails about a paper are
// written separately, by choice, from its Email page (projects/[id]/email).
// The one exception: approving or declining a member's request still emails
// that member automatically. The preview screen below only appears if a form
// asks for step=preview.
const step = String(form.get('step') ?? (gate === 'request-decide' ? 'confirm' : 'confirm-no-email'));
const ret = String(form.get('return') ?? '');
const dest = /^\/pipeline\/[\w/-]*(\?[\w=&%-]*)?$/.test(ret) ? ret : back;
const note = String(form.get('note') ?? '').trim() || undefined;
// Optional coordinator "reviewed copy" link, attached alongside a decision.
const reviewUrl = String(form.get('review_url') ?? '').trim();
if (reviewUrl && !isDocLink(reviewUrl)) {
  return Astro.redirect(`${back}?err=${encodeURIComponent(DOC_LINK_HINT)}`);
}

const { data: p0 } = await supabase.from('project_list').select('*').eq('id', projectId).maybeSingle();
if (!p0) return Astro.redirect('/pipeline/conferences');

let rpc: { fn: string; args: Record<string, unknown> } | null = null;
let mail: null | {
  template: TransitionTemplate;
  venue?: string;
  stageLabel?: string;
  stage?: string;
  to: (string | null)[];
} = null;
let actionLabel = 'Update';

if (gate === '1') {
  const conference = String(form.get('conference') ?? '');
  // Resubmitting after a rejection - link the new attempt back to the most
  // recent rejected one so the project's and the conference's own pages can
  // both say "recycled from an earlier attempt" instead of looking like two
  // unrelated submissions.
  const { data: lastRejected } = await supabase
    .from('conference_attempts')
    .select('id')
    .eq('project_id', projectId)
    .eq('outcome', 'rejected')
    .order('decided_on', { ascending: false })
    .limit(1)
    .maybeSingle();
  rpc = {
    fn: 'gate1_send_to_conference',
    args: { p_project: projectId, p_conference: conference, p_recycled_from: lastRejected?.id ?? null },
  };
  mail = { template: 'conference_assigned', venue: conference, to: [p0.lead_id, p0.analyst_id] };
  actionLabel = `Send to ${conference || 'conference'}`;
} else if (gate === '2') {
  const proceed = String(form.get('proceed') ?? 'yes') === 'yes';
  rpc = {
    fn: 'gate2_proceed',
    args: { p_project: projectId, p_proceed: proceed, p_archive_reason: proceed ? null : String(form.get('archive_reason') ?? 'other') },
  };
  mail = {
    template: proceed ? 'proceeding_full_text' : 'not_proceeding_full_text',
    to: [p0.lead_id, p0.analyst_id, p0.colead_id],
  };
  actionLabel = proceed ? 'Proceed to full text' : 'Not proceeding - close out';
} else if (gate === 'journal-outcome') {
  const attempt = String(form.get('attempt') ?? '');
  const outcome = String(form.get('outcome') ?? '');
  const nextJournal = String(form.get('next_journal') ?? '').trim() || null;
  // Which rejected-* stage label to land on - only meaningful when outcome
  // is 'rejected' with no resubmission; the RPC ignores it otherwise.
  const rejectStage = String(form.get('reject_stage') ?? '').trim() || undefined;
  rpc = {
    fn: 'record_journal_outcome',
    args: { p_attempt: attempt, p_outcome: outcome, p_next_journal: nextJournal, p_reject_stage: rejectStage },
  };
  const template: TransitionTemplate =
    outcome === 'accepted' ? 'journal_accepted' : outcome === 'withdrawn' ? 'journal_withdrawn' : 'journal_rejected';
  mail = { template, venue: p0.current_journal ?? undefined, to: [p0.lead_id, p0.analyst_id] };
  actionLabel = `Journal outcome - ${outcome}`;
} else if (gate === '3') {
  const journal = String(form.get('journal') ?? '');
  const murl = String(form.get('manuscript_url') ?? '').trim() || null;
  rpc = { fn: 'gate3_submit_to_journal', args: { p_project: projectId, p_journal: journal, p_url: murl } };
  mail = { template: 'submitted_to_journal', venue: journal, to: [p0.lead_id, p0.analyst_id] };
  actionLabel = `Submit to ${journal || 'journal'}`;
} else if (gate === 'abstract') {
  const outcome = String(form.get('outcome') ?? '');
  const attempt = String(form.get('attempt') ?? '');
  rpc = { fn: 'record_abstract_outcome', args: { p_attempt: attempt, p_outcome: outcome, p_presenter: null } };
  mail = {
    template: outcome === 'accepted' ? 'abstract_accepted' : 'abstract_rejected',
    venue: p0.current_conference ?? undefined,
    to: [p0.lead_id, p0.analyst_id, p0.presenter_id],
  };
  actionLabel = `Abstract outcome - ${outcome}`;
} else if (gate === 'stage') {
  const stage = String(form.get('stage') ?? '');
  const journal = String(form.get('journal') ?? '').trim();
  const stageLabel = stagesFor(p0.phase).find((s: any) => s.code === stage)?.label ?? stage;
  if (p0.phase === 'journal' && stage === 'submitted') {
    // A journal-phase "Submitted - technical check" also records which journal.
    if (!journal) return Astro.redirect(`${back}?err=${encodeURIComponent('Enter the journal name.')}`);
    rpc = { fn: 'set_submitted_journal', args: { p_project: projectId, p_journal: journal } };
    mail = { template: 'stage_update', venue: journal, stageLabel, stage, to: [p0.lead_id, p0.analyst_id] };
  } else {
    rpc = { fn: 'advance_stage', args: { p_project: projectId, p_stage: stage } };
    mail = { template: 'stage_update', stageLabel, stage, to: [p0.lead_id, p0.analyst_id, p0.colead_id] };
  }
  actionLabel = `Set status to ${stageLabel}`;
} else if (gate === 'clear-reassignment') {
  // Administrative housekeeping, not a status change - applies directly, no email/preview.
  const { error } = await supabase.rpc('clear_reassignment_flag', { p_project: projectId });
  const sep = dest.includes('?') ? '&' : '?';
  if (error) return Astro.redirect(`${dest}${sep}err=${encodeURIComponent(error.message)}`);
  return Astro.redirect(`${dest}${sep}ok=${encodeURIComponent('Flag cleared.')}`);
} else if (gate === 'full-title') {
  // Metadata, not a status change - applies directly, no email/preview.
  const { error } = await supabase.rpc('set_full_title', { p_project: projectId, p_full_title: String(form.get('full_title') ?? '') });
  const sep = dest.includes('?') ? '&' : '?';
  if (error) return Astro.redirect(`${dest}${sep}err=${encodeURIComponent(error.message)}`);
  return Astro.redirect(`${dest}${sep}ok=${encodeURIComponent('Full title saved.')}`);
} else if (gate === 'hide' || gate === 'unhide') {
  // Visibility toggle, not a status change - applies directly, no email/preview.
  // Hiding works regardless of phase or archive state (any paper, any stage).
  const hide = gate === 'hide';
  const reason = String(form.get('reason') ?? '').trim() || null;
  const { error } = await supabase.rpc('set_project_hidden', { p_project: projectId, p_hidden: hide, p_reason: reason });
  const sep = dest.includes('?') ? '&' : '?';
  if (error) return Astro.redirect(`${dest}${sep}err=${encodeURIComponent(error.message)}`);
  return Astro.redirect(`${dest}${sep}ok=${encodeURIComponent(hide ? 'Paper hidden.' : 'Paper unhidden.')}`);
} else if (gate === 'delete' || gate === 'restore') {
  // Soft delete, not a status change - applies directly, no email/preview.
  // A deleted paper drops out of every tab like a hidden one, lands on
  // /admin/deleted, and is hard-deleted by the cron sweep 60 days later
  // unless restored first.
  const del = gate === 'delete';
  const reason = String(form.get('reason') ?? '').trim() || null;
  const { error } = await supabase.rpc('set_project_deleted', { p_project: projectId, p_deleted: del, p_reason: reason });
  const sep = dest.includes('?') ? '&' : '?';
  if (error) return Astro.redirect(`${dest}${sep}err=${encodeURIComponent(error.message)}`);
  return Astro.redirect(`${dest}${sep}ok=${encodeURIComponent(del ? 'Paper deleted.' : 'Paper restored.')}`);
} else if (gate === 'request-decide') {
  const requestId = String(form.get('request') ?? '');
  const approve = String(form.get('approve') ?? '') === 'yes';
  rpc = { fn: 'decide_stage_change', args: { p_request: requestId, p_approve: approve, p_note: note ?? null } };
  const { data: reqRow } = await supabase
    .from('stage_change_requests')
    .select('requested_by,from_phase,to_stage')
    .eq('id', requestId)
    .maybeSingle();
  const stageLabel = reqRow ? stagesFor(reqRow.from_phase).find((s: any) => s.code === reqRow.to_stage)?.label ?? reqRow.to_stage : '';
  mail = {
    template: approve ? 'request_approved' : 'request_declined',
    stageLabel,
    to: [reqRow?.requested_by ?? null],
  };
  actionLabel = `${approve ? 'Approve' : 'Decline'} status request`;
} else {
  return Astro.redirect(`${back}?err=unknown+action`);
}

// Recipients default to the people on the paper for this action, but the
// preview lets the admin remove any of them or add other addresses. Once the
// preview form has been submitted, its list (recipients_set=1) wins.
const EMAIL_RE = /^[^\s@<>,;]+@[^\s@<>,;]+\.[^\s@<>,;]+$/;
const to = form.get('recipients_set') === '1'
  ? [...new Set(form.getAll('recipients').map((v) => String(v).trim().toLowerCase()).filter((e) => EMAIL_RE.test(e)))]
  : await recipientsFor(mail.to);
const subjectOverride = String(form.get('email_subject') ?? '').trim();
const rendered = renderTransitionEmail({
  to,
  template: mail.template,
  projectTitle: p0.full_title || p0.title,
  venue: mail.venue ?? (p0.phase === 'journal' ? p0.current_journal : p0.current_conference) ?? undefined,
  stageLabel: mail.stageLabel,
  stage: mail.stage,
  phase: p0.phase,
  actor: person.full_name,
  note,
  link: `${Astro.url.origin}${back}`,
});
const subject = subjectOverride || rendered.subject;

if (step === 'confirm' || step === 'confirm-no-email') {
  const { error } = await supabase.rpc(rpc.fn, rpc.args);
  if (error) {
    const sep = dest.includes('?') ? '&' : '?';
    return Astro.redirect(`${dest}${sep}err=${encodeURIComponent(error.message)}`);
  }

  // Submitting to a journal can carry the full title Submissions should show.
  // Only when one was typed - a blank box never wipes an existing full title.
  const fullTitle = String(form.get('full_title') ?? '').trim();
  if (gate === '3' && fullTitle) {
    await supabase.rpc('set_full_title', { p_project: projectId, p_full_title: fullTitle });
  }

  // A reviewed-copy link travels with the abstract / gate-2 / journal decision.
  if (reviewUrl && ['abstract', '2', 'journal-outcome'].includes(gate)) {
    await supabase.rpc('attach_review_link', { p_project: projectId, p_url: reviewUrl });
  }

  let emailNote = '';
  if (step === 'confirm-no-email') {
    emailNote = ' · no email sent';
  } else if (to.length) {
    const sent = await sendEmail({ to, subject, html: rendered.html }).catch((e) => ({ ok: false, error: String(e) }));
    emailNote = sent.ok ? ` · emailed ${to.length}` : ' · email failed';
  } else {
    emailNote = ' · no recipients with a real email';
  }

  const sep = dest.includes('?') ? '&' : '?';
  return Astro.redirect(`${dest}${sep}ok=${encodeURIComponent('Done' + emailNote)}`);
}

// step !== 'confirm' → show the preview. Carry every original field forward
// as a hidden input so "confirm" (or "refresh preview") rebuilds the exact
// same rpc/mail plan above.
const hidden: Record<string, string> = {};
for (const [k, v] of form.entries()) {
  if (['step', 'email_subject', 'note', 'recipients', 'recipients_set'].includes(k)) continue;
  hidden[k] = String(v);
}

// Suggestions for the recipients box: everyone active with a real email.
const { data: rosterRows } = await supabase.from('people').select('full_name,email').eq('active', true).order('full_name');
const rosterEmails = (rosterRows ?? []).filter((r: any) => REAL(r.email));
---

<PipelineLayout title="Preview email">
  <p class="pl-crumb"><a class="pl-link" href={back}>&larr; Back to project</a></p>
  <h1 class="pl-h1">Preview: {actionLabel}</h1>
  <form method="post" style="margin-top:18px">
    {Object.entries(hidden).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
    <input type="hidden" name="recipients_set" value="1" />

    <section class="pl-actions pl-actions--plain">
      <h2>Recipients</h2>
      <div class="rcpt" data-rcpt>
        <div class="rcpt__chips" data-rcpt-chips>
          {to.map((e) => (
            <span class="rcpt__chip" data-rcpt-chip={e}>
              {e}
              <input type="hidden" name="recipients" value={e} />
              <button type="button" class="rcpt__x" data-rcpt-remove aria-label={`Remove ${e}`}>×</button>
            </span>
          ))}
        </div>
        <input
          class="rcpt__input"
          type="text"
          inputmode="email"
          list="rcpt-roster"
          placeholder="Add an email or pick a name, then press Enter"
          autocomplete="off"
          data-rcpt-input
        />
        <datalist id="rcpt-roster">
          {rosterEmails.map((r: any) => <option value={r.email}>{r.full_name}</option>)}
        </datalist>
        <p class="rcpt__hint" data-rcpt-empty hidden={to.length > 0}>
          No recipients. The change will still apply, but no email will be sent.
        </p>
      </div>
    </section>

    <div class="pl-actions pl-actions--plain">
      <h2>Email</h2>

      <label class="pl-field"><span>Subject</span><input name="email_subject" value={subject} /></label>
      <label class="pl-field"><span>Note (optional - appears in the email)</span><textarea name="note" rows="3">{note ?? ''}</textarea></label>
      <div class="pl-field">
        <span>Preview</span>
        <iframe
          title="Email preview"
          style="width:100%;height:360px;border:1px solid var(--border);background:#fff"
          srcdoc={rendered.html}
        />
      </div>
    </div>

    <div class="pl-mini" style="margin-top:18px">
      <button class="pl-btn pl-btn--ghost" type="submit" name="step" value="preview">Refresh preview</button>
      <button class="pl-btn pl-btn--ghost" type="submit" name="step" value="confirm-no-email">Update (no email)</button>
      <button class="pl-btn" type="submit" name="step" value="confirm">Send email &amp; apply</button>
      <a class="pl-btn pl-btn--ghost" href={back}>Cancel</a>
    </div>
  </form>
</PipelineLayout>

<style is:global>
  /* Global: chips added in the browser don't get Astro's scoped attribute. */
  .pl-actions--plain { border: 0; padding-left: 0; padding-right: 0; background: transparent; }
  .rcpt { padding: 12px 0 4px; }
  .rcpt__chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
  .rcpt__chips:empty { margin-bottom: 0; }
  .rcpt__chip {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 5px 7px 5px 12px;
    font-size: 0.85rem; font-weight: 600; color: var(--text-strong);
    background: var(--bg-tint, #f4f2ee);
    border: 1px solid var(--pl-border, #d8dce6);
    border-radius: 999px;
  }
  .rcpt__x {
    appearance: none; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    width: 16px; height: 16px; padding: 0; line-height: 1;
    border: 1px solid var(--red, #b42318); border-radius: 4px;
    background: var(--red-wash); color: var(--red, #b42318); font-size: 0.85rem;
  }
  .rcpt__x:hover { background: var(--red, #b42318); color: #fff; }
  .rcpt__input {
    width: 100%; max-width: 520px;
    padding: 9px 12px;
    border: 1px solid var(--border-soft); border-radius: 0;
    background: var(--bg, #fff); color: var(--text-strong); font: inherit;
  }
  .rcpt__input.is-bad { border-color: var(--red, #b42318); }
  .rcpt__hint { margin: 8px 0 0; font-size: 0.85rem; color: var(--text-muted); }
  .rcpt__hint[hidden] { display: none; }
</style>

<script is:inline>
  (() => {
    const box = document.querySelector('[data-rcpt]');
    if (!box) return;
    const chips = box.querySelector('[data-rcpt-chips]');
    const input = box.querySelector('[data-rcpt-input]');
    const empty = box.querySelector('[data-rcpt-empty]');
    const RE = /^[^\s@<>,;]+@[^\s@<>,;]+\.[^\s@<>,;]+$/;
    const roster = new Set([...document.querySelectorAll('#rcpt-roster option')].map((o) => o.value.toLowerCase()));
    const sync = () => { empty.hidden = chips.children.length > 0; };
    const has = (e) => [...chips.querySelectorAll('[data-rcpt-chip]')].some((c) => c.dataset.rcptChip === e);

    const add = (raw) => {
      const parts = String(raw).split(/[\s,;]+/).map((x) => x.trim().toLowerCase()).filter(Boolean);
      let bad = false;
      for (const e of parts) {
        if (!RE.test(e)) { bad = true; continue; }
        if (has(e)) continue;
        const chip = document.createElement('span');
        chip.className = 'rcpt__chip';
        chip.dataset.rcptChip = e;
        chip.append(e);
        const h = document.createElement('input');
        h.type = 'hidden'; h.name = 'recipients'; h.value = e;
        const x = document.createElement('button');
        x.type = 'button'; x.className = 'rcpt__x'; x.dataset.rcptRemove = '';
        x.setAttribute('aria-label', 'Remove ' + e); x.textContent = '×';
        chip.append(h, x);
        chips.appendChild(chip);
      }
      input.classList.toggle('is-bad', bad);
      if (!bad) input.value = '';
      sync();
    };

    input.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter' || ev.key === ',' || ev.key === ';') {
        ev.preventDefault();
        if (input.value.trim()) add(input.value);
      }
    });
    // Picking a name from the suggestion list fills in a whole roster address - add it straight away.
    input.addEventListener('input', () => {
      input.classList.remove('is-bad');
      if (roster.has(input.value.trim().toLowerCase())) add(input.value);
    });
    // Anything typed but not yet added still counts when the form is submitted.
    input.form.addEventListener('submit', () => { if (input.value.trim()) add(input.value); });
    chips.addEventListener('click', (ev) => {
      const x = ev.target.closest('[data-rcpt-remove]');
      if (!x) return;
      x.closest('[data-rcpt-chip]').remove();
      sync();
    });
  })();
</script>
