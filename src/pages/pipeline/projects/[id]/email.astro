---
// Compose an email about one paper, from the coordinator's template library.
// Status changes no longer send anything on their own - this is where emails
// about a paper get written and sent, by choice.
import PipelineLayout from '../../../../layouts/PipelineLayout.astro';
import EmailChips from '../../../../components/EmailChips.astro';
import { EMAIL_TEMPLATES } from '../../../../lib/email-templates';
import { renderComposedEmail, stageUpdateText } from '../../../../lib/pipeline-mailer';
import { sendEmail } from '../../../../lib/email';
import { supabaseAdmin } from '../../../../lib/supabase';

export const prerender = false;

const { supabase, person } = Astro.locals;
const id = Astro.params.id!;
const paperHref = `/pipeline/projects/${id}`;
const ret = String(Astro.url.searchParams.get('from') ?? '');
const back = /^\/pipeline\/[\w/-]*$/.test(ret) ? ret : paperHref;

if (person.role !== 'admin') return Astro.redirect(`${paperHref}?err=${encodeURIComponent('Admins only.')}`);

const { data: p } = await supabase.from('project_list').select('*').eq('id', id).maybeSingle();
if (!p) return Astro.redirect('/pipeline/submissions');

const REAL = (e: string | null | undefined) => !!e && !e.endsWith('@import.invalid');
const EMAIL_RE = /^[^\s@<>,;]+@[^\s@<>,;]+\.[^\s@<>,;]+$/;
const RECOMMENDED = [
  { email: 'jawad.basit@mcaheart.com', label: 'Jawad Basit' },
  { email: 'muhammad.burhan@mcaheart.com', label: 'Muhammad Burhan' },
];

let flashErr = '';
let posted: null | { to: string[]; cc: string[]; bcc: string[]; subject: string; body: string; template: string } = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const list = (k: string) =>
    [...new Set(form.getAll(k).map((v) => String(v).trim().toLowerCase()).filter((e) => EMAIL_RE.test(e)))];
  const to = list('to');
  const cc = list('cc').filter((e) => !to.includes(e));
  const bcc = list('bcc').filter((e) => !to.includes(e) && !cc.includes(e));
  const subject = String(form.get('subject') ?? '').trim();
  const body = String(form.get('body') ?? '').trim();
  const templateTitle = String(form.get('template') ?? '').trim() || 'Custom email';
  posted = { to, cc, bcc, subject, body, template: templateTitle };

  if (!to.length) flashErr = 'Add at least one recipient in To.';
  else if (!subject || !body) flashErr = 'The subject and the email body both need text.';
  else {
    const sent = await sendEmail({ to, cc, bcc, subject, html: renderComposedEmail(body) })
      .catch((e) => ({ ok: false, error: String(e) }));
    if (!sent.ok) flashErr = `The email could not be sent. ${sent.error ?? ''}`.trim();
    // No mailbox configured: sendEmail only logs, so don't claim it went out.
    else if ('id' in sent && sent.id === 'logged-only') flashErr = 'Email sending is not set up on this server yet, so nothing was sent.';
    else {
      // Shows up in the paper's History as "Email sent: <template>".
      await supabaseAdmin()
        .from('events')
        .insert({ project_id: id, actor_id: person.id, kind: 'email', detail: { template: templateTitle, subject, to, cc, bcc } })
        .then(() => {}, () => {});
      const n = to.length + cc.length + bcc.length;
      const sep = back.includes('?') ? '&' : '?';
      return Astro.redirect(`${back}${sep}ok=${encodeURIComponent(`Email sent to ${n} ${n === 1 ? 'person' : 'people'}.`)}`);
    }
  }
}

// The people on this paper are the default To list.
const teamIds: string[] = p.team_member_ids ?? [];
const onPaper = [p.lead_id, p.colead_id, p.analyst_id, p.presenter_id, p.corresponding_id, ...teamIds].filter(Boolean);
const { data: paperPeople } = onPaper.length
  ? await supabase.from('people').select('id,full_name,email').in('id', onPaper)
  : { data: [] };
const byId = new Map((paperPeople ?? []).map((r: any) => [r.id, r]));
const defaultTo = [...new Set(onPaper.map((pid) => byId.get(pid)?.email).filter(REAL).map((e: string) => e.toLowerCase()))];

const { data: rosterRows } = await supabase.from('people').select('full_name,email').eq('active', true).order('full_name');
const roster = (rosterRows ?? []).filter((r: any) => REAL(r.email));

const title = p.full_title || p.title;
const venue = p.phase === 'journal' ? p.current_journal : p.current_conference;
const fmtDate = (d: string | null) =>
  d ? new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';

const values = {
  recipient: byId.get(p.lead_id)?.full_name ?? '',
  sender: person.full_name,
  paper: title,
  journal: venue ?? '',
  deadline: fmtDate(p.next_target),
  manuscriptId: '',
  link: p.manuscript_url ?? '',
  notes: '',
};

const status = stageUpdateText({
  phase: p.phase,
  stage: p.stage,
  stageLabel: p.stage_label,
  projectTitle: '{{paper}}',
  venue: venue ? '{{journal}}' : null,
  sender: '{{sender}}',
});
const templates = [
  {
    category: 'Status update',
    title: `Current status: ${p.stage_label}`,
    description: "Formal wording for this paper's current status.",
    subject: status.subject,
    body: status.body,
  },
  ...EMAIL_TEMPLATES,
];
---

<PipelineLayout title={`Email · ${p.title}`} active={p.phase === 'journal' ? 'submissions' : p.phase === 'manuscript' ? 'ongoing' : 'conferences'}>
  <div class="em">
    <p class="pl-crumb"><a class="pl-link" href={back}>&larr; Back</a></p>
    <h1 class="em__title">{title}</h1>
    {p.full_title && <p class="em__short">{p.title}</p>}

    {flashErr && <p class="pl-flash pl-flash--err">{flashErr}</p>}

    <div class="em__grid">
      <aside class="em__side">
        <h2 class="em__h">Choose a template</h2>
        <label class="em__field"><span>Category</span><select data-em-cat></select></label>
        <label class="em__field"><span>Template</span><select data-em-tpl></select></label>

        <h2 class="em__h em__h--gap">Details</h2>
        <label class="em__field"><span>Recipient name</span><input data-em-val="recipient" value={values.recipient} placeholder="e.g. Dr. Ahmed" /></label>
        <label class="em__field"><span>Your name</span><input data-em-val="sender" value={values.sender} /></label>
        <label class="em__field"><span>Paper title</span><input data-em-val="paper" value={values.paper} /></label>
        <label class="em__field"><span>Journal / conference</span><input data-em-val="journal" value={values.journal} /></label>
        <div class="em__two">
          <label class="em__field"><span>Deadline / date</span><input data-em-val="deadline" value={values.deadline} placeholder="e.g. 15 October 2026" /></label>
          <label class="em__field"><span>Manuscript ID</span><input data-em-val="manuscriptId" placeholder="e.g. JEM-12345" /></label>
        </div>
        <label class="em__field"><span>Document / submission link</span><input data-em-val="link" value={values.link} /></label>
        <label class="em__field"><span>Additional context</span><textarea data-em-val="notes" rows="3" placeholder="A specific request or brief context"></textarea></label>
      </aside>

      <form method="post" class="em__main" data-em-form>
        <input type="hidden" name="template" data-em-template-name />
        <p class="em__tag" data-em-tag></p>
        <h2 class="em__draft" data-em-draft-title></h2>

        <EmailChips name="to" label="To" initial={posted?.to ?? defaultTo} listId="em-roster" />
        <EmailChips name="cc" label="CC" initial={posted?.cc ?? RECOMMENDED.map((r) => r.email)} listId="em-roster" recommended={RECOMMENDED} />
        <EmailChips name="bcc" label="BCC" initial={posted?.bcc ?? []} listId="em-roster" recommended={RECOMMENDED} />
        <datalist id="em-roster">
          {roster.map((r: any) => <option value={r.email}>{r.full_name}</option>)}
        </datalist>

        <label class="em__field"><span>Subject</span><input name="subject" class="em__subject" data-em-subject required /></label>
        <label class="em__field"><span>Email body</span><textarea name="body" class="em__body" data-em-body spellcheck="true" required></textarea></label>

        <div class="em__actions">
          <button type="submit" class="pl-btn">Send email</button>
          <button type="button" class="pl-btn pl-btn--ghost" data-em-reset>Reset to template</button>
          <button type="button" class="pl-btn pl-btn--ghost" data-em-copy>Copy</button>
          <a class="pl-btn pl-btn--ghost" href={back}>Cancel</a>
        </div>
        <p class="em__desc" data-em-status aria-live="polite"></p>
      </form>
    </div>
  </div>

  <script type="application/json" id="em-data" set:html={JSON.stringify({ templates, values, posted }).replace(/</g, '\\u003c')} />
</PipelineLayout>

<style is:global>
  .em .pl-btn, .em .pl-crumb, .em .echips__label { text-transform: none; letter-spacing: 0; }
  .em .pl-btn { font-size: 0.88rem; }
  .em .echips__label { font-size: 0.82rem; font-weight: 600; }
  .em__title { margin: 0; font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem); line-height: 1.2; font-weight: 750; color: var(--text-strong); }
  .em__short { margin: 4px 0 0; color: var(--pl-accent); font-weight: 700; }
  .em__grid { display: grid; grid-template-columns: minmax(260px, 340px) minmax(0, 1fr); gap: 28px; align-items: start; margin-top: 26px; }
  @media (max-width: 860px) { .em__grid { grid-template-columns: 1fr; } }
  .em__side, .em__main { background: var(--surface, #fff); border: 1px solid var(--border-soft); padding: 20px 22px; }
  .em__h { margin: 0 0 12px; font-size: 1rem; font-weight: 750; color: var(--text-strong); }
  .em__h--gap { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--border-soft); }
  .em__field { display: grid; gap: 5px; margin-bottom: 12px; }
  .em__field > span { font-size: 0.82rem; font-weight: 600; color: var(--text-muted); }
  .em__field input, .em__field select, .em__field textarea {
    width: 100%; padding: 9px 11px;
    border: 1px solid var(--border-soft); border-radius: 0;
    background: var(--bg, #fff); color: var(--text-strong); font: inherit; font-size: 0.92rem;
  }
  .em__field input:focus, .em__field select:focus, .em__field textarea:focus { outline: 0; border-color: var(--pl-accent); }
  .em__two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .em__desc { margin: 0 0 12px; font-size: 0.82rem; color: var(--text-muted); }
  .em__tag { display: inline-block; margin: 0 0 6px; padding: 3px 10px; font-size: 0.72rem; font-weight: 700; color: var(--pl-accent); background: var(--accent-wash); border-radius: 999px; }
  .em__draft { margin: 0 0 18px; font-size: 1.15rem; font-weight: 750; color: var(--text-strong); }
  .em__subject { font-weight: 600; }
  .em__body { min-height: 380px; resize: vertical; line-height: 1.6; }
  .em__actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .em__actions + .em__desc { margin-top: 12px; }
</style>

<script is:inline>
  (() => {
    const data = JSON.parse(document.getElementById('em-data').textContent);
    const T = data.templates;
    const $ = (s) => document.querySelector(s);
    const cat = $('[data-em-cat]'), tpl = $('[data-em-tpl]');
    const subject = $('[data-em-subject]'), body = $('[data-em-body]');
    const status = $('[data-em-status]');
    let active = T[0];

    const vals = () => {
      const v = {};
      document.querySelectorAll('[data-em-val]').forEach((el) => {
        const k = el.dataset.emVal;
        v[k] = el.value.trim();
      });
      const fallback = { recipient: '[Recipient name]', sender: '[Your name]', paper: '[Paper title]', journal: '[Journal name]', deadline: '[date]', manuscriptId: '[Manuscript ID]', link: '[Document or submission link]' };
      for (const k in fallback) if (!v[k]) v[k] = fallback[k];
      return v;
    };
    const fill = (s, v) => s.replace(/\{\{(\w+)\}\}/g, (_, k) => v[k] ?? '').replace(/\n{3,}/g, '\n\n');
    const load = (t) => {
      active = t;
      const v = vals();
      subject.value = fill(t.subject, v);
      body.value = fill(t.body, v);
      $('[data-em-tag]').textContent = t.category.replace(/^[A-Z]\. /, '');
      $('[data-em-draft-title]').textContent = t.title;
      $('[data-em-template-name]').value = t.title;
    };
    const fillTemplates = () => {
      tpl.innerHTML = '';
      T.forEach((t, i) => {
        if (t.category !== cat.value) return;
        const o = document.createElement('option');
        o.value = i; o.textContent = t.title;
        tpl.appendChild(o);
      });
      load(T[Number(tpl.value)]);
    };

    [...new Set(T.map((t) => t.category))].forEach((c) => {
      const o = document.createElement('option');
      o.value = c; o.textContent = c;
      cat.appendChild(o);
    });
    cat.addEventListener('change', () => { fillTemplates(); edited = false; });
    tpl.addEventListener('change', () => { load(T[Number(tpl.value)]); edited = false; });
    // Details apply to the draft as you type, until the subject or body has
    // been edited by hand - then they're left alone so nothing typed is lost.
    let edited = false;
    [subject, body].forEach((el) => el.addEventListener('input', () => { edited = true; }));
    document.querySelectorAll('[data-em-val]').forEach((el) => el.addEventListener('input', () => {
      if (!edited) { load(active); return; }
      status.textContent = 'You have edited the draft by hand, so the details were not applied to it. Press Reset to template to apply them.';
    }));
    $('[data-em-reset]').addEventListener('click', () => { load(active); edited = false; status.textContent = 'Draft reset from the selected template with the current details.'; });
    $('[data-em-copy]').addEventListener('click', async () => {
      try { await navigator.clipboard.writeText('Subject: ' + subject.value + '\n\n' + body.value); status.textContent = 'Copied to clipboard.'; }
      catch { status.textContent = 'Copying was blocked. Select the text and copy it manually.'; }
    });
    fillTemplates();
    // After a failed send, put back exactly what was written instead of the template.
    if (data.posted) {
      const i = T.findIndex((t) => t.title === data.posted.template);
      if (i >= 0) { cat.value = T[i].category; fillTemplates(); tpl.value = String(i); load(T[i]); }
      subject.value = data.posted.subject;
      body.value = data.posted.body;
      edited = true;
    }
  })();
</script>
