---
import PipelineLayout from '../../../layouts/PipelineLayout.astro';
import PeoplePicker from '../../../components/PeoplePicker.astro';
import TeamPicker from '../../../components/TeamPicker.astro';
import { stagesFor } from '../../../lib/lifecycle.mjs';
import { personOnProject } from '../../../lib/pipeline-scope';
import { docLinkLabel, DOC_LINK_HINT } from '../../../lib/doc-links';

export const prerender = false;
const { supabase, person } = Astro.locals;
const { id } = Astro.params;
const isAdmin = person.role === 'admin';

const { data: p } = await supabase.from('project_list').select('*').eq('id', id).maybeSingle();
if (!p) return Astro.redirect('/pipeline/conferences', 302);
if (!personOnProject(p, person)) return Astro.redirect('/pipeline/conferences', 302);

const { data: allConferences } = await supabase
  .from('conferences')
  .select('name,abstract_deadline')
  .order('abstract_deadline', { ascending: false });

const teamMemberIds: string[] = p.team_member_ids ?? [];
const ids = [p.lead_id, p.analyst_id, p.colead_id, p.presenter_id, p.corresponding_id, ...teamMemberIds].filter(Boolean);
const { data: peopleRows } = ids.length
  ? await supabase.from('people').select('id,full_name,email').in('id', ids)
  : { data: [] };
const who = new Map((peopleRows ?? []).map((r: any) => [r.id, r]));
const teamMembers = teamMemberIds.map((id) => who.get(id)).filter(Boolean) as { id: string; full_name: string }[];

// Full active roster, for the admin-only "Edit people" pickers below -
// setting analyst_id here is also how that person gets member-portal
// access to this paper (scopeProjects() grants visibility off these
// same five columns).
const { data: roster } = isAdmin
  ? await supabase.from('people').select('id,full_name').eq('active', true).order('full_name')
  : { data: [] };

const { data: confAttempts } = await supabase
  .from('conference_attempts')
  .select('id,outcome,submitted_on,decided_on,recycled_from,conference:conferences(name),presenter:people!conference_attempts_presenter_id_fkey(full_name)')
  .eq('project_id', id)
  .order('submitted_on', { ascending: false })
  .order('id', { ascending: false });
const pendingAttempt = (confAttempts ?? []).find((a: any) => a.outcome == null);

const { data: journalAttempts } = await supabase
  .from('journal_attempts')
  .select('id,journal,outcome,submitted_on,revision_round')
  .eq('project_id', id)
  .order('submitted_on', { ascending: false })
  .order('id', { ascending: false });
// journalAttempts is newest-first now, so the first open one is the current attempt.
const openJournalAttempt = (journalAttempts ?? []).find((a: any) => a.outcome == null);

const { data: projectMentees } = await supabase
  .from('project_mentees')
  .select('person_id,rating,rating_note,rated_at,assigned_at,person:people(full_name,email)')
  .eq('project_id', id)
  .order('assigned_at');
const projectComplete = Boolean(p.archived_at) || (p.phase === 'journal' && p.stage === 'published');
const canRateMentees = (person.id === p.lead_id || person.id === p.colead_id || isAdmin) && projectComplete;

const { data: history } = await supabase
  .from('project_history')
  .select('at,label,actor')
  .eq('project_id', id)
  .order('at', { ascending: false })
  .limit(60);

const { data: requests } = await supabase
  .from('stage_change_requests')
  .select('id,requested_by,from_phase,from_stage,to_stage,note,review_url,status,decide_note,decided_at,created_at')
  .eq('project_id', id)
  .order('created_at', { ascending: false })
  .limit(12);
const reqIds = [...new Set((requests ?? []).map((r: any) => r.requested_by))];
const { data: reqPeople } = reqIds.length
  ? await supabase.from('people').select('id,full_name').in('id', reqIds)
  : { data: [] };
const reqName = new Map((reqPeople ?? []).map((r: any) => [r.id, r.full_name]));
const pendingReqs = (requests ?? []).filter((r: any) => r.status === 'pending');
const myPending = pendingReqs.find((r: any) => r.requested_by === person.id);

const STAGE_LABEL = (phase: string, code: string) =>
  stagesFor(phase).find((s: any) => s.code === code)?.label ?? code;
const canRequest = !isAdmin && !p.archived_at && ['conference', 'manuscript'].includes(p.phase);
// Anyone on the project can attach the draft doc link once past the idea stage.
const canLink = !p.archived_at && p.phase !== 'idea';

const fmtDate = (d: string | null) =>
  d ? new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
const overdue = p.days_overdue != null && p.days_overdue > 0;
const stale = p.days_in_stage != null && p.days_in_stage >= 21;
const phaseTab =
  p.phase === 'journal'
    ? isAdmin && p.stage === 'published'
      ? 'published'
      : 'submissions'
    : p.phase === 'manuscript'
      ? 'ongoing'
      : 'conferences';
const activeTab = phaseTab;
const backHref = `/pipeline/${phaseTab}`;
const backLabel = phaseTab[0].toUpperCase() + phaseTab.slice(1);

const lastHistory = (history ?? [])[0];
---

<PipelineLayout title={p.title} active={activeTab}>
  <div class="pl-page">
  <p class="pl-crumb"><a class="pl-link" href={backHref}>← {backLabel}</a></p>

  <div class="pl-split">
  <div class="pl-split__main">
    <section class="pl-submit-card">
      <div class="pl-submit-card__top">
        <p class="pl-submit-kind">{p.study_type} · Research Article</p>

        {isAdmin && (
          <div class="pl-head-actions">
            <a class="pl-icobtn" href={`/pipeline/projects/${id}/email`} title="Email" aria-label="Email"><svg viewBox="0 0 20 20" width="19" height="19" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M3 5.5l7 5.5 7-5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg></a>
            <details class="pl-inline-details pl-inline-details--compact">
              <summary class="pl-icobtn" title={p.hidden_at ? 'Unhide' : 'Hide'} aria-label={p.hidden_at ? 'Unhide' : 'Hide'}>
                {p.hidden_at ? <Fragment set:html={`<svg viewBox="0 0 20 20" width="19" height="19" aria-hidden="true"><path d="M2.5 10s2.8-5 7.5-5 7.5 5 7.5 5-2.8 5-7.5 5-7.5-5-7.5-5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><circle cx="10" cy="10" r="2.3" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>`} /> : <Fragment set:html={`<svg viewBox="0 0 20 20" width="19" height="19" aria-hidden="true"><path d="M2.5 10s2.8-5 7.5-5 7.5 5 7.5 5-2.8 5-7.5 5-7.5-5-7.5-5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><circle cx="10" cy="10" r="2.3" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M3.5 3.5l13 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>`} />}
              </summary>
              <form method="post" action={`/pipeline/projects/${id}/gate`} class="pl-mini">
                <input type="hidden" name="gate" value={p.hidden_at ? 'unhide' : 'hide'} />
                {!p.hidden_at && <input name="reason" placeholder="Reason (optional)" />}
                <button class="pl-btn pl-btn--ghost" type="submit">{p.hidden_at ? 'Unhide' : 'Confirm'}</button>
              </form>
            </details>
            {p.deleted_at ? (
              <form method="post" action={`/pipeline/projects/${id}/gate`} class="pl-mini">
                <input type="hidden" name="gate" value="restore" />
                <button class="pl-icobtn" type="submit" title="Restore" aria-label="Restore"><svg viewBox="0 0 20 20" width="19" height="19" aria-hidden="true"><path d="M4.5 8.5h7a4 4 0 0 1 0 8H8M4.5 8.5 7.5 5.5M4.5 8.5l3 3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
              </form>
            ) : (
              <details class="pl-inline-details pl-inline-details--compact">
                <summary class="pl-icobtn pl-icobtn--danger" title="Delete" aria-label="Delete"><svg viewBox="0 0 20 20" width="19" height="19" aria-hidden="true"><path d="M3.5 5.5h13M8 5.5V4h4v1.5M5 5.5l.8 10.5h8.4L15 5.5M8.5 8.5v5M11.5 8.5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
                <form method="post" action={`/pipeline/projects/${id}/gate`} class="pl-mini">
                  <input type="hidden" name="gate" value="delete" />
                  <input name="reason" placeholder="Reason (optional)" />
                  <button class="pl-btn pl-btn--danger" type="submit">Confirm delete</button>
                </form>
              </details>
            )}
          </div>
        )}
      </div>

      <h1 class="pl-h1">{p.full_title || p.title}</h1>
      {p.full_title && <p class="pl-phead__short">{p.title}</p>}

      <dl class="pl-submit-meta">
        <div class="pl-submit-meta__row">
          <dt>Submission Status</dt>
          <dd>{p.stage_label}{p.days_in_stage != null && <span class="pl-muted"> · {p.days_in_stage}d in stage</span>}</dd>
        </div>
        {lastHistory && (
          <div class="pl-submit-meta__row">
            <dt>Last Modified</dt>
            <dd>{fmtDate(lastHistory.at)}{lastHistory.actor && ` by ${lastHistory.actor}`} <span class="pl-muted">· {lastHistory.label}</span></dd>
          </div>
        )}
        {p.next_target && (
          <div class="pl-submit-meta__row">
            <dt>
              <svg class="pl-icon" viewBox="0 0 20 20" width="13" height="13" aria-hidden="true">
                <circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path d="M10 6v4l3 2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              </svg>
              Due by
            </dt>
            <dd>{fmtDate(p.next_target)}</dd>
          </div>
        )}
      </dl>

      {p.review_url && (
        <a class="pl-btn pl-btn--ghost pl-btn--icon" href={p.review_url} target="_blank" rel="noopener">
          <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
            <rect x="2.5" y="4.5" width="15" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
            <path d="M3 5.5l7 5.5 7-5.5" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
          Review decision letter
        </a>
      )}

      <div class="pl-chips">
        <span>{p.ref}</span>
        <span>{p.study_type}</span>
        {p.current_conference && <span>{p.current_conference}</span>}
        {p.current_journal && <span class="pl-chip-journal">Journal: {p.current_journal}</span>}
        {p.parked && <span>parked</span>}
        {p.archived_at && <span class="pl-warn">archived - {p.archive_reason}</span>}
        {overdue && <span class="pl-warn">overdue {p.days_overdue}d</span>}
        {stale && !overdue && <span class="pl-warn">stale</span>}
        {p.needs_reassignment && <span class="pl-warn">needs reassignment</span>}
        {p.hidden_at && <span class="pl-warn">hidden{p.hidden_reason ? ` - ${p.hidden_reason}` : ''}</span>}
        {p.deleted_at && <span class="pl-warn">deleted{p.deleted_reason ? ` - ${p.deleted_reason}` : ''}</span>}
      </div>
    </section>

  {(projectMentees ?? []).length > 0 && (
    <section class="pl-actions">
      <h2>Mentees</h2>
      <div class="pl-mentees">
        {(projectMentees ?? []).map((pm: any) => (
          <div class="pl-mentee">
            <p class="pl-mentee__name">
              <b>{pm.person?.full_name}</b>
              {pm.rating ? (
                <span class="pl-mentee__rating">rated {pm.rating}/5</span>
              ) : (
                <span class="pl-muted pl-small"> · not yet rated</span>
              )}
            </p>
            {pm.rating && pm.rating_note && <p class="pl-muted pl-small">“{pm.rating_note}”</p>}

            {!pm.rating && canRateMentees && (
              <form method="post" action={`/pipeline/projects/${id}/rate-mentee`} class="pl-mini">
                <input type="hidden" name="personId" value={pm.person_id} />
                <select name="rating" required>
                  <option value="">Rate…</option>
                  {[5, 4, 3, 2, 1].map((n) => <option value={n}>{n} / 5</option>)}
                </select>
                <input name="note" placeholder="Comment (optional)" />
                <button class="pl-btn" type="submit">Submit rating</button>
              </form>
            )}
            {!pm.rating && !canRateMentees && !projectComplete && (
              <p class="pl-muted pl-small">Rating opens once this project is published or archived.</p>
            )}

            {pm.rating && canRateMentees && (
              <details class="pl-mentee__edit">
                <summary>Edit rating</summary>
                <form method="post" action={`/pipeline/projects/${id}/rate-mentee`} class="pl-mini">
                  <input type="hidden" name="personId" value={pm.person_id} />
                  <select name="rating" required>
                    {[5, 4, 3, 2, 1].map((n) => <option value={n} selected={n === pm.rating}>{n} / 5</option>)}
                  </select>
                  <input name="note" placeholder="Comment (optional)" value={pm.rating_note ?? ''} />
                  <button class="pl-btn" type="submit">Update rating</button>
                </form>
              </details>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  {p.needs_reassignment && (
    <div class="pl-flash pl-flash--err">
      <b>Flagged for reassignment.</b> This manuscript sat {p.days_in_stage}+ days with no status change.
      {isAdmin ? (
        <> The lead and coordinators have been emailed. Reassign the lead, or{' '}
          <form method="post" action={`/pipeline/projects/${id}/gate`} style="display:inline">
            <input type="hidden" name="gate" value="clear-reassignment" />
            <button class="pl-link" style="border:0;background:none;cursor:pointer;font:inherit;color:var(--pl-accent)" type="submit">clear the flag</button>
          </form>{' '}if it's back on track.
        </>
      ) : (
        <> Update the stage today and reply to the coordinator's email if you're still on this.</>
      )}
    </div>
  )}

  {isAdmin && !p.archived_at && (
    <section class="pl-actions" id="pl-actions">
      <h2>Actions</h2>

      {pendingReqs.length > 0 && (
        <div class="pl-actrow pl-actrow--req">
          <label class="pl-actlbl">Requests</label>
          <div class="pl-reqlist">
            {pendingReqs.map((r: any) => (
              <div class="pl-reqcard">
                <p class="pl-reqcard__line">
                  <b>{reqName.get(r.requested_by) ?? 'A member'}</b> asks to set status to{' '}
                  <b>{STAGE_LABEL(r.from_phase ?? p.phase, r.to_stage)}</b>
                  {r.note && <span class="pl-muted"> - “{r.note}”</span>}
                  {r.review_url && (
                    <span class="pl-muted"> · <a href={r.review_url} target="_blank" rel="noopener">reviewed copy →</a></span>
                  )}
                </p>
                <form method="post" action={`/pipeline/projects/${id}/gate`} class="pl-mini">
                  <input type="hidden" name="gate" value="request-decide" />
                  <input type="hidden" name="request" value={r.id} />
                  <input name="note" placeholder="Reply to the member (optional)" />
                  <button class="pl-btn" name="approve" value="yes" type="submit">Approve</button>
                  <button class="pl-btn pl-btn--danger" name="approve" value="no" type="submit">Decline</button>
                </form>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Stage - within the current phase */}
      {['idea', 'manuscript', 'journal'].includes(p.phase) && (
        <form method="post" action={`/pipeline/projects/${id}/gate`} class="pl-actrow" data-stage-form>
          <input type="hidden" name="gate" value="stage" />
          <label class="pl-actlbl">Stage</label>
          <select name="stage" data-stage-select>
            {stagesFor(p.phase).map((s: any) => (
              <option value={s.code} selected={s.code === p.stage}>{s.label}</option>
            ))}
          </select>
          {p.phase === 'journal' && (
            <input
              name="journal"
              placeholder="Enter journal name"
              value={p.current_journal ?? ''}
              data-journal-input
              hidden={p.stage !== 'submitted'}
            />
          )}
          <button class="pl-btn" type="submit">Update</button>
        </form>
      )}

      {/* Abstract outcome */}
      {pendingAttempt && (
        <form method="post" action={`/pipeline/projects/${id}/gate`} class="pl-actrow">
          <input type="hidden" name="gate" value="abstract" />
          <input type="hidden" name="attempt" value={pendingAttempt.id} />
          <label class="pl-actlbl">Abstract outcome</label>
          <input name="review_url" placeholder="Reviewed copy link (optional)" title={DOC_LINK_HINT} />
          <button class="pl-btn" name="outcome" value="accepted" type="submit">Accepted</button>
          <button class="pl-btn pl-btn--danger" name="outcome" value="rejected" type="submit">Rejected</button>
        </form>
      )}

      {/* GATE 1 - idea/conference -> a conference */}
      {['idea', 'conference'].includes(p.phase) && (
        <form method="post" action={`/pipeline/projects/${id}/gate`} class="pl-actrow">
          <input type="hidden" name="gate" value="1" />
          <label class="pl-actlbl">Send to conference</label>
          <select name="conference" required>
            <option value="">Choose…</option>
            {(allConferences ?? []).map((c: any) => <option value={c.name}>{c.name}</option>)}
          </select>
          <button class="pl-btn" type="submit">Send</button>
        </form>
      )}

      {/* GATE 2 - conference -> manuscript / archive */}
      {p.phase === 'conference' && (
        <div class="pl-actrow">
          <label class="pl-actlbl">Gate 2</label>
          <form method="post" action={`/pipeline/projects/${id}/gate`} class="pl-mini">
            <input type="hidden" name="gate" value="2" />
            <input type="hidden" name="proceed" value="yes" />
            <input name="review_url" placeholder="Reviewed abstract link (optional)" title={DOC_LINK_HINT} />
            <button class="pl-btn" type="submit">Proceed to full text →</button>
          </form>
          <details class="pl-inline-details">
            <summary>Not proceeding</summary>
            <form method="post" action={`/pipeline/projects/${id}/gate`} class="pl-mini">
              <input type="hidden" name="gate" value="2" />
              <input type="hidden" name="proceed" value="no" />
              <select name="archive_reason">
                <option value="not_novel">Not novel</option>
                <option value="needs_reanalysis">Needs re-analysis</option>
                <option value="lead_unresponsive">Lead unresponsive</option>
                <option value="insufficient_data">Insufficient data</option>
                <option value="superseded">Superseded</option>
                <option value="other">Other</option>
              </select>
              <input name="review_url" placeholder="Reviewed copy link (optional)" title={DOC_LINK_HINT} />
              <button class="pl-btn pl-btn--danger" type="submit">Not proceeding - close out</button>
            </form>
          </details>
        </div>
      )}

      {/* GATE 3 - manuscript -> journal */}
      {p.phase === 'manuscript' && (
        <div class="pl-actrow">
          <label class="pl-actlbl">Gate 3</label>
          {['ms_5_review', 'ms_6_comments'].includes(p.stage) ? (
            <details class="pl-inline-details">
              <summary>Submit to journal →</summary>
              <form method="post" action={`/pipeline/projects/${id}/gate`} class="pl-mini pl-mini--col">
                <input type="hidden" name="gate" value="3" />
                <input name="journal" placeholder="Journal name" required />
                <input name="full_title" placeholder="Full title (optional - shown on Submissions)" value={p.full_title ?? ''} />
                <input name="manuscript_url" placeholder="Manuscript link (if not set below)" />
                <button class="pl-btn" type="submit">Submit</button>
              </form>
            </details>
          ) : (
            <span class="pl-muted pl-small">Reach stage 5 (sent to RG Operations) first.</span>
          )}
        </div>
      )}

      {/* Journal outcome - submissions phase */}
      {p.phase === 'journal' && openJournalAttempt && (
        <div class="pl-actrow">
          <label class="pl-actlbl">Journal outcome</label>
          <form method="post" action={`/pipeline/projects/${id}/gate`} class="pl-mini pl-mini--col">
            <input type="hidden" name="gate" value="journal-outcome" />
            <input type="hidden" name="attempt" value={openJournalAttempt.id} />
            <span class="pl-muted pl-small">Deciding: <b>{openJournalAttempt.journal}</b></span>
            <input name="review_url" placeholder="Reviewer report / decision letter link (optional)" title={DOC_LINK_HINT} />
            <input name="next_journal" placeholder="Next journal (only if rejected - reopens at Submitted)" />
            <div class="pl-mini">
              <button class="pl-btn" name="outcome" value="accepted" type="submit">Accepted</button>
              <button class="pl-btn pl-btn--danger" name="outcome" value="rejected" type="submit">Rejected</button>
            </div>
          </form>
        </div>
      )}
    </section>
  )}
  {!isAdmin && !p.archived_at && (
    <section class="pl-actions" id="pl-actions">
      <h2>Your status update</h2>

      {p.phase === 'idea' && (
        <p class="pl-actrow pl-muted pl-small">Status updates open once this idea is sent to a conference.</p>
      )}
      {p.phase === 'journal' && (
        <p class="pl-actrow pl-muted pl-small">
          This paper is with a journal - the coordinator manages its status. Every change shows in the history below.
        </p>
      )}

      {canRequest && (
        <>
          {myPending && (
            <p class="pl-actrow pl-reqcard pl-reqcard--wait">
              Requested: <b>{STAGE_LABEL(p.phase, myPending.to_stage)}</b> - waiting for the coordinator to approve.
              {myPending.note && <span class="pl-muted"> “{myPending.note}”</span>}
            </p>
          )}
          <form method="post" action={`/pipeline/projects/${id}/request`} class="pl-actrow">
            <label class="pl-actlbl">New status</label>
            <select name="stage" required>
              <option value="">Choose…</option>
              {stagesFor(p.phase)
                .filter((s: any) => s.code !== p.stage)
                .filter((s: any) => !(p.phase === 'conference' && ['accepted', 'rejected'].includes(s.code) && !pendingAttempt))
                .map((s: any) => <option value={s.code}>{s.label}</option>)}
            </select>
            <input name="note" placeholder="What changed? (optional)" />
            {p.phase === 'conference' && pendingAttempt && (
              <input name="review_url" placeholder="Reviewed copy link (optional)" title={DOC_LINK_HINT} />
            )}
            <button class="pl-btn" type="submit">{myPending ? 'Replace request' : 'Send for approval'}</button>
          </form>
          <p class="pl-actrow pl-muted pl-small" style="border:0;padding-top:0">
            The coordinator approves updates, so the record only ever shows progress that actually happened.
            {p.phase === 'conference' && pendingAttempt && ' Proposing Accepted / Rejected? Attach the conference decision as the reviewed-copy link.'}
          </p>
        </>
      )}
    </section>
  )}
  {!isAdmin && p.archived_at && (
    <p class="pl-muted pl-small" style="margin:14px 0">This project is archived - no further status changes.</p>
  )}

  <section class="pl-actions pl-actions--plain">
    <h2>Manuscript link</h2>
    {canLink && (
      <form method="post" action={`/pipeline/projects/${id}/link`} class="pl-actrow">
        <label class="pl-actlbl">Draft document</label>
        <input
          name="link"
          type="url"
          placeholder="https://docs.google.com/… or OneDrive / SharePoint"
          value={p.manuscript_url ?? ''}
          title={DOC_LINK_HINT}
          style="flex:1;min-width:260px"
        />
        <button class="pl-btn" type="submit">Save</button>
      </form>
    )}
    <div class="pl-linktiles">
      {[
        { label: 'Manuscript draft', url: p.manuscript_url, empty: 'Not set' },
        { label: 'Reviewed copy', url: p.review_url, empty: 'Not submitted yet' },
      ].map((t) =>
        t.url ? (
          <a class="pl-linktile" href={t.url} target="_blank" rel="noopener">
            <span class="pl-linktile__label">{t.label}</span>
            <span class="pl-linktile__value">{docLinkLabel(t.url)} →</span>
          </a>
        ) : (
          <span class="pl-linktile is-disabled" aria-disabled="true">
            <span class="pl-linktile__label">{t.label}</span>
            <span class="pl-linktile__value">{t.empty}</span>
          </span>
        ),
      )}
      <span class:list={['pl-linktile', 'is-static', !p.legacy_source && 'is-disabled']}>
        <span class="pl-linktile__label">Legacy source</span>
        <span class="pl-linktile__value">{p.legacy_source || 'None'}</span>
      </span>
    </div>
  </section>

    <div>
      <h2 class="pl-sech">History</h2>
      {(!history || history.length === 0) && (
        <p class="pl-muted pl-small">No recorded events yet - they accumulate as the project moves.</p>
      )}
      <ul class="pl-history">
        {(history ?? []).map((h: any) => (
          <li>
            <span>{h.label}{h.actor && <span class="pl-muted"> · {h.actor}</span>}</span>
            <time>{fmtDate(h.at)}</time>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="pl-split__side">
    <aside class="pl-rail">
      <h3>People</h3>
      <dl class="pl-rail__inline">
        <dt>Lead</dt><dd>{who.get(p.lead_id)?.full_name ?? '-'}</dd>
        {p.colead_id && <><dt>Co-lead</dt><dd>{who.get(p.colead_id)?.full_name}</dd></>}
        <dt>Analyst</dt><dd>{who.get(p.analyst_id)?.full_name ?? '-'}</dd>
        {p.presenter_id && <><dt>Presenter</dt><dd>{who.get(p.presenter_id)?.full_name}</dd></>}
        <dt>Corresponding author</dt><dd>{who.get(p.corresponding_id)?.full_name ?? <span class="pl-muted">not set</span>}</dd>
        {teamMembers.length > 0 && (
          <>
            <dt>Team members</dt>
            <dd>{teamMembers.map((m) => m.full_name).join(', ')}</dd>
          </>
        )}
      </dl>

      {isAdmin && (
        <details class="pl-inline-details" style="margin-top:10px">
          <summary>Edit people</summary>
          <form method="post" action={`/pipeline/projects/${id}/assign`} class="pl-mini pl-mini--col" style="margin-top:10px">
            <PeoplePicker name="lead_id" label="Lead" roster={roster ?? []} selectedId={p.lead_id} selectedName={who.get(p.lead_id)?.full_name} />
            <PeoplePicker name="colead_id" label="Co-lead" roster={roster ?? []} selectedId={p.colead_id} selectedName={who.get(p.colead_id)?.full_name} />
            <PeoplePicker name="analyst_id" label="Analyst" roster={roster ?? []} selectedId={p.analyst_id} selectedName={who.get(p.analyst_id)?.full_name} />
            <PeoplePicker name="presenter_id" label="Presenter" roster={roster ?? []} selectedId={p.presenter_id} selectedName={who.get(p.presenter_id)?.full_name} />
            <PeoplePicker name="corresponding_id" label="Corresponding author" roster={roster ?? []} selectedId={p.corresponding_id} selectedName={who.get(p.corresponding_id)?.full_name} />
            <TeamPicker name="team_member_ids" label="Team members" roster={roster ?? []} selected={teamMembers} />
            <button class="pl-btn" type="submit">Save people</button>
          </form>
        </details>
      )}

      <h3>Dates</h3>
      <dl class="pl-rail__inline">
        <dt>Opened</dt><dd>{fmtDate(p.created_at)}</dd>
        <dt>In current stage</dt><dd>{p.days_in_stage ?? 0} days</dd>
        <dt>Next target</dt><dd>{p.next_target ? fmtDate(p.next_target) : <span class="pl-muted">none</span>}</dd>
      </dl>

      {confAttempts && confAttempts.length > 0 && (
        <>
          <h3>Conference submission history ({confAttempts.length})</h3>
          <dl>
            {confAttempts.map((a: any) => {
              const recycledFromName = a.recycled_from
                ? confAttempts.find((x: any) => x.id === a.recycled_from)?.conference?.name
                : null;
              return (
                <>
                  <dt>{a.conference?.name}</dt>
                  <dd>
                    {a.outcome ?? 'pending'} · Submitted {a.submitted_on ? fmtDate(a.submitted_on) : 'date unknown'}
                    {a.decided_on && ` · Decided ${fmtDate(a.decided_on)}`}
                    {a.presenter?.full_name && ` · Presenter ${a.presenter.full_name}`}
                    {recycledFromName && ` · previously submitted to ${recycledFromName}`}
                  </dd>
                </>
              );
            })}
          </dl>
        </>
      )}

      {journalAttempts && journalAttempts.length > 0 && (
        <>
          <h3>Journal submission history ({journalAttempts.length})</h3>
          <dl>
            {journalAttempts.map((a: any) => (
              <>
                <dt>{a.journal}</dt>
                <dd>
                  {a.outcome ?? 'open'}{a.revision_round ? ` · rev ${a.revision_round}` : ''}
                  {' · '}Submitted {a.submitted_on ? fmtDate(a.submitted_on) : 'date unknown'}
                </dd>
              </>
            ))}
          </dl>
        </>
      )}

    </aside>
  </div>
  </div>
  </div>
</PipelineLayout>

<script is:inline>
  // Journal-name box appears only when the journal-phase stage is "Submitted".
  (() => {
    const form = document.querySelector('[data-stage-form]');
    if (!form) return;
    const sel = form.querySelector('[data-stage-select]');
    const jrn = form.querySelector('[data-journal-input]');
    const sync = () => {
      if (!jrn || !sel) return;
      const show = sel.value === 'submitted';
      jrn.hidden = !show;
      jrn.required = show;
    };
    if (sel) sel.addEventListener('change', sync);
    sync();
  })();
</script>

<style>

  /* Submission-portal layout (Hindawi's "Your Progress" tracker is the
     reference) - one grid for the whole page, not just the header: title
     card/Actions/Manuscript link/History on the left, Your Progress/People
     rail on the right. Sharing a single grid (instead of two separate ones
     stacked on top of each other) is what keeps the rail's left edge lined
     up with the Your Progress card above it. Stacks on narrow screens. */
  .pl-split { display: grid; grid-template-columns: minmax(0, 1fr) 350px; gap: 20px; align-items: start; margin: 18px 0 26px; }
  @media (max-width: 860px) { .pl-split { grid-template-columns: 1fr; } }
  .pl-split__main { min-width: 0; }
  .pl-split__side { display: grid; gap: 20px; }

  /* No border here on purpose - it's just the page's own text now, not a
     boxed-off card. */
  .pl-submit-card { padding: 4px 0 22px; }
  .pl-submit-card__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
  .pl-submit-kind { margin: 0; color: var(--text-muted, #64748b); font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; }
  .pl-submit-card .pl-h1 { margin-top: 10px; }

  .pl-head-actions { display: flex; flex-wrap: wrap; gap: 8px; flex: 0 0 auto; }
  .pl-inline-details--compact { position: relative; }
  .pl-inline-details--compact > summary { list-style: none; }
  .pl-inline-details--compact > summary::-webkit-details-marker { display: none; }
  .pl-inline-details--compact .pl-mini {
    position: absolute;
    z-index: 10;
    top: 100%;
    right: 0;
    margin-top: 6px;
    padding: 10px;
    flex-wrap: nowrap;
    background: var(--surface, #fff);
    border: 1px solid var(--pl-border, #d8dce6);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }
  .pl-btn--sm { padding: 6px 14px; font-size: 0.7rem; }

  .pl-phead__short { margin: 4px 0 0; color: var(--pl-accent); font-size: 1.05rem; font-weight: 700; }

  .pl-submit-meta { margin: 16px 0 0; display: grid; gap: 8px; }
  .pl-submit-meta__row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 10px; font-size: 0.88rem; }
  .pl-submit-meta__row dt { flex: 0 0 150px; display: inline-flex; align-items: center; gap: 5px; color: var(--text-muted, #64748b); font-weight: 700; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .pl-submit-meta__row dd { margin: 0; color: var(--text-strong, #1e293b); }
  .pl-submit-meta__row .pl-icon { color: var(--text-muted); flex-shrink: 0; }

  .pl-btn--icon { display: inline-flex; align-items: center; gap: 7px; margin-top: 14px; }

  .pl-submit-card .pl-chips { margin: 18px 0 0; }

  /* Journal name - the one piece of the chips row worth reading at a
     glance, so it gets real weight/size instead of the uniform small-caps
     treatment the rest of the chips share. */
  .pl-chip-journal {
    font-size: 0.85rem !important;
    font-weight: 800 !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
    color: var(--pl-accent) !important;
    border-color: var(--pl-accent) !important;
  }

  /* Links as borderless tiles; one with nothing set yet is greyed out and
     not clickable. */
  .pl-linktiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; padding: 14px 0 4px; }
  @media (max-width: 640px) { .pl-linktiles { grid-template-columns: 1fr; } }
  .pl-linktile {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    background: color-mix(in srgb, var(--text-strong) 5%, transparent);
    color: var(--text-strong);
    text-decoration: none;
    transition: background 0.15s ease;
  }
  a.pl-linktile:hover { background: color-mix(in srgb, var(--pl-accent) 12%, transparent); }
  .pl-linktile__label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
  .pl-linktile__value { font-size: 0.92rem; font-weight: 700; }
  a.pl-linktile .pl-linktile__value { color: var(--pl-accent); }
  .pl-linktile.is-static .pl-linktile__value { font-weight: 600; }
  .pl-linktile.is-disabled { opacity: 0.5; cursor: not-allowed; }
  .pl-linktile.is-disabled .pl-linktile__value { font-weight: 500; }
  .pl-actions--plain { border: 0; padding-left: 0; padding-right: 0; background: transparent; }
  /* People and Dates read "Lead: Name" on one line, not label over value. */
  .pl-rail .pl-rail__inline dt { float: left; clear: left; margin: 0 6px 0 0; font-size: 0.85rem; line-height: 1.6; color: var(--text-muted); }
  .pl-rail .pl-rail__inline dt::after { content: ':'; }
  .pl-rail .pl-rail__inline dd { margin: 0 0 8px; line-height: 1.6; }
  /* Email / Hide / Delete as bare icons - no box around them. */
  .pl-head-actions { gap: 4px; align-items: center; }
  .pl-head-actions .pl-mini { margin-top: 0; }
  .pl-icobtn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; padding: 0;
    border: 0; background: transparent;
    color: var(--text-muted); cursor: pointer; list-style: none;
  }
  .pl-icobtn::-webkit-details-marker { display: none; }
  .pl-icobtn:hover, details[open] > .pl-icobtn { color: var(--pl-accent); }
  .pl-icobtn--danger:hover, details[open] > .pl-icobtn--danger { color: var(--red, #b42318); }
</style>
