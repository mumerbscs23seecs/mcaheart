---
import AppLayout from '../../layouts/AppLayout.astro';
import '../../styles/admin.css';
import { currentUser } from '../../lib/auth';
import { getPipelineSession } from '../../lib/pipeline-auth';
import { listReviews, average, type MenteeReview } from '../../lib/mentee-reviews';
import { photoVersions, photoUrl } from '../../lib/profile';

export const prerender = false;

const me = currentUser(Astro.cookies);
if (!me) return Astro.redirect('/login', 302);
if (me.role !== 'admin') return Astro.redirect('/pipeline', 302);

const session = await getPipelineSession(Astro.request, Astro.cookies);
const supabase = session?.supabase ?? null;

const EXPERTISE_TAGS = [
  'Data extraction',
  'Data streaming',
  'Manuscript writing',
  'Statistical analysis',
  'Literature review',
  'Conference presentation',
] as const;

const AVATAR_TONES = ['green', 'rose', 'amber', 'wine'] as const;
function initials(name: string): string {
  return name.split(/\s+/).filter(Boolean).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
}
function avatarTone(id: string): (typeof AVATAR_TONES)[number] {
  let sum = 0;
  for (const ch of id) sum += ch.charCodeAt(0);
  return AVATAR_TONES[sum % AVATAR_TONES.length];
}

type Flash = { tone: 'ok' | 'error'; text: string };
let flash: Flash | null = null;

if (supabase && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const personId = String(form.get('personId') ?? '');

  if (action === 'set-expertise') {
    const tags = form.getAll('expertise').map(String);
    const { error } = await supabase.rpc('set_mentee_expertise', { p_person: personId, p_expertise: tags });
    flash = error ? { tone: 'error', text: error.message } : { tone: 'ok', text: 'Expertise tags updated.' };
  }

  if (action === 'set-availability') {
    const available = form.get('available') === '1';
    const { error } = await supabase.rpc('set_mentee_availability', { p_person: personId, p_available: available });
    flash = error
      ? { tone: 'error', text: error.message }
      : { tone: 'ok', text: available ? 'Marked available for assignment.' : 'Marked unavailable.' };
  }

  if (action === 'set-flag') {
    const flag = String(form.get('flag') ?? 'none');
    const reason = String(form.get('reason') ?? '');
    const { error } = await supabase.rpc('set_mentee_flag', { p_person: personId, p_flag: flag, p_reason: reason || null });
    flash = error
      ? { tone: 'error', text: error.message }
      : { tone: 'ok', text: flag === 'none' ? 'Flag cleared.' : `Marked as ${flag.replace('_', ' ')}.` };
  }

  if (action === 'assign') {
    const projectId = String(form.get('projectId') ?? '');
    if (!projectId) {
      flash = { tone: 'error', text: 'Choose a project to assign them to.' };
    } else {
      const { error } = await supabase.rpc('assign_mentee', { p_project: projectId, p_person: personId });
      flash = error ? { tone: 'error', text: error.message } : { tone: 'ok', text: 'Mentee assigned to the project.' };
    }
  }

  if (action === 'unassign') {
    const projectId = String(form.get('projectId') ?? '');
    const { error } = await supabase.rpc('unassign_mentee', { p_project: projectId, p_person: personId });
    flash = error ? { tone: 'error', text: error.message } : { tone: 'ok', text: 'Mentee unassigned.' };
  }

  if (action === 'rate') {
    const projectId = String(form.get('projectId') ?? '');
    const rating = Number(form.get('rating') ?? '');
    const note = String(form.get('note') ?? '').trim() || null;
    if (!rating) {
      flash = { tone: 'error', text: 'Choose a rating first.' };
    } else {
      const { error } = await supabase.rpc('rate_mentee', {
        p_project: projectId,
        p_person: personId,
        p_rating: rating,
        p_note: note,
      });
      flash = error ? { tone: 'error', text: error.message } : { tone: 'ok', text: 'Rating submitted.' };
    }
  }
}

let mentees: any[] = [];
let openProjects: { id: string; ref: string; title: string; phase: string; lead_id: string | null }[] = [];
let assignmentsByPerson = new Map<string, any[]>();
let dbReady = false;
let dbError = '';

if (supabase) {
  try {
    const { data: menteeRows, error: mErr } = await supabase
      .from('people')
      .select('id,full_name,email,expertise,open_to_assignment,flag_status,flag_reason')
      .eq('is_mentee', true)
      .order('full_name');
    if (mErr) throw mErr;
    mentees = menteeRows ?? [];

    const { data: projRows, error: pErr } = await supabase
      .from('projects')
      .select('id,ref,title,phase,lead_id')
      .is('archived_at', null)
      .is('hidden_at', null)
      .is('deleted_at', null)
      .order('ref');
    if (pErr) throw pErr;
    openProjects = projRows ?? [];

    const { data: pmRows, error: pmErr } = await supabase
      .from('project_mentees')
      .select('person_id,project_id,rating,rating_note,project:projects(ref,title,phase,stage,archived_at)');
    if (pmErr) throw pmErr;
    assignmentsByPerson = new Map();
    for (const row of pmRows ?? []) {
      const list = assignmentsByPerson.get(row.person_id) ?? [];
      list.push(row);
      assignmentsByPerson.set(row.person_id, list);
    }
    dbReady = true;
  } catch (err) {
    dbError = err instanceof Error ? err.message : 'Could not load mentees.';
  }
}

// Private reviews (add-mentee-reviews.sql); until that's run, the old
// one-number rating stays in use below.
const { ready: reviewsReady, reviews: allReviews } = dbReady && supabase
  ? await listReviews(supabase, {})
  : { ready: false, reviews: [] as MenteeReview[] };
const reviewsFor = (personId: string, projectId?: string) =>
  allReviews.filter((r) => r.person_id === personId && (!projectId || r.project_id === projectId));

const photos = await photoVersions(mentees.map((m) => m.id));

// Board: the Ongoing tab's projects (manuscript stage), with who's on each.
const boardProjects = openProjects.filter((p) => p.phase === 'manuscript');
const leadIds = [...new Set(boardProjects.map((p) => p.lead_id).filter(Boolean))] as string[];
const { data: leadRows } = supabase && leadIds.length
  ? await supabase.from('people').select('id,full_name').in('id', leadIds)
  : { data: [] };
const leadName = new Map<string, string>((leadRows ?? []).map((r: any) => [r.id, r.full_name]));
const menteeName = new Map<string, string>(mentees.map((m) => [m.id, m.full_name]));
const onProject = new Map<string, string[]>();
for (const [personId, list] of assignmentsByPerson) {
  for (const a of list) onProject.set(a.project_id, [...(onProject.get(a.project_id) ?? []), personId]);
}
const boardMentees = mentees.filter((m) => m.flag_status !== 'blacklisted');
const reviewedPairs = new Set(allReviews.map((r) => `${r.project_id}:${r.person_id}`));
---

<AppLayout title="Mentees" heading="Mentees" user={me} active="mentees">
  <div class="adm">
    {flash && (
      <div class:list={['adm-flash', `adm-flash--${flash.tone}`]} role="status">
        <p>{flash.text}</p>
      </div>
    )}

    {supabase && !dbReady && (
      <div class="adm-flash adm-flash--error">
        <p>
          The mentees table isn't set up yet in Supabase. Run <code>mca-pipeline/add-mentees.sql</code> in the SQL
          editor, then reload this page.
          {dbError && <><br /><span class="adm-hint">({dbError})</span></>}
        </p>
      </div>
    )}

    {!supabase && (
      <div class="adm-flash adm-flash--error">
        <p>Could not reach the pipeline database - the mentees list needs Supabase access.</p>
      </div>
    )}

    {dbReady && (
      <>
        <div class="mnt-head">
          <div>
            <h2 class="mnt-head__title">Mentees</h2>
            <div class="mnt-views" role="tablist" aria-label="View">
              <button type="button" class="mnt-view is-on" role="tab" aria-selected="true" data-mnt-view-btn="list">List</button>
              <button type="button" class="mnt-view" role="tab" aria-selected="false" data-mnt-view-btn="board">Assign by dragging</button>
            </div>
          </div>
          <label class="mnt-search" data-mnt-view="list">
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M9 15.5A6.5 6.5 0 1 0 9 2.5a6.5 6.5 0 0 0 0 13Zm9 2-4.3-4.3" /></svg>
            <input type="search" data-mnt-search placeholder="Search mentees…" aria-label="Search mentees" />
          </label>
        </div>

        {mentees.length === 0 && (
          <p class="mnt-empty">No mentees yet — approve an applicant to add one.</p>
        )}

        <div class="mnt-list" data-mnt-list data-mnt-view="list">
          {mentees.map((m) => {
            const tags: string[] = m.expertise ?? [];
            const assigned = assignmentsByPerson.get(m.id) ?? [];
            const assignedProjectIds = new Set(assigned.map((a: any) => a.project_id));
            const assignable = openProjects.filter((p) => !assignedProjectIds.has(p.id));
            const badgeTone = m.flag_status === 'blacklisted' ? 'blacklisted' : m.flag_status === 'red_flag' ? 'red_flag' : m.open_to_assignment ? 'available' : 'unavailable';
            const badgeLabel = m.flag_status !== 'none' ? m.flag_status.replace('_', ' ') : m.open_to_assignment ? 'Available' : 'Unavailable';
            return (
              <article class="mnt-card" data-mnt-name={m.full_name.toLowerCase()}>
                <details class="mnt-row">
                  <summary class="mnt-row__head">
                    {photos.get(m.id)
                      ? <img class="mnt-avatar mnt-avatar--photo" src={photoUrl(m.id, photos.get(m.id)!)} alt="" width="46" height="46" />
                      : <span class="mnt-avatar" data-tone={avatarTone(m.id)}>{initials(m.full_name)}</span>}
                    <span class="mnt-row__id">
                      <span class="mnt-row__name">{m.full_name}</span>
                      <span class="mnt-row__meta">{tags.length ? tags.join(' · ') : 'No expertise tagged'} · {assigned.length} project{assigned.length === 1 ? '' : 's'}</span>
                      <span class="mnt-pill" data-tone={badgeTone}><i /> {badgeLabel}</span>
                    </span>
                    <svg class="mnt-row__chev" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="m5 7.5 5 5 5-5" /></svg>
                  </summary>

                  <div class="mnt-row__body">
                    <div class="mnt-cols">
                      <div>
                        <p class="mnt-label">Email</p>
                        <p class="mnt-value">{m.email}</p>
                        <a class="mnt-progress" href={`/admin/mentees/${m.id}`}>See full progress and reviews &rarr;</a>
                        {m.flag_status !== 'none' && (
                          <p class="mnt-value mnt-value--danger">{m.flag_status.replace('_', ' ')}: {m.flag_reason}</p>
                        )}
                      </div>
                      <div>
                        <p class="mnt-label">Expertise tags</p>
                        <div class="mnt-chips mnt-chips--static">
                          {tags.length ? tags.map((t) => <span class="mnt-chip-pill">{t}</span>) : <span class="mnt-value">None tagged</span>}
                        </div>
                      </div>
                    </div>

                    <div class="mnt-projects-head">
                      <h3>Assigned projects</h3>
                      {assignable.length > 0 && (
                        <details class="mnt-assign">
                          <summary><svg viewBox="0 0 20 20" width="13" height="13" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M10 4v12M4 10h12" /></svg> Assign project</summary>
                          <form method="post" class="mnt-assign__form">
                            <input type="hidden" name="personId" value={m.id} />
                            <select class="mnt-select" name="projectId" aria-label="Choose a project">
                              {assignable.map((p) => <option value={p.id}>{p.ref} - {p.title}</option>)}
                            </select>
                            <button class="mnt-btn mnt-btn--primary" type="submit" name="action" value="assign">Confirm</button>
                          </form>
                        </details>
                      )}
                    </div>

                    <div class="mnt-projects">
                      {assigned.length === 0 && <p class="mnt-empty mnt-empty--inline">Not assigned to any project yet.</p>}
                      {assigned.map((a: any) => {
                        const proj = a.project ?? {};
                        const complete = Boolean(proj.archived_at) || (proj.phase === 'journal' && proj.stage === 'published');
                        const theirs = reviewsFor(m.id, a.project_id);
                        return (
                          <div class="pcard">
                            <span class="pcard__icon">
                              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.5" d="M5 2.5h7l3 3v12h-10z" /><path fill="none" stroke="currentColor" stroke-width="1.5" d="M12 2.5v3h3" /></svg>
                            </span>
                            <div class="pcard__body">
                              <p class="pcard__title"><b>{proj.ref}</b> - {proj.title}</p>
                              {reviewsReady ? (
                                <>
                                  <p class="pcard__note">
                                    {theirs.length
                                      ? `${theirs.length} review${theirs.length === 1 ? '' : 's'} · overall ${average(theirs, 'overall')}/5`
                                      : complete ? 'Project complete - waiting for a review.' : 'No reviews yet.'}
                                  </p>
                                  <a class="mnt-link mnt-link--inline" href={`/pipeline/projects/${a.project_id}#mentees`}>{theirs.length ? 'Add another review' : 'Add a review'}</a>
                                  {theirs.length === 0 && (
                                    <form method="post" class="mnt-unassign">
                                      <input type="hidden" name="personId" value={m.id} />
                                      <input type="hidden" name="projectId" value={a.project_id} />
                                      <button class="mnt-link" type="submit" name="action" value="unassign">Unassign</button>
                                    </form>
                                  )}
                                </>
                              ) : (
                                <>
                                  {a.rating ? (
                                    a.rating_note && <p class="pcard__note">“{a.rating_note}”</p>
                                  ) : (
                                    <p class="pcard__note">{complete ? 'Ready to rate.' : 'Rating opens once this project is published or archived.'}</p>
                                  )}

                                  {!a.rating && complete && (
                                    <form method="post" class="mnt-rate">
                                      <input type="hidden" name="personId" value={m.id} />
                                      <input type="hidden" name="projectId" value={a.project_id} />
                                      <select class="mnt-select" name="rating" required>
                                        <option value="">Rate…</option>
                                        {[5, 4, 3, 2, 1].map((n) => <option value={n}>{n} / 5</option>)}
                                      </select>
                                      <input class="mnt-input mnt-rate__note" type="text" name="note" placeholder="Comment (optional)" />
                                      <button class="mnt-btn mnt-btn--primary" type="submit" name="action" value="rate">Submit rating</button>
                                    </form>
                                  )}
                                  {a.rating && (
                                    <details class="mnt-edit-rating">
                                      <summary>Edit rating</summary>
                                      <form method="post" class="mnt-rate">
                                        <input type="hidden" name="personId" value={m.id} />
                                        <input type="hidden" name="projectId" value={a.project_id} />
                                        <select class="mnt-select" name="rating" required>
                                          {[5, 4, 3, 2, 1].map((n) => <option value={n} selected={n === a.rating}>{n} / 5</option>)}
                                        </select>
                                        <input class="mnt-input mnt-rate__note" type="text" name="note" placeholder="Comment (optional)" value={a.rating_note ?? ''} />
                                        <button class="mnt-btn mnt-btn--primary" type="submit" name="action" value="rate">Update rating</button>
                                      </form>
                                    </details>
                                  )}
                                  {!a.rating && (
                                    <form method="post" class="mnt-unassign">
                                      <input type="hidden" name="personId" value={m.id} />
                                      <input type="hidden" name="projectId" value={a.project_id} />
                                      <button class="mnt-link" type="submit" name="action" value="unassign">Unassign</button>
                                    </form>
                                  )}
                                </>
                              )}
                            </div>
                            {reviewsReady ? (
                              <span class="mnt-pill" data-tone={theirs.length ? 'available' : complete ? 'red_flag' : 'unavailable'}>
                                {theirs.length ? `Overall ${average(theirs, 'overall')}/5` : complete ? 'Needs review' : 'In progress'}
                              </span>
                            ) : (
                              <span class="mnt-pill" data-tone={a.rating ? 'available' : complete ? 'red_flag' : 'unavailable'}>
                                {a.rating ? `Rated ${a.rating}/5` : complete ? 'Needs rating' : 'Not complete yet'}
                              </span>
                            )}
                            <a class="pcard__chev" href={`/pipeline/projects/${a.project_id}`} title="Open project" aria-label="Open project">
                              <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="m7.5 5 5 5-5 5" /></svg>
                            </a>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                </details>

                <div class="mnt-row__tools">
                  <a class="mnt-icon-btn" href={`mailto:${m.email}`} title="Email mentee" aria-label="Email mentee">
                    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.5" d="M3 5h14v10H3z" /><path fill="none" stroke="currentColor" stroke-width="1.5" d="m3.5 5.5 6.5 5.5 6.5-5.5" /></svg>
                  </a>
                  <details class="mnt-menu">
                    <summary class="mnt-icon-btn" aria-label="More options">
                      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="4" cy="10" r="1.4" fill="currentColor" /><circle cx="10" cy="10" r="1.4" fill="currentColor" /><circle cx="16" cy="10" r="1.4" fill="currentColor" /></svg>
                    </summary>
                    <div class="mnt-menu__panel">
                      <form method="post">
                        <input type="hidden" name="personId" value={m.id} />
                        <input type="hidden" name="available" value={m.open_to_assignment ? '0' : '1'} />
                        <button class="mnt-menu__item" type="submit" name="action" value="set-availability">
                          {m.open_to_assignment ? 'Mark unavailable' : 'Mark available'}
                        </button>
                      </form>

                      <details class="mnt-menu__sub">
                        <summary>Edit expertise tags</summary>
                        <form method="post" class="mnt-menu__subform">
                          <input type="hidden" name="personId" value={m.id} />
                          <div class="mnt-chips">
                            {EXPERTISE_TAGS.map((tag) => (
                              <label class="mnt-chip">
                                <input type="checkbox" name="expertise" value={tag} checked={tags.includes(tag)} />
                                <span>{tag}</span>
                              </label>
                            ))}
                          </div>
                          <button class="mnt-btn mnt-btn--ghost" type="submit" name="action" value="set-expertise">Save tags</button>
                        </form>
                      </details>

                      <details class="mnt-menu__sub">
                        <summary>Flag mentee</summary>
                        <form method="post" class="mnt-menu__subform">
                          <input type="hidden" name="personId" value={m.id} />
                          <select class="mnt-select" name="flag">
                            <option value="none" selected={m.flag_status === 'none'}>None</option>
                            <option value="red_flag" selected={m.flag_status === 'red_flag'}>Red flag</option>
                            <option value="blacklisted" selected={m.flag_status === 'blacklisted'}>Blacklist</option>
                          </select>
                          <input class="mnt-input" type="text" name="reason" placeholder="Reason (required unless clearing)" value={m.flag_reason ?? ''} />
                          <button class="mnt-btn mnt-btn--danger" type="submit" name="action" value="set-flag">Update flag</button>
                        </form>
                      </details>
                    </div>
                  </details>
                </div>
              </article>
            );
          })}
        </div>

        <section class="mb" data-mnt-view="board" data-mb hidden aria-label="Assign mentees to ongoing projects">
          <aside class="mb__people">
            <label class="mb__search">
              <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M9 15.5A6.5 6.5 0 1 0 9 2.5a6.5 6.5 0 0 0 0 13Zm9 2-4.3-4.3" /></svg>
              <input type="search" placeholder="Type a mentee's name" aria-label="Find a mentee" data-mb-psearch autocomplete="off" />
            </label>
            <p class="mb__hint">Drag a name onto a project. On a phone, or with the keyboard, tap a name, then <b>Add here</b> on the project.</p>
            <ul class="mb__chips" data-mb-chips>
              {boardMentees.map((m) => {
                const count = (assignmentsByPerson.get(m.id) ?? []).length;
                return (
                  <li data-mb-chip-row data-name={m.full_name.toLowerCase()}>
                    <button type="button" class:list={['mb-chip', !m.open_to_assignment && 'is-unavail', m.flag_status === 'red_flag' && 'is-flag']}
                      data-mb-chip data-id={m.id} data-label={m.full_name} aria-pressed="false">
                      <span class="mb-chip__name">{m.full_name}</span>
                      <span class="mb-chip__meta" data-mb-count={count}>{count} project{count === 1 ? '' : 's'}{!m.open_to_assignment ? ' · unavailable' : ''}{m.flag_status === 'red_flag' ? ' · red flag' : ''}</span>
                    </button>
                  </li>
                );
              })}
            </ul>
            <p class="mb__empty" data-mb-pempty hidden>No mentee matches that name.</p>
          </aside>

          <div class="mb__projects">
            <div class="mb__bar">
              <label class="mb__search mb__search--wide">
                <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M9 15.5A6.5 6.5 0 1 0 9 2.5a6.5 6.5 0 0 0 0 13Zm9 2-4.3-4.3" /></svg>
                <input type="search" placeholder={`Search ${boardProjects.length} ongoing projects`} aria-label="Find a project" data-mb-jsearch autocomplete="off" />
              </label>
            </div>
            {boardProjects.length === 0 && <p class="mb__empty">No ongoing projects right now.</p>}
            <div class="mb__grid" data-mb-grid>
              {boardProjects.map((p) => (
                <article class="mb-proj" data-mb-proj data-id={p.id} data-ref={p.ref} data-name={`${p.ref} ${p.title}`.toLowerCase()}>
                  <a class="mb-proj__title" href={`/pipeline/projects/${p.id}`} draggable="false"><b>{p.ref}</b> {p.title}</a>
                  {p.lead_id && leadName.get(p.lead_id) && <p class="mb-proj__lead">Lead: {leadName.get(p.lead_id)}</p>}
                  <ul class="mb-proj__people" data-mb-assigned>
                    {(onProject.get(p.id) ?? []).map((pid) => (
                      <li class="mb-tag" data-person={pid}>
                        <span>{menteeName.get(pid) ?? 'Mentee'}</span>
                        {!reviewedPairs.has(`${p.id}:${pid}`) && (
                          <button type="button" class="mb-tag__x" data-mb-remove aria-label={`Remove ${menteeName.get(pid) ?? 'mentee'} from ${p.ref}`}>&times;</button>
                        )}
                      </li>
                    ))}
                  </ul>
                  <button type="button" class="mb-proj__add" data-mb-add hidden>Add <span data-mb-add-name></span> here</button>
                </article>
              ))}
            </div>
            <p class="mb__empty" data-mb-jempty hidden>No project matches that search.</p>
          </div>

          <div class="mb-toast" data-mb-toast role="status" aria-live="polite" hidden>
            <span data-mb-toast-text></span>
            <button type="button" class="mb-toast__undo" data-mb-undo hidden>Undo</button>
          </div>
        </section>
      </>
    )}
  </div>
</AppLayout>

<script>
  // ---------- List / board switch (remembered for this browser) ----------
  const views = document.querySelectorAll<HTMLElement>('[data-mnt-view]');
  const viewBtns = document.querySelectorAll<HTMLButtonElement>('[data-mnt-view-btn]');
  function showView(v: string) {
    views.forEach((el) => { el.hidden = el.dataset.mntView !== v; });
    viewBtns.forEach((b) => {
      const on = b.dataset.mntViewBtn === v;
      b.classList.toggle('is-on', on);
      b.setAttribute('aria-selected', String(on));
    });
    try { localStorage.setItem('mnt-view', v); } catch { /* storage blocked */ }
  }
  viewBtns.forEach((b) => b.addEventListener('click', () => showView(b.dataset.mntViewBtn ?? 'list')));
  let saved = 'list';
  try { saved = localStorage.getItem('mnt-view') ?? 'list'; } catch { /* storage blocked */ }
  if (new URLSearchParams(location.search).get('view') === 'board') saved = 'board';
  if (saved === 'board' && document.querySelector('[data-mb]')) showView('board');

  // ---------- Board ----------
  const board = document.querySelector<HTMLElement>('[data-mb]');
  if (board) {
    const chips = [...board.querySelectorAll<HTMLButtonElement>('[data-mb-chip]')];
    const cards = [...board.querySelectorAll<HTMLElement>('[data-mb-proj]')];
    const toast = board.querySelector<HTMLElement>('[data-mb-toast]')!;
    const toastText = board.querySelector<HTMLElement>('[data-mb-toast-text]')!;
    const undoBtn = board.querySelector<HTMLButtonElement>('[data-mb-undo]')!;
    let selected: HTMLButtonElement | null = null;
    let toastTimer = 0;
    let undoAction: (() => void) | null = null;

    const filter = (input: HTMLInputElement | null, rows: HTMLElement[], empty: HTMLElement | null) => {
      input?.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        for (const r of rows) {
          const hit = !q || (r.dataset.name ?? '').includes(q);
          r.hidden = !hit;
          if (hit) shown++;
        }
        if (empty) empty.hidden = shown > 0 || rows.length === 0;
      });
    };
    filter(board.querySelector('[data-mb-psearch]'), [...board.querySelectorAll<HTMLElement>('[data-mb-chip-row]')], board.querySelector('[data-mb-pempty]'));
    filter(board.querySelector('[data-mb-jsearch]'), cards, board.querySelector('[data-mb-jempty]'));

    function say(text: string, undo: (() => void) | null = null, isError = false) {
      toastText.textContent = text;
      toast.classList.toggle('is-error', isError);
      undoAction = undo;
      undoBtn.hidden = !undo;
      toast.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => { toast.hidden = true; undoAction = null; }, undo ? 8000 : 5000);
    }
    undoBtn.addEventListener('click', () => {
      const fn = undoAction;
      toast.hidden = true;
      undoAction = null;
      fn?.();
    });

    const chipFor = (personId: string) => chips.find((c) => c.dataset.id === personId) ?? null;
    function bumpCount(personId: string, by: number) {
      const meta = chipFor(personId)?.querySelector<HTMLElement>('[data-mb-count]');
      if (!meta) return;
      const n = Math.max(0, Number(meta.dataset.mbCount ?? 0) + by);
      meta.dataset.mbCount = String(n);
      meta.textContent = meta.textContent!.replace(/^\d+ projects?/, `${n} project${n === 1 ? '' : 's'}`);
    }

    async function post(action: 'assign' | 'unassign', projectId: string, personId: string): Promise<string | null> {
      const body = new FormData();
      body.set('action', action);
      body.set('projectId', projectId);
      body.set('personId', personId);
      try {
        const res = await fetch('/admin/mentees/assign', { method: 'POST', body, headers: { accept: 'application/json' } });
        const out = await res.json().catch(() => ({ ok: false, error: 'Something went wrong. Reload the page and try again.' }));
        return res.ok && out.ok ? null : out.error || 'Something went wrong.';
      } catch {
        return 'Could not reach the server. Check your connection and try again.';
      }
    }

    function addTag(card: HTMLElement, personId: string, name: string) {
      const li = document.createElement('li');
      li.className = 'mb-tag';
      li.dataset.person = personId;
      const span = document.createElement('span');
      span.textContent = name;
      const x = document.createElement('button');
      x.type = 'button';
      x.className = 'mb-tag__x';
      x.dataset.mbRemove = '';
      x.setAttribute('aria-label', `Remove ${name} from ${card.dataset.ref}`);
      x.textContent = '×';
      li.append(span, x);
      card.querySelector('[data-mb-assigned]')?.append(li);
    }

    async function assign(card: HTMLElement, personId: string, name: string, fromUndo = false) {
      const ref = card.dataset.ref ?? 'the project';
      if (card.querySelector(`[data-person="${personId}"]`)) {
        say(`${name} is already on ${ref}.`, null, true);
        return;
      }
      card.classList.add('is-busy');
      const err = await post('assign', card.dataset.id!, personId);
      card.classList.remove('is-busy');
      if (err) { say(err, null, true); return; }
      addTag(card, personId, name);
      bumpCount(personId, 1);
      card.classList.add('is-flash');
      setTimeout(() => card.classList.remove('is-flash'), 900);
      say(fromUndo ? `${name} is back on ${ref}.` : `Added ${name} to ${ref}. They've been notified.`, fromUndo ? null : () => unassign(card, personId, name, true));
    }

    async function unassign(card: HTMLElement, personId: string, name: string, fromUndo = false) {
      const ref = card.dataset.ref ?? 'the project';
      card.classList.add('is-busy');
      const err = await post('unassign', card.dataset.id!, personId);
      card.classList.remove('is-busy');
      if (err) { say(err, null, true); return; }
      card.querySelector(`[data-person="${personId}"]`)?.remove();
      bumpCount(personId, -1);
      say(fromUndo ? `Took ${name} off ${ref} again.` : `Removed ${name} from ${ref}.`, fromUndo ? null : () => assign(card, personId, name, true));
    }

    // Remove buttons (also on tags added after the page loaded).
    board.addEventListener('click', (e) => {
      const x = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-mb-remove]');
      if (!x) return;
      const card = x.closest<HTMLElement>('[data-mb-proj]');
      const personId = x.closest<HTMLElement>('[data-person]')?.dataset.person;
      if (!card || !personId) return;
      const name = chipFor(personId)?.dataset.label ?? x.previousElementSibling?.textContent ?? 'this mentee';
      unassign(card, personId, name);
    });

    // ---- Tap / keyboard: pick a name, then "Add here" on a project ----
    function select(chip: HTMLButtonElement | null) {
      if (selected) { selected.classList.remove('is-picked'); selected.setAttribute('aria-pressed', 'false'); }
      selected = chip && chip !== selected ? chip : null;
      if (selected) { selected.classList.add('is-picked'); selected.setAttribute('aria-pressed', 'true'); }
      board.classList.toggle('has-pick', !!selected);
      for (const card of cards) {
        const add = card.querySelector<HTMLButtonElement>('[data-mb-add]')!;
        add.hidden = !selected;
        const nm = add.querySelector('[data-mb-add-name]');
        if (nm) nm.textContent = selected?.dataset.label ?? '';
      }
    }
    let suppressClick = false;
    chips.forEach((chip) => chip.addEventListener('click', () => {
      if (suppressClick) { suppressClick = false; return; }
      select(chip);
    }));
    cards.forEach((card) => card.querySelector('[data-mb-add]')?.addEventListener('click', () => {
      if (!selected) return;
      const chip = selected;
      select(null);
      assign(card, chip.dataset.id!, chip.dataset.label ?? 'Mentee');
    }));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && selected) select(null); });

    // ---- Mouse / pen drag ----
    let drag: { chip: HTMLButtonElement; ghost: HTMLElement | null; x: number; y: number; over: HTMLElement | null; id: number } | null = null;
    let scrollRaf = 0;
    let lastY = 0;

    const cardAt = (x: number, y: number) => {
      const el = document.elementFromPoint(x, y) as HTMLElement | null;
      return el?.closest<HTMLElement>('[data-mb-proj]') ?? null;
    };
    function autoScroll() {
      if (!drag?.ghost) return;
      const edge = 70;
      const h = window.innerHeight;
      const step = lastY < edge ? -(edge - lastY) / 3 : lastY > h - edge ? (lastY - (h - edge)) / 3 : 0;
      if (step) window.scrollBy(0, step);
      scrollRaf = requestAnimationFrame(autoScroll);
    }
    function endDrag(drop: boolean) {
      if (!drag) return;
      cancelAnimationFrame(scrollRaf);
      const { chip, ghost, over } = drag;
      ghost?.remove();
      over?.classList.remove('is-over');
      board.classList.remove('is-dragging');
      chip.classList.remove('is-dragged');
      const started = !!ghost;
      drag = null;
      if (started) {
        suppressClick = true;
        setTimeout(() => { suppressClick = false; }, 0);
        if (drop && over) assign(over, chip.dataset.id!, chip.dataset.label ?? 'Mentee');
      }
    }
    chips.forEach((chip) => {
      chip.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'touch' || e.button !== 0) return;
        drag = { chip, ghost: null, x: e.clientX, y: e.clientY, over: null, id: e.pointerId };
      });
    });
    document.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      if (!drag.ghost) {
        if (Math.hypot(e.clientX - drag.x, e.clientY - drag.y) < 6) return;
        const g = document.createElement('div');
        g.className = 'mb-ghost';
        g.textContent = drag.chip.dataset.label ?? '';
        document.body.append(g);
        drag.ghost = g;
        drag.chip.classList.add('is-dragged');
        board.classList.add('is-dragging');
        if (selected) select(null);
        scrollRaf = requestAnimationFrame(autoScroll);
      }
      e.preventDefault();
      lastY = e.clientY;
      drag.ghost.style.transform = `translate(${e.clientX + 12}px, ${e.clientY + 12}px)`;
      const over = cardAt(e.clientX, e.clientY);
      if (over !== drag.over) {
        drag.over?.classList.remove('is-over');
        over?.classList.add('is-over');
        drag.over = over;
      }
    });
    document.addEventListener('pointerup', (e) => { if (drag && e.pointerId === drag.id) endDrag(true); });
    document.addEventListener('pointercancel', (e) => { if (drag && e.pointerId === drag.id) endDrag(false); });
    window.addEventListener('blur', () => endDrag(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') endDrag(false); });
  }
</script>

<script>
  const input = document.querySelector('[data-mnt-search]');
  const list = document.querySelector('[data-mnt-list]');
  if (input && list) {
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      list.querySelectorAll('.mnt-card').forEach((card) => {
        const name = card.getAttribute('data-mnt-name') ?? '';
        card.style.display = !q || name.includes(q) ? '' : 'none';
      });
    });
  }
</script>

<style>
  /* This page intentionally departs from the site's zero-radius/no-shadow
     system - a one-off, requested look for Mentees only. Nothing here is
     :global beyond the page heading override, and Astro only bundles this
     stylesheet into this one route, so it can't leak onto other pages. */
  :global(.app__heading) { display: none; }

  /* ---------- view switch ---------- */
  .mnt-views { display: inline-flex; margin-top: 0.8rem; border: 1px solid var(--border-soft); border-radius: 10px; overflow: hidden; }
  .mnt-view { border: 0; background: var(--surface); padding: 0.45rem 0.9rem; font: inherit; font-size: 0.82rem; font-weight: 600; color: var(--text-muted); cursor: pointer; }
  .mnt-view + .mnt-view { border-left: 1px solid var(--border-soft); }
  .mnt-view.is-on { background: var(--text-strong); color: var(--bg); }
  .mnt-progress { display: inline-block; margin-top: 0.5rem; font-size: 0.82rem; font-weight: 600; color: var(--blue); }
  .mnt-avatar--photo { object-fit: cover; padding: 0; }
  .mnt-link--inline { justify-self: start; font-size: 0.8rem; font-weight: 600; color: var(--blue); }
  [data-mnt-view][hidden] { display: none !important; }

  /* ---------- board ---------- */
  .mb { display: grid; grid-template-columns: minmax(230px, 290px) 1fr; gap: 1.25rem; align-items: start; }
  .mb__people {
    position: sticky; top: 1rem; display: grid; gap: 0.6rem; padding: 1rem;
    background: var(--surface); border: 1px solid var(--border-soft); border-radius: 16px;
    max-height: calc(100vh - 2rem); min-height: 0; grid-template-rows: auto auto minmax(0, 1fr) auto;
  }
  .mb__search {
    display: flex; align-items: center; gap: 0.45rem; padding: 0.55rem 0.75rem;
    background: var(--bg-tint); border: 1px solid var(--border-soft); border-radius: 10px; color: var(--text-muted);
  }
  .mb__search input { border: 0; background: none; outline: none; font-size: 0.88rem; color: var(--text-strong); width: 100%; min-width: 0; }
  .mb__search:focus-within { border-color: var(--blue); }
  .mb__search--wide { max-width: 420px; }
  .mb__hint { margin: 0; font-size: 0.76rem; line-height: 1.5; color: var(--text-muted); }
  .mb__chips { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; overflow-y: auto; min-height: 0; }
  .mb__chips li[hidden] { display: none; }
  .mb-chip {
    width: 100%; display: grid; gap: 1px; text-align: left; padding: 0.55rem 0.75rem;
    background: var(--bg); border: 1px solid var(--border-soft); border-radius: 10px;
    font: inherit; color: var(--text-strong); cursor: grab; user-select: none; -webkit-user-select: none;
  }
  .mb-chip:hover { border-color: var(--border); }
  .mb-chip:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .mb-chip__name { font-size: 0.88rem; font-weight: 600; }
  .mb-chip__meta { font-size: 0.72rem; color: var(--text-muted); }
  .mb-chip.is-unavail .mb-chip__name { color: var(--text-muted); }
  .mb-chip.is-flag { border-left: 3px solid var(--warn); }
  .mb-chip.is-picked { border-color: var(--blue); background: var(--accent-wash); box-shadow: 0 0 0 1px var(--blue) inset; }
  .mb-chip.is-dragged { opacity: 0.45; }
  .mb__empty { margin: 0; font-size: 0.84rem; color: var(--text-muted); }
  .mb__projects { display: grid; gap: 0.8rem; min-width: 0; }
  .mb__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0.8rem; }
  .mb-proj {
    display: grid; gap: 0.45rem; align-content: start; padding: 0.9rem 1rem; min-height: 120px;
    background: var(--surface); border: 1px solid var(--border-soft); border-radius: 14px;
    transition: border-color 0.12s, background-color 0.12s;
  }
  .mb-proj[hidden] { display: none; }
  .mb.is-dragging .mb-proj { border-style: dashed; }
  .mb.is-dragging .mb-proj.is-over { border: 2px solid var(--blue); background: var(--accent-wash); padding: calc(0.9rem - 1px) calc(1rem - 1px); }
  .mb-proj.is-busy { opacity: 0.6; }
  .mb-proj.is-flash { border-color: var(--ok); background: var(--ok-bg); }
  .mb-proj__title { font-size: 0.86rem; line-height: 1.35; color: var(--text-strong); }
  .mb-proj__title:hover { color: var(--blue); }
  .mb-proj__lead { margin: 0; font-size: 0.74rem; color: var(--text-muted); }
  .mb-proj__people { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .mb :global(.mb-tag) {
    display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.2rem 0.3rem 0.2rem 0.6rem;
    background: var(--bg-tint); border: 1px solid var(--border-soft); border-radius: 999px; font-size: 0.76rem; color: var(--text-strong);
  }
  .mb :global(.mb-tag__x) {
    border: 0; background: none; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center;
    font-size: 0.95rem; line-height: 1; color: var(--text-muted); cursor: pointer; padding: 0;
  }
  .mb :global(.mb-tag__x:hover) { background: var(--red-wash); color: var(--red); }
  .mb :global(.mb-tag:not(:has(.mb-tag__x))) { padding-right: 0.6rem; }
  .mb-proj__add {
    justify-self: start; margin-top: 0.2rem; padding: 0.4rem 0.75rem; border: 1px dashed var(--blue); border-radius: 8px;
    background: var(--accent-wash); color: var(--blue); font: inherit; font-size: 0.78rem; font-weight: 700; cursor: pointer;
  }
  .mb-proj__add[hidden] { display: none; }
  .mb-toast {
    position: fixed; left: 50%; bottom: 1.25rem; transform: translateX(-50%); z-index: 60;
    display: flex; align-items: center; gap: 0.9rem; max-width: calc(100vw - 2rem);
    padding: 0.7rem 1rem; background: var(--text-strong); color: var(--bg); border-radius: 12px; font-size: 0.86rem;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);
  }
  .mb-toast[hidden] { display: none; }
  .mb-toast.is-error { background: var(--red); color: #fff; }
  .mb-toast__undo { border: 0; background: none; color: inherit; font: inherit; font-weight: 700; text-decoration: underline; cursor: pointer; padding: 0; }
  :global(.mb-ghost) {
    position: fixed; left: 0; top: 0; z-index: 70; pointer-events: none;
    padding: 0.45rem 0.8rem; background: var(--blue); color: #fff; border-radius: 10px;
    font-size: 0.85rem; font-weight: 700; box-shadow: 0 8px 22px rgba(0, 0, 0, 0.22); white-space: nowrap;
  }
  @media (max-width: 760px) {
    .mb { grid-template-columns: 1fr; }
    .mb__people { position: static; max-height: none; }
    .mb__chips { max-height: 260px; }
  }

  .mnt-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .mnt-head__title { font-family: var(--font-sans); font-weight: 700; font-size: 2.3rem; color: var(--text-strong); margin: 0; }

  .mnt-search {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.6rem 0.9rem; background: var(--bg-tint);
    border: 1px solid var(--border-soft); border-radius: 10px;
    color: var(--text-muted); min-width: 220px;
  }
  .mnt-search input {
    border: 0; background: none; outline: none; font-size: 0.88rem; color: var(--text-strong); width: 100%;
  }

  .mnt-empty { padding: 1.25rem 0; font-size: 0.92rem; color: var(--text-muted); }
  .mnt-empty--inline { padding: 0; }

  /* ---------- cards ---------- */
  .mnt-list { display: grid; gap: 1rem; min-width: 0; }
  .mnt-card {
    position: relative;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: 16px;
    box-shadow: 0 1px 2px rgba(20, 20, 18, 0.04), 0 1px 10px rgba(20, 20, 18, 0.045);
  }

  .mnt-row__head {
    display: flex; align-items: flex-start; gap: 0.9rem;
    padding: 1.3rem 4.5rem 1.3rem 1.4rem;
    cursor: pointer; list-style: none;
  }
  .mnt-row__head::-webkit-details-marker { display: none; }

  .mnt-avatar {
    flex-shrink: 0; width: 46px; height: 46px; border-radius: 50%;
    display: grid; place-items: center;
    font-family: var(--font-sans); font-weight: 700; font-size: 1rem;
  }
  .mnt-avatar[data-tone='green'] { background: var(--ok-bg); color: var(--ok); }
  .mnt-avatar[data-tone='rose']  { background: var(--red-wash); color: var(--red); }
  .mnt-avatar[data-tone='amber'] { background: var(--warn-bg); color: var(--warn); }
  .mnt-avatar[data-tone='wine']  { background: var(--accent-wash); color: var(--blue); }

  .mnt-row__id { display: grid; gap: 0.35rem; min-width: 0; }
  .mnt-row__name { font-family: var(--font-sans); font-weight: 700; font-size: 1.3rem; color: var(--text-strong); }
  .mnt-row__meta { font-size: 0.85rem; color: var(--text-muted); }

  .mnt-pill {
    justify-self: start; display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.78rem; font-weight: 600; padding: 0.3rem 0.7rem; border-radius: 999px; width: fit-content;
  }
  .mnt-pill i { width: 7px; height: 7px; border-radius: 50%; background: currentColor; display: inline-block; font-style: normal; }
  .mnt-pill[data-tone='available'] { background: var(--ok-bg); color: var(--ok); }
  .mnt-pill[data-tone='unavailable'] { background: var(--bg-tint); color: var(--text-muted); }
  .mnt-pill[data-tone='red_flag'] { background: var(--warn-bg); color: var(--warn); }
  .mnt-pill[data-tone='blacklisted'] { background: var(--red-wash); color: var(--red); }

  .mnt-row__chev { flex-shrink: 0; margin-top: 0.3rem; color: var(--text-muted); transition: transform 0.2s var(--ease); }
  .mnt-row[open] .mnt-row__chev { transform: rotate(180deg); }

  /* ---------- tools (sibling of <details>, overlaid so clicks on mail/menu
     never land inside <summary> and double-trigger the card's own toggle) ---------- */
  .mnt-row__tools { position: absolute; top: 1.2rem; right: 1.3rem; display: flex; gap: 0.35rem; }
  .mnt-icon-btn {
    display: grid; place-items: center; width: 34px; height: 34px;
    border-radius: 9px; border: 1px solid var(--border-soft); background: var(--bg);
    color: var(--text); cursor: pointer; list-style: none;
  }
  .mnt-icon-btn::-webkit-details-marker { display: none; }
  .mnt-icon-btn:hover { border-color: var(--border-strong); color: var(--text-strong); }

  .mnt-menu { position: relative; }
  .mnt-menu__panel {
    position: absolute; top: calc(100% + 8px); right: 0; z-index: 20;
    width: 260px; padding: 0.6rem;
    background: var(--surface); border: 1px solid var(--border-soft); border-radius: 12px;
    box-shadow: 0 8px 28px rgba(20, 20, 18, 0.14);
    display: grid; gap: 0.3rem;
  }
  .mnt-menu__item {
    width: 100%; text-align: left; padding: 0.55rem 0.6rem; border-radius: 8px;
    background: none; border: 0; font-size: 0.86rem; font-weight: 600; color: var(--text-strong); cursor: pointer;
  }
  .mnt-menu__item:hover { background: var(--bg-tint); }
  .mnt-menu__sub summary {
    padding: 0.55rem 0.6rem; border-radius: 8px; cursor: pointer; list-style: none;
    font-size: 0.86rem; font-weight: 600; color: var(--text-strong);
  }
