---
import AppLayout from '../../layouts/AppLayout.astro';
import '../../styles/admin.css';
import { currentUser } from '../../lib/auth';
import { listRequests, getRequest, markAllRequestsRead, type RequestRecord } from '../../lib/requests';
import { templatesFor, fillTemplate, renderReplyEmail, listReplies, recordReply } from '../../lib/request-replies';
import { sendEmail } from '../../lib/email';
import { INTENT_LABELS, INTENTS, type Intent } from '../../lib/contact-schema';
import { intentRows } from '../../lib/mailer';

export const prerender = false;

const me = currentUser(Astro.cookies);
if (!me) return Astro.redirect('/login', 302);
if (me.role !== 'admin') return Astro.redirect('/pipeline', 302);

// --- Reply by email --------------------------------------------------------
// Sent, recorded, then back to this page (so a refresh can't send it twice).
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const requestId = String(form.get('requestId') ?? '');
  const subject = String(form.get('subject') ?? '').trim().slice(0, 300);
  const body = String(form.get('body') ?? '').trim().slice(0, 20000);
  const template = String(form.get('template') ?? '') || null;
  const typeParam = String(form.get('type') ?? '');
  const back = (kind: 'ok' | 'err', msg: string) =>
    Astro.redirect(`/admin/requests?${typeParam ? `type=${encodeURIComponent(typeParam)}&` : ''}${kind}=${encodeURIComponent(msg)}&open=${encodeURIComponent(requestId)}#req-${requestId}`, 303);
  const r = requestId ? await getRequest(requestId).catch(() => undefined) : undefined;
  if (!r) return back('err', 'That request no longer exists.');
  if (!subject || !body) return back('err', 'The subject and the message both need text.');
  const sent = await sendEmail({ to: r.email, subject, html: renderReplyEmail(body), replyTo: 'researchlab@mcaheart.com' })
    .catch((e) => ({ ok: false as const, error: String(e) }));
  if (!sent.ok) return back('err', `The email to ${r.email} could not be sent. ${'error' in sent ? sent.error ?? '' : ''}`.trim());
  if ('id' in sent && sent.id === 'logged-only') return back('err', 'Email sending is not set up on this server, so nothing was sent.');
  const recErr = await recordReply({ request_id: r.id, sent_by: me.name, to_email: r.email, subject, body, template });
  return back('ok', recErr
    ? `Reply sent to ${r.email}, but it could not be saved to the history (${recErr}).`
    : `Reply sent to ${r.email}.`);
}
const flashOk = Astro.url.searchParams.get('ok');
const flashErr = Astro.url.searchParams.get('err');
const openId = Astro.url.searchParams.get('open') ?? '';

const activeParam = Astro.url.searchParams.get('type') ?? '';
const active: Intent | null = (INTENTS as readonly string[]).includes(activeParam)
  ? (activeParam as Intent)
  : null;

let all: Awaited<ReturnType<typeof listRequests>> = [];
let dbReady = false;
let dbError = '';
try {
  all = await listRequests();
  dbReady = true;
  // Opening this page is how the admin "reads" new requests - the nav badge
  // clears once they've actually looked at the list.
  await markAllRequestsRead();
} catch (err) {
  dbError = err instanceof Error ? err.message : 'Could not load requests.';
}
const requests = active ? all.filter((r) => r.intent === active) : all;
const { ready: repliesReady, byRequest: replies } = dbReady ? await listReplies() : { ready: false, byRequest: new Map() };

const fmtDate = (t: number) => new Date(t).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' });
const ago = (t: number) => {
  const d = Math.floor((Date.now() - t) / 86_400_000);
  return d === 0 ? 'today' : d === 1 ? 'yesterday' : `${d} days ago`;
};

/** Rows specific to the chosen reason - the same rows the email shows. */
const detailRows = (r: RequestRecord) => intentRows(r);
---

<AppLayout title="Requests" heading="Contact requests" user={me} active="requests">
  <div class="adm">
    {flashOk && <div class="adm-flash adm-flash--ok" role="status"><p>{flashOk}</p></div>}
    {flashErr && <div class="adm-flash adm-flash--error" role="alert"><p>{flashErr}</p></div>}
    {dbReady && !repliesReady && (
      <div class="adm-flash adm-flash--error">
        <p>Replying by email needs <code>mca-pipeline/add-request-replies.sql</code>. Run it once in the Supabase SQL editor, then reload this page.</p>
      </div>
    )}
    {!dbReady && (
      <div class="adm-flash adm-flash--error">
        <p>
          Requests storage isn't set up yet. Run <code>mca-pipeline/add-forms-storage.sql</code> in the
          Supabase SQL editor, then reload this page.
          {dbError && <><br /><span class="adm-hint">({dbError})</span></>}
        </p>
      </div>
    )}

    {dbReady && (<>
    <div class="reqs__filter">
      <a class:list={['reqs__chip', !active && 'is-active']} href="/admin/requests">
        All <span>{all.length}</span>
      </a>
      {INTENTS.map((v) => (
        <a class:list={['reqs__chip', active === v && 'is-active']} href={`/admin/requests?type=${v}`}>
          {INTENT_LABELS[v]} <span>{all.filter((r) => r.intent === v).length}</span>
        </a>
      ))}
    </div>

    {requests.length === 0 && <p class="adm-hint">No requests here yet.</p>}

    <div class="reqs__list">
      {requests.map((r) => (
        <details class="idea" id={`req-${r.id}`} open={r.id === openId}>
          <summary class="idea__summary">
            <span class="idea__pill">{INTENT_LABELS[r.intent]}</span>
            {(replies.get(r.id) ?? []).length > 0 && <span class="idea__pill idea__pill--ok">Replied</span>}
            {r.source === 'member' && <span class="idea__pill">From a member</span>}
            <span class="idea__title">{r.fullName}</span>
            <span class="idea__meta">{r.email} · {ago(r.submittedAt)}</span>
            <span class="idea__chev" aria-hidden="true">▾</span>
          </summary>

          <div class="idea__body">
            <dl class="idea__dl">
              <div class="idea__pair"><dt>Email</dt><dd>{r.email}</dd></div>
              <div class="idea__pair"><dt>Phone</dt><dd>{r.phone || '-'}</dd></div>
              <div class="idea__pair"><dt>Location</dt><dd>{r.location || '-'}</dd></div>
              <div class="idea__pair"><dt>Designation</dt><dd>{r.designation || '-'}</dd></div>
              <div class="idea__pair"><dt>Submitted</dt><dd>{fmtDate(r.submittedAt)}</dd></div>
              {detailRows(r).map(([k, v]) => (
                <div class="idea__pair"><dt>{k}</dt><dd>{v}</dd></div>
              ))}
              {r.intent === 'observership' && (
                <div class="idea__pair">
                  <dt>CV</dt>
                  <dd class="idea__files">
                    {r.cv
                      ? <a href={`/admin/requests/${r.id}/cv`} target="_blank" rel="noopener">{r.cv.filename} ({Math.round(r.cv.size / 1024)} KB)</a>
                      : <span class="adm-tag">not attached</span>}
                  </dd>
                </div>
              )}
            </dl>

            {(replies.get(r.id) ?? []).length > 0 && (
              <div class="rp-sent">
                {(replies.get(r.id) ?? []).map((x: any) => (
                  <details class="rp-sent__item">
                    <summary>
                      <span class="rp-sent__dot" aria-hidden="true"></span>
                      <span><b>Replied</b> by {x.sent_by} · {fmtDate(new Date(x.sent_at).getTime())}</span>
                      <span class="rp-sent__subj">{x.subject}</span>
                    </summary>
                    <p class="rp-sent__body">{x.body}</p>
                  </details>
                ))}
              </div>
            )}

            {repliesReady && (() => {
              const options = templatesFor(r).map((tpl) => ({ key: tpl.key, label: tpl.label, subject: fillTemplate(tpl.subject, r), body: fillTemplate(tpl.body, r) }));
              const first = options[0];
              const replied = (replies.get(r.id) ?? []).length > 0;
              return (
                <details class="rp" open={!replied || (r.id === openId && !!flashErr)}>
                  <summary class="rp__toggle">{replied ? 'Reply again' : `Reply to ${r.fullName.split(/\s+/)[0] || 'them'}`}</summary>
                  <form method="post" class="rp__form" data-rp>
                    <input type="hidden" name="requestId" value={r.id} />
                    <input type="hidden" name="type" value={active ?? ''} />
                    <input type="hidden" name="template" value={first.key} data-rp-template />
                    <script type="application/json" data-rp-templates set:html={JSON.stringify(options).replace(/</g, '\\u003c')} />

                    <div class="rp__picks" role="group" aria-label="Start from">
                      {options.map((o, n) => (
                        <button type="button" class:list={['rp__pick', n === 0 && 'is-on']} data-rp-pick={o.key} aria-pressed={n === 0 ? 'true' : 'false'}>{o.label}</button>
                      ))}
                    </div>

                    <div class="rp__card">
                      <div class="rp__meta">
                        <span class="rp__k">To</span><span class="rp__v">{r.fullName} &lt;{r.email}&gt;</span>
                        <label class="rp__k" for={`rs-${r.id}`}>Subject</label>
                        <input class="rp__subject" id={`rs-${r.id}`} name="subject" required maxlength="300" value={first.subject} data-rp-subject />
                      </div>
                      <div class="rp__tabs" role="tablist">
                        <button type="button" class="rp__tab is-on" role="tab" aria-selected="true" data-rp-tab="write">Write</button>
                        <button type="button" class="rp__tab" role="tab" aria-selected="false" data-rp-tab="preview">Preview</button>
                      </div>
                      <textarea class="rp__body" name="body" required rows="13" maxlength="20000" aria-label="Message" data-rp-body>{first.body}</textarea>
                      <iframe class="rp__frame" title="Email preview" sandbox="" data-rp-frame hidden></iframe>
                      <p class="rp__tip">A blank line starts a new paragraph. Start a line with "- " for a bullet. Your signature is added for you.</p>
                    </div>

                    <div class="rp__foot">
                      <button class="btn rp__send" type="submit">Send reply</button>
                      <span class="rp__note">Sent from researchlab@mcaheart.com. Replies come back to that inbox.</span>
                    </div>
                  </form>
                </details>
              );
            })()}
          </div>
        </details>
      ))}
    </div>
    </>)}
  </div>
</AppLayout>

<script>
  // Reply boxes: pick a starting point, edit, preview, send.
  document.querySelectorAll<HTMLFormElement>('[data-rp]').forEach((form) => {
    const options: { key: string; label: string; subject: string; body: string }[] =
      JSON.parse(form.querySelector('[data-rp-templates]')?.textContent ?? '[]');
    const picks = [...form.querySelectorAll<HTMLButtonElement>('[data-rp-pick]')];
    const tmpl = form.querySelector<HTMLInputElement>('[data-rp-template]')!;
    const subject = form.querySelector<HTMLInputElement>('[data-rp-subject]')!;
    const body = form.querySelector<HTMLTextAreaElement>('[data-rp-body]')!;
    const frame = form.querySelector<HTMLIFrameElement>('[data-rp-frame]')!;
    const tabs = [...form.querySelectorAll<HTMLButtonElement>('[data-rp-tab]')];
    let current = options[0];

    picks.forEach((b) => b.addEventListener('click', () => {
      const next = options.find((o) => o.key === b.dataset.rpPick);
      if (!next || next === current) return;
      const edited = body.value !== current.body || subject.value !== current.subject;
      if (edited && !confirm(`Replace what you have written with "${next.label}"?`)) return;
      current = next;
      tmpl.value = next.key;
      subject.value = next.subject;
      body.value = next.body;
      picks.forEach((x) => { const on = x === b; x.classList.toggle('is-on', on); x.setAttribute('aria-pressed', String(on)); });
      showTab('write');
      body.focus();
    }));

    async function showTab(which: string) {
      tabs.forEach((t) => { const on = t.dataset.rpTab === which; t.classList.toggle('is-on', on); t.setAttribute('aria-selected', String(on)); });
      const preview = which === 'preview';
      body.hidden = preview;
      frame.hidden = !preview;
      if (preview) {
        const fd = new FormData();
        fd.set('body', body.value);
        try {
          const res = await fetch('/admin/requests/preview', { method: 'POST', body: fd });
          if (res.ok) frame.srcdoc = await res.text();
        } catch { /* keep the last preview */ }
      }
    }
    tabs.forEach((t) => t.addEventListener('click', () => showTab(t.dataset.rpTab ?? 'write')));

    form.addEventListener('submit', (e) => {
      if (body.value.includes('[Write your reply here.]')) {
        e.preventDefault();
        showTab('write');
        alert('Replace "[Write your reply here.]" with your reply before sending.');
        return;
      }
      if (!confirm(`Send this reply now?`)) { e.preventDefault(); return; }
      const btn = form.querySelector<HTMLButtonElement>('.rp__send')!;
      setTimeout(() => { btn.disabled = true; btn.textContent = 'Sending…'; }, 0);
    });
  });
</script>

<style>
  .idea__pill--ok { color: var(--ok); background: var(--ok-bg); grid-area: auto; }
  .idea__summary:has(.idea__pill--ok) { grid-template-columns: auto auto 1fr auto; grid-template-areas: 'pill ok title chev' 'pill ok meta chev'; }
  .idea__summary .idea__pill--ok { grid-area: ok; align-self: start; margin-top: 0.1rem; }
  .rp-sent { margin-top: 1.1rem; display: grid; gap: 0.4rem; }
  .rp-sent__item { background: var(--ok-bg); padding: 0.6rem 0.85rem; }
  .rp-sent__item summary { cursor: pointer; display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.6rem; font-size: 0.84rem; color: var(--text-strong); list-style: none; }
  .rp-sent__item summary::-webkit-details-marker { display: none; }
  .rp-sent__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); }
  .rp-sent__subj { color: var(--text-muted); }
  .rp-sent__body { margin: 0.6rem 0 0.2rem; font-size: 0.86rem; line-height: 1.6; color: var(--text); white-space: pre-wrap; }
  .rp { margin-top: 1.2rem; }
  .rp__toggle {
    cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem; list-style: none;
    padding: 0.55rem 1rem; background: var(--ink); color: var(--bg); font-size: 0.84rem; font-weight: 700;
  }
  .rp__toggle::-webkit-details-marker { display: none; }
  .rp[open] .rp__toggle { background: none; color: var(--text-strong); padding: 0; font-size: 1rem; }
  .rp__form { display: grid; gap: 0.9rem; margin-top: 0.8rem; max-width: 820px; }
  .rp__picks { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .rp__pick {
    border: 0; padding: 0.45rem 0.85rem; background: var(--bg-tint); color: var(--text);
    font: inherit; font-size: 0.8rem; font-weight: 600; cursor: pointer;
  }
  .rp__pick:hover { color: var(--text-strong); }
  .rp__pick.is-on { background: var(--blue); color: #fff; }
  .rp__card { background: var(--bg); box-shadow: inset 0 0 0 1px var(--border-soft); }
  .rp__meta { display: grid; grid-template-columns: 4.5rem 1fr; align-items: center; gap: 0.5rem 0.8rem; padding: 0.8rem 1rem 0.4rem; }
  .rp__k { font-size: 0.78rem; font-weight: 700; color: var(--text-muted); }
  .rp__v { font-size: 0.88rem; color: var(--text-strong); overflow-wrap: anywhere; }
  .rp__subject { width: 100%; padding: 0.5rem 0.6rem; border: 0; background: var(--bg-tint); font: inherit; font-size: 0.9rem; font-weight: 600; color: var(--text-strong); }
  .rp__subject:focus, .rp__body:focus { outline: 2px solid var(--blue); outline-offset: -2px; }
  .rp__tabs { display: flex; gap: 1.1rem; padding: 0.6rem 1rem 0; }
  .rp__tab { border: 0; background: none; padding: 0.3rem 0; font: inherit; font-size: 0.82rem; font-weight: 700; color: var(--text-muted); cursor: pointer; box-shadow: inset 0 -2px 0 transparent; }
  .rp__tab.is-on { color: var(--text-strong); box-shadow: inset 0 -2px 0 var(--blue); }
  .rp__body { display: block; width: 100%; min-height: 300px; padding: 0.9rem 1rem; border: 0; background: var(--bg); font: inherit; font-size: 0.92rem; line-height: 1.6; color: var(--text-strong); resize: vertical; }
  .rp__body[hidden], .rp__frame[hidden] { display: none; }
  .rp__frame { display: block; width: 100%; height: 560px; border: 0; background: #f3f3f3; }
  .rp__tip { margin: 0; padding: 0.55rem 1rem 0.75rem; font-size: 0.74rem; color: var(--text-muted); }
  .rp__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1rem; }
  .rp__note { font-size: 0.78rem; color: var(--text-muted); }

  .reqs__filter { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: var(--space-m); }
  .reqs__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 0;
    background: transparent;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .reqs__chip span { font-variant-numeric: tabular-nums; color: var(--text-faint); }
  .reqs__chip:hover { border-color: var(--ink); color: var(--text-strong); }
  .reqs__chip.is-active { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .reqs__chip.is-active span { color: var(--bg); opacity: 0.7; }

  .reqs__list { display: grid; gap: 0.6rem; }

  .idea { background: var(--surface); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); overflow: hidden; }
  .idea[open] { border-color: var(--border); }
  .idea__summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'pill title chev' 'pill meta chev';
    gap: 0.15rem 0.75rem;
    align-items: center;
    padding: 0.9rem 1.1rem;
    cursor: pointer;
    list-style: none;
  }
  .idea__summary::-webkit-details-marker { display: none; }
  .idea__summary:hover { background: var(--bg-tint); }
  .idea__pill {
    grid-area: pill; align-self: start; margin-top: 0.1rem;
    font-size: 0.64rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em;
    padding: 0.2rem 0.5rem; border-radius: 0;
    color: var(--blue); background: var(--accent-wash);
  }
  .idea__title { grid-area: title; font-weight: 600; color: var(--text-strong); font-size: 0.95rem; line-height: 1.35; }
  .idea__meta { grid-area: meta; font-size: 0.78rem; color: var(--text-muted); }
  .idea__chev { grid-area: chev; color: var(--text-muted); transition: transform 0.2s var(--ease); }
  .idea[open] .idea__chev { transform: rotate(180deg); }

  .idea__body { padding: 0.4rem 1.1rem 1.2rem; border-top: 1px solid var(--border-soft); }
  .idea__dl { display: grid; gap: 0; margin: 0.6rem 0 0; }
  .idea__pair {
    display: grid; grid-template-columns: 210px 1fr; gap: 0.75rem;
    padding: 0.55rem 0; border-bottom: 1px solid var(--border-soft);
  }
  .idea__pair dt { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-muted); }
  .idea__pair dd { margin: 0; font-size: 0.88rem; line-height: 1.6; color: var(--text); white-space: pre-wrap; }
  @media (max-width: 640px) { .idea__pair { grid-template-columns: 1fr; gap: 0.15rem; } }

  .idea__files a { color: var(--blue); font-weight: 600; }
  .idea__files a:hover { text-decoration: underline; }
</style>
