---
/**
 * One mentee's whole progress, for admins: their details, every project
 * they've been on, and every private review leads and coordinators wrote.
 */
import AppLayout from '../../../layouts/AppLayout.astro';
import MenteeReviewList from '../../../components/MenteeReviewList.astro';
import '../../../styles/admin.css';
import { currentUser } from '../../../lib/auth';
import { supabaseAdmin } from '../../../lib/supabase';
import { listReviews, average, SCORE_FIELDS, fmtReviewDate } from '../../../lib/mentee-reviews';
import MembershipComposer from '../../../components/MembershipComposer.astro';
import { sendEmail } from '../../../lib/email';
import { renderReplyEmail } from '../../../lib/request-replies';
import {
  loadMemberships, emailFor, dayNumber, longDate, shortDate, addSixMonths, nextTermStart,
  STEP_ACTION, LOG_LABEL, STATUS_LABEL, NOTICE_ORDER,
  type MemberRow, type LogRow, type EmailStep, type NoticeStep,
} from '../../../lib/membership';

export const prerender = false;

const me = currentUser(Astro.cookies);
if (!me) return Astro.redirect('/login', 302);
if (me.role !== 'admin') return Astro.redirect('/pipeline', 302);

const { supabase } = Astro.locals as any;
const id = String(Astro.params.id ?? '');
if (!/^[0-9a-f-]{36}$/i.test(id)) return Astro.redirect('/admin/mentees', 302);

const here = `/admin/mentees/${id}`;
const LAB_EMAIL = 'researchlab@mcaheart.com';
const EMAIL_STEPS: EmailStep[] = ['warning_1', 'warning_2', 'explanation', 'removal', 'renewal', 'departure'];
const DONE_TEXT: Record<string, string> = {
  warning_1: 'First warning sent.',
  warning_2: 'Second warning sent.',
  explanation: 'Request for an explanation sent.',
  removal: 'They have been removed from the lab and told by email.',
  renewal: 'Membership renewed for six months.',
  departure: 'Membership ended and the departure email sent.',
  note: 'Marked as active. The three-month count starts again from today.',
  restore: 'Membership restored. A new six-month term starts today.',
};

// ---------------------------------------------------------------- membership actions
let flashErr = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('action') ?? '') === 'member-step' && String(form.get('personId') ?? '') === id) {
    const kind = String(form.get('kind') ?? '');
    const subject = String(form.get('subject') ?? '').trim();
    const body = String(form.get('body') ?? '').trim();
    const note = String(form.get('note') ?? '').trim();
    const { ready: msReady, rows } = await loadMemberships(supabase);
    const row = rows.find((r) => r.person_id === id);
    const isEmailStep = (EMAIL_STEPS as string[]).includes(kind);
    const emailIt = isEmailStep && (kind !== 'renewal' || form.get('email') === '1');

    if (!msReady || !row) {
      flashErr = 'Membership tracking is not switched on yet. Run add-membership.sql first.';
    } else if ((NOTICE_ORDER as string[]).includes(kind) && row.next_step !== kind) {
      flashErr = 'That step is no longer due. The page has been refreshed to show where things stand.';
    } else if ((kind === 'renewal' || kind === 'departure') && !(row.review_due && row.membership_status === 'active')) {
      flashErr = 'The term review is not due yet.';
    } else if (kind === 'note' && !note) {
      flashErr = 'Add a short note saying what they have been doing.';
    } else if (emailIt && (!subject || !body)) {
      flashErr = 'The email needs a subject and a message.';
    } else if (!isEmailStep && kind !== 'note' && kind !== 'restore') {
      flashErr = 'Unknown action.';
    } else {
      let sentOk = true;
      if (emailIt) {
        const sent = await sendEmail({ to: row.email, subject, html: renderReplyEmail(body, { formal: true }), replyTo: LAB_EMAIL })
          .catch((e: unknown) => ({ ok: false, error: e instanceof Error ? e.message : 'Email delivery failed.' }));
        if (!sent.ok) {
          sentOk = false;
          flashErr = `The email could not be sent (${sent.error ?? 'unknown error'}). Nothing was changed. Please try again.`;
        }
      }
      if (sentOk) {
        const { error } = await supabase.rpc('record_membership_step', {
          p_person: id,
          p_kind: kind,
          p_subject: emailIt ? subject : null,
          p_body: kind === 'note' ? note : emailIt ? body : null,
          p_emailed: emailIt,
        });
        if (error) {
          flashErr = emailIt
            ? `The email was sent, but the step could not be saved: ${error.message}`
            : error.message;
        } else {
          return Astro.redirect(`${here}?done=${encodeURIComponent(kind)}#membership`, 303);
        }
      }
    }
  }
}
const doneKey = Astro.url.searchParams.get('done') ?? '';
const flashOk = DONE_TEXT[doneKey] ?? '';

const { data: m } = await supabase
  .from('people')
  .select('id,full_name,email,expertise,open_to_assignment,flag_status,flag_reason,is_mentee')
  .eq('id', id)
  .maybeSingle();
if (!m) return Astro.redirect('/admin/mentees', 302);

// Affiliation only exists once add-profiles.sql has been run.
const { data: extra } = await supabaseAdmin().from('people').select('affiliation').eq('id', id).maybeSingle();
const affiliation: string | null = (extra as any)?.affiliation ?? null;

const { data: pmRows } = await supabase
  .from('project_mentees')
  .select('project_id,assigned_at')
  .eq('person_id', id)
  .order('assigned_at', { ascending: false });
const projectIds = (pmRows ?? []).map((r: any) => r.project_id);
const { data: projRows } = projectIds.length
  ? await supabase.from('project_list').select('id,ref,title,phase,stage,stage_label,lead_name,archived_at,deleted_at').in('id', projectIds)
  : { data: [] };
const projById = new Map((projRows ?? []).map((p: any) => [p.id, p]));

const { ready, reviews } = await listReviews(supabase, { personId: id });
const reviewerIds = [...new Set(reviews.map((r) => r.reviewer_id).filter(Boolean))] as string[];
const { data: reviewerRows } = reviewerIds.length
  ? await supabase.from('people').select('id,full_name').in('id', reviewerIds)
  : { data: [] };
const names = new Map<string, string>((reviewerRows ?? []).map((r: any) => [r.id, r.full_name]));

const done = (p: any) => Boolean(p?.archived_at) || (p?.phase === 'journal' && p?.stage === 'published');
const overall = average(reviews, 'overall');
const againCount = { yes: 0, maybe: 0, no: 0 };
for (const r of reviews) if (r.work_again) againCount[r.work_again]++;
const initials = m.full_name.split(/\s+/).filter(Boolean).map((w: string) => w[0]).slice(0, 2).join('').toUpperCase();
const status = m.flag_status !== 'none' ? m.flag_status.replace('_', ' ') : m.open_to_assignment ? 'Available' : 'Unavailable';

// ---------------------------------------------------------------- membership
const { ready: msReady, rows: msRows } = await loadMemberships(supabase);
const ms: MemberRow | null = msRows.find((r) => r.person_id === id) ?? null;
let log: LogRow[] = [];
let activity: { at: string; label: string; project_id: string | null }[] = [];
if (ms) {
  const [{ data: logRows }, { data: actRows }] = await Promise.all([
    supabase.from('membership_log').select('id,person_id,kind,at,by_id,term_number,emailed,subject,body').eq('person_id', id).order('at', { ascending: false }),
    supabase.rpc('member_recent_activity', { p_person: id, p_limit: 8 }),
  ]);
  log = (logRows ?? []) as LogRow[];
  activity = (actRows ?? []) as any[];
}
const byIds = [...new Set(log.map((l) => l.by_id).filter(Boolean))] as string[];
const { data: byRows } = byIds.length ? await supabase.from('people').select('id,full_name').in('id', byIds) : { data: [] };
const byName = new Map<string, string>((byRows ?? []).map((r: any) => [r.id, r.full_name]));

const day = ms ? dayNumber(ms.member_since) : null;
const termDay = ms ? dayNumber(ms.term_started_on) : null;
const inactiveLong = ms && ms.next_step !== null;
const stepNo = ms?.next_step ? NOTICE_ORDER.indexOf(ms.next_step) + 1 : 0;
const reviewOpen = Boolean(ms && ms.review_due && ms.membership_status === 'active');
const ended = ms && ms.membership_status !== 'active';

// Work for the term review: everything they're on, ideas, and this term's reviews.
let roleProjects: any[] = [];
let ideas: { title: string; status: string; submitted_at: string }[] = [];
if (ms) {
  const { data: rp } = await supabase
    .from('projects')
    .select('id')
    .is('deleted_at', null)
    .or(`lead_id.eq.${id},colead_id.eq.${id},analyst_id.eq.${id},presenter_id.eq.${id},corresponding_id.eq.${id},team_member_ids.cs.{${id}}`);
  const ids = (rp ?? []).map((r: any) => r.id).filter((x: string) => !projectIds.includes(x));
  if (ids.length) {
    const { data } = await supabase.from('project_list').select('id,ref,title,phase,stage,stage_label,lead_name,archived_at').in('id', ids);
    roleProjects = data ?? [];
  }
  const { data: ideaRows } = await supabaseAdmin()
    .from('ideas')
    .select('status,submitted_at,payload')
    .eq('payload->>leadEmail', String(m.email).toLowerCase())
    .order('submitted_at', { ascending: false });
  ideas = (ideaRows ?? []).map((r: any) => ({ title: r.payload?.title ?? 'Untitled idea', status: r.status, submitted_at: r.submitted_at }));
}
const termStart = ms?.term_started_on ?? '';
const reviewsThisTerm = termStart ? reviews.filter((r) => r.created_at.slice(0, 10) >= termStart) : [];
const newThisTerm = termStart ? (pmRows ?? []).filter((pm: any) => String(pm.assigned_at).slice(0, 10) >= termStart).length : 0;
const nextStart = ms ? nextTermStart(ms) : '';
---

<AppLayout title={`${m.full_name} - progress`} user={me} active="mentees">
  <div class="adm mp">
    <a class="mp__back" href="/admin/mentees">&larr; All mentees</a>

    <header class="mp__head">
      <span class="mp__avatar" aria-hidden="true">{initials}</span>
      <div class="mp__id">
        <h1 class="mp__name">{m.full_name}</h1>
        <p class="mp__meta">
          <a href={`mailto:${m.email}`}>{m.email}</a>
          {affiliation && <span>{affiliation}</span>}
        </p>
        <p class="mp__meta">
          <span class:list={['mp__status', m.flag_status !== 'none' && 'is-flag']}>{status}</span>
          {(m.expertise ?? []).length > 0 && <span>{(m.expertise ?? []).join(', ')}</span>}
        </p>
        {m.flag_status !== 'none' && m.flag_reason && <p class="mp__flag">Reason: {m.flag_reason}</p>}
      </div>
    </header>

    {flashOk && <div class="adm-flash adm-flash--ok" role="status"><p>{flashOk}</p></div>}
    {flashErr && <div class="adm-flash adm-flash--error" role="alert"><p>{flashErr}</p></div>}

    {!msReady && (
      <div class="adm-flash adm-flash--error">
        <p>Membership tracking isn't switched on yet. Run <code>mca-pipeline/add-membership.sql</code> in the Supabase SQL editor, then reload.</p>
      </div>
    )}

    {ms && (
      <section class="ms" id="membership" aria-label="Membership">
        <div class="ms__facts">
          <div class="ms__fact">
            <span class="ms__k">{ended ? 'Membership' : 'In the lab'}</span>
            <b class="ms__big">{ended ? STATUS_LABEL[ms.membership_status] : `Day ${day}`}</b>
            <span class="ms__s">{ended ? `Ended ${longDate(ms.ended_on)}` : `Joined ${longDate(ms.member_since)}`}</span>
          </div>
          <div class="ms__fact">
            <span class="ms__k">Term {ms.term_number}</span>
            <b class="ms__big">{ended ? '-' : `Day ${termDay}`}</b>
            <span class="ms__s">{shortDate(ms.term_started_on)} to {shortDate(ms.term_ends_on)}</span>
          </div>
          <div class="ms__fact">
            <span class="ms__k">Term review</span>
            <b class:list={['ms__big', reviewOpen && 'is-due']}>{ended ? '-' : reviewOpen ? 'Due now' : shortDate(ms.review_due_on)}</b>
            <span class="ms__s">Six months and five days into the term</span>
          </div>
          <div class="ms__fact">
            <span class="ms__k">Last active</span>
            <b class:list={['ms__big', inactiveLong && 'is-due']}>{ms.days_inactive === null ? '-' : ms.days_inactive === 0 ? 'Today' : `${ms.days_inactive} day${ms.days_inactive === 1 ? '' : 's'} ago`}</b>
            <span class="ms__s">{ms.last_active_label ?? 'Nothing recorded'}</span>
          </div>
        </div>

        {inactiveLong && ms.next_step && (
          <div class="ms__due">
            <div class="ms__due-head">
              <h2 class="ms__h">No activity for {ms.days_inactive} days</h2>
              <ol class="ms__steps" aria-label="Inactivity steps">
                {NOTICE_ORDER.map((st, n) => (
                  <li class:list={['ms__step', n + 1 < stepNo && 'is-done', n + 1 === stepNo && 'is-now']}>
                    {['First warning', 'Second warning', 'Explanation', 'Removal'][n]}
                  </li>
                ))}
              </ol>
              <p class="ms__p">
                {ms.notice_stage
                  ? `${LOG_LABEL[ms.notice_stage]} on ${longDate(ms.notice_sent_at)}. The next step is below. Any new activity, or marking them active, stops this.`
                  : 'Their last recorded activity was more than three months ago. You can send them a first warning.'}
              </p>
            </div>
            {(() => {
              const e = emailFor(ms.next_step as EmailStep, ms, log);
              return (
                <MembershipComposer
                  personId={id}
                  step={ms.next_step!}
                  to={`${ms.full_name} <${ms.email}>`}
                  subject={e.subject}
                  body={e.body}
                  sendLabel={STEP_ACTION[ms.next_step as EmailStep]}
                  confirmText={ms.next_step === 'removal'
                    ? `Remove ${ms.full_name} from the lab and send this email? They will be taken off the list of active collaborators.`
                    : `Send this email to ${ms.full_name} now?`}
                  danger={ms.next_step === 'removal'}
                />
              );
            })()}
          </div>
        )}

        {reviewOpen && (
          <div class="ms__due">
            <div class="ms__due-head">
              <h2 class="ms__h">Term {ms.term_number} review</h2>
              <p class="ms__p">Their term ran from {longDate(ms.term_started_on)} to {longDate(ms.term_ends_on)}. Look over their work, then renew them for six more months or end their membership.</p>
            </div>

            <div class="ms__work">
              <div class="ms__tally">
                <div><b>{projectIds.length + roleProjects.length}</b><span>projects in total</span></div>
                <div><b>{newThisTerm}</b><span>joined this term</span></div>
                <div><b>{ideas.length}</b><span>idea{ideas.length === 1 ? '' : 's'} submitted</span></div>
                <div><b>{reviewsThisTerm.length ? average(reviewsThisTerm, 'overall') : '-'}</b><span>{reviewsThisTerm.length} lead review{reviewsThisTerm.length === 1 ? '' : 's'} this term</span></div>
              </div>
              <div class="ms__lists">
                <div>
                  <h3 class="ms__h3">Projects</h3>
                  {projectIds.length + roleProjects.length === 0 && <p class="ms__empty">Not on any project.</p>}
                  <ul class="ms__ul">
                    {(pmRows ?? []).map((pm: any) => {
                      const p: any = projById.get(pm.project_id);
                      return p && <li><a href={`/pipeline/projects/${p.id}`}>{p.ref}</a> {p.title}<span class="ms__tag">{done(p) ? 'Completed' : p.stage_label ?? ''}</span></li>;
                    })}
                    {roleProjects.map((p: any) => (
                      <li><a href={`/pipeline/projects/${p.id}`}>{p.ref}</a> {p.title}<span class="ms__tag">{done(p) ? 'Completed' : p.stage_label ?? ''}</span></li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h3 class="ms__h3">Ideas</h3>
                  {ideas.length === 0 && <p class="ms__empty">No ideas submitted.</p>}
                  <ul class="ms__ul">
                    {ideas.map((i) => <li>{i.title}<span class="ms__tag">{i.status === 'approved' ? 'Approved' : i.status === 'declined' ? 'Declined' : i.status === 'withheld' ? 'On hold' : 'Pending'} · {shortDate(i.submitted_at)}</span></li>)}
                  </ul>
                  <h3 class="ms__h3">Recent activity</h3>
                  {activity.length === 0 && <p class="ms__empty">Nothing recorded.</p>}
                  <ul class="ms__ul">
                    {activity.map((a) => <li>{a.label}<span class="ms__tag">{shortDate(a.at)}</span></li>)}
                  </ul>
                </div>
              </div>
            </div>

            <div class="ms__choice" role="group" aria-label="Decision">
              <button type="button" class="ms__pick is-on" data-ms-pick="renewal" aria-pressed="true">Renew for 6 months</button>
              <button type="button" class="ms__pick" data-ms-pick="departure" aria-pressed="false">End membership</button>
            </div>
            {(['renewal', 'departure'] as const).map((st) => {
              const e = emailFor(st, ms, log);
              return (
                <div class="ms__pane" data-ms-pane={st} hidden={st !== 'renewal'}>
                  <p class="ms__p">{st === 'renewal'
                    ? `The new term will run from ${longDate(nextStart)} to ${longDate(addSixMonths(nextStart))}.`
                    : 'They will be marked as finished and taken off the list of active collaborators.'}</p>
                  <MembershipComposer
                    personId={id}
                    step={st}
                    to={`${ms.full_name} <${ms.email}>`}
                    subject={e.subject}
                    body={e.body}
                    sendLabel={STEP_ACTION[st]}
                    optionalEmail={st === 'renewal'}
                    confirmText={st === 'renewal'
                      ? `Renew ${ms.full_name} for six months?`
                      : `End ${ms.full_name}'s membership and send this email?`}
                    danger={st === 'departure'}
                  />
                </div>
              );
            })}
          </div>
        )}

        <div class="ms__more">
          {!ended && (
            <details class="ms__mini">
              <summary>Mark as active</summary>
              <form method="post" class="ms__note">
                <input type="hidden" name="action" value="member-step" />
                <input type="hidden" name="kind" value="note" />
                <input type="hidden" name="personId" value={id} />
                <label class="ms__label" for="ms-note">What have they been doing? This restarts the three-month count.</label>
                <textarea id="ms-note" name="note" rows="2" maxlength="500" required placeholder="For example: helping with screening on P123, discussed on WhatsApp"></textarea>
                <button class="btn" type="submit">Mark as active</button>
              </form>
            </details>
          )}
          {ended && (
            <form method="post" class="ms__restore" onsubmit={`return confirm('Restore ${ms.full_name.replace(/'/g, '')} as an active member? A new six-month term starts today. No email is sent.')`}>
              <input type="hidden" name="action" value="member-step" />
              <input type="hidden" name="kind" value="restore" />
              <input type="hidden" name="personId" value={id} />
              <button class="btn" type="submit">Restore membership</button>
            </form>
          )}
        </div>

        {log.length > 0 && (
          <div class="ms__log">
            <h3 class="ms__h3">History</h3>
            <ul class="ms__history">
              {log.map((l) => (
                <li>
                  <details>
                    <summary>
                      <span class="ms__when">{shortDate(l.at)}</span>
                      <span class="ms__what">{LOG_LABEL[l.kind]}{l.kind === 'renewal' && !l.emailed ? ' (no email)' : ''}</span>
                      <span class="ms__who">{l.by_id ? byName.get(l.by_id) ?? '' : ''}</span>
                    </summary>
                    {l.subject && <p class="ms__subj">{l.subject}</p>}
                    {l.body && <p class="ms__body">{l.body}</p>}
                  </details>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}

    {!ready && (
      <div class="adm-flash adm-flash--error">
        <p>Reviews aren't switched on yet. Run <code>mca-pipeline/add-mentee-reviews.sql</code> in the Supabase SQL editor, then reload.</p>
      </div>
    )}

    <section class="mp__stats" aria-label="Summary">
      <div class="mp__stat"><b>{projectIds.length}</b><span>project{projectIds.length === 1 ? '' : 's'}</span></div>
      <div class="mp__stat"><b>{(projRows ?? []).filter(done).length}</b><span>completed</span></div>
      <div class="mp__stat"><b>{reviews.length}</b><span>review{reviews.length === 1 ? '' : 's'}</span></div>
      <div class="mp__stat"><b>{overall ?? '-'}</b><span>average overall</span></div>
    </section>

    {reviews.length > 0 && (
      <section class="adm-panel mp__scores">
        <h2 class="adm-panel__title">Scores across all reviews</h2>
        <dl class="mp__bars">
          {([['overall', 'Overall'], ...SCORE_FIELDS] as const).map(([f, label]) => {
            const a = average(reviews, f as any);
            return (
              <div class="mp__bar">
                <dt>{label}</dt>
                <dd>
                  <span class="mp__track"><span class="mp__fill" style={`width:${a ? (a / 5) * 100 : 0}%`}></span></span>
                  <b>{a ?? 'Not rated'}{a ? ' / 5' : ''}</b>
                </dd>
              </div>
            );
          })}
        </dl>
        <p class="mp__again">
          Would work with them again: <b>{againCount.yes}</b> yes · <b>{againCount.maybe}</b> maybe · <b>{againCount.no}</b> no
          <span class="mp__latest">Latest review {fmtReviewDate(reviews[0].created_at)}</span>
        </p>
      </section>
    )}

    <section class="mp__projects">
      <h2 class="mp__h2">Projects</h2>
      {projectIds.length === 0 && <p class="adm-hint">Not on any project yet. Assign one from the Mentees page.</p>}
      {(pmRows ?? []).map((pm: any) => {
        const p: any = projById.get(pm.project_id);
        const theirs = reviews.filter((r) => r.project_id === pm.project_id);
        return (
          <article class="mp__proj">
            <div class="mp__proj-head">
              <a class="mp__proj-title" href={`/pipeline/projects/${pm.project_id}`}>{p ? `${p.ref} - ${p.title}` : 'Project no longer available'}</a>
              <span class="mp__proj-meta">
                {p?.stage_label && <span>{p.stage_label}</span>}
                {p?.lead_name && <span>Lead: {p.lead_name}</span>}
                <span>Assigned {fmtReviewDate(pm.assigned_at)}</span>
                {done(p) && <span class="mp__done">Completed</span>}
              </span>
            </div>
            {theirs.length
              ? <MenteeReviewList reviews={theirs} names={names} viewerId={me.id} isAdmin={true} returnTo={here} />
              : <p class="adm-hint mp__none">No reviews on this project yet. <a href={`/pipeline/projects/${pm.project_id}#mentees`}>Add one on the paper's page</a>.</p>}
          </article>
        );
      })}
    </section>
  </div>
</AppLayout>

<script>
  // Term review: switch between the renewal and departure emails.
  const picks = [...document.querySelectorAll<HTMLButtonElement>('[data-ms-pick]')];
  const panes = [...document.querySelectorAll<HTMLElement>('[data-ms-pane]')];
  picks.forEach((b) => b.addEventListener('click', () => {
    picks.forEach((x) => { const on = x === b; x.classList.toggle('is-on', on); x.setAttribute('aria-pressed', String(on)); });
    panes.forEach((pn) => { pn.hidden = pn.dataset.msPane !== b.dataset.msPick; });
  }));
</script>

<style>
  /* ---------- membership ---------- */
  .ms { margin-bottom: var(--space-m); display: grid; gap: 1rem; scroll-margin-top: 90px; }
  .ms__facts { display: grid; grid-template-columns: repeat(4, 1fr); background: var(--bg-tint); }
  .ms__fact { padding: 0.9rem 1rem; display: grid; gap: 3px; align-content: start; min-width: 0; }
  .ms__k { font-size: 0.76rem; font-weight: 700; color: var(--text-muted); }
