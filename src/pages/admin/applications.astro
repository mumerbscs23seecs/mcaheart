---
import AppLayout from '../../layouts/AppLayout.astro';
import EmailChips from '../../components/EmailChips.astro';
import { COPY_SUGGESTIONS, emailsFrom } from '../../lib/copy-suggestions';
import { supabaseAdmin } from '../../lib/supabase';
import '../../styles/admin.css';
import { currentUser } from '../../lib/auth';
import { getPipelineSession } from '../../lib/pipeline-auth';
import {
  listApplications, getApplication, decideApplication,
  listVotes, castVote, reviewerFor, scoreVotes, REVIEWERS,
  type Vote, type VoteSet,
} from '../../lib/applications';
import { deliverApplicationDecision, renderApplicationDecisionEmail } from '../../lib/recruitment-mailer';
import ListFilter from '../../components/ListFilter.astro';
import { SKILLS, skillsFromApplication } from '../../lib/skills';

export const prerender = false;

const me = currentUser(Astro.cookies);
if (!me) return Astro.redirect('/login', 302);
if (me.role !== 'admin') return Astro.redirect('/pipeline', 302);

// An approved applicant becomes a real mentee in the pipeline's people
// table - bridge a session the same way admin/ideas.astro does.
const session = await getPipelineSession(Astro.request, Astro.cookies);
const supabase = session?.supabase ?? null;

// The skills a new mentee starts with (they can change them later in their
// profile). Pre-ticked from what the applicant picked on the Join form.
const EXPERTISE_TAGS = SKILLS;
const guessExpertiseTags = (freeText: string): string[] => skillsFromApplication(freeText);

type Flash = { tone: 'ok' | 'error'; text: string };
type Decision = 'approved' | 'withheld' | 'declined';
type Preview = {
  appId: string;
  decision: Decision;
  note: string;
  to: string;
  subject: string;
  html: string;
  expertiseTags: string[];
  cc: string[];
  bcc: string[];
};
let flash: Flash | null = null;
let preview: Preview | null = null;
// Many decisions at once: the review screen, then what happened to each.
type BatchItem = { appId: string; name: string; decision: Decision; to: string; subject: string; html: string; note: string; tags: string[] };
let batch: { items: BatchItem[]; cc: string[]; bcc: string[]; skipped: string[] } | null = null;
let batchResults: { name: string; tone: 'ok' | 'error'; text: string }[] | null = null;
const BATCH_MAX = 25;
// Which application to show expanded after a POST, so a vote doesn't collapse it.
let openId = '';

// Jawad / Burhan (either of their logins), or null for any other admin.
const myReviewer = reviewerFor(me.email);
const VOTE_LABEL: Record<Vote, string> = { accept: 'Accept', withhold: 'Withhold', reject: 'Reject' };
const RESULT_LABEL = { approved: 'Accept', withheld: 'Withhold', declined: 'Reject' } as const;
const STATUS_DONE: Record<Decision, string> = { approved: 'Accepted', withheld: 'On hold', declined: 'Rejected' };

// Votes need mca-pipeline/add-application-votes.sql. Until it's run, the page
// falls back to the old single-click decision so nothing breaks.
async function loadVotes(): Promise<{ ready: boolean; map: Map<string, VoteSet> }> {
  try {
    return { ready: true, map: await listVotes() };
  } catch {
    return { ready: false, map: new Map() };
  }
}

const decisionFromAction = (action: string): Decision =>
  action.includes('approve') ? 'approved' : action.includes('withhold') ? 'withheld' : 'declined';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  let action = String(form.get('action') ?? '');
  const appId = String(form.get('appId') ?? '');
  const note = String(form.get('note') ?? '');
  const decision: Decision =
    (['approved', 'withheld', 'declined'] as const).find((d) => d === form.get('decision')) ??
    decisionFromAction(action);

  openId = appId;

  if (action === 'vote') {
    const vote = String(form.get('vote') ?? '') as Vote;
    if (!myReviewer) flash = { tone: 'error', text: 'Only Jawad and Burhan vote on applications.' };
    else if (!['accept', 'withhold', 'reject'].includes(vote)) flash = { tone: 'error', text: 'Pick Accept, Withhold or Reject.' };
    else {
      const r = await castVote(appId, myReviewer, vote, String(form.get('vote_note') ?? ''), me.email);
      flash = r.ok
        ? { tone: 'ok', text: `Voted ${VOTE_LABEL[vote]}. You can change it until the decision is sent.` }
        : { tone: 'error', text: r.error ?? 'Could not record your vote.' };
    }
  }

  // --- Many votes at once (Jawad / Burhan) ---------------------------------------
  if (action === 'batch-vote') {
    if (!myReviewer) flash = { tone: 'error', text: 'Only Jawad and Burhan vote on applications.' };
    else {
      let wanted: Record<string, string> = {};
      try { wanted = JSON.parse(String(form.get('votes') ?? '{}')); } catch { wanted = {}; }
      const current = (await loadVotes()).map;
      let saved = 0;
      const problems: string[] = [];
      for (const [id, v] of Object.entries(wanted).slice(0, 200)) {
        if (!['accept', 'withhold', 'reject'].includes(v)) continue;
        const keepNote = current.get(id)?.[myReviewer]?.note ?? '';
        const r = await castVote(id, myReviewer, v as Vote, keepNote, me.email);
        if (r.ok) saved++;
        else problems.push(r.error ?? 'could not save');
      }
      flash = problems.length
        ? { tone: 'error', text: `Saved ${saved} vote${saved === 1 ? '' : 's'}. ${problems.length} could not be saved: ${[...new Set(problems)].join('; ')}` }
        : { tone: 'ok', text: `Saved ${saved} vote${saved === 1 ? '' : 's'}.` };
    }
    action = '';
  }

  // --- Many decision emails at once: review screen, then send ------------------
  if (action === 'batch-preview' || action === 'batch-confirm') {
    const ids = [...new Set(form.getAll('ids').map(String))].slice(0, BATCH_MAX);
    const { ready, map } = await loadVotes();
    const items: BatchItem[] = [];
    const skipped: string[] = [];
    for (const id of ids) {
      const app = await getApplication(id);
      if (!app) { skipped.push('an application that no longer exists'); continue; }
      if (app.status !== 'pending') { skipped.push(`${app.name} (already ${app.status})`); continue; }
      const result = ready ? scoreVotes(map.get(id)) : null;
      if (!result) { skipped.push(`${app.name} (both votes needed)`); continue; }
      const itemNote = String(form.get(`note-${id}`) ?? '');
      const submittedTags = form.getAll(`expertise-${id}`).map(String);
      const tags = action === 'batch-preview' && !form.has(`tags-set-${id}`) ? guessExpertiseTags(app.expertise) : submittedTags;
      const { subject, html } = renderApplicationDecisionEmail({ to: app.email, name: app.name, decision: result.decision, note: itemNote.trim() || null });
      items.push({ appId: id, name: app.name, decision: result.decision, to: app.email, subject, html, note: itemNote, tags });
    }
    if (action === 'batch-preview') {
      if (!items.length) flash = { tone: 'error', text: skipped.length ? `Nothing to send: ${skipped.join(', ')}.` : 'Tick at least one applicant to send.' };
      else batch = { items, cc: emailsFrom(form, 'cc'), bcc: emailsFrom(form, 'bcc'), skipped };
    } else {
      const cc = emailsFrom(form, 'cc');
      const bcc = emailsFrom(form, 'bcc');
      batchResults = skipped.map((name) => ({ name, tone: 'error' as const, text: 'Skipped' }));
      for (const it of items) {
        const result = await decideApplication(it.appId, it.decision, me.name, it.note);
        if (!result.ok || !result.application) {
          batchResults.push({ name: it.name, tone: 'error', text: result.error ?? 'Could not record the decision. Nothing was sent.' });
          continue;
        }
        const app = result.application;
        let emailed = true;
        try {
          await deliverApplicationDecision({ to: app.email, name: app.name, decision: it.decision, note: app.decisionNote, cc, bcc });
        } catch (err) {
          emailed = false;
          console.error('[applications] batch decision email failed:', err);
        }
        let menteeNote = '';
        if (it.decision === 'approved') {
          if (!supabase) menteeNote = ' Add them as a mentee by hand (database not reachable).';
          else {
            const { error: mentErr } = await supabase.rpc('add_mentee', { p_full_name: app.name, p_email: app.email, p_expertise: it.tags });
            if (mentErr) menteeNote = ` Could not add them as a mentee: ${mentErr.message}`;
          }
        }
        const verb = it.decision === 'approved' ? 'Approved' : it.decision === 'withheld' ? 'Withheld' : 'Declined';
        batchResults.push(emailed
          ? { name: it.name, tone: menteeNote ? 'error' : 'ok', text: `${verb}, email sent to ${app.email}.${menteeNote}` }
          : { name: it.name, tone: 'error', text: `${verb} and recorded, but the email to ${app.email} could not be sent - send it by hand.${menteeNote}` });
      }
    }
    action = '';
  }

  // Once votes are in use, the decision has to be the one the two votes add up to.
  if (action.startsWith('preview-') || action === 'confirm') {
    const { ready, map } = await loadVotes();
    const result = ready ? scoreVotes(map.get(appId)) : null;
    if (ready && !result) {
      flash = { tone: 'error', text: 'Both Jawad and Burhan need to vote before a decision can be sent.' };
      action = '';
    } else if (result && result.decision !== decision) {
      flash = { tone: 'error', text: `The votes add up to ${RESULT_LABEL[result.decision]}, so that is the decision to send.` };
      action = '';
    }
  }

  if (action === 'preview-approve' || action === 'preview-withhold' || action === 'preview-decline') {
    const app = await getApplication(appId);
    if (!app) flash = { tone: 'error', text: 'Application not found.' };
    else if (app.status !== 'pending') flash = { tone: 'error', text: `That application was already ${app.status}.` };
    else {
      const { subject, html } = renderApplicationDecisionEmail({
        to: app.email,
        name: app.name,
        decision,
        note: note.trim() || null,
      });
      const submittedTags = form.getAll('expertise').map(String);
      const expertiseTags = submittedTags.length ? submittedTags : guessExpertiseTags(app.expertise);
      preview = { appId, decision, note, to: app.email, subject, html, expertiseTags, cc: emailsFrom(form, 'cc'), bcc: emailsFrom(form, 'bcc') };
    }
  }

  if (action === 'confirm') {
    const result = await decideApplication(appId, decision, me.name, note);
    if (!result.ok || !result.application) {
      flash = { tone: 'error', text: result.error ?? 'Could not record that decision.' };
    } else {
      const app = result.application;
      let emailed = true;
      try {
        await deliverApplicationDecision({
          to: app.email, name: app.name, decision, note: app.decisionNote,
          cc: emailsFrom(form, 'cc'), bcc: emailsFrom(form, 'bcc'),
        });
      } catch (err) {
        emailed = false;
        console.error('[applications] decision email failed:', err);
      }
      let menteeNote = '';
      if (decision === 'approved') {
        if (!supabase) {
          menteeNote = ' Could not reach the pipeline database - add them as a mentee by hand.';
        } else {
          const tags = form.getAll('expertise').map(String);
          const { error: mentErr } = await supabase.rpc('add_mentee', {
            p_full_name: app.name,
            p_email: app.email,
            p_expertise: tags,
          });
          if (mentErr) menteeNote = ` Added, but could not add them as a mentee: ${mentErr.message}`;
        }
      }
      const verb = decision === 'approved' ? 'Approved' : decision === 'withheld' ? 'Withheld' : 'Declined';
      flash = emailed
        ? { tone: 'ok', text: `${verb} - email sent to ${app.email}.${menteeNote}` }
        : { tone: 'error', text: `${verb} and recorded, but the email to ${app.email} could not be sent.${menteeNote}` };
    }
  }
}

let apps: Awaited<ReturnType<typeof listApplications>> = [];
let dbReady = false;
let dbError = '';
try {
  apps = await listApplications();
  dbReady = true;
} catch (err) {
  dbError = err instanceof Error ? err.message : 'Could not load applications.';
}
const pending = apps.filter((a) => a.status === 'pending').length;
const { ready: votesReady, map: votes } = await loadVotes();
const voteCount = (id: string) => REVIEWERS.filter((r) => votes.get(id)?.[r.key]).length;

const fmtDate = (t: number | null) =>
  t ? new Date(t).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : '-';
const ago = (t: number) => {
  const d = Math.floor((Date.now() - t) / 86_400_000);
  return d === 0 ? 'today' : d === 1 ? 'yesterday' : `${d} days ago`;
};

const detailRows = (a: (typeof apps)[number]): Array<[string, string]> => [
  ['Email', a.email],
  ['WhatsApp', a.whatsapp],
  ['Graduated medical school', a.gradYear],
  ['Current status', a.jobStatus],
  ['Cardiology fellowship plan', a.fellowshipPlan],
  ['Main research expertise', a.expertise],
  ['Profile link', a.profileLink],
  ['Research experience', a.researchExperience],
  ['Letter of interest', a.letterOfInterest],
  ['Current job / academic status', a.currentStatus || '-'],
  ['Professional goals', a.professionalGoals || '-'],
  ['Internal reference / prior collaboration', a.internalRef || '-'],
  ['How they heard about MCA', a.referralSource],
];

// CC / BCC suggestions for the decision email: everyone active with a real email.
const { data: rosterRows } = await supabaseAdmin().from('people').select('full_name,email').eq('active', true).order('full_name');
const copyRoster = (rosterRows ?? []).filter((r: any) => r.email && !r.email.endsWith('@import.invalid'));
---

<AppLayout title="Applicants" heading="Lab applicants" user={me} active="applicants">
  <div class="adm">
    {flash && (
      <div class:list={['adm-flash', `adm-flash--${flash.tone}`]} role="status">
        <p>{flash.text}</p>
      </div>
    )}

    {!dbReady && (
      <div class="adm-flash adm-flash--error">
        <p>
          Applications storage isn't set up yet. Run <code>mca-pipeline/add-forms-storage.sql</code> in the
          Supabase SQL editor, then reload this page.
          {dbError && <><br /><span class="adm-hint">({dbError})</span></>}
        </p>
      </div>
    )}

    {batchResults && (
      <section class="bres" aria-label="What happened">
        <h2 class="bres__title">Decisions sent</h2>
        <ul class="bres__list">
          {batchResults.map((r) => (
            <li class:list={['bres__item', `bres__item--${r.tone}`]}><b>{r.name}</b> {r.text}</li>
          ))}
        </ul>
      </section>
    )}

    {dbReady && batch && (
      <form method="post" class="bprev" data-bprev>
        <h2 class="mailprev__title">Review {batch.items.length} decision email{batch.items.length === 1 ? '' : 's'}</h2>
        <p class="adm-hint">Nothing has been sent yet. Check each email, add comments if you like, then send them all.</p>
        {batch.skipped.length > 0 && <p class="adm-hint">Left out: {batch.skipped.join(', ')}.</p>}
        <div class="mailprev__copy">
          <EmailChips name="cc" label="CC (every email)" initial={batch.cc} listId="copy-roster" recommended={COPY_SUGGESTIONS} />
          <EmailChips name="bcc" label="BCC (every email)" initial={batch.bcc} listId="copy-roster" recommended={COPY_SUGGESTIONS} />
          <datalist id="copy-roster">
            {copyRoster.map((r: any) => <option value={r.email}>{r.full_name}</option>)}
          </datalist>
        </div>
        <ol class="bprev__list">
          {batch.items.map((it) => (
            <li class="bprev__item">
              <input type="hidden" name="ids" value={it.appId} />
              <input type="hidden" name={`tags-set-${it.appId}`} value="1" />
              <div class="bprev__head">
                <span class:list={['idea__pill', `idea__pill--${it.decision}`]}>{it.decision === 'approved' ? 'Accept' : it.decision === 'withheld' ? 'Withhold' : 'Reject'}</span>
                <b>{it.name}</b>
                <span class="bprev__to">{it.to}</span>
              </div>
              <label class="idea__notelabel" for={`bn-${it.appId}`}>Comments to {it.name} (optional)</label>
              <textarea class="idea__note" id={`bn-${it.appId}`} name={`note-${it.appId}`} rows="2">{it.note}</textarea>
              {it.decision === 'approved' && (
                <fieldset class="mentee-tags">
                  <legend class="idea__notelabel">Skills (they can change these later)</legend>
                  <div class="mentee-tags__grid">
                    {EXPERTISE_TAGS.map((tag) => (
                      <label class="mentee-tags__item">
                        <input type="checkbox" name={`expertise-${it.appId}`} value={tag} checked={it.tags.includes(tag)} />
                        {tag}
                      </label>
                    ))}
                  </div>
                </fieldset>
              )}
              <details class="bprev__mail">
                <summary>Show the email · {it.subject}</summary>
                <iframe class="mailprev__frame" srcdoc={it.html} title={`Email to ${it.name}`} sandbox=""></iframe>
              </details>
            </li>
          ))}
        </ol>
        <div class="mailprev__actions bprev__actions">
          <button class="adm-btn" type="submit" name="action" value="batch-preview">Refresh the emails</button>
          <button class="btn idea__approve" type="submit" name="action" value="batch-confirm" data-bprev-send>{batch.items.length === 1 ? 'Send the email' : `Send all ${batch.items.length} emails`}</button>
          <a class="mailprev__cancel" href="/admin/applications">Cancel</a>
        </div>
      </form>
    )}

    {dbReady && !batch && (preview ? (
      <div class="mailprev">
        <h2 class="mailprev__title">
          Preview - {preview.decision === 'approved' ? 'approval' : preview.decision === 'withheld' ? 'hold' : 'decline'} email
        </h2>
        <dl class="mailprev__head">
          <div><dt>To</dt><dd>{preview.to}</dd></div>
          <div><dt>Subject</dt><dd>{preview.subject}</dd></div>
        </dl>

        <iframe class="mailprev__frame" srcdoc={preview.html} title="Email preview" sandbox=""></iframe>

        <form method="post" class="mailprev__form">
          <input type="hidden" name="appId" value={preview.appId} />
          <input type="hidden" name="decision" value={preview.decision} />
          <div class="mailprev__copy">
            <EmailChips name="cc" label="CC" initial={preview.cc} listId="copy-roster" recommended={COPY_SUGGESTIONS} />
            <EmailChips name="bcc" label="BCC" initial={preview.bcc} listId="copy-roster" recommended={COPY_SUGGESTIONS} />
            <datalist id="copy-roster">
              {copyRoster.map((r: any) => <option value={r.email}>{r.full_name}</option>)}
            </datalist>
          </div>
          <label class="idea__notelabel" for="prev-note">Comments to the applicant</label>
          <textarea class="idea__note" id="prev-note" name="note" rows="3"
            placeholder="Add or edit comments, then refresh the preview.">{preview.note}</textarea>

          {preview.decision === 'approved' && (
            <fieldset class="mentee-tags">
              <legend class="idea__notelabel">Skills (they can change these later)</legend>
              <div class="mentee-tags__grid">
                {EXPERTISE_TAGS.map((tag) => (
                  <label class="mentee-tags__item">
                    <input type="checkbox" name="expertise" value={tag} checked={preview.expertiseTags.includes(tag)} />
                    {tag}
                  </label>
                ))}
              </div>
            </fieldset>
          )}

          <div class="mailprev__actions">
            <button class="adm-btn" type="submit"
              name="action" value={`preview-${preview.decision === 'approved' ? 'approve' : preview.decision === 'withheld' ? 'withhold' : 'decline'}`}>
              Refresh preview
            </button>
            <button
              class:list={['btn', preview.decision === 'approved' ? 'idea__approve' : preview.decision === 'withheld' ? 'idea__withhold' : 'btn--red']}
              type="submit" name="action" value="confirm">
              Send email &amp; {preview.decision === 'approved' ? 'approve' : preview.decision === 'withheld' ? 'withhold' : 'decline'}
            </button>
            <a class="mailprev__cancel" href="/admin/applications">Cancel</a>
          </div>
        </form>
      </div>
    ) : (
      <>
    <p class="ideas__count"><strong>{pending}</strong> awaiting review · {apps.length} total</p>

    <ListFilter
      noun="applicants"
      searchLabel="Search name, email or expertise"
      filters={[
        { key: 'status', label: 'Status', options: [
          { value: 'pending', label: 'Pending' }, { value: 'approved', label: 'Approved' },
          { value: 'withheld', label: 'Withheld' }, { value: 'declined', label: 'Declined' },
        ] },
        ...(votesReady ? [{ key: 'votes', label: 'Votes', options: [
          ...(myReviewer ? [{ value: 'mine', label: 'Needs my vote' }] : []),
          { value: 'waiting', label: 'Waiting for a vote' },
          { value: 'ready', label: 'Ready to send' },
        ] }] : []),
      ]}
    />

    {apps.length === 0 && <p class="adm-hint">No applications yet.</p>}

    <div class="ideas__list">
      {apps.map((a) => (
        <details class="idea" open={a.id === openId}
          data-lf-item
          data-lf-text={`${a.name} ${a.email} ${a.expertise} ${a.jobStatus}`.toLowerCase()}
          data-lf-status={a.status}
          data-lf-votes={a.status !== 'pending' || !votesReady ? '' : [
            scoreVotes(votes.get(a.id)) ? 'ready' : 'waiting',
            myReviewer && !votes.get(a.id)?.[myReviewer] ? 'mine' : '',
          ].filter(Boolean).join(' ')}
          data-lf-days={Math.floor((Date.now() - a.submittedAt) / 86_400_000)}>
          <summary class="idea__summary ar">
            <span class="idea__title">{a.name}</span>
            <span class="idea__meta">
              {a.jobStatus} · {a.expertise} · {ago(a.submittedAt)}
            </span>
            <span class="ar__side">
              {a.status !== 'pending' && (
                <span class:list={['ar__status', `ar__status--${a.status}`]}>{STATUS_DONE[a.status as Decision]}</span>
              )}
              {a.status === 'pending' && votesReady && (() => {
                const v = votes.get(a.id) ?? {};
                const result = scoreVotes(v);
                const mine = myReviewer ? v[myReviewer]?.vote : undefined;
                const other = REVIEWERS.find((r) => r.key !== myReviewer);
                return (
                  <span class="quick" data-quick data-app={a.id}>
                    {myReviewer && (
                      <span class="quick__votes" role="group" aria-label={`Your vote for ${a.name}`} data-quick-votes data-current={mine ?? ''}>
                        {(['accept', 'withhold', 'reject'] as Vote[]).map((opt) => (
                          <button type="button" class:list={['quick__vote', `quick__vote--${opt}`, mine === opt && 'is-on']} data-vote={opt} aria-pressed={mine === opt ? 'true' : 'false'}>{VOTE_LABEL[opt]}</button>
                        ))}
                      </span>
                    )}
                    <span class="quick__info">
                      <span class="quick__state" data-quick-state aria-live="polite">{myReviewer ? (mine ? 'Your vote is saved' : 'Your vote') : `${voteCount(a.id)} of 2 votes`}</span>
                      {myReviewer && other && (
                        <span class="quick__other" data-quick-other>{v[other.key] ? `${other.name.split(' ')[0]} has voted` : `${other.name.split(' ')[0]} has not voted`}</span>
                      )}
                    </span>
                    <span class="quick__result" data-quick-result hidden={!result}>
                      <span class="quick__score" data-quick-score>{result ? `Score ${result.score} of 4: ${RESULT_LABEL[result.decision]}` : ''}</span>
                      <label class="quick__send">
                        <input type="checkbox" data-quick-send value={a.id} />
                        <span>Send the <span data-quick-decision>{result ? RESULT_LABEL[result.decision] : ''}</span> email</span>
                      </label>
                    </span>
                  </span>
                );
              })()}
            </span>
            <span class="idea__chev" aria-hidden="true">▾</span>
          </summary>

          <div class="idea__body">
            <dl class="idea__dl">
              {detailRows(a).map(([k, v]) => (
                <div class="idea__pair"><dt>{k}</dt><dd>{v}</dd></div>
              ))}
              <div class="idea__pair">
                <dt>Documents</dt>
                <dd class="idea__files">
                  {a.cv
                    ? <a href={`/admin/applications/${a.id}/cv`} target="_blank" rel="noopener">CV - {a.cv.filename} ({Math.round(a.cv.size / 1024)} KB)</a>
                    : <span class="adm-tag">no CV on file</span>}
                  {a.headshot
                    ? <a href={`/admin/applications/${a.id}/headshot`} target="_blank" rel="noopener">Headshot - {a.headshot.filename} ({Math.round(a.headshot.size / 1024)} KB)</a>
                    : <span class="adm-tag">no headshot on file</span>}
                </dd>
              </div>
            </dl>

            {a.status === 'pending' && votesReady ? (() => {
              const v = votes.get(a.id) ?? {};
              const result = scoreVotes(v);
              const mine = myReviewer ? v[myReviewer] : undefined;
              const step = result ? (result.decision === 'approved' ? 'approve' : result.decision === 'withheld' ? 'withhold' : 'decline') : '';
              return (
                <div class="vote">
                  <div class="vote__board">
                    {REVIEWERS.map((r) => {
                      const cast = v[r.key];
                      return (
                        <div class="vote__who">
                          <span class="vote__name">{r.key === myReviewer ? `${r.name} (you)` : r.name}</span>
                          {result && cast ? (
                            <span class:list={['vote__tag', `vote__tag--${cast.vote}`]}>{VOTE_LABEL[cast.vote]}</span>
                          ) : r.key === myReviewer && cast ? (
                            <span class:list={['vote__tag', `vote__tag--${cast.vote}`]}>Voted {VOTE_LABEL[cast.vote]}</span>
                          ) : cast ? (
                            <span class="vote__tag vote__tag--done">Voted</span>
                          ) : (
                            <span class="vote__tag vote__tag--waiting">Not voted yet</span>
                          )}
                          {result && cast?.note && <p class="vote__note">“{cast.note}”</p>}
                        </div>
                      );
                    })}
                  </div>

                  {result && (
                    <div class:list={['vote__result', `vote__result--${result.decision}`]}>
                      <p><strong>Score {result.score} of 4: {RESULT_LABEL[result.decision]}</strong></p>
                      <p class="vote__rule">Accept 2, Withhold 1, Reject 0. A total of 3-4 is Accept, 2 is Withhold, 0-1 is Reject.</p>
                    </div>
                  )}

                  {myReviewer && (
                    <form method="post" class="vote__form">
                      <input type="hidden" name="appId" value={a.id} />
                      <input type="hidden" name="action" value="vote" />
                      <label class="idea__notelabel" for={`vnote-${a.id}`}>{mine ? 'Change your vote' : 'Your vote'}</label>
                      <textarea class="idea__note" id={`vnote-${a.id}`} name="vote_note" rows="2"
                        placeholder="Note for the other reviewer (optional, not sent to the applicant)">{mine?.note ?? ''}</textarea>
                      <div class="idea__actions">
                        {(['accept', 'withhold', 'reject'] as Vote[]).map((opt) => (
                          <button
                            class:list={['btn', opt === 'accept' ? 'idea__approve' : opt === 'withhold' ? 'idea__withhold' : 'btn--red', mine && mine.vote !== opt && 'vote__btn--dim']}
                            name="vote" value={opt} type="submit">
                            {mine?.vote === opt ? `✓ ${VOTE_LABEL[opt]}` : VOTE_LABEL[opt]}
                          </button>
                        ))}
                      </div>
                    </form>
                  )}

                  {!myReviewer && !result && (
                    <p class="adm-hint">Waiting for Jawad and Burhan to vote. The decision opens once both have.</p>
                  )}

                  {result && (
                    <form method="post" class="idea__decide">
                      <input type="hidden" name="appId" value={a.id} />
                      <label class="idea__notelabel" for={`note-${a.id}`}>Comments to the applicant (optional)</label>
                      <textarea class="idea__note" id={`note-${a.id}`} name="note" rows="2"
                        placeholder="You'll see the full email before it sends."></textarea>
                      <div class="idea__actions">
                        <button
                          class:list={['btn', result.decision === 'approved' ? 'idea__approve' : result.decision === 'withheld' ? 'idea__withhold' : 'btn--red']}
                          name="action" value={`preview-${step}`} type="submit">
                          {RESULT_LABEL[result.decision]} and preview the email…
                        </button>
                      </div>
                    </form>
                  )}
                </div>
              );
            })() : a.status === 'pending' ? (
              <form method="post" class="idea__decide">
                <input type="hidden" name="appId" value={a.id} />
                <label class="idea__notelabel" for={`note-${a.id}`}>Comments to the applicant (optional)</label>
                <textarea class="idea__note" id={`note-${a.id}`} name="note" rows="2"
                  placeholder="You'll see the full email before it sends."></textarea>
                <div class="idea__actions">
                  <button class="btn idea__approve" name="action" value="preview-approve" type="submit">Approve…</button>
                  <button class="btn idea__withhold" name="action" value="preview-withhold" type="submit">Withhold…</button>
                  <button class="btn btn--red" name="action" value="preview-decline" type="submit">Decline…</button>
                </div>
                <p class="idea__hint-inline">Next step shows the email to review before it's sent.</p>
              </form>
            ) : (
              <div class:list={['idea__decision', `idea__decision--${a.status}`]}>
                <p><strong>{a.status === 'approved' ? 'Approved' : a.status === 'withheld' ? 'Withheld' : 'Declined'}</strong> by {a.reviewedBy} · {fmtDate(a.reviewedAt)}</p>
                {a.decisionNote && <p class="idea__decision-note">“{a.decisionNote}”</p>}
              </div>
            )}
          </div>
        </details>
      ))}
    </div>

    <div class="bbar" data-bbar hidden>
      <form method="post" class="bbar__part" data-bbar-send hidden>
        <input type="hidden" name="action" value="batch-preview" />
        <span data-bbar-send-text></span>
        <span data-bbar-send-ids></span>
        <button class="btn idea__approve" type="submit">Review &amp; send emails</button>
      </form>
    </div>
      </>
    ))}
  </div>
</AppLayout>

<script>
  // Quick votes save straight away. "Send" ticks collect into the bar at the
  // bottom, which opens the review screen for those emails.
  const bar = document.querySelector<HTMLElement>('[data-bbar]');
  const sendForm = bar?.querySelector<HTMLFormElement>('[data-bbar-send]') ?? null;
  const sendText = bar?.querySelector<HTMLElement>('[data-bbar-send-text]') ?? null;
  const sendIds = bar?.querySelector<HTMLElement>('[data-bbar-send-ids]') ?? null;
  const MAX = 25;
  const LABEL: Record<string, string> = { approved: 'Accept', withheld: 'Withhold', declined: 'Reject' };

  // Clicks on the quick controls must not open or close the row.
  document.querySelectorAll<HTMLElement>('[data-quick]').forEach((q) => {
    q.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('label') && t.tagName === 'INPUT') { e.stopPropagation(); return; }
      if (t.closest('label')) { e.preventDefault(); const cb = t.closest('label')!.querySelector('input'); if (cb) { cb.checked = !cb.checked; cb.dispatchEvent(new Event('change', { bubbles: true })); } return; }
      e.preventDefault();
    });
    q.addEventListener('keydown', (e) => { if (e.key === ' ' || e.key === 'Enter') e.stopPropagation(); });
  });

  document.querySelectorAll<HTMLElement>('[data-quick-votes]').forEach((group) => {
    const quick = group.closest<HTMLElement>('[data-quick]')!;
    const app = quick.dataset.app!;
    const state = quick.querySelector<HTMLElement>('[data-quick-state]')!;
    const show = (v: string) => group.querySelectorAll<HTMLButtonElement>('[data-vote]').forEach((x) => {
      x.classList.toggle('is-on', x.dataset.vote === v);
      x.setAttribute('aria-pressed', String(x.dataset.vote === v));
    });
    group.querySelectorAll<HTMLButtonElement>('[data-vote]').forEach((b) => {
      b.addEventListener('click', async () => {
        const v = b.dataset.vote!;
        const before = group.dataset.current ?? '';
        if (v === before || group.classList.contains('is-saving')) return;
        show(v);
        group.classList.add('is-saving');
        state.classList.remove('is-error');
        state.textContent = 'Saving…';
        const fd = new FormData();
        fd.set('appId', app);
        fd.set('vote', v);
        try {
          const res = await fetch('/admin/applications/vote', { method: 'POST', body: fd });
          const out = await res.json().catch(() => ({ ok: false, error: 'The server did not answer.' }));
          if (!out.ok) throw new Error(out.error || 'Could not save your vote.');
          group.dataset.current = v;
          state.textContent = 'Saved';
          setTimeout(() => { if (state.textContent === 'Saved') state.textContent = 'Your vote is saved'; }, 2500);
          // The filter "Needs my vote" no longer applies to this row.
          const item = quick.closest<HTMLElement>('[data-lf-item]');
          if (item) {
            const tags = (item.dataset.lfVotes ?? '').split(' ').filter((t) => t && t !== 'mine' && t !== 'waiting' && t !== 'ready');
            tags.push(out.result ? 'ready' : 'waiting');
            item.dataset.lfVotes = tags.join(' ');
          }
          const result = quick.querySelector<HTMLElement>('[data-quick-result]')!;
          if (out.result) {
            quick.querySelector<HTMLElement>('[data-quick-score]')!.textContent = `Score ${out.result.score} of 4: ${LABEL[out.result.decision]}`;
            quick.querySelector<HTMLElement>('[data-quick-decision]')!.textContent = LABEL[out.result.decision];
            result.hidden = false;
          } else {
            result.hidden = true;
          }
        } catch (err) {
          show(before);
          state.classList.add('is-error');
          state.textContent = err instanceof Error ? err.message : 'Could not save your vote.';
        } finally {
          group.classList.remove('is-saving');
          update();
        }
      });
    });
  });

  document.addEventListener('change', (e) => {
    if ((e.target as HTMLElement).matches?.('[data-quick-send]')) update();
  });
  document.addEventListener('lf:change', update);

  function update() {
    if (!bar || !sendForm || !sendText || !sendIds) return;
    // Only ticked rows that are still visible go to the review screen.
    const ticked = [...document.querySelectorAll<HTMLInputElement>('[data-quick-send]:checked')]
      .filter((cb) => !cb.closest<HTMLElement>('[data-lf-item]')?.hidden && !cb.closest<HTMLElement>('[data-quick-result]')?.hidden);
    sendIds.replaceChildren(...ticked.slice(0, MAX).map((cb) => Object.assign(document.createElement('input'), { type: 'hidden', name: 'ids', value: cb.value })));
    sendText.textContent = ticked.length > MAX
      ? `${ticked.length} ticked - the first ${MAX} go in this batch`
      : `${ticked.length} decision email${ticked.length === 1 ? '' : 's'} ready to send`;
    sendForm.hidden = ticked.length === 0;
    bar.hidden = sendForm.hidden;
  }
  update();

  // The review screen: one click sends, so stop a double submit.
  document.querySelector<HTMLFormElement>('[data-bprev]')?.addEventListener('submit', (e) => {
    const btn = (e as SubmitEvent).submitter as HTMLButtonElement | null;
    if (btn?.hasAttribute('data-bprev-send')) {
      if (!confirm('Send all of these emails now?')) { e.preventDefault(); return; }
      setTimeout(() => { btn.disabled = true; btn.textContent = 'Sending…'; }, 0);
    }
  });
</script>

