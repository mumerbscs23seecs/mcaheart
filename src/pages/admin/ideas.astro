---
import AppLayout from '../../layouts/AppLayout.astro';
import EmailChips from '../../components/EmailChips.astro';
import { COPY_SUGGESTIONS, emailsFrom } from '../../lib/copy-suggestions';
import { supabaseAdmin } from '../../lib/supabase';
import '../../styles/admin.css';
import { currentUser } from '../../lib/auth';
import { getPipelineSession } from '../../lib/pipeline-auth';
import {
  listIdeas, getIdea, decideIdea, listIdeaReviews, saveIdeaReview,
  OUTCOME_LABEL, OUTCOME_STATUS, RECOMMENDATION_LABEL,
  type IdeaOutcome, type IdeaReview, type Recommendation,
} from '../../lib/ideas';
import { reviewerFor, REVIEWERS } from '../../lib/applications';
import { deliverIdeaDecision, renderIdeaDecisionEmail } from '../../lib/idea-mailer';
import { CONFERENCE_LABELS, COMMITMENT_LABELS, type Conference } from '../../lib/idea-schema';
import type { IdeaRecord } from '../../lib/ideas';

export const prerender = false;

const me = currentUser(Astro.cookies);
if (!me) return Astro.redirect('/login', 302);
if (me.role !== 'admin') return Astro.redirect('/pipeline', 302);

// An accepted idea becomes a real Supabase project - bridge a session the
// same way /admin's dashboard does, transparently, from the in-memory login.
const session = await getPipelineSession(Astro.request, Astro.cookies);
const supabase = session?.supabase ?? null;

// The real, dated conference instances an approved idea can be sent to
// (e.g. "TCT 2026") - distinct from the idea form's own conference field,
// which is just a general preference (TCT/SCAI/ACC/flexible/none).
const { data: allConferences } = supabase
  ? await supabase.from('conferences').select('name,abstract_deadline').order('abstract_deadline', { ascending: false })
  : { data: null };
const conferenceOptions: string[] = (allConferences ?? []).map((c: any) => c.name);

/** Best-guess default for the "send to conference" picker - the nearest
 *  upcoming named conference whose series matches what the submitter asked
 *  for (e.g. idea.conference "TCT" -> conference row "TCT 2026"). */
function defaultConferenceFor(idea: IdeaRecord): string {
  if (idea.conference === 'TCT' || idea.conference === 'SCAI' || idea.conference === 'ACC') {
    return conferenceOptions.find((n) => n.toUpperCase().startsWith(idea.conference.toUpperCase())) ?? '';
  }
  return '';
}

/** idea.researchType/databases -> the pipeline's fixed study_type enum. */
function studyTypeFor(idea: IdeaRecord): string {
  if (idea.researchType === 'Meta-analysis') return 'SRMA';
  const dbs = idea.databases ?? [];
  if (dbs.includes('DMC PCI Database')) return 'DMC PCI';
  if (dbs.includes('National Inpatient Sample (NIS)')) return 'NIS';
  if (dbs.includes('TriNetX')) return 'TriNetX';
  if (dbs.includes('National Readmissions Database')) return 'NRD';
  return 'Other';
}

type Flash = { tone: 'ok' | 'error'; text: string };
let flash: Flash | null = null;
// Which idea to show expanded after a POST, so saving a review doesn't collapse it.
let openId = '';

// Jawad / Burhan (either of their logins), or null for any other admin.
const myReviewer = reviewerFor(me.email);
const reviewerName = (k: string) => REVIEWERS.find((r) => r.key === k)?.name ?? k;
const OUTCOMES = Object.keys(OUTCOME_LABEL) as IdeaOutcome[];
const OUTCOME_HINT: Record<IdeaOutcome, string> = {
  approved: 'Adds it to the pipeline and a conference',
  rejected: 'Closes the idea',
  modify: 'Held until the author revises it',
  details: 'Held until the author replies',
};

// Initial reviews need mca-pipeline/add-idea-reviews.sql. Until it's run, the
// review step is skipped and any admin can tick the outcome straight away.
async function loadReviews(): Promise<{ ready: boolean; map: Map<string, IdeaReview[]> }> {
  try {
    return { ready: true, map: await listIdeaReviews() };
  } catch {
    return { ready: false, map: new Map() };
  }
}

/** Why `me` can't make the final decision on this idea yet, or null if they can. */
function decisionBlocked(reviews: IdeaReview[], ready: boolean): string | null {
  if (!ready) return null;
  if (reviews.length === 0) return 'Jawad or Burhan needs to add an initial review first.';
  if (myReviewer && reviews.every((r) => r.reviewer === myReviewer)) {
    const other = REVIEWERS.find((r) => r.key !== myReviewer)!.name;
    return `You wrote the initial review, so ${other} makes the final decision.`;
  }
  return null;
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const ideaId = String(form.get('ideaId') ?? '');
  const note = String(form.get('note') ?? '');
  const conference = String(form.get('conference') ?? '');
  const outcome = OUTCOMES.find((o) => o === form.get('outcome')) ?? null;
  openId = ideaId;

  // --- Step 1: the initial review ---------------------------------------------
  if (action === 'review') {
    const rec = String(form.get('recommendation') ?? '') as Recommendation;
    if (!myReviewer) flash = { tone: 'error', text: 'Only Jawad and Burhan add initial reviews.' };
    else if (!(rec in RECOMMENDATION_LABEL)) flash = { tone: 'error', text: 'Pick Accept, Reject or Modify.' };
    else {
      const r = await saveIdeaReview(ideaId, myReviewer, rec, String(form.get('review_comment') ?? ''), me.email);
      flash = r.ok
        ? { tone: 'ok', text: `Initial review saved (${RECOMMENDATION_LABEL[rec]}). You can change it until the decision is sent.` }
        : { tone: 'error', text: r.error ?? 'Could not save your review.' };
    }
  }

  // --- Step 2: the final decision (previewed live on the page) -------------------
  if (action === 'confirm') {
    const { ready, map } = await loadReviews();
    const blocked = decisionBlocked(map.get(ideaId) ?? [], ready);
    if (blocked) flash = { tone: 'error', text: blocked };
    else if (!outcome) flash = { tone: 'error', text: 'Tick one box for the outcome.' };
    else if (outcome === 'approved' && !conference) {
      flash = { tone: 'error', text: 'Choose which conference to send this to before approving.' };
    }
  }

  if (action === 'confirm' && !flash && outcome) {
    const decision = OUTCOME_STATUS[outcome];
    const result = await decideIdea(ideaId, outcome, me.name, note);
    if (!result.ok || !result.idea) {
      flash = { tone: 'error', text: result.error ?? 'Could not record that decision.' };
    } else {
      const idea = result.idea;
      let pipelineNote = '';
      if (decision === 'approved') {
        if (!supabase) {
          pipelineNote = ' (could not reach the pipeline database - add the project by hand)';
        } else {
          const { data: person } = await supabase
            .from('people')
            .select('id')
            .ilike('email', idea.leadEmail)
            .maybeSingle();
          const { data: created, error: createErr } = await supabase.rpc('create_project_from_idea', {
            p_title: idea.title,
            p_study_type: studyTypeFor(idea),
            p_lead_id: person?.id ?? null,
            p_submitter_label: `${idea.leadName} <${idea.leadEmail}>`,
          });
          if (createErr) {
            pipelineNote = ` (pipeline project not created: ${createErr.message})`;
          } else {
            // The RPC's return shape isn't pinned down here (scalar id, a
            // row, or nothing) - fall back to looking the new project up by
            // the exact title/submitter we just created it with if it
            // didn't hand back a usable id directly.
            let newProjectId: string | null =
              typeof created === 'string'
                ? created
                : Array.isArray(created)
                  ? (created[0]?.id ?? null)
                  : (created?.id ?? null);
            if (!newProjectId) {
              const { data: justCreated } = await supabase
                .from('projects')
                .select('id')
                .eq('title', idea.title)
                .eq('submitter_label', `${idea.leadName} <${idea.leadEmail}>`)
                .order('created_at', { ascending: false })
                .limit(1)
                .maybeSingle();
              newProjectId = justCreated?.id ?? null;
            }

            const leadNote = person?.id
              ? ' - added to the pipeline as the lead'
              : ' - added to the pipeline, but no lead was assigned (no pipeline account for that email yet)';

            if (!newProjectId) {
              pipelineNote = `${leadNote} (could not find it again to send it to ${conference} - open it in the pipeline and use "Send to conference")`;
            } else {
              const { error: gateErr } = await supabase.rpc('gate1_send_to_conference', {
                p_project: newProjectId,
                p_conference: conference,
                p_recycled_from: null,
              });
              pipelineNote = gateErr
                ? `${leadNote}, but could not send it to ${conference}: ${gateErr.message}`
                : `${leadNote} and sent to ${conference}`;
            }
          }
        }
      }
      let emailed = true;
      let notSetUp = false;
      try {
        notSetUp = !(await deliverIdeaDecision({
          to: idea.leadEmail,
          title: idea.title,
          outcome,
          note: idea.decisionNote,
          cc: emailsFrom(form, 'cc'),
          bcc: emailsFrom(form, 'bcc'),
        }));
      } catch (err) {
        emailed = false;
        console.error('[ideas] decision email failed:', err);
      }
      const verb = OUTCOME_LABEL[outcome];
      flash = notSetUp
        ? { tone: 'error', text: `${verb} and recorded${decision === 'approved' ? pipelineNote : ''}, but no email was sent: email sending isn't set up on this server (it only works on mcaheart.com).` }
        : emailed
        ? {
            tone: 'ok',
            text: `${verb}${decision === 'approved' ? pipelineNote : ''} - email sent to ${idea.leadEmail}.`,
          }
        : {
            tone: 'error',
            text: `${verb} and recorded${decision === 'approved' ? pipelineNote : ''}, but the email to ${idea.leadEmail} could not be sent.`,
          };
    }
  }
}

let ideas: Awaited<ReturnType<typeof listIdeas>> = [];
let dbReady = false;
let dbError = '';
try {
  ideas = await listIdeas();
  dbReady = true;
} catch (err) {
  dbError = err instanceof Error ? err.message : 'Could not load ideas.';
}
const pending = ideas.filter((i) => i.status === 'pending').length;

const fmtDate = (t: number | null) =>
  t ? new Date(t).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : '-';
const ago = (t: number) => {
  const d = Math.floor((Date.now() - t) / 86_400_000);
  if (d === 0) return 'today';
  if (d === 1) return 'yesterday';
  return `${d} days ago`;
};

// CC / BCC suggestions for the decision email: everyone active with a real email.
const { data: rosterRows } = await supabaseAdmin().from('people').select('full_name,email').eq('active', true).order('full_name');
const copyRoster = (rosterRows ?? []).filter((r: any) => r.email && !r.email.endsWith('@import.invalid'));

const { ready: reviewsReady, map: reviews } = await loadReviews();

/** Label for a decided idea: the ticked box, or the plain status for older ones. */
const decidedLabel = (i: IdeaRecord) =>
  i.decisionOutcome ? OUTCOME_LABEL[i.decisionOutcome] : i.status === 'approved' ? 'Approved' : i.status === 'withheld' ? 'Withheld' : 'Declined';
---

<AppLayout title="Ideas" heading="Research ideas" user={me} active="ideas">
  <div class="adm">
    {flash && (
      <div class:list={['adm-flash', `adm-flash--${flash.tone}`]} role="status">
        <p>{flash.text}</p>
      </div>
    )}

    {!dbReady && (
      <div class="adm-flash adm-flash--error">
        <p>
          Ideas storage isn't set up yet. Run <code>mca-pipeline/add-forms-storage.sql</code> in the
          Supabase SQL editor, then reload this page.
          {dbError && <><br /><span class="adm-hint">({dbError})</span></>}
        </p>
      </div>
    )}

    {dbReady && (
      <>
    <p class="ideas__count">
      <strong>{pending}</strong> awaiting review · {ideas.length} total
    </p>

    {ideas.length === 0 && <p class="adm-hint">No idea submissions yet.</p>}

    <div class="ideas__list">
      {ideas.map((i) => (
        <details class="idea" open={i.id === openId}>
          <summary class="idea__summary">
            <span class:list={['idea__pill', `idea__pill--${i.status}`]}>{i.status}</span>
            <span class="idea__title">{i.title}</span>
            <span class="idea__meta">
              {i.leadName} · {i.researchType} · {i.conference === 'none' ? 'no conference' : i.conference === 'flexible' ? 'conf. flexible' : i.conference} · {ago(i.submittedAt)}
              {reviewsReady && i.status === 'pending' && (
                <> · <b class="idea__stage">{(reviews.get(i.id) ?? []).length ? 'Awaiting final decision' : 'Awaiting initial review'}</b></>
              )}
            </span>
            <span class="idea__chev" aria-hidden="true">▾</span>
          </summary>

          <div class="idea__body">
            {(() => {
              const list = reviews.get(i.id) ?? [];
              const pendingIdea = i.status === 'pending';
              const first = list[0];
              return (
                <>
                  {pendingIdea && reviewsReady && (
                    <ol class="steps" aria-label="Review progress">
                      <li class:list={['steps__item', first ? 'is-done' : 'is-current']}>
                        <span class="steps__num">{first ? '✓' : '1'}</span>
                        <span class="steps__text">
                          <b>Initial review</b>
                          <small>{first ? `${reviewerName(first.reviewer)} · ${RECOMMENDATION_LABEL[first.recommendation]}` : 'Jawad or Burhan'}</small>
                        </span>
                      </li>
                      <li class:list={['steps__item', first && 'is-current']}>
                        <span class="steps__num">2</span>
                        <span class="steps__text"><b>Final decision</b><small>{first ? `${REVIEWERS.find((r) => r.key !== first.reviewer)?.name ?? 'The other reviewer'}` : 'The other reviewer'}</small></span>
                      </li>
                      <li class="steps__item">
                        <span class="steps__num">3</span>
                        <span class="steps__text"><b>Email sent</b><small>To the author</small></span>
                      </li>
                    </ol>
                  )}

                  <section class="prop" aria-label="Proposal">
                    <div class="prop__who">
                      <div>
                        <p class="prop__name">{i.leadName}</p>
                        <p class="prop__contact">
                          <a href={`mailto:${i.leadEmail}`}>{i.leadEmail}</a>
                          <span>{i.contactNumber}</span>
                        </p>
                      </div>
                      <div class="prop__chips">
                        <span class="chip">{i.researchType}</span>
                        {(i.databases ?? []).map((d) => <span class="chip">{d}</span>)}
                        <span class="chip">{CONFERENCE_LABELS[i.conference]}</span>
                        {i.attachmentName && <span class="chip chip--file">{i.attachmentName}</span>}
                      </div>
                    </div>

                    <div class="pico">
                      {([['P', 'Population', i.population], ['I', 'Intervention / exposure', i.intervention], ['C', 'Comparison', i.comparison], ['O', 'Outcomes', i.outcomes]] as const).map(([letter, label, text]) => (
                        <div class="pico__cell">
                          <span class="pico__letter">{letter}</span>
                          <div><p class="prop__label">{label}</p><p class="prop__text">{text}</p></div>
                        </div>
                      ))}
                    </div>

                    <div class="prop__grid">
                      <div class="prop__block prop__block--wide"><p class="prop__label">Rationale</p><p class="prop__text">{i.rationale}</p></div>
                      {(i.researchType === 'Database'
                        ? [['Proposed study design', i.studyDesign], ['Prior published studies', i.priorStudies], ['Latest study on topic', i.latestStudy]]
                        : [['Previous meta-analysis', i.previousMetaDate], ['New studies to include', i.newStudies], ['Sample-size increase', i.sampleSizeIncrease]]
                      ).map(([label, text]) => (
                        <div class="prop__block"><p class="prop__label">{label}</p><p class="prop__text">{text || '-'}</p></div>
                      ))}
                      <div class="prop__block prop__block--wide"><p class="prop__label">Manuscript commitment</p><p class="prop__text">{COMMITMENT_LABELS[i.researchType][i.commitment]}</p></div>
                    </div>
                  </section>

                  {reviewsReady && list.map((r) => (
                    <article class:list={['rcard', `rcard--${r.recommendation}`]}>
                      <span class="rcard__avatar" aria-hidden="true">{reviewerName(r.reviewer).split(' ').map((w) => w[0]).join('').slice(0, 2)}</span>
                      <div class="rcard__main">
                        <p class="rcard__head">
                          <b>{reviewerName(r.reviewer)}{r.reviewer === myReviewer ? ' (you)' : ''}</b>
                          <span class="rcard__rec">{RECOMMENDATION_LABEL[r.recommendation]}</span>
                          <span class="rcard__when">{fmtDate(r.reviewedAt)}</span>
                        </p>
                        <p class:list={['rcard__comment', !r.comment && 'is-empty']}>{r.comment ?? 'No comments added.'}</p>
                      </div>
                    </article>
                  ))}

                  {pendingIdea ? (() => {
                    const mine = list.find((r) => r.reviewer === myReviewer);
                    const blocked = decisionBlocked(list, reviewsReady);
                    return (
                      <>
                        {reviewsReady && myReviewer && (list.length === 0 || mine) && (
                          <form method="post" class="panel">
                            <input type="hidden" name="ideaId" value={i.id} />
                            <input type="hidden" name="action" value="review" />
                            <h3 class="panel__title">{mine ? 'Your initial review' : 'Add your initial review'}</h3>
                            <div class="opts opts--3">
                              {(['accept', 'reject', 'modify'] as Recommendation[]).map((opt) => (
                                <label class:list={['opt', `opt--${opt}`]}>
                                  <input type="radio" name="recommendation" value={opt} required checked={mine?.recommendation === opt} />
                                  <span class="opt__dot" aria-hidden="true"></span>
                                  <span class="opt__label">{RECOMMENDATION_LABEL[opt]}</span>
                                </label>
                              ))}
                            </div>
                            <label class="field">
                              <span class="field__label">Comments for the final reviewer</span>
                              <textarea name="review_comment" rows="3" placeholder="What should the other reviewer know?">{mine?.comment ?? ''}</textarea>
                            </label>
                            <div class="panel__foot">
                              <button class="btn" type="submit">{mine ? 'Update review' : 'Save review'}</button>
                            </div>
                          </form>
                        )}

                        {reviewsReady && !myReviewer && list.length === 0 && (
                          <p class="waiting">Waiting for Jawad or Burhan to add an initial review.</p>
                        )}

                        {!blocked && (() => {
                          const initial = renderIdeaDecisionEmail({ to: i.leadEmail, title: i.title, outcome: 'none' as IdeaOutcome, note: null });
                          return (
                            <form method="post" class="panel decide" data-decide data-title={i.title}>
                              <input type="hidden" name="ideaId" value={i.id} />
                              <input type="hidden" name="action" value="confirm" />
                              <div class="decide__controls">
                                <h3 class="panel__title">Final decision</h3>
                                <div class="opts">
                                  {OUTCOMES.map((o) => (
                                    <label class:list={['opt', `opt--${o}`]}>
                                      <input type="radio" name="outcome" value={o} required />
                                      <span class="opt__dot" aria-hidden="true"></span>
                                      <span class="opt__label">{OUTCOME_LABEL[o]}<small>{OUTCOME_HINT[o]}</small></span>
                                    </label>
                                  ))}
                                </div>
                                <label class="field tick__conf">
                                  <span class="field__label">Send to conference</span>
                                  <select name="conference">
                                    <option value="" selected={!defaultConferenceFor(i)}>Choose…</option>
                                    {conferenceOptions.map((c) => <option value={c} selected={c === defaultConferenceFor(i)}>{c}</option>)}
                                  </select>
                                </label>
                                <label class="field">
                                  <span class="field__label">Explanation</span>
                                  <textarea name="note" rows="4" placeholder="Shown in bold under the boxes in the email."></textarea>
                                </label>
                                <details class="copyto">
                                  <summary>CC / BCC</summary>
                                  <div class="copyto__body">
                                    <EmailChips name="cc" label="CC" initial={[]} listId="copy-roster" recommended={COPY_SUGGESTIONS} />
                                    <EmailChips name="bcc" label="BCC" initial={[]} listId="copy-roster" recommended={COPY_SUGGESTIONS} />
                                  </div>
                                </details>
                                <button class="btn decide__send" type="submit" data-decide-send disabled>Send email</button>
                              </div>
                              <div class="mailwin">
                                <div class="mailwin__bar" aria-hidden="true"><i></i><i></i><i></i></div>
                                <dl class="mailwin__head">
                                  <div><dt>To</dt><dd>{i.leadEmail}</dd></div>
                                  <div><dt>Subject</dt><dd>{initial.subject}</dd></div>
                                </dl>
                                <iframe class="mailwin__frame" srcdoc={initial.html} title="Email preview" sandbox="" data-decide-frame></iframe>
                              </div>
                            </form>
                          );
                        })()}
                      </>
                    );
                  })() : (
                    <div class:list={['outcome', `outcome--${i.status}`]}>
                      <p class="outcome__head"><b>{decidedLabel(i)}</b><span>by {i.reviewedBy} · {fmtDate(i.reviewedAt)}</span></p>
                      {i.decisionNote && <p class="outcome__note">{i.decisionNote}</p>}
                      {i.decisionOutcome && (() => {
                        const sent = renderIdeaDecisionEmail({ to: i.leadEmail, title: i.title, outcome: i.decisionOutcome, note: i.decisionNote });
                        return (
                          <details class="outcome__mail">
                            <summary>Show the email</summary>
                            <div class="mailwin">
                              <dl class="mailwin__head">
                                <div><dt>To</dt><dd>{i.leadEmail}</dd></div>
                                <div><dt>Subject</dt><dd>{sent.subject}</dd></div>
                              </dl>
                              <iframe class="mailwin__frame" srcdoc={sent.html} title="Email that was sent" sandbox=""></iframe>
                            </div>
                          </details>
                        );
                      })()}
                    </div>
                  )}
                </>
              );
            })()}
          </div>
        </details>
      ))}
    </div>
      </>
    )}
    <datalist id="copy-roster">
      {copyRoster.map((r: any) => <option value={r.email}>{r.full_name}</option>)}
    </datalist>
  </div>
</AppLayout>

<script>
  import { renderIdeaDecisionEmail, type IdeaOutcome } from '../../lib/idea-email-template';

  // Live preview: every tick or keystroke re-renders the email beside the form.
  document.querySelectorAll<HTMLFormElement>('[data-decide]').forEach((form) => {
    const frame = form.querySelector<HTMLIFrameElement>('[data-decide-frame]')!;
    const send = form.querySelector<HTMLButtonElement>('[data-decide-send]')!;
    const conf = form.querySelector<HTMLSelectElement>('select[name=conference]')!;
    const note = form.querySelector<HTMLTextAreaElement>('textarea[name=note]')!;
    const title = form.dataset.title ?? '';
    const update = () => {
      const outcome = form.querySelector<HTMLInputElement>('input[name=outcome]:checked')?.value as IdeaOutcome | undefined;
      frame.srcdoc = renderIdeaDecisionEmail({ to: '', title, outcome: outcome ?? ('none' as IdeaOutcome), note: note.value }).html;
      conf.required = outcome === 'approved';
      send.disabled = !outcome;
    };
    form.addEventListener('input', update);
    form.addEventListener('change', update);
    update();
  });
</script>

<style>
  .ideas__count { font-size: 0.86rem; color: var(--text-muted); }
  .ideas__count strong { color: var(--text-strong); }
  .ideas__list { display: grid; gap: 0.6rem; }

  .idea {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .idea[open] { border-color: var(--border); }

  .idea__summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'pill title chev' 'pill meta chev';
    gap: 0.15rem 0.75rem;
    align-items: center;
    padding: 0.9rem 1.1rem;
    cursor: pointer;
    list-style: none;
  }
  .idea__summary::-webkit-details-marker { display: none; }
  .idea__summary:hover { background: var(--bg-tint); }

  .idea__pill {
    grid-area: pill;
    align-self: start;
    margin-top: 0.1rem;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 0;
  }
  .idea__pill::first-letter { text-transform: uppercase; }
  .idea__pill--pending { color: var(--warn); background: var(--warn-bg); }
  .idea__pill--approved { color: var(--ok); background: var(--ok-bg); }
