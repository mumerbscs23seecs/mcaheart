---
import { supabaseForRequest } from '../lib/supabase';
import { endSession } from '../lib/auth';

export const prerender = false;

// Clear both sessions: the in-memory members-area one and any Supabase pipeline
// session left in the cookies.
await supabaseForRequest(Astro.request, Astro.cookies).auth.signOut().catch(() => {});
endSession(Astro.cookies);
return Astro.redirect('/', 303);
---
