---
import { supabaseForRequest } from '../lib/supabase';
import { clearHintCookie } from '../lib/auth';

export const prerender = false;

// End the Supabase session and drop the header's members-menu hint.
await supabaseForRequest(Astro.request, Astro.cookies).auth.signOut().catch(() => {});
clearHintCookie(Astro.cookies);
return Astro.redirect('/', 303);
---
